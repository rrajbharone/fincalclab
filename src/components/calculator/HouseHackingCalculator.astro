---
import CalculatorLayout from './CalculatorLayout.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
---

<CalculatorLayout
  title="House Hacking Calculator"
  description="Estimate how much rental income from your multi-family property or spare bedrooms can offset your mortgage, eliminate housing expenses, and generate positive cash flow."
  category="Real Estate &amp; Investing"
>
  <!-- Inputs Section -->
  <div slot="inputs" class="calc-inputs-wrapper" id="house-hacking-calculator">
    
    <!-- Section 1: Property Purchase & Financing -->
    <h3 class="input-section-heading">1. Property Purchase &amp; Mortgage Financing</h3>
    
    <!-- Currency Selector -->
    <div class="input-group">
      <div class="input-label-row">
        <label for="hh-currency-select">Currency</label>
        <select id="hh-currency-select" class="currency-select" aria-label="Select Currency">
          <option value="USD" selected>USD ($) - US Dollar</option>
          <option value="CAD">CAD (C$) - Canadian Dollar</option>
          <option value="GBP">GBP (£) - British Pound</option>
          <option value="EUR">EUR (€) - Euro</option>
          <option value="AUD">AUD (A$) - Australian Dollar</option>
          <option value="INR">INR (₹) - Indian Rupee</option>
          <option value="SGD">SGD (S$) - Singapore Dollar</option>
          <option value="JPY">JPY (¥) - Japanese Yen</option>
          <option value="CHF">CHF (CHF) - Swiss Franc</option>
        </select>
      </div>
    </div>

    <!-- Purchase Price -->
    <div class="input-group">
      <div class="input-label-row">
        <label for="hh-price-input">Property Purchase Price</label>
        <div class="input-symbol-wrapper">
          <span class="currency-symbol" id="sym-price">$</span>
          <input 
            type="number" 
            id="hh-price-input" 
            min="10000" 
            step="5000" 
            value="425000" 
            aria-label="Property Purchase Price" 
          />
        </div>
      </div>
      <input 
        type="range" 
        id="hh-price-slider" 
        min="100000" 
        max="1200000" 
        step="10000" 
        value="425000" 
        class="slider-range" 
        aria-label="Purchase Price Slider" 
      />
      <span class="input-hint">Agreed purchase price for the duplex, triplex, fourplex, or single-family house.</span>
    </div>

    <!-- Down Payment Row (% and Amount) -->
    <div class="input-row-grid">
      <div class="input-group">
        <div class="input-label-row">
          <label for="hh-dp-pct-input">Down Payment (%)</label>
          <div class="input-symbol-wrapper">
            <input 
              type="number" 
              id="hh-dp-pct-input" 
              min="0" 
              max="100" 
              step="0.5" 
              value="5.0" 
              aria-label="Down Payment Percentage" 
            />
            <span class="unit-symbol">%</span>
          </div>
        </div>
        <input 
          type="range" 
          id="hh-dp-pct-slider" 
          min="0" 
          max="30" 
          step="0.5" 
          value="5.0" 
          class="slider-range" 
          aria-label="Down Payment Percentage Slider" 
        />
        <span class="input-hint">E.g., 3.5% FHA, 5% Conventional, or 20%.</span>
      </div>

      <div class="input-group">
        <div class="input-label-row">
          <label for="hh-dp-amt-input">Down Payment Amount</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol" id="sym-dp-amt">$</span>
            <input 
              type="number" 
              id="hh-dp-amt-input" 
              min="0" 
              step="1000" 
              value="21250" 
              aria-label="Down Payment Dollar Amount" 
            />
          </div>
        </div>
        <span class="input-hint">Auto-calculated from down payment percentage.</span>
      </div>
    </div>

    <!-- Closing Costs & Initial Repairs -->
    <div class="input-row-grid">
      <div class="input-group">
        <div class="input-label-row">
          <label for="hh-closing-input">Closing Costs</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol" id="sym-closing">$</span>
            <input 
              type="number" 
              id="hh-closing-input" 
              min="0" 
              step="500" 
              value="9000" 
              aria-label="Estimated Closing Costs" 
            />
          </div>
        </div>
        <span class="input-hint">Lender fees, title, escrow (~2%–4% of price).</span>
      </div>

      <div class="input-group">
        <div class="input-label-row">
          <label for="hh-repairs-input">Initial Repairs &amp; Renovation</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol" id="sym-repairs">$</span>
            <input 
              type="number" 
              id="hh-repairs-input" 
              min="0" 
              step="500" 
              value="8000" 
              aria-label="Initial Repairs and Renovation Costs" 
            />
          </div>
        </div>
        <span class="input-hint">Upfront cosmetic or tenant unit repairs.</span>
      </div>
    </div>

    <!-- Mortgage Interest Rate & Loan Term -->
    <div class="input-row-grid">
      <div class="input-group">
        <div class="input-label-row">
          <label for="hh-rate-input">Interest Rate (%)</label>
          <div class="input-symbol-wrapper">
            <input 
              type="number" 
              id="hh-rate-input" 
              min="0.0" 
              max="15.0" 
              step="0.125" 
              value="6.5" 
              aria-label="Mortgage Interest Rate" 
            />
            <span class="unit-symbol">%</span>
          </div>
        </div>
        <input 
          type="range" 
          id="hh-rate-slider" 
          min="2.0" 
          max="11.0" 
          step="0.125" 
          value="6.5" 
          class="slider-range" 
          aria-label="Interest Rate Slider" 
        />
      </div>

      <div class="input-group">
        <div class="input-label-row">
          <label for="hh-term-select">Mortgage Term</label>
          <select id="hh-term-select" class="currency-select" aria-label="Mortgage Term in Years">
            <option value="30" selected>30 Years Fixed</option>
            <option value="25">25 Years Fixed</option>
            <option value="20">20 Years Fixed</option>
            <option value="15">15 Years Fixed</option>
          </select>
        </div>
        <span class="input-hint">Standard residential financing term.</span>
      </div>
    </div>

    <!-- Section 2: Monthly Rental Income -->
    <div style="margin-top: var(--space-6);">
      <h3 class="input-section-heading">2. Monthly Rental Income (Tenant Units &amp; Rooms)</h3>
      
      <!-- Units / Bedrooms Count -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="hh-units-count-select">Number of Rental Units / Rooms</label>
          <select id="hh-units-count-select" class="currency-select" aria-label="Number of Tenant Units or Rooms">
            <option value="1">1 Unit / Room (e.g. Duplex - 1 Tenant Unit)</option>
            <option value="2" selected>2 Units / Rooms (e.g. Triplex - 2 Tenant Units)</option>
            <option value="3">3 Units / Rooms (e.g. Fourplex - 3 Tenant Units)</option>
            <option value="4">4 Units / Rooms (e.g. 4-Bedroom House Hack)</option>
            <option value="5">5 Units / Rooms</option>
            <option value="6">6 Units / Rooms</option>
          </select>
        </div>
        <span class="input-hint">Specify how many tenant units or rented bedrooms you have alongside your own unit.</span>
      </div>

      <!-- Repeatable Rental Unit Inputs Container -->
      <div id="hh-units-list" class="units-list-container">
        <!-- Injected via JavaScript dynamically -->
      </div>

      <!-- Add Unit Button for Convenience -->
      <div style="margin-top: var(--space-2); margin-bottom: var(--space-4);">
        <button type="button" id="hh-add-unit-btn" class="add-unit-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          Add Another Rental Unit / Room
        </button>
      </div>

      <!-- Other Monthly Rental Income & Vacancy Allowance -->
      <div class="input-row-grid">
        <div class="input-group">
          <div class="input-label-row">
            <label for="hh-other-income-input">Other Monthly Rental Income</label>
            <div class="input-symbol-wrapper">
              <span class="currency-symbol" id="sym-other-inc">$</span>
              <input 
                type="number" 
                id="hh-other-income-input" 
                min="0" 
                step="25" 
                value="50" 
                aria-label="Other Monthly Rental Income" 
              />
            </div>
          </div>
          <span class="input-hint">Parking, garage, storage, laundry, pet rent.</span>
        </div>

        <div class="input-group">
          <div class="input-label-row">
            <label for="hh-vacancy-input">Vacancy Allowance (%)</label>
            <div class="input-symbol-wrapper">
              <input 
                type="number" 
                id="hh-vacancy-input" 
                min="0" 
                max="25" 
                step="0.5" 
                value="5.0" 
                aria-label="Vacancy Allowance Percentage" 
              />
              <span class="unit-symbol">%</span>
            </div>
          </div>
          <input 
            type="range" 
            id="hh-vacancy-slider" 
            min="0" 
            max="15" 
            step="0.5" 
            value="5.0" 
            class="slider-range" 
            aria-label="Vacancy Rate Slider" 
          />
          <span class="input-hint">Standard buffer for tenant turnover (~5% = 18 days/yr).</span>
        </div>
      </div>
    </div>

    <!-- Section 3: Monthly Property Operating Expenses -->
    <div style="margin-top: var(--space-6);">
      <h3 class="input-section-heading">3. Monthly Property Operating Expenses</h3>
      
      <!-- Property Taxes & Insurance -->
      <div class="input-row-grid">
        <div class="input-group">
          <div class="input-label-row">
            <label for="hh-tax-input">Property Taxes (Monthly)</label>
            <div class="input-symbol-wrapper">
              <span class="currency-symbol" id="sym-tax">$</span>
              <input 
                type="number" 
                id="hh-tax-input" 
                min="0" 
                step="25" 
                value="375" 
                aria-label="Monthly Property Taxes" 
              />
            </div>
          </div>
          <span class="input-hint" id="hint-tax-annual">Annual: $4,500 (~1.06% of price)</span>
        </div>

        <div class="input-group">
          <div class="input-label-row">
            <label for="hh-insurance-input">Homeowners Insurance (Monthly)</label>
            <div class="input-symbol-wrapper">
              <span class="currency-symbol" id="sym-ins">$</span>
              <input 
                type="number" 
                id="hh-insurance-input" 
                min="0" 
                step="10" 
                value="140" 
                aria-label="Monthly Homeowners Insurance" 
              />
            </div>
          </div>
          <span class="input-hint" id="hint-ins-annual">Annual: $1,680</span>
        </div>
      </div>

      <!-- PMI & Maintenance -->
      <div class="input-row-grid">
        <div class="input-group">
          <div class="input-label-row">
            <label for="hh-pmi-input">PMI / Mortgage Insurance</label>
            <div class="input-symbol-wrapper">
              <span class="currency-symbol" id="sym-pmi">$</span>
              <input 
                type="number" 
                id="hh-pmi-input" 
                min="0" 
                step="10" 
                value="160" 
                aria-label="Monthly PMI or Mortgage Insurance" 
              />
            </div>
          </div>
          <span class="input-hint">Applies when down payment is under 20%.</span>
        </div>

        <div class="input-group">
          <div class="input-label-row">
            <label for="hh-maint-input">Maintenance &amp; CapEx</label>
            <div class="input-symbol-wrapper">
              <span class="currency-symbol" id="sym-maint">$</span>
              <input 
                type="number" 
                id="hh-maint-input" 
                min="0" 
                step="25" 
                value="200" 
                aria-label="Monthly Maintenance and Repairs" 
              />
            </div>
          </div>
          <span class="input-hint">Reserve fund for repairs, roof, HVAC, plumbing.</span>
        </div>
      </div>

      <!-- Utilities, Management & HOA -->
      <div class="input-row-grid">
        <div class="input-group">
          <div class="input-label-row">
            <label for="hh-utils-input">Owner-Paid Utilities</label>
            <div class="input-symbol-wrapper">
              <span class="currency-symbol" id="sym-utils">$</span>
              <input 
                type="number" 
                id="hh-utils-input" 
                min="0" 
                step="25" 
                value="175" 
                aria-label="Owner-Paid Monthly Utilities" 
              />
            </div>
          </div>
          <span class="input-hint">Water, sewer, trash, common electric, WiFi.</span>
        </div>

        <div class="input-group">
          <div class="input-label-row">
            <label for="hh-mgmt-input">Property Management</label>
            <div class="input-symbol-wrapper">
              <span class="currency-symbol" id="sym-mgmt">$</span>
              <input 
                type="number" 
                id="hh-mgmt-input" 
                min="0" 
                step="25" 
                value="0" 
                aria-label="Monthly Property Management Fee" 
              />
            </div>
          </div>
          <span class="input-hint">Leave $0 if you self-manage your house hack.</span>
        </div>
      </div>

      <!-- HOA Fees -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="hh-hoa-input">HOA Fees &amp; Other Recurring Expenses</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol" id="sym-hoa">$</span>
            <input 
              type="number" 
              id="hh-hoa-input" 
              min="0" 
              step="25" 
              value="0" 
              aria-label="Monthly HOA Fees and Other Expenses" 
            />
          </div>
        </div>
        <span class="input-hint">Monthly condo or community association fees, if applicable.</span>
      </div>
    </div>

    <!-- Section 4: Optional Comparison -->
    <div style="margin-top: var(--space-6);">
      <h3 class="input-section-heading">4. Housing Cost Comparison (Optional)</h3>
      
      <div class="input-group">
        <div class="input-label-row">
          <label for="hh-current-cost-input">Current Monthly Housing Cost (Rent or Mortgage)</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol" id="sym-curr">$</span>
            <input 
              type="number" 
              id="hh-current-cost-input" 
              min="0" 
              step="50" 
              value="2000" 
              aria-label="Current Monthly Housing Cost" 
            />
          </div>
        </div>
        <span class="input-hint">Compare your new out-of-pocket payment against what you currently pay to live elsewhere.</span>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="inputs-actions" style="margin-top: var(--space-6);">
      <Button id="hh-reset-btn" variant="outline" size="sm" style="width: 100%;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
        Reset Calculator to Defaults
      </Button>
    </div>
  </div>

  <!-- Results Section -->
  <div slot="results" class="calc-results-wrapper">
    <h3 class="results-heading">House Hacking Cash Flow &amp; Housing Cost</h3>

    <!-- Core Payout Display (Hero Boxes) -->
    <div class="net-value-container">
      <!-- Box 1: Primary Out-of-Pocket / Net Cash Flow -->
      <div class="net-value-box out-of-pocket-box" id="box-primary-result">
        <span class="net-box-label" id="lbl-primary-title">Net Monthly Out-of-Pocket Housing Cost</span>
        <div id="res-primary-amount" class="net-box-amount text-primary">$1,061</div>
        <span class="net-box-sub" id="lbl-primary-sub">You pay $1,061/mo instead of full $3,581 expenses</span>
      </div>

      <!-- Box 2: Total Property Expenses -->
      <div class="net-value-box expenses-box">
        <span class="net-box-label">Total Monthly Property Expenses</span>
        <div id="res-total-expenses" class="net-box-amount text-muted">$3,581</div>
        <span class="net-box-sub" id="lbl-expense-breakdown">Mortgage P&amp;I: $2,551 | OpEx: $1,030</span>
      </div>

      <!-- Box 3: Effective Rental Income -->
      <div class="net-value-box income-box">
        <span class="net-box-label">Effective Monthly Rental Income</span>
        <div id="res-effective-income" class="net-box-amount text-accent">$2,520</div>
        <span class="net-box-sub" id="lbl-gross-income">Gross: $2,650/mo | Vacancy Loss: -$130/mo</span>
      </div>
    </div>

    <!-- Rental Coverage Visual Progress Bar -->
    <div class="coverage-bar-card">
      <div class="coverage-bar-header">
        <span class="coverage-bar-title">Rental Income Expense Coverage</span>
        <span class="coverage-bar-pct" id="res-coverage-pct">70.4%</span>
      </div>
      <div class="coverage-track" role="progressbar" aria-valuenow="70.4" aria-valuemin="0" aria-valuemax="100">
        <div class="coverage-fill" id="bar-coverage-fill" style="width: 70.4%;"></div>
      </div>
      <div class="coverage-bar-labels">
        <span>0% (Full Out-of-Pocket)</span>
        <span>100% (Free Living)</span>
        <span>120%+ (Positive Cash Flow)</span>
      </div>
    </div>

    <!-- Dynamic Status Verdict Card -->
    <div class="verdict-banner" id="verdict-banner">
      <div class="verdict-icon" id="verdict-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      </div>
      <div class="verdict-content">
        <h4 class="verdict-title" id="verdict-title">Substantial Housing Subsidy</h4>
        <p class="verdict-desc" id="verdict-desc">
          Your tenants cover 70.4% of your total property expenses. You save $939/month compared to your current housing cost!
        </p>
      </div>
    </div>

    <!-- 8-Metric Responsive Breakdown Grid (Rule 15 Compliant) -->
    <div class="metrics-grid">
      <!-- Metric 1: Monthly Mortgage (P&I) -->
      <div class="metric-card">
        <span class="metric-label">Monthly Mortgage (P&amp;I)</span>
        <span class="metric-value" id="res-mortgage">$2,551</span>
        <span class="metric-sub" id="lbl-mortgage-sub">Loan: $403,750 @ 6.5%</span>
      </div>

      <!-- Metric 2: Monthly Operating Expenses -->
      <div class="metric-card">
        <span class="metric-label">Monthly Operating Expenses</span>
        <span class="metric-value" id="res-monthly-opex">$1,030</span>
        <span class="metric-sub">Taxes, Insurance, PMI, Maint, Utils</span>
      </div>

      <!-- Metric 3: Gross Rental Income -->
      <div class="metric-card">
        <span class="metric-label">Gross Monthly Rental Income</span>
        <span class="metric-value text-accent" id="res-gross-rent">$2,650</span>
        <span class="metric-sub" id="lbl-gross-sub">2 Units/Rooms + Other Income</span>
      </div>

      <!-- Metric 4: Expected Vacancy Loss -->
      <div class="metric-card">
        <span class="metric-label">Expected Vacancy Loss</span>
        <span class="metric-value text-muted" id="res-vacancy-loss">-$130</span>
        <span class="metric-sub" id="lbl-vacancy-sub">5.0% turnover buffer</span>
      </div>

      <!-- Metric 5: Initial Cash Required -->
      <div class="metric-card">
        <span class="metric-label">Initial Cash to Close</span>
        <span class="metric-value" id="res-initial-cash">$38,250</span>
        <span class="metric-sub" id="lbl-cash-breakdown">Down ($21.3k) + Close ($9k) + Rep ($8k)</span>
      </div>

      <!-- Metric 6: Monthly Property Cash Flow -->
      <div class="metric-card">
        <span class="metric-label">Monthly Property Cash Flow</span>
        <span class="metric-value" id="res-cash-flow">-$1,061</span>
        <span class="metric-sub" id="lbl-cash-flow-sub">Owner covers remaining cost</span>
      </div>

      <!-- Metric 7: Monthly Housing Savings -->
      <div class="metric-card highlight-card">
        <span class="metric-label">Monthly Housing Savings</span>
        <span class="metric-value text-success" id="res-monthly-savings">+$939</span>
        <span class="metric-sub" id="lbl-savings-sub">vs $2,000/mo Current Rent</span>
      </div>

      <!-- Metric 8: Annual Housing Savings -->
      <div class="metric-card highlight-card">
        <span class="metric-label">Annual Housing Savings</span>
        <span class="metric-value text-success" id="res-annual-savings">+$11,269</span>
        <span class="metric-sub">Extra wealth accumulated each year</span>
      </div>
    </div>

    <!-- Monthly Cash Flow & Expense Itemization Table -->
    <div class="breakdown-table-wrapper" style="margin-top: var(--space-6);">
      <h4 class="table-heading">Monthly House Hacking Cash Flow Statement</h4>
      <div class="table-scroll-container">
        <table class="cashflow-table">
          <thead>
            <tr>
              <th>Line Item Category</th>
              <th style="text-align: right;">Monthly Amount</th>
              <th style="text-align: right;">Annual Amount</th>
            </tr>
          </thead>
          <tbody>
            <tr class="row-highlight-income">
              <td><strong>Gross Rental Income</strong></td>
              <td style="text-align: right;" id="tbl-gross-rent">$2,650</td>
              <td style="text-align: right;" id="tbl-annual-gross-rent">$31,800</td>
            </tr>
            <tr class="row-deduct">
              <td>Less: Vacancy Allowance (<span id="tbl-vacancy-pct">5.0%</span>)</td>
              <td style="text-align: right;" id="tbl-vacancy">-$130</td>
              <td style="text-align: right;" id="tbl-annual-vacancy">-$1,560</td>
            </tr>
            <tr class="row-subtotal">
              <td><strong>= Effective Rental Income</strong></td>
              <td style="text-align: right;"><strong id="tbl-eff-rent">$2,520</strong></td>
              <td style="text-align: right;"><strong id="tbl-annual-eff-rent">$30,240</strong></td>
            </tr>
            <tr>
              <td>Mortgage Principal &amp; Interest</td>
              <td style="text-align: right;" id="tbl-mortgage">-$2,551</td>
              <td style="text-align: right;" id="tbl-annual-mortgage">-$30,612</td>
            </tr>
            <tr>
              <td>Property Taxes</td>
              <td style="text-align: right;" id="tbl-taxes">-$375</td>
              <td style="text-align: right;" id="tbl-annual-taxes">-$4,500</td>
            </tr>
            <tr>
              <td>Homeowners Insurance</td>
              <td style="text-align: right;" id="tbl-insurance">-$140</td>
              <td style="text-align: right;" id="tbl-annual-insurance">-$1,680</td>
            </tr>
            <tr>
              <td>PMI / Mortgage Insurance</td>
              <td style="text-align: right;" id="tbl-pmi">-$160</td>
              <td style="text-align: right;" id="tbl-annual-pmi">-$1,920</td>
            </tr>
            <tr>
              <td>Maintenance &amp; CapEx Reserves</td>
              <td style="text-align: right;" id="tbl-maint">-$200</td>
              <td style="text-align: right;" id="tbl-annual-maint">-$2,400</td>
            </tr>
            <tr>
              <td>Owner-Paid Utilities</td>
              <td style="text-align: right;" id="tbl-utils">-$175</td>
              <td style="text-align: right;" id="tbl-annual-utils">-$2,100</td>
            </tr>
            <tr>
              <td>Property Management &amp; HOA</td>
              <td style="text-align: right;" id="tbl-mgmt-hoa">$0</td>
