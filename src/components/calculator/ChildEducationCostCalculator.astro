    // Helper: Number Formatter based on country
    function formatMoney(amount: number, country: string): string {
      const rounded = Math.round(amount);
      if (country === 'IN') {
        return rounded.toLocaleString('en-IN');
      }
      return rounded.toLocaleString('en-US');
    }

    function formatShortCurrency(amount: number, country: string): string {
      const sym = COUNTRY_CONFIGS[country].currencySym;
      if (country === 'IN') {
        if (amount >= 10000000) {
          return `${sym}${(amount / 10000000).toFixed(2)} Cr`;
        }
        if (amount >= 100000) {
          return `${sym}${(amount / 100000).toFixed(2)} L`;
        }
      }
      if (amount >= 1000000) {
        return `${sym}${(amount / 1000000).toFixed(2)}M`;
      }
      if (amount >= 1000) {
        return `${sym}${(amount / 1000).toFixed(0)}k`;
      }
      return `${sym}${Math.round(amount)}`;
    }

    // Populate Education Levels for Current Country
    function populateEducationLevels(country: string, preserveSelection = false) {
      if (!eduLevelSelect) return;
      const cfg = COUNTRY_CONFIGS[country];
      const previousValue = eduLevelSelect.value;
      eduLevelSelect.innerHTML = '';

      cfg.levels.forEach((lvl, idx) => {
        const opt = document.createElement('option');
        opt.value = lvl.id;
        opt.textContent = lvl.label;
        if (!preserveSelection && idx === 0) {
          opt.selected = true;
        } else if (preserveSelection && lvl.id === previousValue) {
          opt.selected = true;
        }
        eduLevelSelect.appendChild(opt);
      });

      if (!preserveSelection || !cfg.levels.some(l => l.id === previousValue)) {
        eduLevelSelect.value = cfg.levels[0].id;
      }

      onLevelChanged(false);
    }

    // When Level changes, populate categories and set default duration / start age
    function onLevelChanged(isUserCategorySwitch = false) {
      if (!eduLevelSelect || !eduCategorySelect) return;
      const cfg = COUNTRY_CONFIGS[activeCountry];
      const currentLevel = cfg.levels.find(l => l.id === eduLevelSelect.value) || cfg.levels[0];

      if (eduLevelSubtext) {
        eduLevelSubtext.textContent = currentLevel.subtext;
      }

      eduCategorySelect.innerHTML = '';
      currentLevel.categories.forEach((cat, idx) => {
        const opt = document.createElement('option');
        opt.value = cat.id;
        opt.textContent = cat.label;
        if (idx === 0) opt.selected = true;
        eduCategorySelect.appendChild(opt);
      });

      if (!isUserCategorySwitch) {
        // Set default timeline
        durationInput.value = String(currentLevel.defaultDuration);
        durationSlider.value = String(currentLevel.defaultDuration);

        // Adjust start age if needed
        const curAge = Math.max(0, parseInt(childAgeInput.value) || 0);
        let targetStart = currentLevel.defaultStartAge;
        if (targetStart <= curAge) {
          targetStart = curAge + 1;
        }
        startAgeInput.value = String(targetStart);
        startAgeSlider.value = String(targetStart);
      }

      onCategoryChanged();
    }

    // When Category changes, update base cost and additional costs
    function onCategoryChanged() {
      if (!eduLevelSelect || !eduCategorySelect) return;
      const cfg = COUNTRY_CONFIGS[activeCountry];
      const currentLevel = cfg.levels.find(l => l.id === eduLevelSelect.value) || cfg.levels[0];
      const currentCat = currentLevel.categories.find(c => c.id === eduCategorySelect.value) || currentLevel.categories[0];

      if (eduCategorySubtext) {
        eduCategorySubtext.textContent = currentCat.subtext;
      }

      let baseCost = currentCat.defaultBaseCost;
      let addCost = currentCat.defaultAddCost;

      // Special Singapore Student Status override
      if (activeCountry === 'SG' && sgStatusSelect) {
        const status = sgStatusSelect.value || 'citizen';
        const statusRates = SG_STATUS_RATES[status];
        if (statusRates && statusRates[currentCat.id]) {
          baseCost = statusRates[currentCat.id].base;
          addCost = statusRates[currentCat.id].add;
        }
      }

      baseCostInput.value = String(baseCost);
      addCostInput.value = String(addCost);

      calculateAndRender();
    }

    // Update Country UI and reset/populate fields
    function updateCountryUI(country: string) {
      activeCountry = country;
      const cfg = COUNTRY_CONFIGS[country];

      // Sync mobile dropdown
      if (mobileCountrySelect && mobileCountrySelect.value !== country) {
        mobileCountrySelect.value = country;
      }
      if (mobileSelectedFlag) {
        mobileSelectedFlag.textContent = cfg.flag;
      }

      // Sync desktop pills
      countryPills.forEach(p => {
        const isCurrent = (p.getAttribute('data-country') === country);
        p.classList.toggle('active', isCurrent);
        p.setAttribute('aria-selected', String(isCurrent));
      });

      // Update badge and descriptions
      if (countryActiveBadge) countryActiveBadge.textContent = `${cfg.name} (${cfg.currencyCode} ${cfg.currencySym.trim()})`;
      if (countryHelpText) countryHelpText.textContent = cfg.helpText;
      if (tipHeading) tipHeading.textContent = cfg.guidanceHeading;
      if (tipBody) tipBody.textContent = cfg.guidanceBody;

      // Toggle Singapore specific status dropdown
      if (fieldSgStatus) {
        fieldSgStatus.classList.toggle('hidden', country !== 'SG');
      }

      // Update currency symbols across input & result cards
      const sym = cfg.currencySym;
      if (currSym1) currSym1.textContent = sym;
      if (currSym2) currSym2.textContent = sym;
      if (currSym3) currSym3.textContent = sym;
      if (resCurrSym) resCurrSym.textContent = sym;
      if (subCurr1) subCurr1.textContent = sym;
      if (subCurr2) subCurr2.textContent = sym;

      // Update defaults for inflation & return
      inflationInput.value = cfg.defaultInflation.toFixed(1);
      inflationSlider.value = String(cfg.defaultInflation);
      returnInput.value = cfg.defaultReturn.toFixed(1);
      returnSlider.value = String(cfg.defaultReturn);

      // Default existing savings per country scale
      if (country === 'IN') {
        existingSavingsInput.value = '200000';
      } else if (country === 'UAE') {
        existingSavingsInput.value = '25000';
      } else if (country === 'SG') {
        existingSavingsInput.value = '15000';
      }

      // Populate education levels and categories
      populateEducationLevels(country, false);
    }

    // Core Calculation and DOM Rendering
    function calculateAndRender() {
      const curAge = Math.max(0, parseInt(childAgeInput.value) || 0);
      let startAge = Math.max(1, parseInt(startAgeInput.value) || 1);
      if (startAge < curAge) {
        startAge = curAge;
        startAgeInput.value = String(curAge);
        startAgeSlider.value = String(curAge);
      }

      const dur = Math.max(1, Math.min(20, parseInt(durationInput.value) || 1));
      const yearsUntilStart = Math.max(0, startAge - curAge);

      // Horizon indicator text
      if (horizonText) {
        const endAge = startAge + dur;
        if (yearsUntilStart === 0) {
          horizonText.textContent = `Education starts immediately (Child age ${curAge}) and runs for ${dur} years (until age ${endAge}).`;
        } else {
          horizonText.textContent = `${yearsUntilStart} years until education starts (Age ${startAge} to ${endAge}).`;
        }
      }

      const baseCost = Math.max(0, parseFloat(baseCostInput.value) || 0);
      const addCost = Math.max(0, parseFloat(addCostInput.value) || 0);
      const annualCostToday = baseCost + addCost;
      const totalCostToday = annualCostToday * dur;

      const inflationRate = Math.max(0, parseFloat(inflationInput.value) || 0) / 100;
      const returnRate = Math.max(0, parseFloat(returnInput.value) || 0) / 100;
      const existingSavings = Math.max(0, parseFloat(existingSavingsInput.value) || 0);

      // Year-by-year projected cash flows
      const yearlyCosts: { yearIndex: number; childAge: number; calendarYear: number; inflatedCost: number; inflationFactor: number }[] = [];
      let totalProjectedCost = 0;
      let firstYearCost = 0;
      const currentCalendarYear = new Date().getFullYear();

      for (let y = 1; y <= dur; y++) {
        const elapsedYears = yearsUntilStart + (y - 1);
        const inflationFactor = Math.pow(1 + inflationRate, elapsedYears);
        const inflatedCost = annualCostToday * inflationFactor;
        yearlyCosts.push({
          yearIndex: y,
          childAge: startAge + (y - 1),
          calendarYear: currentCalendarYear + elapsedYears,
          inflatedCost,
          inflationFactor
        });
        totalProjectedCost += inflatedCost;
        if (y === 1) firstYearCost = inflatedCost;
      }

      // FV of existing savings at start of education
      const fvExistingSavingsAtStart = existingSavings * Math.pow(1 + returnRate, yearsUntilStart);

      // Present value of education cash flows at year T
      let pvCorpusAtStart = 0;
      for (let y = 1; y <= dur; y++) {
        const discountYears = y - 1;
        if (returnRate === 0) {
          pvCorpusAtStart += yearlyCosts[y - 1].inflatedCost;
        } else {
          pvCorpusAtStart += yearlyCosts[y - 1].inflatedCost / Math.pow(1 + returnRate, discountYears);
        }
      }

      // Net Target Corpus needed at Year T
      const isSurplus = fvExistingSavingsAtStart >= pvCorpusAtStart;
      const netCorpusGapAtStart = Math.max(0, pvCorpusAtStart - fvExistingSavingsAtStart);
      const surplusAmount = isSurplus ? fvExistingSavingsAtStart - pvCorpusAtStart : 0;

      // Required Monthly & Annual Investments
      let requiredMonthlySavings = 0;
      let requiredAnnualSavings = 0;

      if (netCorpusGapAtStart > 0) {
        if (yearsUntilStart === 0) {
          const totalMonths = dur * 12;
          const monthlyRate = returnRate / 12;
          if (returnRate === 0) {
            requiredMonthlySavings = netCorpusGapAtStart / totalMonths;
            requiredAnnualSavings = netCorpusGapAtStart / dur;
          } else {
            requiredMonthlySavings = netCorpusGapAtStart * (monthlyRate / (Math.pow(1 + monthlyRate, totalMonths) - 1));
            requiredAnnualSavings = netCorpusGapAtStart * (returnRate / (Math.pow(1 + returnRate, dur) - 1));
          }
        } else {
          const totalMonths = yearsUntilStart * 12;
          const monthlyRate = returnRate / 12;
          if (returnRate === 0) {
            requiredMonthlySavings = netCorpusGapAtStart / totalMonths;
            requiredAnnualSavings = netCorpusGapAtStart / yearsUntilStart;
          } else {
            requiredMonthlySavings = netCorpusGapAtStart * (monthlyRate / (Math.pow(1 + monthlyRate, totalMonths) - 1));
            requiredAnnualSavings = netCorpusGapAtStart * (returnRate / (Math.pow(1 + returnRate, yearsUntilStart) - 1));
          }
        }
      }

      // Total Capital Invested (Out of pocket)
      let totalDeposits = 0;
      if (yearsUntilStart > 0) {
        if (savingsFrequency === 'monthly') {
          totalDeposits = requiredMonthlySavings * (yearsUntilStart * 12);
        } else {
          totalDeposits = requiredAnnualSavings * yearsUntilStart;
        }
      } else {
        totalDeposits = (savingsFrequency === 'monthly') ? requiredMonthlySavings * (dur * 12) : requiredAnnualSavings * dur;
      }

      const totalOutOfPocket = existingSavings + totalDeposits;
      const totalInvestmentGrowth = Math.max(0, totalProjectedCost - totalOutOfPocket);
      const growthSharePct = totalProjectedCost > 0 ? (totalInvestmentGrowth / totalProjectedCost) * 100 : 0;
      const inflationMultiplier = totalCostToday > 0 ? (totalProjectedCost / totalCostToday) : 1;

      // Update Hero Card
      if (resInflationMultiplier) {
        resInflationMultiplier.textContent = `${inflationMultiplier.toFixed(1)}× Today's Cost`;
      }
      if (resTotalCost) {
        resTotalCost.textContent = formatMoney(totalProjectedCost, activeCountry);
      }
      if (resHeroVerdict) {
        const startYr = currentCalendarYear + yearsUntilStart;
        const curSym = COUNTRY_CONFIGS[activeCountry].currencySym;
        if (activeCountry === 'IN') {
          const formattedLakh = (totalProjectedCost / 100000).toFixed(2);
          resHeroVerdict.textContent = `Over ${dur} years of education starting in ${startYr} at ${(inflationRate * 100).toFixed(1)}% annual inflation, you will need an estimated total corpus of ${curSym}${formattedLakh} Lakh.`;
        } else {
          resHeroVerdict.textContent = `Over ${dur} years of education starting in ${startYr} at ${(inflationRate * 100).toFixed(1)}% annual inflation, you will need an estimated total corpus of ${curSym}${formatMoney(totalProjectedCost, activeCountry)}.`;
        }
      }

      // Update Sub-Hero Cards
      if (resMonthlySavings) resMonthlySavings.textContent = formatMoney(requiredMonthlySavings, activeCountry);
      if (resMonthlyHint) {
        if (yearsUntilStart > 0) {
          resMonthlyHint.textContent = `For ${yearsUntilStart} years at ${(returnRate * 100).toFixed(1)}% expected annual return`;
        } else {
          resMonthlyHint.textContent = `Across ${dur} years of education (starts immediately)`;
        }
      }

      if (resAnnualSavings) resAnnualSavings.textContent = formatMoney(requiredAnnualSavings, activeCountry);
      if (resAnnualHint) {
        resAnnualHint.textContent = (yearsUntilStart > 0) ? `If investing lump sum once a year for ${yearsUntilStart} yrs` : `If funding annually during study period`;
      }

      // Update Savings Gap Callout Card
      if (resGapCard && gapTitle && gapDesc) {
        const curSym = COUNTRY_CONFIGS[activeCountry].currencySym;
        if (isSurplus) {
          resGapCard.classList.add('surplus');
          gapTitle.textContent = `Goal Fully Funded! Projected Surplus: ${curSym}${formatMoney(surplusAmount, activeCountry)}`;
          gapDesc.textContent = `Your existing savings of ${curSym}${formatMoney(existingSavings, activeCountry)} are projected to grow to ${curSym}${formatMoney(fvExistingSavingsAtStart, activeCountry)} by the start of education, fully covering the required ${curSym}${formatMoney(pvCorpusAtStart, activeCountry)} corpus. No additional savings are strictly required.`;
        } else {
          resGapCard.classList.remove('surplus');
          gapTitle.textContent = `Estimated Savings Gap: ${curSym}${formatMoney(netCorpusGapAtStart, activeCountry)}`;
          gapDesc.textContent = `Your existing ${curSym}${formatMoney(existingSavings, activeCountry)} savings will grow to ${curSym}${formatMoney(fvExistingSavingsAtStart, activeCountry)} by start of education. A disciplined ${savingsFrequency} investment of ${curSym}${formatMoney(savingsFrequency === 'monthly' ? requiredMonthlySavings : requiredAnnualSavings, activeCountry)} bridges the remaining ${curSym}${formatMoney(netCorpusGapAtStart, activeCountry)} target corpus.`;
        }
      }

      // Update Visual Split Bar
      const totalPool = Math.max(1, fvExistingSavingsAtStart + totalDeposits + totalInvestmentGrowth);
      const pctExisting = Math.min(100, Math.max(0, (fvExistingSavingsAtStart / totalPool) * 100));
      const pctDeposits = Math.min(100, Math.max(0, (totalDeposits / totalPool) * 100));
      const pctGrowth = Math.min(100, Math.max(0, 100 - pctExisting - pctDeposits));

      if (barSegExisting) barSegExisting.style.width = `${pctExisting.toFixed(1)}%`;
      if (barSegDeposits) barSegDeposits.style.width = `${pctDeposits.toFixed(1)}%`;
      if (barSegGrowth) barSegGrowth.style.width = `${pctGrowth.toFixed(1)}%`;

      if (resGrowthShare) resGrowthShare.textContent = `${growthSharePct.toFixed(1)}% Funded by Compounding`;
      if (legExistingVal) legExistingVal.textContent = formatShortCurrency(fvExistingSavingsAtStart, activeCountry);
      if (legDepositsVal) legDepositsVal.textContent = formatShortCurrency(totalDeposits, activeCountry);
      if (legGrowthVal) legGrowthVal.textContent = formatShortCurrency(totalInvestmentGrowth, activeCountry);

      // Update 8 Metrics Grid
      const sym = COUNTRY_CONFIGS[activeCountry].currencySym;
      if (tileCostToday) tileCostToday.textContent = `${sym}${formatMoney(totalCostToday, activeCountry)}`;
      if (tileFirstYear) tileFirstYear.textContent = `${sym}${formatMoney(firstYearCost, activeCountry)}`;
      if (tileYearsStart) tileYearsStart.textContent = `${yearsUntilStart} yrs`;
      if (tileDuration) tileDuration.textContent = `${dur} yrs`;
      if (tileFvSavings) tileFvSavings.textContent = `${sym}${formatMoney(fvExistingSavingsAtStart, activeCountry)}`;
      if (tileOutOfPocket) tileOutOfPocket.textContent = `${sym}${formatMoney(totalOutOfPocket, activeCountry)}`;
      if (tileGrowth) tileGrowth.textContent = `${sym}${formatMoney(totalInvestmentGrowth, activeCountry)}`;
      if (tileCorpusTarget) tileCorpusTarget.textContent = `${sym}${formatMoney(pvCorpusAtStart, activeCountry)}`;

      // Update Year-by-Year Table
      if (tableSubtitle) {
        tableSubtitle.textContent = `Projected cash flows based on ${(inflationRate * 100).toFixed(1)}% annual education inflation`;
      }

      if (eduScheduleTbody) {
        eduScheduleTbody.innerHTML = '';
        let cumulative = 0;
        yearlyCosts.forEach(item => {
          cumulative += item.inflatedCost;
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td style="text-align: left; font-weight: 600;">Year ${item.yearIndex} (${item.calendarYear})</td>
            <td style="text-align: center;">Age ${item.childAge}</td>
            <td style="text-align: right;">${sym}${formatMoney(annualCostToday, activeCountry)}</td>
            <td style="text-align: right; color: var(--color-primary); font-weight: 600;">${item.inflationFactor.toFixed(2)}&times;</td>
            <td style="text-align: right; font-weight: 700; color: var(--color-heading);">${sym}${formatMoney(item.inflatedCost, activeCountry)}</td>
            <td style="text-align: right; font-weight: 600;">${sym}${formatMoney(cumulative, activeCountry)}</td>
          `;
          eduScheduleTbody.appendChild(tr);
        });
      }
    }

    // Event Listeners

    // Country Pill Selection (Desktop)
    countryPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const c = pill.getAttribute('data-country') || 'IN';
        updateCountryUI(c);
      });
    });

    // Mobile Country Select (Mobile)
    if (mobileCountrySelect) {
      mobileCountrySelect.addEventListener('change', () => {
        updateCountryUI(mobileCountrySelect.value);
      });
    }

    // Level & Category Selectors
    if (eduLevelSelect) {
      eduLevelSelect.addEventListener('change', () => onLevelChanged(false));
    }
    if (eduCategorySelect) {
      eduCategorySelect.addEventListener('change', onCategoryChanged);
    }
    if (sgStatusSelect) {
      sgStatusSelect.addEventListener('change', onCategoryChanged);
    }

    // Sync Slider & Numeric Inputs
    function bindSliderInput(slider: HTMLInputElement, input: HTMLInputElement, callback: () => void) {
      slider.addEventListener('input', () => {
        input.value = slider.value;
        callback();
      });
      input.addEventListener('input', () => {
        slider.value = input.value;
        callback();
      });
    }

    bindSliderInput(childAgeSlider, childAgeInput, calculateAndRender);
    bindSliderInput(startAgeSlider, startAgeInput, calculateAndRender);
    bindSliderInput(durationSlider, durationInput, calculateAndRender);
    bindSliderInput(inflationSlider, inflationInput, calculateAndRender);
    bindSliderInput(returnSlider, returnInput, calculateAndRender);

    [baseCostInput, addCostInput, existingSavingsInput].forEach(inp => {
      inp.addEventListener('input', calculateAndRender);
    });

    // Age Preset Pills
    document.querySelectorAll('.age-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('.age-pill').forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        const age = pill.getAttribute('data-age') || '5';
        childAgeInput.value = age;
        childAgeSlider.value = age;
        calculateAndRender();
      });
    });

    // Start Age Preset Pills
    document.querySelectorAll('.start-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('.start-pill').forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        const start = pill.getAttribute('data-start') || '18';
        startAgeInput.value = start;
        startAgeSlider.value = start;
        calculateAndRender();
      });
    });

    // Frequency Buttons
    freqButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        freqButtons.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-checked', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-checked', 'true');
        savingsFrequency = btn.getAttribute('data-freq') || 'monthly';
        calculateAndRender();
      });
    });

    // Reset Button
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        updateCountryUI(activeCountry);
      });
    }

    // Native Platform Clipboard Export
    document.addEventListener('copy-calculator-results', () => {
      const sym = COUNTRY_CONFIGS[activeCountry].currencySym;
      const text = `Child Education Cost Calculation (${COUNTRY_CONFIGS[activeCountry].name}):
Projected Total Education Cost: ${sym}${resTotalCost?.textContent || '0'}
Required Monthly Savings: ${sym}${resMonthlySavings?.textContent || '0'}/mo
Required Annual Savings: ${sym}${resAnnualSavings?.textContent || '0'}/yr
Cost in Today's Money: ${tileCostToday?.textContent || '0'}
First Year Projected Fee: ${tileFirstYear?.textContent || '0'}
Future Value of Existing Savings: ${tileFvSavings?.textContent || '0'}
Total Investment Growth: ${tileGrowth?.textContent || '0'}
Target Corpus Needed at Start: ${tileCorpusTarget?.textContent || '0'}
Calculated via FinCalcLab Child Education Cost Calculator (https://fincalclab.com/calculator/child-education-cost-calculator)`;

      navigator.clipboard.writeText(text).then(() => {
        alert('Child education calculation results copied to clipboard!');
      }).catch(err => {
        console.error('Failed to copy: ', err);
      });
    });

    // Initial load
    updateCountryUI('IN');
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initChildEducationCalculator);
  } else {
    initChildEducationCalculator();
  }
</script>
