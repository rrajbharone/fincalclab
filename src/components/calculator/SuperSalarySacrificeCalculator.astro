  function calculateIncomeTax(taxableIncome: number, brackets: TaxBracket[]): number {
    if (taxableIncome <= 18200) return 0;
    for (let i = brackets.length - 1; i >= 0; i--) {
      const b = brackets[i];
      if (taxableIncome > b.min) {
        return b.baseTax + (taxableIncome - b.min) * b.rate;
      }
    }
    return 0;
  }

  function calculateMedicareLevy(taxableIncome: number, config: TaxYearConfig): number {
    if (taxableIncome <= config.medicareLowIncomeThreshold) {
      return 0;
    }
    if (taxableIncome <= config.medicarePhaseInThreshold) {
      return (taxableIncome - config.medicareLowIncomeThreshold) * 0.10;
    }
    return taxableIncome * config.medicareRate;
  }

  function initAuSalarySacrificeCalculator() {
    const salaryInput = document.getElementById('au-salary-input') as HTMLInputElement;
    const salarySlider = document.getElementById('au-salary-slider') as HTMLInputElement;

    const taxYearSelect = document.getElementById('au-tax-year-select') as HTMLSelectElement;
    const taxYearSubtext = document.getElementById('au-tax-year-subtext');
    const payFreqSelect = document.getElementById('au-pay-freq-select') as HTMLSelectElement;

    const btnModeDollar = document.getElementById('btn-mode-dollar');
    const btnModePercent = document.getElementById('btn-mode-percent');
    const groupDollar = document.getElementById('group-sacrifice-dollar');
    const groupPercent = document.getElementById('group-sacrifice-percent');

    const sacrificeVal = document.getElementById('au-sacrifice-val') as HTMLInputElement;
    const sacrificeSlider = document.getElementById('au-sacrifice-slider') as HTMLInputElement;

    const sacrificePctVal = document.getElementById('au-sacrifice-pct-val') as HTMLInputElement;
    const sacrificePctSlider = document.getElementById('au-sacrifice-pct-slider') as HTMLInputElement;
    const lblPctEquiv = document.getElementById('lbl-pct-equiv');

    const advancedToggle = document.getElementById('au-advanced-toggle');
    const advancedPanel = document.getElementById('au-advanced-panel');
    const advancedChevron = document.getElementById('au-advanced-chevron');

    const employerSuperInput = document.getElementById('au-employer-super-input') as HTMLInputElement;
    const lblAutoSg = document.getElementById('lbl-auto-sg');

    const resetBtn = document.getElementById('au-sacrifice-reset');

    let currentMode = 'dollar'; // 'dollar' | 'percent'

    if (!salaryInput || !taxYearSelect || !sacrificeVal) return;

    // Advanced Accordion Toggle
    if (advancedToggle && advancedPanel && advancedChevron) {
      advancedToggle.addEventListener('click', () => {
        const isExpanded = advancedToggle.getAttribute('aria-expanded') === 'true';
        advancedToggle.setAttribute('aria-expanded', String(!isExpanded));
        advancedPanel.classList.toggle('hidden', isExpanded);
        advancedChevron.style.transform = isExpanded ? 'rotate(0deg)' : 'rotate(180deg)';
      });
    }

    // Bidirectional Slider Binding
    function bindSlider(input: HTMLInputElement, slider: HTMLInputElement, maxSync = false) {
      if (!input || !slider) return;
      input.addEventListener('input', () => {
        const val = parseFloat(input.value) || 0;
        if (maxSync && val > parseFloat(slider.max)) {
          slider.max = String(Math.ceil(val * 1.5));
        }
        slider.value = input.value;
        calculateAll();
      });
      slider.addEventListener('input', () => {
        input.value = slider.value;
        calculateAll();
      });
    }

    bindSlider(salaryInput, salarySlider, true);
    bindSlider(sacrificeVal, sacrificeSlider, true);
    bindSlider(sacrificePctVal, sacrificePctSlider);

    if (employerSuperInput) {
      employerSuperInput.addEventListener('input', calculateAll);
    }

    // Mode Toggle (Dollar vs Percent)
    if (btnModeDollar && btnModePercent && groupDollar && groupPercent) {
      btnModeDollar.addEventListener('click', () => {
        currentMode = 'dollar';
        btnModeDollar.classList.add('active');
        btnModeDollar.setAttribute('aria-checked', 'true');
        btnModePercent.classList.remove('active');
        btnModePercent.setAttribute('aria-checked', 'false');
        groupDollar.classList.remove('hidden');
        groupPercent.classList.add('hidden');
        calculateAll();
      });

      btnModePercent.addEventListener('click', () => {
        currentMode = 'percent';
        btnModePercent.classList.add('active');
        btnModePercent.setAttribute('aria-checked', 'true');
        btnModeDollar.classList.remove('active');
        btnModeDollar.setAttribute('aria-checked', 'false');
        groupPercent.classList.remove('hidden');
        groupDollar.classList.add('hidden');
        calculateAll();
      });
    }

    taxYearSelect.addEventListener('change', () => {
      const cfg = AU_TAX_CONFIGS[taxYearSelect.value] || AU_TAX_CONFIGS['2025_26'];
      if (taxYearSubtext) {
        taxYearSubtext.textContent = `ATO tax brackets with ${(cfg.sgRate * 100).toFixed(1)}% Super Guarantee and $${cfg.concessionalCap.toLocaleString('en-AU')} concessional cap.`;
      }
      calculateAll();
    });

    payFreqSelect.addEventListener('change', calculateAll);

    // Salary Presets
    document.querySelectorAll('[data-salary]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const val = target.dataset.salary;
        if (val !== undefined) {
          salaryInput.value = val;
          salarySlider.value = val;
          document.querySelectorAll('[data-salary]').forEach(b => b.classList.remove('active'));
          target.classList.add('active');
          calculateAll();
        }
      });
    });

    // Dollar Presets
    document.querySelectorAll('[data-sac-dollar]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const val = target.dataset.sacDollar;
        if (val !== undefined) {
          sacrificeVal.value = val;
          sacrificeSlider.value = val;
          document.querySelectorAll('[data-sac-dollar]').forEach(b => b.classList.remove('active'));
          target.classList.add('active');
          calculateAll();
        }
      });
    });

    // Percent Presets
    document.querySelectorAll('[data-sac-pct]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const val = target.dataset.sacPct;
        if (val !== undefined) {
          sacrificePctVal.value = val;
          sacrificePctSlider.value = val;
          document.querySelectorAll('[data-sac-pct]').forEach(b => b.classList.remove('active'));
          target.classList.add('active');
          calculateAll();
        }
      });
    });

    // Reset Handler
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        salaryInput.value = '100000';
        salarySlider.value = '100000';

        taxYearSelect.value = '2025_26';
        payFreqSelect.value = 'annual';

        currentMode = 'dollar';
        btnModeDollar?.classList.add('active');
        btnModePercent?.classList.remove('active');
        groupDollar?.classList.remove('hidden');
        groupPercent?.classList.add('hidden');

        sacrificeVal.value = '10000';
        sacrificeSlider.value = '10000';

        sacrificePctVal.value = '10.0';
        sacrificePctSlider.value = '10.0';

        if (employerSuperInput) employerSuperInput.value = '';

        document.querySelectorAll('.preset-pill').forEach(b => b.classList.remove('active'));
        document.querySelector('[data-salary="100000"]')?.classList.add('active');
        document.querySelector('[data-sac-dollar="10000"]')?.classList.add('active');
        document.querySelector('[data-sac-pct="10"]')?.classList.add('active');

        calculateAll();
      });
    }

    function formatAUD(val: number): string {
      return '$' + Math.max(0, val).toLocaleString('en-AU', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    function formatShortAUD(val: number): string {
      return '$' + Math.max(0, Math.round(val)).toLocaleString('en-AU');
    }

    function calculateAll() {
      const salary = Math.max(0, parseFloat(salaryInput.value) || 0);
      const taxYear = taxYearSelect.value;
      const config = AU_TAX_CONFIGS[taxYear] || AU_TAX_CONFIGS['2025_26'];
      const payFreq = payFreqSelect.value;

      // Determine sacrificed amount
      let sacrificedAmount = 0;
      if (currentMode === 'percent') {
        const pct = Math.max(0, Math.min(100, parseFloat(sacrificePctVal.value) || 0));
        sacrificedAmount = (salary * pct) / 100;
        if (lblPctEquiv) {
          lblPctEquiv.textContent = `${formatAUD(sacrificedAmount)} / year`;
        }
      } else {
        sacrificedAmount = Math.max(0, parseFloat(sacrificeVal.value) || 0);
      }
      sacrificedAmount = Math.min(salary, sacrificedAmount);

      // Auto employer SG
      const autoSgVal = salary * config.sgRate;
      if (lblAutoSg) {
        lblAutoSg.textContent = formatAUD(autoSgVal);
      }
      const customSgText = employerSuperInput?.value.trim();
      const employerSuper = customSgText && customSgText !== ''
        ? Math.max(0, parseFloat(customSgText) || 0)
        : autoSgVal;

      // Scenario 1: Without Sacrifice
      const taxableWithout = salary;
      const incomeTaxWithout = calculateIncomeTax(taxableWithout, config.brackets);
      const medicareWithout = calculateMedicareLevy(taxableWithout, config);
      const totalTaxWithout = incomeTaxWithout + medicareWithout;
      const takeHomeWithout = Math.max(0, taxableWithout - totalTaxWithout);

      // Scenario 2: With Sacrifice
      const taxableWith = Math.max(0, salary - sacrificedAmount);
      const incomeTaxWith = calculateIncomeTax(taxableWith, config.brackets);
      const medicareWith = calculateMedicareLevy(taxableWith, config);
      const totalTaxWith = incomeTaxWith + medicareWith;
      const takeHomeWith = Math.max(0, taxableWith - totalTaxWith);

      // Reductions & Savings
      const incomeTaxSaved = incomeTaxWithout - incomeTaxWith;
      const medicareSaved = medicareWithout - medicareWith;
      const totalTaxSaved = totalTaxWithout - totalTaxWith;

      const takeHomeDrop = takeHomeWithout - takeHomeWith;

      // Super Tax inside fund (15%)
      const superFundTax = sacrificedAmount * config.superTaxRate;
      const netSuperAdded = Math.max(0, sacrificedAmount - superFundTax);
      const netWealthBoost = netSuperAdded - takeHomeDrop;

      // Marginal tax rate estimate
      const marginalRatePct = sacrificedAmount > 0 ? (totalTaxSaved / sacrificedAmount) * 100 : 32.0;

      // Pay frequency factor
      const freqMap: Record<string, { factor: number; label: string }> = {
        annual: { factor: 1, label: 'Year' },
        monthly: { factor: 12, label: 'Month' },
        fortnightly: { factor: 26, label: 'Fortnight' },
        weekly: { factor: 52, label: 'Week' }
      };
      const freqInfo = freqMap[payFreq] || freqMap.annual;
      const takeHomeWithoutPer = takeHomeWithout / freqInfo.factor;
      const takeHomeWithPer = takeHomeWith / freqInfo.factor;
      const takeHomeDropPer = takeHomeDrop / freqInfo.factor;

      // Total Concessional Contributions
      const totalConcessional = employerSuper + sacrificedAmount;
      const isCapExceeded = totalConcessional > config.concessionalCap;
      const excessAmount = Math.max(0, totalConcessional - config.concessionalCap);

      // Division 293 condition
      const div293Applies = (taxableWith + totalConcessional) > config.div293Threshold;

      // --- DOM UPDATES ---

      // Hero Elements
      const resTaxSaving = document.getElementById('res-tax-saving');
      const resHeroSub = document.getElementById('res-hero-subtext');
      const auTaxRateBadge = document.getElementById('au-tax-rate-badge');
      const resTakehomeDrop = document.getElementById('res-takehome-drop');
      const resTakehomeDropSub = document.getElementById('res-takehome-drop-sub');
      const resSuperNet = document.getElementById('res-super-net');

      if (resTaxSaving) resTaxSaving.textContent = formatAUD(totalTaxSaved);
      if (resHeroSub) {
        resHeroSub.textContent = `Saves ${formatAUD(incomeTaxSaved)} income tax + ${formatAUD(medicareSaved)} Medicare levy`;
      }
      if (auTaxRateBadge) {
        auTaxRateBadge.textContent = `${marginalRatePct.toFixed(1)}% Marginal Benefit`;
      }
      if (resTakehomeDrop) {
        resTakehomeDrop.textContent = `−${formatAUD(takeHomeDrop)}`;
      }
      if (resTakehomeDropSub) {
        resTakehomeDropSub.textContent = payFreq !== 'annual'
          ? `−${formatAUD(takeHomeDropPer)} per ${freqInfo.label.toLowerCase()}`
          : 'Effective out-of-pocket cost';
      }
      if (resSuperNet) {
        resSuperNet.textContent = `+${formatAUD(netSuperAdded)}`;
      }

      // Trade-off Summary Card
      const tradeoffGross = document.getElementById('tradeoff-gross');
      const tradeoffTaxSaved = document.getElementById('tradeoff-tax-saved');
      const tradeoffTakehomeDrop = document.getElementById('tradeoff-takehome-drop');
      const tradeoffNetBoost = document.getElementById('tradeoff-net-boost');

      if (tradeoffGross) tradeoffGross.textContent = formatAUD(sacrificedAmount);
      if (tradeoffTaxSaved) tradeoffTaxSaved.textContent = `+${formatAUD(totalTaxSaved)}`;
      if (tradeoffTakehomeDrop) tradeoffTakehomeDrop.textContent = `−${formatAUD(takeHomeDrop)}`;
      if (tradeoffNetBoost) tradeoffNetBoost.textContent = `+${formatAUD(netWealthBoost)}`;

      // Warnings
      const capWarning = document.getElementById('au-cap-warning');
      const capWarningMsg = document.getElementById('au-cap-warning-msg');
      if (capWarning && capWarningMsg) {
        if (isCapExceeded) {
          capWarning.classList.remove('hidden');
          capWarningMsg.innerHTML = `<strong>Concessional Contributions Cap Alert:</strong> Your combined employer super (${formatAUD(employerSuper)}) and salary sacrifice (${formatAUD(sacrificedAmount)}) total <strong>${formatAUD(totalConcessional)}</strong>, exceeding the <strong>$${config.concessionalCap.toLocaleString('en-AU')} annual cap</strong> by <strong>${formatAUD(excessAmount)}</strong>. Excess concessional contributions are taxed at your marginal rate (less a 15% offset) plus an interest charge, unless withdrawn or carried forward under unused cap provisions.`;
        } else {
          capWarning.classList.add('hidden');
        }
      }

      const div293Warning = document.getElementById('au-div293-warning');
      if (div293Warning) {
        div293Warning.classList.toggle('hidden', !div293Applies);
      }

      // Comparison Table
      const tblGrossWithout = document.getElementById('tbl-gross-without');
      const tblGrossWith = document.getElementById('tbl-gross-with');
      const tblSacrificed = document.getElementById('tbl-sacrificed');
      const tblSacDiff = document.getElementById('tbl-sac-diff');
      const tblTaxableWithout = document.getElementById('tbl-taxable-without');
      const tblTaxableWith = document.getElementById('tbl-taxable-with');
      const tblTaxableDiff = document.getElementById('tbl-taxable-diff');
      const tblTaxWithout = document.getElementById('tbl-tax-without');
      const tblTaxWith = document.getElementById('tbl-tax-with');
      const tblTaxDiff = document.getElementById('tbl-tax-diff');
      const tblMedicareWithout = document.getElementById('tbl-medicare-without');
      const tblMedicareWith = document.getElementById('tbl-medicare-with');
      const tblMedicareDiff = document.getElementById('tbl-medicare-diff');
      const tblTotalTaxWithout = document.getElementById('tbl-total-tax-without');
      const tblTotalTaxWith = document.getElementById('tbl-total-tax-with');
      const tblTotalTaxDiff = document.getElementById('tbl-total-tax-diff');
      const tblTakehomeWithout = document.getElementById('tbl-takehome-without');
      const tblTakehomeWith = document.getElementById('tbl-takehome-with');
      const tblTakehomeDiff = document.getElementById('tbl-takehome-diff');

      const rowPeriodic = document.getElementById('row-takehome-periodic');
      const lblTblFreq = document.getElementById('lbl-tbl-freq');
      const tblFreqWithout = document.getElementById('tbl-freq-without');
      const tblFreqWith = document.getElementById('tbl-freq-with');
      const tblFreqDiff = document.getElementById('tbl-freq-diff');

      const tblSuperGross = document.getElementById('tbl-super-gross');
      const tblSuperGrossDiff = document.getElementById('tbl-super-gross-diff');
      const tblSuperTax = document.getElementById('tbl-super-tax');
      const tblSuperTaxDiff = document.getElementById('tbl-super-tax-diff');
      const tblSuperNet = document.getElementById('tbl-super-net');
      const tblSuperNetDiff = document.getElementById('tbl-super-net-diff');

      if (tblGrossWithout) tblGrossWithout.textContent = formatAUD(salary);
      if (tblGrossWith) tblGrossWith.textContent = formatAUD(salary);
      if (tblSacrificed) tblSacrificed.textContent = formatAUD(sacrificedAmount);
      if (tblSacDiff) tblSacDiff.textContent = `+${formatAUD(sacrificedAmount)}`;

      if (tblTaxableWithout) tblTaxableWithout.textContent = formatAUD(taxableWithout);
      if (tblTaxableWith) tblTaxableWith.textContent = formatAUD(taxableWith);
      if (tblTaxableDiff) tblTaxableDiff.textContent = `−${formatAUD(sacrificedAmount)}`;

      if (tblTaxWithout) tblTaxWithout.textContent = formatAUD(incomeTaxWithout);
      if (tblTaxWith) tblTaxWith.textContent = formatAUD(incomeTaxWith);
      if (tblTaxDiff) tblTaxDiff.textContent = `−${formatAUD(incomeTaxSaved)}`;

      if (tblMedicareWithout) tblMedicareWithout.textContent = formatAUD(medicareWithout);
      if (tblMedicareWith) tblMedicareWith.textContent = formatAUD(medicareWith);
      if (tblMedicareDiff) tblMedicareDiff.textContent = `−${formatAUD(medicareSaved)}`;

      if (tblTotalTaxWithout) tblTotalTaxWithout.textContent = formatAUD(totalTaxWithout);
      if (tblTotalTaxWith) tblTotalTaxWith.textContent = formatAUD(totalTaxWith);
      if (tblTotalTaxDiff) tblTotalTaxDiff.textContent = `−${formatAUD(totalTaxSaved)}`;

      if (tblTakehomeWithout) tblTakehomeWithout.textContent = formatAUD(takeHomeWithout);
      if (tblTakehomeWith) tblTakehomeWith.textContent = formatAUD(takeHomeWith);
      if (tblTakehomeDiff) tblTakehomeDiff.textContent = `−${formatAUD(takeHomeDrop)}`;

      if (rowPeriodic && lblTblFreq && tblFreqWithout && tblFreqWith && tblFreqDiff) {
        if (payFreq !== 'annual') {
          rowPeriodic.style.display = 'table-row';
          lblTblFreq.textContent = freqInfo.label;
          tblFreqWithout.textContent = formatAUD(takeHomeWithoutPer);
          tblFreqWith.textContent = formatAUD(takeHomeWithPer);
          tblFreqDiff.textContent = `−${formatAUD(takeHomeDropPer)}`;
        } else {
          rowPeriodic.style.display = 'none';
        }
      }

      if (tblSuperGross) tblSuperGross.textContent = formatAUD(sacrificedAmount);
      if (tblSuperGrossDiff) tblSuperGrossDiff.textContent = `+${formatAUD(sacrificedAmount)}`;
      if (tblSuperTax) tblSuperTax.textContent = `−${formatAUD(superFundTax)}`;
      if (tblSuperTaxDiff) tblSuperTaxDiff.textContent = `−${formatAUD(superFundTax)}`;
      if (tblSuperNet) tblSuperNet.textContent = `+${formatAUD(netSuperAdded)}`;
      if (tblSuperNetDiff) tblSuperNetDiff.textContent = `+${formatAUD(netSuperAdded)}`;

      // 8-Tile Metrics Grid
      const tileGross = document.getElementById('tile-gross-salary');
      const tileSac = document.getElementById('tile-sacrificed');
      const tileTaxable = document.getElementById('tile-taxable-salary');
      const tileSaved = document.getElementById('tile-tax-saved');
      const tileSavedSub = document.getElementById('tile-tax-saved-sub');
      const tileDrop = document.getElementById('tile-takehome-drop');
      const tileDropSub = document.getElementById('tile-takehome-drop-sub');
      const tileNetSuper = document.getElementById('tile-net-super');
      const tileConcessional = document.getElementById('tile-total-concessional');
      const tileConcessionalSub = document.getElementById('tile-concessional-sub');
      const tileBoost = document.getElementById('tile-net-boost');

      if (tileGross) tileGross.textContent = formatShortAUD(salary);
      if (tileSac) tileSac.textContent = formatShortAUD(sacrificedAmount);
      if (tileTaxable) tileTaxable.textContent = formatShortAUD(taxableWith);
      if (tileSaved) tileSaved.textContent = formatShortAUD(totalTaxSaved);
      if (tileSavedSub) tileSavedSub.textContent = `${marginalRatePct.toFixed(1)}% marginal savings`;
      if (tileDrop) tileDrop.textContent = `−${formatShortAUD(takeHomeDrop)}`;
      if (tileDropSub) {
        tileDropSub.textContent = payFreq !== 'annual' ? `−${formatAUD(takeHomeDropPer)}/${freqInfo.label.toLowerCase()}` : 'Effective annual cost';
      }
      if (tileNetSuper) tileNetSuper.textContent = `+${formatShortAUD(netSuperAdded)}`;
      if (tileConcessional) tileConcessional.textContent = formatShortAUD(totalConcessional);
      if (tileConcessionalSub) {
        const remainingCap = Math.max(0, config.concessionalCap - totalConcessional);
        tileConcessionalSub.textContent = isCapExceeded
          ? `Exceeds cap by ${formatShortAUD(excessAmount)}`
          : `$${remainingCap.toLocaleString('en-AU')} room left`;
      }
      if (tileBoost) tileBoost.textContent = `+${formatShortAUD(netWealthBoost)}`;

      // Verdict Description
      const verdictText = document.getElementById('res-verdict-text');
      if (verdictText) {
        const freqPhrase = payFreq !== 'annual'
          ? ` (or <strong>−${formatAUD(takeHomeDropPer)}</strong> each ${freqInfo.label.toLowerCase()})`
          : '';
        verdictText.innerHTML = `Salary sacrificing <strong>${formatAUD(sacrificedAmount)}</strong> of your <strong>${formatAUD(salary)}</strong> salary reduces your taxable income to <strong>${formatAUD(taxableWith)}</strong>, saving you <strong>${formatAUD(totalTaxSaved)}</strong> in income tax and Medicare levy. Your take-home pay decreases by <strong>${formatAUD(takeHomeDrop)}</strong> per year${freqPhrase}, while your super balance increases by <strong>${formatAUD(netSuperAdded)}</strong> (after the 15% super fund tax), resulting in an immediate net wealth advantage of <strong>${formatAUD(netWealthBoost)}</strong>.`;
      }
    }

    // Clipboard copy results handler
    window.addEventListener('copy-calculator-results', () => {
      const salary = parseFloat(salaryInput.value) || 0;
      const sacrificed = document.getElementById('tile-sacrificed')?.textContent || '$0';
      const taxSaved = document.getElementById('res-tax-saving')?.textContent || '$0';
      const takehomeDrop = document.getElementById('res-takehome-drop')?.textContent || '$0';
      const netSuper = document.getElementById('res-super-net')?.textContent || '$0';
      const netBoost = document.getElementById('tile-net-boost')?.textContent || '$0';
      const taxYear = taxYearSelect.options[taxYearSelect.selectedIndex]?.text || '';

      const text = `Australian Super Salary Sacrifice Analysis (${taxYear}):\n` +
                   `Gross Salary: $${salary.toLocaleString('en-AU')} | Sacrificed to Super: ${sacrificed}\n` +
                   `Estimated Tax Saved (Income Tax + Medicare): ${taxSaved}\n` +
                   `Take-Home Pay Reduction: ${takehomeDrop}\n` +
                   `Net Credited to Super (after 15% fund tax): ${netSuper}\n` +
                   `Net Wealth Boost: ${netBoost}\n` +
                   `Summary: Giving up ${takehomeDrop} in take-home pay deposits ${netSuper} net into superannuation, creating a ${netBoost} tax advantage.`;

      navigator.clipboard.writeText(text).then(() => {
        window.dispatchEvent(new CustomEvent('calculator-copied-success'));
      });
    });

    // Initial calculation run
    calculateAll();
  }

