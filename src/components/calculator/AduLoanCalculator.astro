---
import CalculatorLayout from './CalculatorLayout.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
---

<CalculatorLayout
  title="ADU Loan Calculator"
  description="Estimate monthly payments, borrowing costs, down payment requirements, and total interest for financing an Accessory Dwelling Unit (ADU)."
  category="Real Estate &amp; Mortgages"
>
  <!-- Inputs Section -->
  <div slot="inputs" class="calc-inputs-wrapper" id="adu-loan-calculator">
    
    <!-- Currency Selector -->
    <div class="input-group">
      <label for="adu-currency-select" class="field-label-top">Currency</label>
      <select id="adu-currency-select" class="form-select-full" aria-label="Select Currency">
        <option value="USD" selected>USD ($) - US Dollar</option>
        <option value="CAD">CAD (C$) - Canadian Dollar</option>
        <option value="GBP">GBP (£) - British Pound</option>
        <option value="EUR">EUR (€) - Euro</option>
        <option value="AUD">AUD (A$) - Australian Dollar</option>
        <option value="INR">INR (₹) - Indian Rupee</option>
        <option value="SGD">SGD (S$) - Singapore Dollar</option>
        <option value="JPY">JPY (¥) - Japanese Yen</option>
        <option value="CHF">CHF (CHF) - Swiss Franc</option>
      </select>
    </div>

    <!-- Input 1: Total ADU Project Cost -->
    <div class="input-group">
      <div class="input-label-row">
        <label for="adu-project-cost">Total ADU Project Cost</label>
        <div class="input-symbol-wrapper">
          <span class="currency-symbol" id="sym-cost">$</span>
          <input 
            type="number" 
            id="adu-project-cost" 
            min="5000" 
            max="2000000" 
            step="5000" 
            value="150000" 
            aria-label="Total ADU Project Cost" 
          />
        </div>
      </div>
      <input 
        type="range" 
        id="adu-project-cost-slider" 
        min="20000" 
        max="500000" 
        step="5000" 
        value="150000" 
        class="slider-range" 
        aria-label="Total ADU Project Cost Slider" 
      />
      <span class="input-hint">Total all-in budget including architectural plans, permitting, site preparation, utility connections, and construction.</span>
    </div>

    <!-- Input 2: Down Payment -->
    <div class="input-group">
      <div class="input-label-row">
        <div class="label-with-badge">
          <label for="adu-down-payment">Down Payment</label>
          <span class="pct-badge" id="adu-down-pct-badge">20.0% of cost</span>
        </div>
        <div class="input-symbol-wrapper">
          <span class="currency-symbol" id="sym-down">$</span>
          <input 
            type="number" 
            id="adu-down-payment" 
            min="0" 
            max="2000000" 
            step="1000" 
            value="30000" 
            aria-label="Down Payment Amount" 
          />
        </div>
      </div>
      <input 
        type="range" 
        id="adu-down-payment-slider" 
        min="0" 
        max="150000" 
        step="1000" 
        value="30000" 
        class="slider-range" 
        aria-label="Down Payment Slider" 
      />
      <div class="quick-chips-row" aria-label="Quick down payment options">
        <span class="chips-label">Quick Down %:</span>
        <button type="button" class="quick-chip-btn" data-pct="0">0%</button>
        <button type="button" class="quick-chip-btn" data-pct="10">10%</button>
        <button type="button" class="quick-chip-btn active" data-pct="20">20%</button>
        <button type="button" class="quick-chip-btn" data-pct="30">30%</button>
        <button type="button" class="quick-chip-btn" data-pct="50">50%</button>
      </div>
      <span class="input-hint">Out-of-pocket cash contributed toward project costs. Reduces borrowing needs and total interest.</span>
    </div>

    <!-- Two-Column Grid for Rate & Term -->
    <div class="input-row-grid">
      <!-- Input 3: Annual Interest Rate -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="adu-interest-rate">Annual Interest Rate (%)</label>
          <div class="input-symbol-wrapper">
            <input 
              type="number" 
              id="adu-interest-rate" 
              min="0" 
              max="25" 
              step="0.1" 
              value="7.0" 
              aria-label="Annual Interest Rate" 
            />
            <span class="percent-symbol">%</span>
          </div>
        </div>
        <input 
          type="range" 
          id="adu-interest-rate-slider" 
          min="0" 
          max="15" 
          step="0.1" 
          value="7.0" 
          class="slider-range" 
          aria-label="Interest Rate Slider" 
        />
        <span class="input-hint">Expected annual rate on your construction loan, HELOC, or mortgage.</span>
      </div>

      <!-- Input 4: Loan Term (Years) -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="adu-loan-term">Loan Term (Years)</label>
          <div class="input-symbol-wrapper">
            <input 
              type="number" 
              id="adu-loan-term" 
              min="1" 
              max="40" 
              step="1" 
              value="20" 
              aria-label="Loan Term in Years" 
            />
            <span class="unit-symbol">yrs</span>
          </div>
        </div>
        <input 
          type="range" 
          id="adu-loan-term-slider" 
          min="5" 
          max="30" 
          step="1" 
          value="20" 
          class="slider-range" 
          aria-label="Loan Term Slider" 
        />
        <div class="quick-chips-row" aria-label="Quick loan term options">
          <span class="chips-label">Terms:</span>
          <button type="button" class="term-chip-btn" data-term="10">10y</button>
          <button type="button" class="term-chip-btn" data-term="15">15y</button>
          <button type="button" class="term-chip-btn active" data-term="20">20y</button>
          <button type="button" class="term-chip-btn" data-term="30">30y</button>
        </div>
        <span class="input-hint">Repayment duration in years (e.g., 20 years = 240 monthly payments).</span>
      </div>
    </div>

    <!-- Reset Form Button -->
    <div class="reset-action-row">
      <button type="button" id="adu-reset-btn" class="reset-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
        <span>Reset to Default Example</span>
      </button>
    </div>

  </div>

  <!-- Results Section -->
  <div slot="results" class="calc-results-wrapper" id="adu-results-panel">
    
    <div class="results-header">
      <h2 class="results-title">ADU Financing Summary</h2>
      <span class="results-subtitle">Principal and interest amortization breakdown</span>
    </div>

    <!-- Hero Cards (Primary Prominent Outputs) -->
    <div class="hero-metrics-grid">
      <div class="hero-metric-card primary-hero">
        <span class="hero-label">Estimated Monthly Payment</span>
        <div class="hero-value-wrap">
          <span class="hero-value" id="res-monthly-payment">$930</span>
          <span class="hero-unit">/mo</span>
        </div>
        <span class="hero-subtext" id="res-monthly-subtext">Principal &amp; Interest only • 240 payments</span>
      </div>

      <div class="hero-metric-card secondary-hero">
        <span class="hero-label">Loan Amount (Borrowed)</span>
        <div class="hero-value-wrap">
          <span class="hero-value" id="res-loan-amount">$120,000</span>
        </div>
        <span class="hero-subtext" id="res-loan-subtext">80.0% of total project cost</span>
      </div>
    </div>

    <!-- 4-Metric Grid (Responsive wrapping) -->
    <div class="metrics-grid">
      <div class="metric-tile">
        <span class="tile-label">Down Payment</span>
        <span class="tile-value" id="res-down-payment">$30,000</span>
        <span class="tile-caption" id="res-down-pct-caption">20.0% of total budget</span>
      </div>

      <div class="metric-tile">
        <span class="tile-label">Total Interest Paid</span>
        <span class="tile-value text-accent" id="res-total-interest">$103,286</span>
        <span class="tile-caption" id="res-interest-pct-caption">46.3% of total loan payoff</span>
      </div>

      <div class="metric-tile">
        <span class="tile-label">Total Loan Repayment</span>
        <span class="tile-value" id="res-total-loan-repay">$223,286</span>
        <span class="tile-caption">Principal + interest payments</span>
      </div>

      <div class="metric-tile">
        <span class="tile-label">Total Project Cost</span>
        <span class="tile-value" id="res-total-project-cost">$253,286</span>
        <span class="tile-caption">Project budget + financing interest</span>
      </div>
    </div>

    <!-- Cost Breakdown Progress Bar -->
    <div class="cost-breakdown-card">
      <div class="breakdown-header">
        <span class="breakdown-title">Total Project Expenditure Distribution</span>
        <span class="breakdown-total" id="res-bar-total">$253,286</span>
      </div>

      <div class="stacked-bar-container" role="progressbar" aria-valuemin="0" aria-valuemax="100" id="res-progress-bar" aria-label="Project cost breakdown">
        <div class="bar-segment bar-down" id="bar-down" style="width: 11.8%;" title="Down Payment"></div>
        <div class="bar-segment bar-principal" id="bar-principal" style="width: 47.4%;" title="Principal Borrowed"></div>
        <div class="bar-segment bar-interest" id="bar-interest" style="width: 40.8%;" title="Total Interest"></div>
      </div>

      <div class="breakdown-legend">
        <div class="legend-item">
          <span class="legend-color-dot dot-down"></span>
          <div class="legend-text-col">
            <span class="legend-title">Down Payment</span>
            <span class="legend-numbers" id="legend-down">$30,000 (11.8%)</span>
          </div>
        </div>

        <div class="legend-item">
          <span class="legend-color-dot dot-principal"></span>
          <div class="legend-text-col">
            <span class="legend-title">Loan Principal</span>
            <span class="legend-numbers" id="legend-principal">$120,000 (47.4%)</span>
          </div>
        </div>

        <div class="legend-item">
          <span class="legend-color-dot dot-interest"></span>
          <div class="legend-text-col">
            <span class="legend-title">Financing Interest</span>
            <span class="legend-numbers" id="legend-interest">$103,286 (40.8%)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Plain English Dynamic Narrative Explanation -->
    <div class="narrative-card">
      <div class="narrative-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        <span>Financing Breakdown Analysis</span>
      </div>
      <p class="narrative-text" id="res-narrative">
        For an ADU construction project costing <strong>$150,000</strong> with <strong>$30,000</strong> down (20.0%), you would borrow <strong>$120,000</strong>. At a <strong>7.0%</strong> annual interest rate over <strong>20 years</strong> (240 monthly payments), your estimated monthly principal and interest payment is <strong>$930</strong>. Over the life of the loan, you will pay <strong>$103,286</strong> in total interest, bringing the total all-in cost of your ADU to <strong>$253,286</strong>.
      </p>
    </div>

    <!-- P&I Statutory Exclusion Callout -->
    <div class="pi-notice-box">
      <div class="pi-notice-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
      </div>
      <p class="pi-notice-text">
        <strong>Payment Scope Notice:</strong> This estimated monthly payment represents <strong>principal and interest (P&amp;I) only</strong>. It excludes local property tax reassessments, homeowners/hazard insurance policy adjustments, lender origination fees, municipal permit charges, and ongoing utility or maintenance reserves.
      </p>
    </div>

  </div>
</CalculatorLayout>

<script>
  function initAduCalculator() {
    // Currency configuration
    const currencySymbols = {
      USD: '$',
      CAD: 'C$',
      GBP: '£',
      EUR: '€',
      AUD: 'A$',
      INR: '₹',
      SGD: 'S$',
      JPY: '¥',
      CHF: 'CHF '
    };

    let currentCurrency = 'USD';
    let currentSymbol = '$';

    // Inputs & Sliders
    const currencySelect = document.getElementById('adu-currency-select');
    const costInput = document.getElementById('adu-project-cost');
    const costSlider = document.getElementById('adu-project-cost-slider');
    const downInput = document.getElementById('adu-down-payment');
    const downSlider = document.getElementById('adu-down-payment-slider');
    const rateInput = document.getElementById('adu-interest-rate');
    const rateSlider = document.getElementById('adu-interest-rate-slider');
    const termInput = document.getElementById('adu-loan-term');
    const termSlider = document.getElementById('adu-loan-term-slider');
    const resetBtn = document.getElementById('adu-reset-btn');

    // UI Badges & Symbols
    const symCost = document.getElementById('sym-cost');
    const symDown = document.getElementById('sym-down');
    const downPctBadge = document.getElementById('adu-down-pct-badge');
    const quickChips = document.querySelectorAll('.quick-chip-btn');
    const termChips = document.querySelectorAll('.term-chip-btn');

    // Outputs
    const resMonthlyPayment = document.getElementById('res-monthly-payment');
    const resMonthlySubtext = document.getElementById('res-monthly-subtext');
    const resLoanAmount = document.getElementById('res-loan-amount');
    const resLoanSubtext = document.getElementById('res-loan-subtext');
    const resDownPayment = document.getElementById('res-down-payment');
    const resDownPctCaption = document.getElementById('res-down-pct-caption');
    const resTotalInterest = document.getElementById('res-total-interest');
    const resInterestPctCaption = document.getElementById('res-interest-pct-caption');
    const resTotalLoanRepay = document.getElementById('res-total-loan-repay');
    const resTotalProjectCost = document.getElementById('res-total-project-cost');
    const resNarrative = document.getElementById('res-narrative');

    // Progress bar & Legend
    const resBarTotal = document.getElementById('res-bar-total');
    const barDown = document.getElementById('bar-down');
    const barPrincipal = document.getElementById('bar-principal');
    const barInterest = document.getElementById('bar-interest');
    const legendDown = document.getElementById('legend-down');
    const legendPrincipal = document.getElementById('legend-principal');
    const legendInterest = document.getElementById('legend-interest');

    if (!costInput) return;

    function formatMoney(amount, decimals = 0) {
      if (isNaN(amount) || amount === null) amount = 0;
      const formattedNumber = Math.round(amount).toLocaleString('en-US', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });
      return `${currentSymbol}${formattedNumber}`;
    }

    function formatNumber(amount, decimals = 0) {
      if (isNaN(amount) || amount === null) amount = 0;
      return amount.toLocaleString('en-US', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });
    }

    function updateCurrency(curr) {
      currentCurrency = curr;
      currentSymbol = currencySymbols[curr] || '$';
      if (symCost) symCost.textContent = currentSymbol;
      if (symDown) symDown.textContent = currentSymbol;
      recalculate();
    }

    function recalculate() {
      let cost = parseFloat(costInput.value) || 0;
      let down = parseFloat(downInput.value) || 0;
      let rate = parseFloat(rateInput.value);
      let termYears = parseFloat(termInput.value) || 1;

      if (isNaN(rate) || rate < 0) rate = 0;
      if (cost < 0) cost = 0;
      if (down < 0) down = 0;
      if (termYears < 1) termYears = 1;

      // Update down payment slider maximum to match cost dynamically if cost > 0
      if (cost > 0) {
        downSlider.max = String(Math.max(cost, 10000));
      }

      // Cap down payment at cost for realistic loan borrowing
      const effectiveDown = Math.min(cost, down);
      const downPct = cost > 0 ? (effectiveDown / cost) * 100 : 0;

      // Update down payment badge
      if (downPctBadge) {
        downPctBadge.textContent = `${downPct.toFixed(1)}% of cost`;
      }

      // Calculate Loan Amount
      const loanAmount = Math.max(0, cost - effectiveDown);
      const loanPct = cost > 0 ? (loanAmount / cost) * 100 : 0;
      const totalMonths = Math.round(termYears * 12);

      let monthlyPayment = 0;
      let totalLoanRepayment = 0;
      let totalInterest = 0;

      if (loanAmount === 0) {
        monthlyPayment = 0;
        totalLoanRepayment = 0;
        totalInterest = 0;
      } else if (rate === 0) {
        monthlyPayment = loanAmount / totalMonths;
        totalLoanRepayment = loanAmount;
        totalInterest = 0;
      } else {
        const monthlyRate = rate / (12 * 100);
        const compoundFactor = Math.pow(1 + monthlyRate, totalMonths);
        monthlyPayment = loanAmount * (monthlyRate * compoundFactor) / (compoundFactor - 1);
        totalLoanRepayment = monthlyPayment * totalMonths;
        totalInterest = Math.max(0, totalLoanRepayment - loanAmount);
      }

      const totalProjectCostWithInterest = effectiveDown + totalLoanRepayment;
      const interestAsPctOfLoan = loanAmount > 0 ? (totalInterest / loanAmount) * 100 : 0;

      // Update Hero Outputs
      if (resMonthlyPayment) {
        resMonthlyPayment.textContent = formatMoney(monthlyPayment);
      }
      if (resMonthlySubtext) {
        if (loanAmount === 0) {
          resMonthlySubtext.textContent = '100% cash funded • No monthly debt service';
        } else {
          resMonthlySubtext.textContent = `Principal & Interest only • ${totalMonths} monthly payments`;
        }
      }
      if (resLoanAmount) {
        resLoanAmount.textContent = formatMoney(loanAmount);
      }
      if (resLoanSubtext) {
        resLoanSubtext.textContent = `${loanPct.toFixed(1)}% of total project cost`;
      }

      // Update 4-Tile Grid
      if (resDownPayment) {
        resDownPayment.textContent = formatMoney(effectiveDown);
      }
      if (resDownPctCaption) {
        resDownPctCaption.textContent = `${downPct.toFixed(1)}% of total budget`;
      }
      if (resTotalInterest) {
        resTotalInterest.textContent = formatMoney(totalInterest);
      }
      if (resInterestPctCaption) {
        if (loanAmount === 0) {
          resInterestPctCaption.textContent = '$0 interest paid (no loan)';
        } else {
          resInterestPctCaption.textContent = `${interestAsPctOfLoan.toFixed(1)}% of borrowed principal`;
        }
      }
      if (resTotalLoanRepay) {
        resTotalLoanRepay.textContent = formatMoney(totalLoanRepayment);
      }
      if (resTotalProjectCost) {
        resTotalProjectCost.textContent = formatMoney(totalProjectCostWithInterest);
      }

      // Update Progress Bar & Legend
      const totalBarBasis = totalProjectCostWithInterest > 0 ? totalProjectCostWithInterest : 1;
      const downBarPct = (effectiveDown / totalBarBasis) * 100;
      const principalBarPct = (loanAmount / totalBarBasis) * 100;
      const interestBarPct = (totalInterest / totalBarBasis) * 100;

      if (resBarTotal) {
        resBarTotal.textContent = formatMoney(totalProjectCostWithInterest);
      }
      if (barDown) barDown.style.width = `${downBarPct.toFixed(1)}%`;
      if (barPrincipal) barPrincipal.style.width = `${principalBarPct.toFixed(1)}%`;
      if (barInterest) barInterest.style.width = `${interestBarPct.toFixed(1)}%`;

      if (legendDown) {
        legendDown.textContent = `${formatMoney(effectiveDown)} (${downBarPct.toFixed(1)}%)`;
      }
      if (legendPrincipal) {
        legendPrincipal.textContent = `${formatMoney(loanAmount)} (${principalBarPct.toFixed(1)}%)`;
      }
      if (legendInterest) {
        legendInterest.textContent = `${formatMoney(totalInterest)} (${interestBarPct.toFixed(1)}%)`;
      }

      // Update Dynamic Narrative
      if (resNarrative) {
        if (loanAmount === 0) {
          resNarrative.innerHTML = `Your down payment of <strong>${formatMoney(effectiveDown)}</strong> covers 100% of the total <strong>${formatMoney(cost)}</strong> ADU project cost. Because no construction loan or financing is required, your monthly principal and interest payment is <strong>${formatMoney(0)}</strong>, and you will pay <strong>${formatMoney(0)}</strong> in loan interest.`;
        } else if (rate === 0) {
          resNarrative.innerHTML = `For an ADU construction project costing <strong>${formatMoney(cost)}</strong> with <strong>${formatMoney(effectiveDown)}</strong> down (${downPct.toFixed(1)}%), you would borrow <strong>${formatMoney(loanAmount)}</strong>. With a <strong>0.0%</strong> interest rate over <strong>${termYears} years</strong> (${totalMonths} months), your monthly payment is <strong>${formatMoney(monthlyPayment)}</strong> with <strong>${formatMoney(0)}</strong> total interest paid, totaling <strong>${formatMoney(cost)}</strong>.`;
        } else {
          resNarrative.innerHTML = `For an ADU construction project costing <strong>${formatMoney(cost)}</strong> with <strong>${formatMoney(effectiveDown)}</strong> down (${downPct.toFixed(1)}%), you would borrow <strong>${formatMoney(loanAmount)}</strong>. At a <strong>${rate.toFixed(1)}%</strong> annual interest rate over <strong>${termYears} years</strong> (${totalMonths} monthly payments), your estimated monthly principal and interest payment is <strong>${formatMoney(monthlyPayment)}</strong>. Over the life of the loan, you will pay <strong>${formatMoney(totalInterest)}</strong> in total interest, bringing the total all-in cost of your ADU to <strong>${formatMoney(totalProjectCostWithInterest)}</strong>.`;
        }
      }

      // Update active states on quick chips
      quickChips.forEach(chip => {
        const chipPct = parseFloat(chip.getAttribute('data-pct'));
        if (Math.abs(downPct - chipPct) < 0.2) {
          chip.classList.add('active');
        } else {
          chip.classList.remove('active');
        }
      });

      termChips.forEach(chip => {
        const chipTerm = parseFloat(chip.getAttribute('data-term'));
        if (Math.abs(termYears - chipTerm) < 0.1) {
          chip.classList.add('active');
        } else {
          chip.classList.remove('active');
        }
      });
    }

    // Event Listeners for Currency
    if (currencySelect) {
      currencySelect.addEventListener('change', (e) => {
        updateCurrency(e.target.value);
      });
    }

    // Bidirectional sync: Cost
    costInput.addEventListener('input', () => {
      costSlider.value = costInput.value;
      recalculate();
    });
    costSlider.addEventListener('input', () => {
      costInput.value = costSlider.value;
      recalculate();
    });

    // Bidirectional sync: Down Payment
    downInput.addEventListener('input', () => {
      downSlider.value = downInput.value;
      recalculate();
    });
    downSlider.addEventListener('input', () => {
      downInput.value = downSlider.value;
      recalculate();
    });

    // Quick Down Payment Chips
    quickChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const pct = parseFloat(chip.getAttribute('data-pct')) || 0;
        const cost = parseFloat(costInput.value) || 0;
        const newDown = Math.round(cost * (pct / 100));
        downInput.value = newDown;
        downSlider.value = newDown;
        recalculate();
      });
    });

    // Bidirectional sync: Interest Rate
    rateInput.addEventListener('input', () => {
      rateSlider.value = rateInput.value;
      recalculate();
    });
    rateSlider.addEventListener('input', () => {
      rateInput.value = rateSlider.value;
      recalculate();
    });

    // Bidirectional sync: Loan Term
    termInput.addEventListener('input', () => {
      termSlider.value = termInput.value;
      recalculate();
    });
    termSlider.addEventListener('input', () => {
      termInput.value = termSlider.value;
      recalculate();
    });

    // Quick Term Chips
    termChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const term = parseFloat(chip.getAttribute('data-term')) || 20;
        termInput.value = term;
        termSlider.value = term;
        recalculate();
      });
    });

    // Reset button
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        costInput.value = '150000';
        costSlider.value = '150000';
        downInput.value = '30000';
        downSlider.value = '30000';
        rateInput.value = '7.0';
        rateSlider.value = '7.0';
        termInput.value = '20';
        termSlider.value = '20';
        if (currencySelect) {
          currencySelect.value = 'USD';
          updateCurrency('USD');
        } else {
          recalculate();
        }
      });
    }

    // Action Toolbar Clipboard Integration
    window.addEventListener('copy-calculator-results', async () => {
      try {
        const cost = parseFloat(costInput.value) || 0;
        const down = parseFloat(downInput.value) || 0;
        const rate = parseFloat(rateInput.value) || 0;
        const term = parseFloat(termInput.value) || 0;
        const monthly = resMonthlyPayment ? resMonthlyPayment.textContent : '';
        const loan = resLoanAmount ? resLoanAmount.textContent : '';
        const interest = resTotalInterest ? resTotalInterest.textContent : '';
        const totalCost = resTotalProjectCost ? resTotalProjectCost.textContent : '';

        const textToCopy = `FinCalcLab ADU Loan Calculation Results:
• Total Project Cost: ${formatMoney(cost)}
• Down Payment: ${formatMoney(down)}
• Annual Interest Rate: ${rate.toFixed(1)}%
• Loan Term: ${term} Years
---------------------------------------
• Estimated Monthly Payment (P&I): ${monthly}/mo
• Total Loan Amount: ${loan}
• Total Interest Paid: ${interest}
• Total Project Cost With Financing: ${totalCost}
• Calculated online at: ${window.location.href}`;

        await navigator.clipboard.writeText(textToCopy);
        window.dispatchEvent(new CustomEvent('calculator-copied-success'));
      } catch (err) {
        console.error('Failed to copy calculator results:', err);
      }
    });

    // Initial calculation on load
    recalculate();
  }

  // Handle both standard loads and Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAduCalculator);
  } else {
    initAduCalculator();
  }
  document.addEventListener('astro:page-load', initAduCalculator);
</script>

