---
import CalculatorLayout from './CalculatorLayout.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
---

<CalculatorLayout
  title="Child Education Cost Calculator"
  description="Calculate future school and college education costs with country-specific education inflation for India, the UAE, and Singapore. Estimate your required monthly savings, investment growth, and education corpus."
  category="Education & Savings"
>
  <!-- Inputs Section -->
  <div slot="inputs" class="calc-inputs-wrapper" id="child-edu-root">
    <!-- Country Selection Section -->
    <div class="input-section" style="border-top: none; padding-top: 0;">
      <div class="section-header-row">
        <h3 class="section-title">1. Select Country</h3>
        <span class="country-badge-label" id="country-active-badge">India (INR ₹)</span>
      </div>

      <!-- Mobile Country Dropdown (<= 640px) -->
      <div class="mobile-country-selector-wrap">
        <label for="mobile-edu-country-select" class="sr-only">Choose Country</label>
        <div class="mobile-select-box">
          <span class="mobile-select-flag" id="mobile-selected-flag" aria-hidden="true">🇮🇳</span>
          <select id="mobile-edu-country-select" class="mobile-country-dropdown" aria-label="Select Country">
            <option value="IN" selected>India — INR (₹)</option>
            <option value="UAE">United Arab Emirates — AED (د.إ)</option>
            <option value="SG">Singapore — SGD (S$)</option>
          </select>
          <div class="mobile-select-arrow" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </div>
        </div>
      </div>

      <!-- Desktop Country Pills (> 640px) -->
      <div class="country-selector-pills" role="tablist" aria-label="Country Options">
        <button type="button" class="country-pill active" data-country="IN" role="tab" aria-selected="true">
          <span class="pill-flag">🇮🇳</span>
          <span class="pill-name">India (₹)</span>
        </button>
        <button type="button" class="country-pill" data-country="UAE" role="tab" aria-selected="false">
          <span class="pill-flag">🇦🇪</span>
          <span class="pill-name">UAE (AED)</span>
        </button>
        <button type="button" class="country-pill" data-country="SG" role="tab" aria-selected="false">
          <span class="pill-flag">🇸🇬</span>
          <span class="pill-name">Singapore (S$)</span>
        </button>
      </div>
      <span class="input-subtext" id="country-help-text">Verified Indian school and university fee structures, 10% average education inflation, and equity SIP benchmarks.</span>
    </div>

    <!-- Education Type & Category Section -->
    <div class="input-section">
      <h3 class="section-title">2. Education Goal &amp; Category</h3>

      <!-- Singapore Student Status (Visible only for Singapore) -->
      <div class="input-group hidden" id="field-sg-status">
        <div class="input-label-row">
          <label for="edu-sg-status">Student Residency Status</label>
          <select id="edu-sg-status" class="currency-select" aria-label="Singapore Student Status">
            <option value="citizen" selected>Singapore Citizen (Subsidized)</option>
            <option value="pr">Permanent Resident (PR)</option>
            <option value="international">International Student (IS)</option>
          </select>
        </div>
        <span class="input-subtext">Tuition fees in Singapore vary substantially across Singapore Citizens, PRs, and International Students per MOE schedules.</span>
      </div>

      <!-- Education Level / Goal -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="edu-level-select">Education Goal</label>
          <select id="edu-level-select" class="currency-select" aria-label="Education Goal">
            <!-- Dynamically populated based on country -->
          </select>
        </div>
        <span class="input-subtext" id="edu-level-subtext">Choose the target education stage you are funding for your child.</span>
      </div>

      <!-- Institution / Category Type -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="edu-category-select">Institution / Category</label>
          <select id="edu-category-select" class="currency-select" aria-label="Institution Category">
            <!-- Dynamically populated based on country and level -->
          </select>
        </div>
        <span class="input-subtext" id="edu-category-subtext">Verified typical annual cost benchmark for this institution tier.</span>
      </div>
    </div>

    <!-- Timeline & Duration Section -->
    <div class="input-section">
      <h3 class="section-title">3. Timeline &amp; Age</h3>

      <!-- Child Age Grid -->
      <div class="age-inputs-grid">
        <!-- Child Current Age -->
        <div class="input-group">
          <div class="input-label-row">
            <label for="edu-child-age">Child's Current Age</label>
            <div class="input-symbol-wrapper unit-wrapper">
              <input type="number" id="edu-child-age" min="0" max="22" step="1" value="5" aria-label="Child Current Age" />
              <span class="unit-suffix">yrs</span>
            </div>
          </div>
          <input type="range" id="edu-child-age-slider" min="0" max="20" step="1" value="5" class="slider-range" aria-label="Child Current Age Slider" />
          <div class="preset-pills-row">
            <span class="preset-label">Age:</span>
            <button type="button" class="preset-pill age-pill" data-age="1">1</button>
            <button type="button" class="preset-pill age-pill" data-age="3">3</button>
            <button type="button" class="preset-pill age-pill active" data-age="5">5</button>
            <button type="button" class="preset-pill age-pill" data-age="10">10</button>
            <button type="button" class="preset-pill age-pill" data-age="14">14</button>
          </div>
        </div>

        <!-- Start Age -->
        <div class="input-group">
          <div class="input-label-row">
            <label for="edu-start-age">Education Begins At</label>
            <div class="input-symbol-wrapper unit-wrapper">
              <input type="number" id="edu-start-age" min="1" max="25" step="1" value="18" aria-label="Age When Education Begins" />
              <span class="unit-suffix">yrs</span>
            </div>
          </div>
          <input type="range" id="edu-start-age-slider" min="3" max="25" step="1" value="18" class="slider-range" aria-label="Start Age Slider" />
          <div class="preset-pills-row">
            <span class="preset-label">Target:</span>
            <button type="button" class="preset-pill start-pill" data-start="4">Age 4 (KG)</button>
            <button type="button" class="preset-pill start-pill" data-start="6">Age 6 (Grade 1)</button>
            <button type="button" class="preset-pill start-pill active" data-start="18">Age 18 (UG)</button>
            <button type="button" class="preset-pill start-pill" data-start="22">Age 22 (PG)</button>
          </div>
        </div>
      </div>

      <!-- Duration -->
      <div class="input-group" style="margin-top: var(--space-3);">
        <div class="input-label-row">
          <label for="edu-duration">Education Duration</label>
          <div class="input-symbol-wrapper unit-wrapper">
            <input type="number" id="edu-duration" min="1" max="15" step="1" value="4" aria-label="Duration in Years" />
            <span class="unit-suffix">years</span>
          </div>
        </div>
        <input type="range" id="edu-duration-slider" min="1" max="15" step="1" value="4" class="slider-range" aria-label="Duration Slider" />
        <span class="input-subtext" id="edu-duration-subtext">Number of academic years to fund (e.g. 4 years for Bachelor's, 2 years for Master's, 12 years for School).</span>
      </div>

      <!-- Horizon Alert -->
      <div class="horizon-indicator-pill" id="edu-horizon-pill">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        <span id="edu-horizon-text">13 years until education starts (Age 18 to 22)</span>
      </div>
    </div>

    <!-- Cost & Inflation Section -->
    <div class="input-section">
      <h3 class="section-title">4. Current Costs &amp; Inflation</h3>

      <!-- Annual Base Tuition Cost -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="edu-base-cost">Current Annual Tuition Cost</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol" id="curr-sym-1">₹</span>
            <input type="number" id="edu-base-cost" min="0" max="100000000" step="5000" value="400000" aria-label="Annual Tuition Cost Today" />
          </div>
        </div>
        <span class="input-subtext">Current annual tuition fee in today's money. Fully editable.</span>
      </div>

      <!-- Additional Annual Expenses -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="edu-add-cost">Additional Annual Expenses</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol" id="curr-sym-2">₹</span>
            <input type="number" id="edu-add-cost" min="0" max="50000000" step="2000" value="50000" aria-label="Additional Annual Expenses" />
          </div>
        </div>
        <span class="input-subtext">Living expenses, hostel/accommodation, books, uniforms, transport, exam fees, and coaching.</span>
      </div>

      <!-- Education Inflation Rate -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="edu-inflation-rate">Annual Education Inflation Rate</label>
          <div class="input-symbol-wrapper unit-wrapper">
            <input type="number" id="edu-inflation-rate" min="0" max="25" step="0.5" value="10.0" aria-label="Annual Education Inflation Rate" />
            <span class="unit-suffix">%</span>
          </div>
        </div>
        <input type="range" id="edu-inflation-slider" min="0" max="20" step="0.5" value="10.0" class="slider-range" aria-label="Inflation Slider" />
        <span class="input-subtext" id="edu-inflation-subtext">Education inflation typically outpaces general consumer CPI by 3%–5% annually.</span>
      </div>
    </div>

    <!-- Savings & Investment Return Section -->
    <div class="input-section">
      <h3 class="section-title">5. Existing Savings &amp; Investment Plan</h3>

      <!-- Existing Education Savings -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="edu-existing-savings">Existing Education Savings</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol" id="curr-sym-3">₹</span>
            <input type="number" id="edu-existing-savings" min="0" max="500000000" step="10000" value="200000" aria-label="Existing Education Savings" />
          </div>
        </div>
        <span class="input-subtext">Current dedicated mutual funds, FDs, Sukanya Samriddhi, CPF, or cash earmarked for education.</span>
      </div>

      <!-- Expected Investment Return -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="edu-return-rate">Expected Annual Investment Return</label>
          <div class="input-symbol-wrapper unit-wrapper">
            <input type="number" id="edu-return-rate" min="0" max="25" step="0.5" value="11.0" aria-label="Expected Investment Return Rate" />
            <span class="unit-suffix">%</span>
          </div>
        </div>
        <input type="range" id="edu-return-slider" min="0" max="20" step="0.5" value="11.0" class="slider-range" aria-label="Return Slider" />
        <span class="input-subtext" id="edu-return-subtext">Estimated annual growth rate on your monthly investments and existing savings portfolio.</span>
      </div>

      <!-- Savings Frequency Toggle -->
      <div class="input-group">
        <label class="control-label" style="display:block; margin-bottom: 8px;">Savings Frequency</label>
        <div class="freq-toggle-group" role="radiogroup" aria-label="Savings Frequency">
          <button type="button" class="freq-btn active" data-freq="monthly" role="radio" aria-checked="true">Monthly (SIP)</button>
          <button type="button" class="freq-btn" data-freq="annual" role="radio" aria-checked="false">Annually (Lump Sum)</button>
        </div>
        <span class="input-subtext">How often you plan to deposit funds into your child's education investment portfolio.</span>
      </div>
    </div>

    <!-- Reset Button -->
    <div class="input-actions" style="margin-top: var(--space-4);">
      <Button variant="secondary" size="md" id="edu-reset-btn" class="w-full">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        Reset to Country Defaults
      </Button>
    </div>
  </div>

  <!-- Results Section -->
  <div slot="results" class="calc-results-wrapper" id="child-edu-results">
    <!-- Primary Hero Card: Total Projected Education Cost -->
    <div class="hero-result-card">
      <div class="hero-top-row">
        <span class="hero-label">Projected Total Education Cost</span>
        <span class="hero-badge" id="res-inflation-multiplier">2.4× Today's Cost</span>
      </div>
      <div class="hero-amount-wrapper">
        <span class="hero-currency" id="res-curr-sym">₹</span>
        <span class="hero-value" id="res-total-cost">72,09,896</span>
      </div>
      <p class="hero-verdict" id="res-hero-verdict">
        Over 4 years of education starting in 2039 at 10.0% annual inflation, you will need a total estimated corpus of ₹72.10 Lakh.
      </p>
    </div>

    <!-- Sub-Hero Cards: Required Monthly & Annual Investment -->
    <div class="sub-hero-grid">
      <div class="sub-card sub-card-primary">
        <span class="sub-card-label">Required Monthly Savings</span>
        <div class="sub-card-value-wrap">
          <span class="sub-curr" id="sub-curr-1">₹</span>
          <span class="sub-val" id="res-monthly-savings">15,573</span>
          <span class="sub-period">/ mo</span>
        </div>
        <span class="sub-card-hint" id="res-monthly-hint">For 13 years at 11.0% expected annual return</span>
      </div>

      <div class="sub-card sub-card-secondary">
        <span class="sub-card-label">Required Annual Savings</span>
        <div class="sub-card-value-wrap">
          <span class="sub-curr" id="sub-curr-2">₹</span>
          <span class="sub-val" id="res-annual-savings">1,99,750</span>
          <span class="sub-period">/ yr</span>
        </div>
        <span class="sub-card-hint" id="res-annual-hint">If investing lump sum once a year</span>
      </div>
    </div>

    <!-- Savings Gap / Surplus Callout Card -->
    <div class="gap-status-card" id="res-gap-card">
      <div class="gap-card-header">
        <div class="gap-icon" id="gap-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        </div>
        <div class="gap-content">
          <strong id="gap-title">Estimated Savings Gap: ₹64,33,240</strong>
          <p id="gap-desc">Your existing ₹2,00,000 savings will grow to ₹7,76,656 by college start. A disciplined monthly SIP of ₹15,573 closes the remaining funding gap.</p>
        </div>
      </div>
    </div>

    <!-- Visual Portfolio Split Chart -->
    <div class="visual-progress-card">
      <div class="split-bar-header">
        <span>Education Funding Breakdown</span>
        <span id="res-growth-share">63.5% Funded by Compounding</span>
      </div>
      <div class="split-bar-track" aria-hidden="true">
        <div class="bar-segment bar-savings" id="bar-seg-existing" style="width: 11%;" title="Existing Savings FV"></div>
        <div class="bar-segment bar-invested" id="bar-seg-deposits" style="width: 34%;" title="Planned New Deposits"></div>
        <div class="bar-segment bar-growth" id="bar-seg-growth" style="width: 55%;" title="Investment Growth"></div>
      </div>
      <div class="split-legend">
        <div class="legend-item"><span class="dot dot-savings"></span>Existing Savings: <strong id="leg-existing-val">₹7.77 L</strong></div>
        <div class="legend-item"><span class="dot dot-invested"></span>New Deposits: <strong id="leg-deposits-val">₹24.29 L</strong></div>
        <div class="legend-item"><span class="dot dot-growth"></span>Compound Growth: <strong id="leg-growth-val">₹40.04 L</strong></div>
      </div>
    </div>

    <!-- 8-Tile Responsive Metrics Grid -->
    <div class="metrics-grid">
      <div class="metric-tile">
        <span class="metric-label">Today's Total Cost</span>
        <span class="metric-val" id="tile-cost-today">₹18,00,000</span>
        <span class="metric-sub">Without inflation</span>
      </div>
      <div class="metric-tile">
        <span class="metric-label">First Year Cost</span>
        <span class="metric-val" id="tile-first-year">₹15,53,522</span>
        <span class="metric-sub">At education start</span>
      </div>
      <div class="metric-tile">
        <span class="metric-label">Years to Start</span>
        <span class="metric-val" id="tile-years-start">13 yrs</span>
        <span class="metric-sub">Accumulation window</span>
      </div>
      <div class="metric-tile">
        <span class="metric-label">Duration</span>
        <span class="metric-val" id="tile-duration">4 yrs</span>
        <span class="metric-sub">Education period</span>
      </div>
      <div class="metric-tile">
        <span class="metric-label">FV of Existing Savings</span>
        <span class="metric-val" id="tile-fv-savings">₹7,76,656</span>
        <span class="metric-sub">At start of education</span>
      </div>
      <div class="metric-tile">
        <span class="metric-label">Total Out-of-Pocket</span>
        <span class="metric-val" id="tile-out-of-pocket">₹26,29,388</span>
        <span class="metric-sub">Principal invested</span>
      </div>
      <div class="metric-tile">
        <span class="metric-label">Compound Returns</span>
        <span class="metric-val" id="tile-growth">₹45,80,508</span>
        <span class="metric-sub">Wealth from returns</span>
      </div>
      <div class="metric-tile">
        <span class="metric-label">Corpus Target</span>
        <span class="metric-val" id="tile-corpus-target">₹61,30,617</span>
        <span class="metric-sub">Required at start</span>
      </div>
    </div>

    <!-- Year-by-Year Cost & Withdrawal Schedule Table -->
    <div class="table-card">
      <div class="table-card-header">
        <div>
          <h4 class="table-title">Year-by-Year Projected Education Expenses</h4>
          <span class="table-subtitle" id="table-subtitle">Projected cash flows based on 10.0% annual education inflation</span>
        </div>
        <span class="table-scroll-hint" aria-hidden="true">Scroll table &rarr;</span>
      </div>

      <div class="table-responsive-wrapper">
        <table class="edu-schedule-table" aria-label="Year-by-Year Education Cost Schedule">
          <thead>
            <tr>
              <th scope="col" style="text-align: left;">Year</th>
              <th scope="col" style="text-align: center;">Child Age</th>
              <th scope="col" style="text-align: right;">Cost in Today's Money</th>
              <th scope="col" style="text-align: right;">Inflation Factor</th>
              <th scope="col" style="text-align: right;">Projected Annual Fee</th>
              <th scope="col" style="text-align: right;">Cumulative Expenses</th>
            </tr>
          </thead>
          <tbody id="edu-schedule-tbody">
            <!-- Dynamically populated rows -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Country Guidance & Assumptions Callout Box -->
    <div class="callout-tip-box" id="res-country-tip">
      <div class="tip-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
      </div>
      <div class="tip-content">
        <strong id="tip-heading">India Planning Guidance (NSSO &amp; Higher Education Benchmarks)</strong>
        <p id="tip-body">
          Indian higher education inflation historically tracks between 8%–12% per year. Private engineering degrees currently averaging ₹12–₹18 Lakh for 4 years can exceed ₹50–₹75 Lakh by the time a toddler reaches age 18. Starting an equity mutual fund SIP early harnesses compound returns to fund up to 60%+ of the goal.
        </p>
      </div>
    </div>
  </div>
</CalculatorLayout>

<style>
  /* -------------------------------------------------------------
     CHILD EDUCATION COST CALCULATOR COMPONENT STYLES
     Fully responsive from 320px to 1920px (Mobile-First)
     ------------------------------------------------------------- */
  :global(.calc-inputs-card),
  :global(.calc-results-card) {
    min-width: 0 !important;
    max-width: 100% !important;
    width: 100% !important;
    box-sizing: border-box !important;
    overflow: visible !important;
  }

  @media (max-width: 480px) {
    :global(.calc-inputs-card),
    :global(.calc-results-card) {
      padding: 14px !important;
      border-radius: var(--radius-md) !important;
    }
  }

  .calc-inputs-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .input-section {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
    gap: 8px;
    flex-wrap: wrap;
  }

  .section-title {
    font-size: 0.96rem;
    font-weight: 700;
    color: var(--color-heading);
    margin: 0;
  }

  .country-badge-label {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: var(--radius-full);
    background: rgba(37, 99, 235, 0.08);
    color: var(--color-primary);
  }

  /* Country Selector (Mobile Dropdown vs Desktop Pills) */
  .mobile-country-selector-wrap {
    display: none;
    width: 100%;
    margin-bottom: var(--space-2);
  }

  .mobile-select-box {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    background: var(--color-card);
    border: 1.5px solid var(--color-primary);
    border-radius: var(--radius-md);
    box-shadow: 0 1px 3px rgba(37, 99, 235, 0.1);
  }

  .mobile-select-flag {
    position: absolute;
    left: 12px;
    font-size: 1.25rem;
    line-height: 1;
    pointer-events: none;
    z-index: 1;
  }

  .mobile-country-dropdown {
    width: 100%;
    height: 44px;
    padding: 8px 36px 8px 44px;
    background: transparent;
    border: none;
    border-radius: var(--radius-md);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-heading);
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
  }

  .mobile-country-dropdown:focus {
    outline: none;
  }

  .mobile-select-arrow {
    position: absolute;
    right: 12px;
    color: var(--color-primary);
    pointer-events: none;
  }

  .country-selector-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    width: 100%;
    min-width: 0;
  }

  .country-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    font-size: 0.86rem;
