    <!-- Category Contribution Bar -->
    <div class="chart-container" id="trc-chart-container">
      <h3 class="breakdown-heading" style="text-align: center; margin-bottom: var(--space-2);">Revenue Composition</h3>
      <div 
        id="trc-composition-bar" 
        class="composition-bar" 
        role="progressbar" 
        aria-label="Twitch Revenue Composition Breakdown" 
        aria-valuemin="0" 
        aria-valuemax="100"
      >
        <!-- Injected via JS -->
      </div>
      <div class="chart-legend-grid trc-legend-grid">
        <span class="legend-item" id="leg-item-paid"><span class="legend-dot" style="background: #a855f7;"></span>Paid Subs: <strong id="lbl-t-paid-subs-val">$511.57 (42.4%)</strong></span>
        <span class="legend-item" id="leg-item-prime"><span class="legend-dot" style="background: #06b6d4;"></span>Prime Subs: <strong id="lbl-t-prime-subs-val">$112.50 (9.3%)</strong></span>
        <span class="legend-item" id="leg-item-ads"><span class="legend-dot" style="background: #3b82f6;"></span>Ads: <strong id="lbl-t-ads-val">$336.00 (27.9%)</strong></span>
        <span class="legend-item" id="leg-item-bits"><span class="legend-dot" style="background: #10b981;"></span>Bits: <strong id="lbl-t-bits-val">$100.00 (8.3%)</strong></span>
        <span class="legend-item" id="leg-item-tips"><span class="legend-dot" style="background: #f59e0b;"></span>Direct Tips: <strong id="lbl-t-tips-val">$145.50 (12.1%)</strong></span>
      </div>
    </div>

    <!-- Transparency Disclaimer Box -->
    <div class="payout-note-card">
      <div class="payout-note-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
      </div>
      <p class="payout-note-text">
        <strong>Important Payout Reality:</strong> Results represent estimated pre-tax platform earnings based on your inputs. Actual take-home payouts will differ due to regional subscription pricing (SUBtember discounts), withholding taxes, local VAT/GST, payment processor charges, and chargebacks.
      </p>
    </div>

  </div>
</CalculatorLayout>

<script>
  function initTwitchCalculator() {
    // Currency reference rates (relative to 1 USD)
    const defaultFxRates: Record<string, number> = {
      USD: 1.0,
      EUR: 0.92,
      GBP: 0.79,
      CAD: 1.39,
      AUD: 1.52,
      INR: 84.0,
      JPY: 153.0,
      SGD: 1.32,
      CHF: 0.87
    };

    const currencySymbols: Record<string, string> = {
      USD: '$',
      EUR: '€',
      GBP: '£',
      CAD: 'C$',
      AUD: 'A$',
      INR: '₹',
      JPY: '¥',
      SGD: 'S$',
      CHF: 'CHF '
    };

    // Regional base subscription pricing presets (Tier 1, Tier 2, Tier 3, Prime Payout)
    const regionalPricePresets: Record<string, { t1: number; t2: number; t3: number; prime: number }> = {
      USD: { t1: 4.99, t2: 9.99, t3: 24.99, prime: 2.25 },
      EUR: { t1: 3.99, t2: 7.99, t3: 19.99, prime: 1.55 },
      GBP: { t1: 3.99, t2: 7.99, t3: 19.99, prime: 1.80 },
      CAD: { t1: 6.99, t2: 13.99, t3: 34.99, prime: 1.40 },
      AUD: { t1: 7.99, t2: 15.99, t3: 39.99, prime: 1.40 },
      INR: { t1: 110.0, t2: 220.0, t3: 550.0, prime: 21.0 },
      JPY: { t1: 600.0, t2: 1200.0, t3: 3000.0, prime: 150.0 },
      SGD: { t1: 5.99, t2: 11.99, t3: 29.99, prime: 1.70 },
      CHF: { t1: 4.50, t2: 9.00, t3: 22.50, prime: 1.90 }
    };

    // Selector Checkboxes and Card Elements
    const chkTotal = document.getElementById('sel-source-total') as HTMLInputElement;
    const chkSubs = document.getElementById('sel-source-subs') as HTMLInputElement;
    const chkAds = document.getElementById('sel-source-ads') as HTMLInputElement;
    const chkBits = document.getElementById('sel-source-bits') as HTMLInputElement;

    const cardTotal = document.getElementById('card-source-total') as HTMLElement;
    const cardSubs = document.getElementById('card-source-subs') as HTMLElement;
    const cardAds = document.getElementById('card-source-ads') as HTMLElement;
    const cardBits = document.getElementById('card-source-bits') as HTMLElement;

    // Input Sections
    const secSubs = document.getElementById('section-subscription-earnings') as HTMLElement;
    const secAds = document.getElementById('section-advertising-revenue') as HTMLElement;
    const secBits = document.getElementById('section-bits-donations') as HTMLElement;

    // Currency elements
    const currencySelect = document.getElementById('trc-currency-select') as HTMLSelectElement;
    const fxGroup = document.getElementById('trc-fx-group') as HTMLElement;
    const fxRateInput = document.getElementById('trc-fx-rate') as HTMLInputElement;

    // Stream profile elements
    const viewersInput = document.getElementById('trc-viewers-input') as HTMLInputElement;
    const viewersSlider = document.getElementById('trc-viewers-slider') as HTMLInputElement;
    const hoursInput = document.getElementById('trc-hours-input') as HTMLInputElement;
    const hoursSlider = document.getElementById('trc-hours-slider') as HTMLInputElement;

    // Subscription elements
    const splitSelect = document.getElementById('trc-split') as HTMLSelectElement;
    const customSplitGroup = document.getElementById('trc-custom-split-group') as HTMLElement;
    const customSplitInput = document.getElementById('trc-custom-split-input') as HTMLInputElement;

    const subsT1Input = document.getElementById('trc-subs-t1-input') as HTMLInputElement;
    const subsT1Slider = document.getElementById('trc-subs-t1-slider') as HTMLInputElement;
    const priceT1Input = document.getElementById('trc-price-t1') as HTMLInputElement;

    const subsT2Input = document.getElementById('trc-subs-t2-input') as HTMLInputElement;
    const subsT2Slider = document.getElementById('trc-subs-t2-slider') as HTMLInputElement;
    const priceT2Input = document.getElementById('trc-price-t2') as HTMLInputElement;

    const subsT3Input = document.getElementById('trc-subs-t3-input') as HTMLInputElement;
    const subsT3Slider = document.getElementById('trc-subs-t3-slider') as HTMLInputElement;
    const priceT3Input = document.getElementById('trc-price-t3') as HTMLInputElement;

    const subsGiftInput = document.getElementById('trc-subs-gift-input') as HTMLInputElement;
    const subsGiftSlider = document.getElementById('trc-subs-gift-slider') as HTMLInputElement;

    const subsPrimeInput = document.getElementById('trc-subs-prime-input') as HTMLInputElement;
    const subsPrimeSlider = document.getElementById('trc-subs-prime-slider') as HTMLInputElement;
    const payoutPrimeInput = document.getElementById('trc-payout-prime') as HTMLInputElement;

    // Ad elements
    const adRateInput = document.getElementById('trc-ad-rate-input') as HTMLInputElement;
    const adRateSlider = document.getElementById('trc-ad-rate-slider') as HTMLInputElement;
    const adCpmInput = document.getElementById('trc-ad-cpm-input') as HTMLInputElement;
    const adCpmSlider = document.getElementById('trc-ad-cpm-slider') as HTMLInputElement;

    // Bits & Tips elements
    const bitsInput = document.getElementById('trc-bits') as HTMLInputElement;
    const tipsInput = document.getElementById('trc-tips') as HTMLInputElement;
    const tipFeeInput = document.getElementById('trc-tip-fee') as HTMLInputElement;

    // Results DOM Elements
    const resultsTitle = document.getElementById('trc-results-title');
    const resultsSubtitle = document.getElementById('trc-results-subtitle');
    const lblHeroMonthly = document.getElementById('lbl-hero-monthly');
    const resMonthly = document.getElementById('res-trc-monthly');
    const lblAnnual = document.getElementById('lbl-trc-annual');
    const resHourly = document.getElementById('res-trc-hourly');
    const lblHoursTotal = document.getElementById('lbl-trc-hours-total');

    const cardTilePaid = document.getElementById('tile-card-paid-subs');
    const cardTilePrime = document.getElementById('tile-card-prime-subs');
    const cardTileAds = document.getElementById('tile-card-ads');
    const cardTileBits = document.getElementById('tile-card-bits');
    const cardTileTips = document.getElementById('tile-card-tips');

    const tilePaidSubs = document.getElementById('tile-trc-paid-subs');
    const lblPaidSubsDetail = document.getElementById('lbl-t-paid-subs-detail');
    const lblPaidSubsShare = document.getElementById('lbl-t-paid-subs-share');

    const tilePrimeSubs = document.getElementById('tile-trc-prime-subs');
    const lblPrimeSubsDetail = document.getElementById('lbl-t-prime-subs-detail');
    const lblPrimeSubsShare = document.getElementById('lbl-t-prime-subs-share');

    const tileAds = document.getElementById('tile-trc-ads');
    const lblAdsDetail = document.getElementById('lbl-t-ads-impressions');
    const lblAdsShare = document.getElementById('lbl-t-ads-share');

    const tileBits = document.getElementById('tile-trc-bits');
    const lblBitsDetail = document.getElementById('lbl-t-bits-detail');
    const lblBitsShare = document.getElementById('lbl-t-bits-share');

    const tileTips = document.getElementById('tile-trc-tips');
    const lblTipsDetail = document.getElementById('lbl-t-tips-detail');
    const lblTipsShare = document.getElementById('lbl-t-tips-share');

    const legItemPaid = document.getElementById('leg-item-paid');
    const legItemPrime = document.getElementById('leg-item-prime');
    const legItemAds = document.getElementById('leg-item-ads');
    const legItemBits = document.getElementById('leg-item-bits');
    const legItemTips = document.getElementById('leg-item-tips');

    const cPaid = document.getElementById('lbl-t-paid-subs-val');
    const cPrime = document.getElementById('lbl-t-prime-subs-val');
    const cAd = document.getElementById('lbl-t-ads-val');
    const cBits = document.getElementById('lbl-t-bits-val');
    const cTips = document.getElementById('lbl-t-tips-val');

    const compBar = document.getElementById('trc-composition-bar');
    const verdictText = document.getElementById('res-trc-verdict-text');
    const verdictTitle = document.getElementById('lbl-verdict-title');

    if (!viewersInput || !currencySelect || !chkTotal || !chkSubs) return;

    // --- REVENUE SOURCE SELECTION LOGIC ---
    function syncCardClasses() {
      if (cardTotal) cardTotal.classList.toggle('active', chkTotal.checked);
      if (cardSubs) cardSubs.classList.toggle('active', chkSubs.checked);
      if (cardAds) cardAds.classList.toggle('active', chkAds.checked);
      if (cardBits) cardBits.classList.toggle('active', chkBits.checked);

      // Toggle Input Sections
      if (secSubs) secSubs.style.display = chkSubs.checked ? 'flex' : 'none';
      if (secAds) secAds.style.display = chkAds.checked ? 'flex' : 'none';
      if (secBits) secBits.style.display = chkBits.checked ? 'flex' : 'none';
    }

    // Master Total Checkbox
    chkTotal.addEventListener('change', () => {
      if (chkTotal.checked) {
        chkSubs.checked = true;
        chkAds.checked = true;
        chkBits.checked = true;
      } else {
        // If unchecking Total, keep Subscriptions as default single source
        chkSubs.checked = true;
        chkAds.checked = false;
        chkBits.checked = false;
      }
      syncCardClasses();
      calculateAll();
    });

    // Individual Source Checkboxes
    [chkSubs, chkAds, chkBits].forEach(chk => {
      chk.addEventListener('change', () => {
        // Prevent deselecting everything (must have at least one active source)
        if (!chkSubs.checked && !chkAds.checked && !chkBits.checked) {
          chk.checked = true;
          return;
        }

        // If all 3 individual sources are checked, auto-check Total
        const allChecked = chkSubs.checked && chkAds.checked && chkBits.checked;
        chkTotal.checked = allChecked;

        syncCardClasses();
        calculateAll();
      });
    });

    // Slider bidirectional sync helper
    function bindSlider(input: HTMLInputElement, slider: HTMLInputElement) {
      if (!input || !slider) return;
      input.addEventListener('input', () => {
        const val = Math.max(0, parseFloat(input.value) || 0);
        slider.value = String(val);
        calculateAll();
      });
      slider.addEventListener('input', () => {
        input.value = slider.value;
        calculateAll();
      });
    }

    bindSlider(viewersInput, viewersSlider);
    bindSlider(hoursInput, hoursSlider);
    bindSlider(subsT1Input, subsT1Slider);
    bindSlider(subsT2Input, subsT2Slider);
    bindSlider(subsT3Input, subsT3Slider);
    bindSlider(subsGiftInput, subsGiftSlider);
    bindSlider(subsPrimeInput, subsPrimeSlider);
    bindSlider(adRateInput, adRateSlider);
    bindSlider(adCpmInput, adCpmSlider);

    // Split dropdown change
    splitSelect.addEventListener('change', () => {
      if (splitSelect.value === 'custom') {
        if (customSplitGroup) customSplitGroup.style.display = 'flex';
      } else {
        if (customSplitGroup) customSplitGroup.style.display = 'none';
      }
      calculateAll();
    });

    if (customSplitInput) {
      customSplitInput.addEventListener('input', calculateAll);
    }

    // Direct input change listeners
    [
      fxRateInput,
      priceT1Input,
      priceT2Input,
      priceT3Input,
      payoutPrimeInput,
      bitsInput,
      tipsInput,
      tipFeeInput
    ].forEach(el => {
      if (el) el.addEventListener('input', calculateAll);
    });

    // Currency selector handling
    currencySelect.addEventListener('change', () => {
      const curr = currencySelect.value;
      const symbol = currencySymbols[curr] || '$';

      // Update all symbol tags across labels and inputs
      document.querySelectorAll('.dynamic-curr-sym').forEach(el => {
        el.textContent = symbol;
      });

      // Update active currency code span
      const codeSpan = document.querySelector('.active-currency-code');
      if (codeSpan) codeSpan.textContent = curr;

      // Handle exchange rate visibility
      if (curr === 'USD') {
        if (fxGroup) fxGroup.style.display = 'none';
        if (fxRateInput) fxRateInput.value = '1.0';
      } else {
        if (fxGroup) fxGroup.style.display = 'flex';
        const defaultRate = defaultFxRates[curr] || 1.0;
        if (fxRateInput) fxRateInput.value = String(defaultRate);
      }

      // Populate regional price preset for the selected currency
      const preset = regionalPricePresets[curr] || regionalPricePresets.USD;
      if (priceT1Input) priceT1Input.value = String(preset.t1);
      if (priceT2Input) priceT2Input.value = String(preset.t2);
      if (priceT3Input) priceT3Input.value = String(preset.t3);
      if (payoutPrimeInput) payoutPrimeInput.value = String(preset.prime);

      calculateAll();
    });

    // Reset button
    const resetBtn = document.getElementById('trc-reset');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        // Reset selections to Total (all 3 active)
        chkTotal.checked = true;
        chkSubs.checked = true;
        chkAds.checked = true;
        chkBits.checked = true;
        syncCardClasses();

        currencySelect.value = 'USD';
        if (fxGroup) fxGroup.style.display = 'none';
        if (fxRateInput) fxRateInput.value = '1.0';

        viewersInput.value = '300';
        viewersSlider.value = '300';
        hoursInput.value = '80';
        hoursSlider.value = '80';

        splitSelect.value = '50';
        if (customSplitGroup) customSplitGroup.style.display = 'none';
        if (customSplitInput) customSplitInput.value = '50';

        subsT1Input.value = '150';
        subsT1Slider.value = '150';
        priceT1Input.value = '4.99';

        subsT2Input.value = '10';
        subsT2Slider.value = '10';
        priceT2Input.value = '9.99';

        subsT3Input.value = '2';
        subsT3Slider.value = '2';
        priceT3Input.value = '24.99';

        subsGiftInput.value = '25';
        subsGiftSlider.value = '25';

        subsPrimeInput.value = '50';
        subsPrimeSlider.value = '50';
        payoutPrimeInput.value = '2.25';

        adRateInput.value = '4.0';
        adRateSlider.value = '4.0';
        adCpmInput.value = '3.50';
        adCpmSlider.value = '3.50';

        bitsInput.value = '10000';
        tipsInput.value = '150';
        tipFeeInput.value = '3.0';

        document.querySelectorAll('.dynamic-curr-sym').forEach(el => el.textContent = '$');
        calculateAll();
      });
    }

    function formatMoney(amount: number, decimals: number = 2) {
      if (isNaN(amount) || amount === null) amount = 0;
      const curr = currencySelect.value;
      const symbol = currencySymbols[curr] || '$';
      const formatted = amount.toLocaleString('en-US', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });
      return `${symbol}${formatted}`;
    }

    function calculateAll() {
      const isSubs = chkSubs.checked;
      const isAds = chkAds.checked;
      const isBits = chkBits.checked;
      const isTotal = chkTotal.checked;

      const curr = currencySelect.value;
      const fxRate = curr === 'USD' ? 1.0 : (Math.max(0.001, parseFloat(fxRateInput.value) || defaultFxRates[curr] || 1.0));

      const viewers = Math.max(0, parseFloat(viewersInput.value) || 0);
      const hours = Math.max(0, parseFloat(hoursInput.value) || 0);

      // Creator split
      let split = 0.50;
      if (splitSelect.value === 'custom') {
        const customPct = Math.max(0, Math.min(100, parseFloat(customSplitInput.value) || 50));
        split = customPct / 100;
      } else {
        split = (parseFloat(splitSelect.value) || 50) / 100;
      }

      // 1. Subscriptions Calculation
      const t1Count = Math.max(0, parseFloat(subsT1Input.value) || 0);
      const t1Price = Math.max(0, parseFloat(priceT1Input.value) || 0);

      const t2Count = Math.max(0, parseFloat(subsT2Input.value) || 0);
      const t2Price = Math.max(0, parseFloat(priceT2Input.value) || 0);

      const t3Count = Math.max(0, parseFloat(subsT3Input.value) || 0);
      const t3Price = Math.max(0, parseFloat(priceT3Input.value) || 0);

      const giftCount = Math.max(0, parseFloat(subsGiftInput.value) || 0);

      const t1Rev = t1Count * t1Price * split;
      const t2Rev = t2Count * t2Price * split;
      const t3Rev = t3Count * t3Price * split;
      const giftRev = giftCount * t1Price * split;
      const rawPaidSubsRev = t1Rev + t2Rev + t3Rev + giftRev;

      const primeCount = Math.max(0, parseFloat(subsPrimeInput.value) || 0);
      const primePayout = Math.max(0, parseFloat(payoutPrimeInput.value) || 0);
      const rawPrimeRev = primeCount * primePayout;

      // 2. Ad Revenue Calculation
      const adRate = Math.max(0, parseFloat(adRateInput.value) || 0);
      const cpm = Math.max(0, parseFloat(adCpmInput.value) || 0);
      const totalImpressions = Math.round(viewers * adRate * hours);
      const rawAdRev = (totalImpressions / 1000) * cpm;

      // 3. Bits & Tips Calculation
      const bits = Math.max(0, parseFloat(bitsInput.value) || 0);
      const bitsRevUsd = bits * 0.01;
      const rawBitsRev = bitsRevUsd * fxRate;

      const tipsGross = Math.max(0, parseFloat(tipsInput.value) || 0);
      const tipFeePct = Math.max(0, Math.min(100, parseFloat(tipFeeInput.value) || 0));
      const rawTipsRev = tipsGross * (1 - (tipFeePct / 100));

      // Active Filtered Values based on selection
      const paidSubsRev = isSubs ? rawPaidSubsRev : 0;
      const primeRev = isSubs ? rawPrimeRev : 0;
      const adRev = isAds ? rawAdRev : 0;
      const bitsRev = isBits ? rawBitsRev : 0;
      const tipsRev = isBits ? rawTipsRev : 0;

      const totalMonthly = paidSubsRev + primeRev + adRev + bitsRev + tipsRev;
      const totalAnnual = totalMonthly * 12;
      const hourlyWage = hours > 0 ? totalMonthly / hours : 0;

      // Live impressions helper box (in Ads section)
      const liveImpressionsEl = document.getElementById('trc-live-ad-impressions');
      if (liveImpressionsEl) {
        liveImpressionsEl.textContent = `${totalImpressions.toLocaleString('en-US')} Total Impressions`;
      }

      // Dynamic Titles based on selection
      if (resultsTitle && resultsSubtitle && lblHeroMonthly) {
        if (isTotal) {
          resultsTitle.textContent = 'Twitch Revenue Summary';
          resultsSubtitle.textContent = 'Estimated gross creator earnings across all channels';
          lblHeroMonthly.textContent = 'Est. Monthly Total Revenue';
        } else if (isSubs && !isAds && !isBits) {
          resultsTitle.textContent = 'Subscription Earnings Summary';
          resultsSubtitle.textContent = 'Estimated monthly and annual income from paid and Prime subscriptions';
          lblHeroMonthly.textContent = 'Est. Monthly Sub Revenue';
        } else if (isAds && !isSubs && !isBits) {
          resultsTitle.textContent = 'Advertising Revenue Summary';
          resultsSubtitle.textContent = 'Estimated monthly and annual earnings from video ad impressions';
          lblHeroMonthly.textContent = 'Est. Monthly Ad Revenue';
        } else if (isBits && !isSubs && !isAds) {
          resultsTitle.textContent = 'Bits & Tips Revenue Summary';
          resultsSubtitle.textContent = 'Estimated monthly earnings from cheered Bits and direct viewer tips';
          lblHeroMonthly.textContent = 'Est. Monthly Bits & Tips';
        } else {
          resultsTitle.textContent = 'Selected Revenue Summary';
          resultsSubtitle.textContent = 'Estimated earnings across your custom combination of revenue sources';
          lblHeroMonthly.textContent = 'Est. Monthly Selected Revenue';
        }
      }

      // DOM Updates: Hero Cards
      if (resMonthly) resMonthly.textContent = formatMoney(totalMonthly);
      if (lblAnnual) lblAnnual.textContent = `Estimated Annual: ${formatMoney(totalAnnual)} /yr`;
      if (resHourly) resHourly.textContent = formatMoney(hourlyWage);
      if (lblHoursTotal) lblHoursTotal.textContent = `Across ${hours} broadcast hours`;

      // Detailed Channel Breakdown Tiles: Show only relevant tiles!
      if (cardTilePaid) cardTilePaid.style.display = isSubs ? 'flex' : 'none';
      if (cardTilePrime) cardTilePrime.style.display = isSubs ? 'flex' : 'none';
      if (cardTileAds) cardTileAds.style.display = isAds ? 'flex' : 'none';
      if (cardTileBits) cardTileBits.style.display = isBits ? 'flex' : 'none';
      if (cardTileTips) cardTileTips.style.display = isBits ? 'flex' : 'none';

      // Percentages calculated strictly against active total
      const shareBasis = totalMonthly > 0 ? totalMonthly : 1;
      const pPaidSubs = isSubs ? (paidSubsRev / shareBasis) * 100 : 0;
      const pPrime = isSubs ? (primeRev / shareBasis) * 100 : 0;
      const pAds = isAds ? (adRev / shareBasis) * 100 : 0;
      const pBits = isBits ? (bitsRev / shareBasis) * 100 : 0;
      const pTips = isBits ? (tipsRev / shareBasis) * 100 : 0;

      if (tilePaidSubs) tilePaidSubs.textContent = formatMoney(paidSubsRev);
      if (lblPaidSubsDetail) lblPaidSubsDetail.textContent = `${t1Count + t2Count + t3Count + giftCount} paid & gift subs (${(split * 100).toFixed(0)}% split)`;
      if (lblPaidSubsShare) lblPaidSubsShare.textContent = totalMonthly > 0 ? `${pPaidSubs.toFixed(1)}% of selected` : '0.0%';

      if (tilePrimeSubs) tilePrimeSubs.textContent = formatMoney(primeRev);
      if (lblPrimeSubsDetail) lblPrimeSubsDetail.textContent = `${primeCount} Prime subs at ${formatMoney(primePayout)}`;
      if (lblPrimeSubsShare) lblPrimeSubsShare.textContent = totalMonthly > 0 ? `${pPrime.toFixed(1)}% of selected` : '0.0%';

      if (tileAds) tileAds.textContent = formatMoney(adRev);
      if (lblAdsDetail) lblAdsDetail.textContent = `${totalImpressions.toLocaleString('en-US')} ad views at ${formatMoney(cpm)} CPM`;
      if (lblAdsShare) lblAdsShare.textContent = totalMonthly > 0 ? `${pAds.toFixed(1)}% of selected` : '0.0%';

      if (tileBits) tileBits.textContent = formatMoney(bitsRev);
      if (lblBitsDetail) lblBitsDetail.textContent = `${bits.toLocaleString('en-US')} Bits (${formatMoney(bitsRev)})`;
      if (lblBitsShare) lblBitsShare.textContent = totalMonthly > 0 ? `${pBits.toFixed(1)}% of selected` : '0.0%';

      if (tileTips) tileTips.textContent = formatMoney(tipsRev);
      if (lblTipsDetail) lblTipsDetail.textContent = `${formatMoney(tipsGross)} gross (-${tipFeePct.toFixed(1)}% fees)`;
      if (lblTipsShare) lblTipsShare.textContent = totalMonthly > 0 ? `${pTips.toFixed(1)}% of selected` : '0.0%';

      // Verdict card and text
      if (verdictText && verdictTitle) {
        if (totalMonthly > 0) {
          const activeChannels: { name: string; val: number; pct: number }[] = [];
          if (isSubs) {
            activeChannels.push({ name: 'Paid Subscriptions', val: paidSubsRev, pct: pPaidSubs });
            activeChannels.push({ name: 'Prime Gaming Subscriptions', val: primeRev, pct: pPrime });
          }
          if (isAds) {
            activeChannels.push({ name: 'Advertising Revenue', val: adRev, pct: pAds });
          }
          if (isBits) {
            activeChannels.push({ name: 'Bits & Cheers', val: bitsRev, pct: pBits });
            activeChannels.push({ name: 'Direct Tips & Donations', val: tipsRev, pct: pTips });
          }

          activeChannels.sort((a, b) => b.val - a.val);
          const top = activeChannels[0];

          if (activeChannels.length === 1 || (isSubs && !isAds && !isBits && activeChannels.length === 2 && activeChannels[1].val === 0)) {
            verdictTitle.textContent = 'Revenue Breakdown Summary';
            verdictText.innerHTML = `Your estimated income from <strong>${top.name}</strong> is <strong>${formatMoney(top.val)}</strong> (${formatMoney(totalAnnual)}/year), delivering an effective streaming wage of <strong>${formatMoney(hourlyWage)}/hour</strong> across ${hours} broadcast hours.`;
          } else {
            verdictTitle.textContent = 'Primary Revenue Driver';
            verdictText.innerHTML = `Among your selected sources, your primary earnings driver is <strong>${top.name}</strong>, contributing <strong>${formatMoney(top.val)}</strong> (<strong>${top.pct.toFixed(1)}%</strong> of selected monthly stream income).`;
          }
        } else {
          verdictTitle.textContent = 'Revenue Estimate';
          verdictText.innerHTML = `Enter stream metrics above to estimate your Twitch monthly revenue breakdown.`;
        }
      }

      // Legend visibility & values
      if (legItemPaid) legItemPaid.style.display = isSubs ? 'inline-flex' : 'none';
      if (legItemPrime) legItemPrime.style.display = isSubs ? 'inline-flex' : 'none';
      if (legItemAds) legItemAds.style.display = isAds ? 'inline-flex' : 'none';
      if (legItemBits) legItemBits.style.display = isBits ? 'inline-flex' : 'none';
      if (legItemTips) legItemTips.style.display = isBits ? 'inline-flex' : 'none';

      if (cPaid) cPaid.textContent = totalMonthly > 0 ? `${formatMoney(paidSubsRev)} (${pPaidSubs.toFixed(1)}%)` : formatMoney(0);
      if (cPrime) cPrime.textContent = totalMonthly > 0 ? `${formatMoney(primeRev)} (${pPrime.toFixed(1)}%)` : formatMoney(0);
      if (cAd) cAd.textContent = totalMonthly > 0 ? `${formatMoney(adRev)} (${pAds.toFixed(1)}%)` : formatMoney(0);
      if (cBits) cBits.textContent = totalMonthly > 0 ? `${formatMoney(bitsRev)} (${pBits.toFixed(1)}%)` : formatMoney(0);
      if (cTips) cTips.textContent = totalMonthly > 0 ? `${formatMoney(tipsRev)} (${pTips.toFixed(1)}%)` : formatMoney(0);

      // Stacked Bar Composition (render only active sources!)
      if (compBar) {
        if (totalMonthly > 0) {
          let barHtml = '';
          if (isSubs && pPaidSubs > 0) {
            barHtml += `<div style="width: ${pPaidSubs.toFixed(2)}%; height: 100%; background: #a855f7;" title="Paid Subscriptions: ${pPaidSubs.toFixed(1)}%"></div>`;
          }
          if (isSubs && pPrime > 0) {
            barHtml += `<div style="width: ${pPrime.toFixed(2)}%; height: 100%; background: #06b6d4;" title="Prime Subscriptions: ${pPrime.toFixed(1)}%"></div>`;
          }
          if (isAds && pAds > 0) {
            barHtml += `<div style="width: ${pAds.toFixed(2)}%; height: 100%; background: #3b82f6;" title="Ad Revenue: ${pAds.toFixed(1)}%"></div>`;
          }
          if (isBits && pBits > 0) {
            barHtml += `<div style="width: ${pBits.toFixed(2)}%; height: 100%; background: #10b981;" title="Bits & Cheers: ${pBits.toFixed(1)}%"></div>`;
          }
          if (isBits && pTips > 0) {
            barHtml += `<div style="width: ${pTips.toFixed(2)}%; height: 100%; background: #f59e0b;" title="Direct Tips: ${pTips.toFixed(1)}%"></div>`;
          }
          compBar.innerHTML = barHtml || `<div style="width: 100%; height: 100%; background: var(--color-border);"></div>`;
        } else {
          compBar.innerHTML = `<div style="width: 100%; height: 100%; background: var(--color-border);"></div>`;
        }
      }
    }

    // Trigger initial setup & calculation
    syncCardClasses();
    calculateAll();

    // Clipboard copy results handler
    window.addEventListener('copy-calculator-results', () => {
      const isSubs = chkSubs.checked;
      const isAds = chkAds.checked;
      const isBits = chkBits.checked;

      const activeNames = [
        isSubs ? 'Subscriptions' : '',
        isAds ? 'Advertising' : '',
        isBits ? 'Bits & Donations' : ''
      ].filter(Boolean).join(', ');

      let breakdownText = '';
      if (isSubs) {
        breakdownText += ` - Paid Subscriptions: ${tilePaidSubs?.textContent}\n - Prime Subscriptions: ${tilePrimeSubs?.textContent}\n`;
      }
      if (isAds) {
        breakdownText += ` - Ad Revenue: ${tileAds?.textContent}\n`;
      }
      if (isBits) {
        breakdownText += ` - Bits & Cheers: ${tileBits?.textContent}\n - Direct Tips (Net): ${tileTips?.textContent}\n`;
      }

      const text = `Twitch Stream Earnings Analysis (FinCalcLab.com):\n` +
                   `Selected Sources: ${activeNames}\n` +
                   `Est. Monthly Revenue: ${resMonthly?.textContent}\n` +
                   `Annual Run-Rate: ${lblAnnual?.textContent}\n` +
                   `Hourly Streaming Rate: ${resHourly?.textContent}\n` +
                   `Channels Breakdown:\n${breakdownText}` +
                   `Summary: ${verdictText?.textContent?.replace(/<[^>]+>/g, '')}`;
      
      navigator.clipboard.writeText(text).then(() => {
        window.dispatchEvent(new CustomEvent('calculator-copied-success'));
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initTwitchCalculator);
  document.addEventListener('astro:after-swap', initTwitchCalculator);
</script>

