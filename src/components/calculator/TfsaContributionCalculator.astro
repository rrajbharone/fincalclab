---
import CalculatorLayout from './CalculatorLayout.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
---

<CalculatorLayout
  title="TFSA Contribution Calculator (Canada)"
  description="Calculate your official Canadian TFSA contribution room, track unused carry-forward amounts, model previous-year withdrawals, and prevent over-contributions for 2026."
  category="Taxes & Retirement"
>
  <!-- Inputs Section -->
  <div slot="inputs" class="calc-inputs-wrapper" id="tfsa-root">
    <div class="input-section" style="border-top: none; padding-top: 0;">
      <h3 class="section-title">TFSA Contribution Room Details</h3>

      <!-- Tax Year Selector -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="tfsa-tax-year">Tax Year</label>
          <select id="tfsa-tax-year" class="currency-select" aria-label="Select Tax Year">
            <option value="2026" selected>2026 (Annual Limit: $7,000)</option>
            <option value="2025">2025 (Annual Limit: $7,000)</option>
            <option value="2024">2024 (Annual Limit: $7,000)</option>
            <option value="2023">2023 (Annual Limit: $6,500)</option>
            <option value="2022">2022 (Annual Limit: $6,000)</option>
            <option value="2021">2021 (Annual Limit: $6,000)</option>
            <option value="2020">2020 (Annual Limit: $6,000)</option>
            <option value="2019">2019 (Annual Limit: $6,000)</option>
          </select>
        </div>
        <span class="input-subtext">The CRA annual dollar limit is set at $7,000 for the 2026 tax year.</span>
      </div>

      <!-- Unused TFSA Contribution Room from Previous Years -->
      <div class="input-group" style="margin-top: var(--space-3);">
        <div class="input-label-row">
          <label for="tfsa-unused-val">Unused Room from Previous Years</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol">$</span>
            <input type="number" id="tfsa-unused-val" min="0" max="200000" step="1000" value="0" aria-label="Unused TFSA Contribution Room from Previous Years" />
          </div>
        </div>
        <input type="range" id="tfsa-unused-slider" min="0" max="102000" step="1000" value="0" class="slider-range" aria-label="Unused Room Slider" />
        
        <!-- Unused Room Quick Presets -->
        <div class="preset-pills-row">
          <span class="preset-label">Quick:</span>
          <button type="button" class="preset-pill active" data-unused="0">$0 (Fully Used)</button>
          <button type="button" class="preset-pill" data-unused="7000">$7k</button>
          <button type="button" class="preset-pill" data-unused="20000">$20k</button>
          <button type="button" class="preset-pill" data-unused="50000">$50k</button>
          <button type="button" class="preset-pill" data-unused="102000">$102k (Max 2025)</button>
        </div>
        <span class="input-subtext">
          Found on your latest CRA Notice of Assessment, CRA My Account online, or Form T1028. If you have never contributed and were eligible since 2009, enter $102,000.
        </span>
      </div>

      <!-- Optional Accumulated Room Estimator (Accordion) -->
      <div class="advanced-section" style="margin-top: var(--space-2); margin-bottom: var(--space-2);">
        <button type="button" class="advanced-toggle-btn" id="tfsa-estimator-toggle" aria-expanded="false" aria-controls="tfsa-estimator-panel">
          <span style="display: flex; align-items: center; gap: 8px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            Estimate Unused Room (Eligibility Helper)
          </span>
          <svg class="chevron-icon" id="tfsa-estimator-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>

        <div class="advanced-panel hidden" id="tfsa-estimator-panel">
          <p style="font-size: 0.8rem; color: var(--color-text-muted); margin: 0 0 var(--space-3) 0; line-height: 1.45;">
            TFSA room starts accumulating the year you turn 18 and are a Canadian resident (earliest start year is 2009).
          </p>
          <div class="input-group">
            <div class="input-label-row" style="font-size: 0.85rem;">
              <label for="tfsa-turned-18">Year You Turned 18</label>
              <input type="number" id="tfsa-turned-18" min="1950" max="2008" step="1" value="2009" class="currency-select" style="width: 140px; text-align: right;" aria-label="Year turned 18" />
            </div>
          </div>
          <div class="input-group" style="margin-top: var(--space-2);">
            <div class="input-label-row" style="font-size: 0.85rem;">
              <label for="tfsa-resident-year">Year You Became Canadian Resident</label>
              <input type="number" id="tfsa-resident-year" min="1950" max="2026" step="1" value="2009" class="currency-select" style="width: 140px; text-align: right;" aria-label="Year became Canadian resident" />
            </div>
            <span class="input-subtext">Leave as same year (or 2009) if you were already a resident when turning 18.</span>
          </div>
          <div class="input-group" style="margin-top: var(--space-2);">
            <div class="input-label-row" style="font-size: 0.85rem;">
              <label for="tfsa-past-contribs">Total Past Deposits (All Prior Years)</label>
              <div class="input-symbol-wrapper" style="width: 140px;">
                <span class="currency-symbol">$</span>
                <input type="number" id="tfsa-past-contribs" min="0" max="200000" step="1000" value="0" aria-label="Total Past Contributions" />
              </div>
            </div>
          </div>
          <div style="margin-top: var(--space-3);">
            <Button variant="secondary" size="sm" id="tfsa-apply-estimate-btn" class="w-full">
              Calculate &amp; Apply to Unused Room
            </Button>
          </div>
        </div>
      </div>

      <!-- TFSA Withdrawals Made in Previous Year -->
      <div class="input-group" style="margin-top: var(--space-3);">
        <div class="input-label-row">
          <label for="tfsa-withdrawals-val">TFSA Withdrawals in Previous Year (2025)</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol">$</span>
            <input type="number" id="tfsa-withdrawals-val" min="0" max="200000" step="500" value="0" aria-label="TFSA Withdrawals Made in Previous Year" />
          </div>
        </div>
        
        <!-- Withdrawals Quick Presets -->
        <div class="preset-pills-row">
          <span class="preset-label">Quick:</span>
          <button type="button" class="preset-pill active" data-withdrawal="0">$0</button>
          <button type="button" class="preset-pill" data-withdrawal="1000">$1k</button>
          <button type="button" class="preset-pill" data-withdrawal="2500">$2.5k</button>
          <button type="button" class="preset-pill" data-withdrawal="5000">$5k</button>
          <button type="button" class="preset-pill" data-withdrawal="10000">$10k</button>
        </div>
        <span class="input-subtext">
          Withdrawals made during the previous calendar year are added back to your contribution room on January 1 of the current tax year.
        </span>
      </div>

      <!-- Contributions Already Made This Year -->
      <div class="input-group" style="margin-top: var(--space-3);">
        <div class="input-label-row">
          <label for="tfsa-already-val">Contributions Already Made This Year (2026)</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol">$</span>
            <input type="number" id="tfsa-already-val" min="0" max="200000" step="500" value="0" aria-label="Contributions Already Made This Year" />
          </div>
        </div>
        
        <!-- Already Contributed Presets -->
        <div class="preset-pills-row">
          <span class="preset-label">Quick:</span>
          <button type="button" class="preset-pill active" data-already="0">$0</button>
          <button type="button" class="preset-pill" data-already="1000">$1k</button>
          <button type="button" class="preset-pill" data-already="2500">$2.5k</button>
          <button type="button" class="preset-pill" data-already="5000">$5k</button>
          <button type="button" class="preset-pill" data-already="7000">$7k (Full Limit)</button>
        </div>
        <span class="input-subtext">
          Any contributions you have already deposited into any of your TFSA accounts during the current year.
        </span>
      </div>

      <!-- Planned TFSA Contribution -->
      <div class="input-group" style="margin-top: var(--space-3);">
        <div class="input-label-row">
          <label for="tfsa-planned-val">Planned TFSA Contribution</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol">$</span>
            <input type="number" id="tfsa-planned-val" min="0" max="200000" step="500" value="7000" aria-label="Planned TFSA Contribution Amount" />
          </div>
        </div>
        <input type="range" id="tfsa-planned-slider" min="0" max="25000" step="500" value="7000" class="slider-range" aria-label="Planned Contribution Slider" />
        
        <!-- Planned Quick Presets -->
        <div class="preset-pills-row">
          <span class="preset-label">Quick:</span>
          <button type="button" class="preset-pill" data-planned="1000">$1k</button>
          <button type="button" class="preset-pill" data-planned="3000">$3k</button>
          <button type="button" class="preset-pill" data-planned="5000">$5k</button>
          <button type="button" class="preset-pill active" data-planned="7000">$7k</button>
          <button type="button" class="preset-pill" data-planned="max">Match Room</button>
        </div>
        <span class="input-subtext">The amount you intend to deposit into your TFSA before year-end.</span>
      </div>

      <div style="margin-top: var(--space-4);">
        <Button variant="secondary" size="sm" id="tfsa-reset-btn" class="w-full">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          Reset Calculator
        </Button>
      </div>
    </div>
  </div>

  <!-- Results Section -->
  <div slot="results" class="calc-results-wrapper">

    <!-- Primary Hero Card: Available TFSA Contribution Room -->
    <Card elevation="md" class="primary-hero-card">
      <div class="hero-top-row">
        <span class="hero-label">Available TFSA Contribution Room</span>
        <span class="hero-badge" id="tfsa-hero-badge">Eligible to Contribute</span>
      </div>
      <div class="hero-main-metric" id="tfsa-hero-room">$7,000.00</div>
      <p class="hero-subtext" id="tfsa-hero-sub">
        Total maximum allowable deposit for 2026
      </p>

      <!-- Sub-Hero: Remaining Room After Planned Contribution -->
      <div class="sub-hero-container">
        <div class="sub-hero-label" id="tfsa-subhero-label">Remaining Room After Planned Contribution</div>
        <div class="sub-hero-val" id="tfsa-hero-remaining">$0.00</div>
        <p class="sub-hero-subtext" id="tfsa-hero-remaining-sub">
          Contribution room remaining after your $7,000 deposit
        </p>
      </div>
    </Card>

    <!-- Visual Calculation Breakdown Flow -->
    <div class="flow-card">
      <div class="flow-header">
        <span class="flow-title">How CRA Calculates Your 2026 Room</span>
      </div>
      <div class="step-flow-grid">
        <div class="step-tile">
          <div class="step-desc">2026 Limit</div>
          <div class="step-val text-primary" id="flow-limit">$7,000</div>
        </div>
        <div class="step-op">+</div>
        <div class="step-tile">
          <div class="step-desc">Unused Room</div>
          <div class="step-val" id="flow-unused">$0</div>
        </div>
        <div class="step-op">+</div>
        <div class="step-tile">
          <div class="step-desc">2025 Withdrawals</div>
          <div class="step-val text-success" id="flow-withdrawals">$0</div>
        </div>
        <div class="step-op">−</div>
        <div class="step-tile">
          <div class="step-desc">2026 Deposits</div>
          <div class="step-val text-danger" id="flow-already">$0</div>
        </div>
        <div class="step-op">=</div>
        <div class="step-tile highlight-step">
          <div class="step-desc">Available Room</div>
          <div class="step-val text-success" id="flow-available">$7,000</div>
        </div>
      </div>
    </div>

    <!-- Over-Contribution Alert Banner -->
    <div id="tfsa-over-alert" class="status-banner hidden">
      <div class="status-banner-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      </div>
      <div class="status-banner-content" id="tfsa-over-msg">
        <!-- Dynamically injected warning message -->
      </div>
    </div>

    <!-- Critical Withdrawal Timing Notice -->
    <div class="status-banner info-banner">
      <div class="status-banner-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
      </div>
      <div class="status-banner-content">
        <strong>Important CRA Withdrawal Rule:</strong> Withdrawals made in the <em>current</em> calendar year (2026) do <strong>not</strong> create new room immediately. Withdrawn amounts are added back to your room on <strong>January 1 of the following year (2027)</strong>. Re-contributing withdrawn money in the same year without sufficient available room will cause an over-contribution penalty.
      </div>
    </div>

    <!-- Detailed Metrics Grid (Rule 15 Responsive) -->
    <div class="metrics-grid">
      <div class="metric-tile">
        <span class="metric-label">Current-Year Limit</span>
        <span class="metric-val text-primary" id="metric-limit">$7,000.00</span>
        <span class="metric-sub" id="metric-limit-sub">Official 2026 CRA limit</span>
      </div>

      <div class="metric-tile">
        <span class="metric-label">Unused Room Carried Forward</span>
        <span class="metric-val" id="metric-unused">$0.00</span>
        <span class="metric-sub">From prior eligible years</span>
      </div>

      <div class="metric-tile">
        <span class="metric-label">Previous-Year Withdrawals</span>
        <span class="metric-val text-success" id="metric-withdrawals">$0.00</span>
        <span class="metric-sub">Re-added on Jan 1, 2026</span>
      </div>

      <div class="metric-tile">
        <span class="metric-label">Deposited Already This Year</span>
        <span class="metric-val text-danger" id="metric-already">$0.00</span>
        <span class="metric-sub">Prior 2026 contributions</span>
      </div>

      <div class="metric-tile highlight-tile">
        <span class="metric-label">Available Contribution Room</span>
        <span class="metric-val text-success" id="metric-available">$7,000.00</span>
        <span class="metric-sub">Net room before planned</span>
      </div>

      <div class="metric-tile">
        <span class="metric-label">Planned Contribution</span>
        <span class="metric-val" id="metric-planned">$7,000.00</span>
        <span class="metric-sub">Intended deposit</span>
      </div>

      <div class="metric-tile">
        <span class="metric-label">Remaining Room</span>
        <span class="metric-val" id="metric-remaining">$0.00</span>
        <span class="metric-sub" id="metric-remaining-sub">Room left after planned deposit</span>
      </div>

      <div class="metric-tile" id="metric-over-tile">
        <span class="metric-label">Over-Contribution Amount</span>
        <span class="metric-val" id="metric-over">$0.00</span>
        <span class="metric-sub" id="metric-over-sub">Within CRA limit</span>
      </div>
    </div>

    <!-- Plain-English Verdict & CRA Statutory Disclaimer -->
    <div class="verdict-container" style="margin-top: var(--space-2);">
      <Card elevation="sm" class="verdict-card verdict-info">
        <div class="verdict-header">
          <div class="verdict-badge">CRA Guidance</div>
          <span class="verdict-title" id="tfsa-verdict-title">TFSA Contribution Summary</span>
        </div>
        <p class="verdict-desc" id="tfsa-verdict-desc">
          Your available 2026 TFSA contribution room is <strong>$7,000.00</strong>. Making your planned deposit of <strong>$7,000.00</strong> will fully utilize your room, leaving <strong>$0.00</strong> in remaining contribution room.
        </p>
        <p class="verdict-disclaimer">
          This calculator provides an estimate based on the information entered. Your official TFSA contribution room can be affected by your complete TFSA transaction history and CRA records. Users should verify their available room using their own financial records and their CRA account before contributing.
        </p>
      </Card>
    </div>

  </div>
</CalculatorLayout>

<script>
  function initTfsaContributionCalculator() {
    // Official CRA Annual TFSA Dollar Limits (2009–2026)
    const TFSA_LIMITS: Record<number, number> = {
      2009: 5000,
      2010: 5000,
      2011: 5000,
      2012: 5000,
      2013: 5500,
      2014: 5500,
      2015: 10000,
      2016: 5500,
      2017: 5500,
      2018: 5500,
      2019: 6000,
      2020: 6000,
      2021: 6000,
      2022: 6000,
      2023: 6500,
      2024: 7000,
      2025: 7000,
      2026: 7000
    };

    const root = document.getElementById('tfsa-root');
    if (!root) return;

    // Inputs
    const taxYearSelect  = document.getElementById('tfsa-tax-year') as HTMLSelectElement;
    const unusedInput    = document.getElementById('tfsa-unused-val') as HTMLInputElement;
    const unusedSlider   = document.getElementById('tfsa-unused-slider') as HTMLInputElement;
    const withdrawInput  = document.getElementById('tfsa-withdrawals-val') as HTMLInputElement;
    const alreadyInput   = document.getElementById('tfsa-already-val') as HTMLInputElement;
    const plannedInput   = document.getElementById('tfsa-planned-val') as HTMLInputElement;
    const plannedSlider  = document.getElementById('tfsa-planned-slider') as HTMLInputElement;
    const resetBtn       = document.getElementById('tfsa-reset-btn') as HTMLButtonElement;

    // Estimator accordion inputs
    const estimatorToggle = document.getElementById('tfsa-estimator-toggle') as HTMLButtonElement;
    const estimatorPanel  = document.getElementById('tfsa-estimator-panel') as HTMLElement;
    const estimatorChevron= document.getElementById('tfsa-estimator-chevron') as HTMLElement;
    const turned18Input   = document.getElementById('tfsa-turned-18') as HTMLInputElement;
    const residentInput   = document.getElementById('tfsa-resident-year') as HTMLInputElement;
    const pastContribsInput= document.getElementById('tfsa-past-contribs') as HTMLInputElement;
    const applyEstimateBtn= document.getElementById('tfsa-apply-estimate-btn') as HTMLButtonElement;

    // Outputs
    const heroRoom       = document.getElementById('tfsa-hero-room') as HTMLElement;
    const heroBadge      = document.getElementById('tfsa-hero-badge') as HTMLElement;
    const heroSub        = document.getElementById('tfsa-hero-sub') as HTMLElement;
    const subHeroLabel   = document.getElementById('tfsa-subhero-label') as HTMLElement;
    const heroRemaining  = document.getElementById('tfsa-hero-remaining') as HTMLElement;
    const heroRemainingSub = document.getElementById('tfsa-hero-remaining-sub') as HTMLElement;

    // Flow
    const flowLimit      = document.getElementById('flow-limit') as HTMLElement;
    const flowUnused     = document.getElementById('flow-unused') as HTMLElement;
    const flowWithdrawals= document.getElementById('flow-withdrawals') as HTMLElement;
    const flowAlready    = document.getElementById('flow-already') as HTMLElement;
    const flowAvailable  = document.getElementById('flow-available') as HTMLElement;

    // Alert
    const overAlert      = document.getElementById('tfsa-over-alert') as HTMLElement;
    const overMsg        = document.getElementById('tfsa-over-msg') as HTMLElement;

    // Metrics
    const metricLimit    = document.getElementById('metric-limit') as HTMLElement;
    const metricLimitSub = document.getElementById('metric-limit-sub') as HTMLElement;
    const metricUnused   = document.getElementById('metric-unused') as HTMLElement;
    const metricWithdrawals = document.getElementById('metric-withdrawals') as HTMLElement;
    const metricAlready  = document.getElementById('metric-already') as HTMLElement;
    const metricAvailable= document.getElementById('metric-available') as HTMLElement;
    const metricPlanned  = document.getElementById('metric-planned') as HTMLElement;
    const metricRemaining= document.getElementById('metric-remaining') as HTMLElement;
    const metricRemainingSub = document.getElementById('metric-remaining-sub') as HTMLElement;
    const metricOver     = document.getElementById('metric-over') as HTMLElement;
    const metricOverSub  = document.getElementById('metric-over-sub') as HTMLElement;

    // Verdict
    const verdictTitle   = document.getElementById('tfsa-verdict-title') as HTMLElement;
    const verdictDesc    = document.getElementById('tfsa-verdict-desc') as HTMLElement;

    function fmt(val: number): string {
      const absVal = Math.abs(val);
      const str = absVal.toLocaleString('en-CA', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
      return `${val < 0 ? '-' : ''}$${str}`;
    }

    function updateCalculation() {
      const year = parseInt(taxYearSelect.value, 10) || 2026;
      const currentLimit = TFSA_LIMITS[year] || 7000;

      const unusedRoom = Math.max(0, parseFloat(unusedInput.value) || 0);
      const prevWithdrawals = Math.max(0, parseFloat(withdrawInput.value) || 0);
      const alreadyContributed = Math.max(0, parseFloat(alreadyInput.value) || 0);
      const plannedContrib = Math.max(0, parseFloat(plannedInput.value) || 0);

      // Core formula
      const availableRoom = currentLimit + unusedRoom + prevWithdrawals - alreadyContributed;
      const netAfterPlanned = availableRoom - plannedContrib;
      const remainingRoom = Math.max(0, netAfterPlanned);
      const overContribution = netAfterPlanned < 0 ? Math.abs(netAfterPlanned) : 0;
      const isOver = overContribution > 0;

      // Update Hero Card
      heroRoom.textContent = fmt(availableRoom);
      heroSub.textContent = `Total allowable deposit for ${year}`;

      if (isOver) {
        heroBadge.textContent = 'Over-Contribution Warning';
        heroBadge.style.backgroundColor = 'rgba(239, 68, 68, 0.15)';
        heroBadge.style.color = 'var(--color-danger, #ef4444)';

        subHeroLabel.textContent = 'Estimated Over-Contribution';
        subHeroLabel.style.color = 'var(--color-danger, #ef4444)';
        heroRemaining.textContent = fmt(overContribution);
        heroRemaining.style.color = 'var(--color-danger, #ef4444)';
        heroRemainingSub.textContent = `Deposit exceeds available room by ${fmt(overContribution)}`;
      } else {
        heroBadge.textContent = remainingRoom === 0 ? 'Room Fully Utilized' : 'Eligible to Contribute';
        heroBadge.style.backgroundColor = 'var(--color-success-subtle, rgba(16, 185, 129, 0.1))';
        heroBadge.style.color = 'var(--color-success, #10b981)';

        subHeroLabel.textContent = 'Remaining Room After Planned Contribution';
        subHeroLabel.style.color = 'var(--color-text-muted)';
        heroRemaining.textContent = fmt(remainingRoom);
        heroRemaining.style.color = 'var(--color-primary)';
        heroRemainingSub.textContent = `Contribution room remaining after your ${fmt(plannedContrib)} deposit`;
      }

      // Update Flow
      flowLimit.textContent = `$${currentLimit.toLocaleString('en-CA')}`;
      flowUnused.textContent = `$${Math.round(unusedRoom).toLocaleString('en-CA')}`;
      flowWithdrawals.textContent = `$${Math.round(prevWithdrawals).toLocaleString('en-CA')}`;
      flowAlready.textContent = `$${Math.round(alreadyContributed).toLocaleString('en-CA')}`;
      flowAvailable.textContent = fmt(availableRoom);

      // Update Metrics Grid
      metricLimit.textContent = fmt(currentLimit);
      metricLimitSub.textContent = `Official ${year} CRA annual limit`;
      metricUnused.textContent = fmt(unusedRoom);
      metricWithdrawals.textContent = fmt(prevWithdrawals);
      metricAlready.textContent = fmt(alreadyContributed);
      metricAvailable.textContent = fmt(availableRoom);
      metricPlanned.textContent = fmt(plannedContrib);
      metricRemaining.textContent = fmt(remainingRoom);
      metricRemainingSub.textContent = isOver ? 'No room remaining' : 'Room available after deposit';

      metricOver.textContent = fmt(overContribution);
      if (isOver) {
        metricOver.style.color = 'var(--color-danger, #ef4444)';
        metricOverSub.textContent = 'Subject to CRA 1%/mo tax';
        metricOverSub.style.color = 'var(--color-danger, #ef4444)';
      } else {
        metricOver.style.color = 'var(--color-text)';
        metricOverSub.textContent = 'Within CRA limit';
        metricOverSub.style.color = 'var(--color-text-muted)';
      }

      // Over-Contribution Alert Banner
      if (isOver) {
        overAlert.classList.remove('hidden');
        overMsg.innerHTML = `<strong>Warning: Over-Contribution of ${fmt(overContribution)} detected.</strong> Your planned contribution of <strong>${fmt(plannedContrib)}</strong> exceeds your available room of <strong>${fmt(availableRoom)}</strong>. Under CRA rules, excess TFSA contributions are subject to a <strong>1% per month penalty tax</strong> on the highest excess amount each month until withdrawn or absorbed by new room.`;
      } else {
        overAlert.classList.add('hidden');
      }

      // Verdict Description
      if (isOver) {
        verdictTitle.textContent = 'TFSA Over-Contribution Warning';
        verdictDesc.innerHTML = `Your available ${year} TFSA room is <strong>${fmt(availableRoom)}</strong>. Contributing <strong>${fmt(plannedContrib)}</strong> results in an estimated over-contribution of <strong>${fmt(overContribution)}</strong>. To prevent CRA penalty taxes of 1% per month, reduce your deposit to no more than <strong>${fmt(availableRoom)}</strong>.`;
      } else if (remainingRoom === 0) {
        verdictTitle.textContent = 'TFSA Room Fully Maximized';
        verdictDesc.innerHTML = `Your available ${year} TFSA contribution room is <strong>${fmt(availableRoom)}</strong>. Making your planned deposit of <strong>${fmt(plannedContrib)}</strong> will fully utilize your available room, leaving <strong>$0.00</strong> in remaining room.`;
      } else {
        verdictTitle.textContent = 'TFSA Contribution Summary';
        verdictDesc.innerHTML = `Your available ${year} TFSA contribution room is <strong>${fmt(availableRoom)}</strong>. Making your planned deposit of <strong>${fmt(plannedContrib)}</strong> leaves you with <strong>${fmt(remainingRoom)}</strong> in unused room to invest tax-free.`;
      }
    }

    // Input events
    unusedInput.addEventListener('input', () => {
      unusedSlider.value = unusedInput.value;
      updateCalculation();
    });
    unusedSlider.addEventListener('input', () => {
      unusedInput.value = unusedSlider.value;
      updateCalculation();
    });

    withdrawInput.addEventListener('input', updateCalculation);
    alreadyInput.addEventListener('input', updateCalculation);

    plannedInput.addEventListener('input', () => {
      plannedSlider.value = plannedInput.value;
      updateCalculation();
    });
    plannedSlider.addEventListener('input', () => {
      plannedInput.value = plannedSlider.value;
      updateCalculation();
    });

    taxYearSelect.addEventListener('change', () => {
      const yr = parseInt(taxYearSelect.value, 10) || 2026;
      const limit = TFSA_LIMITS[yr] || 7000;
      plannedInput.value = String(limit);
      plannedSlider.value = String(limit);
      updateCalculation();
    });

    // Preset Buttons
    root.querySelectorAll('.preset-pill').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const unusedVal = target.getAttribute('data-unused');
        const withdrawalVal = target.getAttribute('data-withdrawal');
        const alreadyVal = target.getAttribute('data-already');
        const plannedVal = target.getAttribute('data-planned');

        if (unusedVal !== null) {
          unusedInput.value = unusedVal;
          unusedSlider.value = unusedVal;
          target.parentElement?.querySelectorAll('.preset-pill').forEach(p => p.classList.remove('active'));
          target.classList.add('active');
        } else if (withdrawalVal !== null) {
          withdrawInput.value = withdrawalVal;
          target.parentElement?.querySelectorAll('.preset-pill').forEach(p => p.classList.remove('active'));
          target.classList.add('active');
        } else if (alreadyVal !== null) {
          alreadyInput.value = alreadyVal;
          target.parentElement?.querySelectorAll('.preset-pill').forEach(p => p.classList.remove('active'));
          target.classList.add('active');
        } else if (plannedVal !== null) {
          if (plannedVal === 'max') {
            const yr = parseInt(taxYearSelect.value, 10) || 2026;
            const currentLimit = TFSA_LIMITS[yr] || 7000;
            const u = Math.max(0, parseFloat(unusedInput.value) || 0);
            const w = Math.max(0, parseFloat(withdrawInput.value) || 0);
            const a = Math.max(0, parseFloat(alreadyInput.value) || 0);
            const avail = Math.max(0, currentLimit + u + w - a);
            plannedInput.value = String(avail);
            plannedSlider.value = String(avail);
          } else {
            plannedInput.value = plannedVal;
            plannedSlider.value = plannedVal;
          }
          target.parentElement?.querySelectorAll('.preset-pill').forEach(p => p.classList.remove('active'));
          target.classList.add('active');
        }
        updateCalculation();
      });
    });

    // Estimator accordion
    estimatorToggle.addEventListener('click', () => {
      const isExpanded = estimatorToggle.getAttribute('aria-expanded') === 'true';
      estimatorToggle.setAttribute('aria-expanded', String(!isExpanded));
      estimatorPanel.classList.toggle('hidden');
      estimatorChevron.classList.toggle('rotated');
    });

    applyEstimateBtn.addEventListener('click', () => {
      const turned18 = parseInt(turned18Input.value, 10) || 2009;
      const resident = parseInt(residentInput.value, 10) || 2009;
      const targetYear = parseInt(taxYearSelect.value, 10) || 2026;
      const pastContribs = Math.max(0, parseFloat(pastContribsInput.value) || 0);

      // Prior years room (from start year up to prior year targetYear - 1)
      const effectiveStart = Math.max(2009, Math.max(turned18, resident));
      let cumulativePrior = 0;
      for (let y = effectiveStart; y < targetYear; y++) {
        if (TFSA_LIMITS[y]) {
          cumulativePrior += TFSA_LIMITS[y];
        }
      }

      const calculatedUnused = Math.max(0, cumulativePrior - pastContribs);
      unusedInput.value = String(calculatedUnused);
      unusedSlider.value = String(calculatedUnused);

      // Reset unused preset pills
      root.querySelectorAll('[data-unused]').forEach(p => p.classList.remove('active'));

      updateCalculation();

      // Close panel
      estimatorToggle.setAttribute('aria-expanded', 'false');
      estimatorPanel.classList.add('hidden');
      estimatorChevron.classList.remove('rotated');
    });

    // Reset Button
    resetBtn.addEventListener('click', () => {
      taxYearSelect.value = '2026';
      unusedInput.value = '0';
      unusedSlider.value = '0';
      withdrawInput.value = '0';
      alreadyInput.value = '0';
      plannedInput.value = '7000';
      plannedSlider.value = '7000';

      root.querySelectorAll('.preset-pill').forEach(p => p.classList.remove('active'));
      root.querySelector('[data-unused="0"]')?.classList.add('active');
      root.querySelector('[data-withdrawal="0"]')?.classList.add('active');
      root.querySelector('[data-already="0"]')?.classList.add('active');
      root.querySelector('[data-planned="7000"]')?.classList.add('active');

      updateCalculation();
    });

    // Initial run
    updateCalculation();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTfsaContributionCalculator);
  } else {
    initTfsaContributionCalculator();
  }
</script>

