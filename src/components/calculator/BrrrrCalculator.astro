    // Formatting Helpers
    function getSym() {
      return currencyConfigs[activeCurrency]?.symbol || '$';
    }

    function formatCurrency(val) {
      if (val === Infinity || val === null || isNaN(val)) return '—';
      const cfg = currencyConfigs[activeCurrency] || currencyConfigs.USD;
      return new Intl.NumberFormat(cfg.locale, {
        style: 'currency',
        currency: cfg.code,
        minimumFractionDigits: 0,
        maximumFractionDigits: 0
      }).format(Math.round(val));
    }

    // Input Synchronization
    function syncInput(inputEl, sliderEl) {
      if (!inputEl || !sliderEl) return;
      inputEl.addEventListener('input', () => {
        sliderEl.value = inputEl.value;
        recalculate();
      });
      sliderEl.addEventListener('input', () => {
        inputEl.value = sliderEl.value;
        recalculate();
      });
    }

    syncInput(purchasePriceInput, purchasePriceSlider);
    syncInput(rehabCostInput, rehabCostSlider);
    syncInput(purchaseClosingInput, purchaseClosingSlider);
    syncInput(monthlyHoldingInput, monthlyHoldingSlider);
    syncInput(refiMonthsInput, refiMonthsSlider);
    syncInput(arvInput, arvSlider);
    syncInput(monthlyRentInput, monthlyRentSlider);
    syncInput(monthlyExpensesInput, monthlyExpensesSlider);
    syncInput(initRateInput, initRateSlider);
    syncInput(refiLtvInput, refiLtvSlider);
    syncInput(refiClosingInput, refiClosingSlider);
    syncInput(refiRateInput, refiRateSlider);

    // Down Payment % and $ sync
    let isUpdatingDp = false;

    if (downPctInput && downPctSlider && downAmtInput && purchasePriceInput) {
      downPctInput.addEventListener('input', () => {
        if (isUpdatingDp) return;
        isUpdatingDp = true;
        downPctSlider.value = downPctInput.value;
        const price = Math.max(0, parseFloat(purchasePriceInput.value) || 0);
        const pct = Math.max(0, Math.min(100, parseFloat(downPctInput.value) || 0));
        downAmtInput.value = Math.round(price * (pct / 100));
        isUpdatingDp = false;
        recalculate();
      });

      downPctSlider.addEventListener('input', () => {
        if (isUpdatingDp) return;
        isUpdatingDp = true;
        downPctInput.value = downPctSlider.value;
        const price = Math.max(0, parseFloat(purchasePriceInput.value) || 0);
        const pct = Math.max(0, Math.min(100, parseFloat(downPctSlider.value) || 0));
        downAmtInput.value = Math.round(price * (pct / 100));
        isUpdatingDp = false;
        recalculate();
      });

      downAmtInput.addEventListener('input', () => {
        if (isUpdatingDp) return;
        isUpdatingDp = true;
        const price = Math.max(1, parseFloat(purchasePriceInput.value) || 1);
        const amt = Math.max(0, parseFloat(downAmtInput.value) || 0);
        const pct = Math.min(100, (amt / price) * 100);
        downPctInput.value = pct.toFixed(1);
        downPctSlider.value = pct.toFixed(1);
        isUpdatingDp = false;
        recalculate();
      });

      purchasePriceInput.addEventListener('input', () => {
        if (isUpdatingDp) return;
        isUpdatingDp = true;
        const price = Math.max(0, parseFloat(purchasePriceInput.value) || 0);
        const pct = Math.max(0, Math.min(100, parseFloat(downPctInput.value) || 0));
        downAmtInput.value = Math.round(price * (pct / 100));
        isUpdatingDp = false;
      });

      purchasePriceSlider.addEventListener('input', () => {
        if (isUpdatingDp) return;
        isUpdatingDp = true;
        const price = Math.max(0, parseFloat(purchasePriceSlider.value) || 0);
        const pct = Math.max(0, Math.min(100, parseFloat(downPctInput.value) || 0));
        downAmtInput.value = Math.round(price * (pct / 100));
        isUpdatingDp = false;
      });
    }

    if (initLoanTypeSelect) {
      initLoanTypeSelect.addEventListener('change', recalculate);
    }
    if (refiTermSelect) {
      refiTermSelect.addEventListener('change', recalculate);
    }

    // Currency Switcher
    if (curSelect) {
      curSelect.addEventListener('change', (e) => {
        activeCurrency = e.target.value;
        const sym = getSym();
        document.querySelectorAll('.currency-symbol').forEach(el => {
          el.textContent = sym;
        });
        recalculate();
      });
    }

    // Reset Defaults
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        purchasePriceInput.value = '150000';
        purchasePriceSlider.value = '150000';
        downPctInput.value = '20';
        downPctSlider.value = '20';
        downAmtInput.value = '30000';
        rehabCostInput.value = '40000';
        rehabCostSlider.value = '40000';
        purchaseClosingInput.value = '4000';
        purchaseClosingSlider.value = '4000';
        monthlyHoldingInput.value = '1000';
        monthlyHoldingSlider.value = '1000';
        refiMonthsInput.value = '6';
