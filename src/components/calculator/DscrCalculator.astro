---
import CalculatorLayout from './CalculatorLayout.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
---

<CalculatorLayout
  title="DSCR Calculator"
  description="Calculate your Debt Service Coverage Ratio (DSCR) for rental properties and commercial real estate. Compare Net Operating Income (NOI) against total debt payments to assess cash flow and lending qualification."
  category="Real Estate & Mortgages"
>
  <!-- Inputs Section -->
  <div slot="inputs" class="calc-inputs-wrapper" id="dscr-calculator">
    
    <!-- 1. Currency & Global Settings -->
    <div class="input-section-header">
      <h3 class="input-section-title">Calculator Settings</h3>
    </div>
    
    <div class="input-group">
      <div class="input-label-row">
        <label for="dscr-currency-select">Currency</label>
        <select id="dscr-currency-select" class="currency-select" aria-label="Select Currency">
          <option value="USD" selected>USD ($) - US Dollar</option>
          <option value="EUR">EUR (€) - Euro</option>
          <option value="GBP">GBP (£) - British Pound</option>
          <option value="CAD">CAD (C$) - Canadian Dollar</option>
          <option value="AUD">AUD (A$) - Australian Dollar</option>
          <option value="INR">INR (₹) - Indian Rupee</option>
          <option value="JPY">JPY (¥) - Japanese Yen</option>
          <option value="SGD">SGD (S$) - Singapore Dollar</option>
          <option value="CHF">CHF (CHF) - Swiss Franc</option>
        </select>
      </div>
    </div>

    <!-- 2. Income and Operating Expenses -->
    <div class="input-section-header" style="margin-top: var(--space-4);">
      <h3 class="input-section-title">1. Property Income &amp; Operating Expenses</h3>
    </div>

    <!-- Annual Rental Income -->
    <div class="input-group">
      <div class="input-label-row">
        <div class="label-with-subtext">
          <label for="dscr-gross-rent-input">Annual Rental / Property Income</label>
          <span class="field-subtext">Total tenant rents collected over 12 months</span>
        </div>
        <div class="input-symbol-wrapper">
          <span class="currency-symbol">$</span>
          <input 
            type="number" 
            id="dscr-gross-rent-input" 
            min="0" 
            step="1000" 
            value="150000" 
            aria-label="Annual Rental Property Income" 
          />
        </div>
      </div>
      <input 
        type="range" 
        id="dscr-gross-rent-slider" 
        min="0" 
        max="500000" 
        step="2500" 
        value="150000" 
        class="slider-range" 
        aria-label="Annual Rental Income Slider" 
      />
    </div>

    <!-- Annual Operating Expenses -->
    <div class="input-group">
      <div class="input-label-row">
        <div class="label-with-subtext">
          <label for="dscr-expenses-input">Annual Operating Expenses</label>
          <span class="field-subtext">Property taxes, insurance, repairs, and management (<strong>excl. mortgage</strong>)</span>
        </div>
        <div class="input-symbol-wrapper">
          <span class="currency-symbol">$</span>
          <input 
            type="number" 
            id="dscr-expenses-input" 
            min="0" 
            step="1000" 
            value="30000" 
            aria-label="Annual Operating Expenses" 
          />
        </div>
      </div>
      <input 
        type="range" 
        id="dscr-expenses-slider" 
        min="0" 
        max="200000" 
        step="1000" 
        value="30000" 
        class="slider-range" 
        aria-label="Annual Operating Expenses Slider" 
      />
    </div>

    <!-- NOI Live Subtotal Badge -->
    <div class="subtotal-strip">
      <span class="subtotal-label">Net Operating Income (NOI):</span>
      <span class="subtotal-val" id="subtotal-noi-val">$120,000.00</span>
    </div>

    <!-- 3. Annual Debt Service Obligations -->
    <div class="input-section-header" style="margin-top: var(--space-4);">
      <h3 class="input-section-title">2. Annual Loan Payments (Debt Service)</h3>
    </div>

    <!-- Annual Principal Payments -->
    <div class="input-group">
      <div class="input-label-row">
        <div class="label-with-subtext">
          <label for="dscr-principal-input">Annual Principal Payments</label>
          <span class="field-subtext">Portion of 12-month loan payments reducing loan balance</span>
        </div>
        <div class="input-symbol-wrapper">
          <span class="currency-symbol">$</span>
          <input 
            type="number" 
            id="dscr-principal-input" 
            min="0" 
            step="500" 
            value="35000" 
            aria-label="Annual Principal Payments" 
          />
        </div>
      </div>
      <input 
        type="range" 
        id="dscr-principal-slider" 
        min="0" 
        max="150000" 
        step="1000" 
        value="35000" 
        class="slider-range" 
        aria-label="Annual Principal Slider" 
      />
    </div>

    <!-- Annual Interest Payments -->
    <div class="input-group">
      <div class="input-label-row">
        <div class="label-with-subtext">
          <label for="dscr-interest-input">Annual Interest Payments</label>
          <span class="field-subtext">Total mortgage interest charges paid across 12 months</span>
        </div>
        <div class="input-symbol-wrapper">
          <span class="currency-symbol">$</span>
          <input 
            type="number" 
            id="dscr-interest-input" 
            min="0" 
            step="500" 
            value="45000" 
            aria-label="Annual Interest Payments" 
          />
        </div>
      </div>
      <input 
        type="range" 
        id="dscr-interest-slider" 
        min="0" 
        max="150000" 
        step="1000" 
        value="45000" 
        class="slider-range" 
        aria-label="Annual Interest Slider" 
      />
    </div>

    <!-- Debt Service Live Subtotal Badge -->
    <div class="subtotal-strip debt-strip">
      <span class="subtotal-label">Total Annual Debt Service:</span>
      <span class="subtotal-val debt-text" id="subtotal-debt-val">$80,000.00</span>
    </div>

    <!-- Reset Action -->
    <div class="inputs-actions" style="margin-top: var(--space-6);">
      <Button id="dscr-reset-btn" variant="outline" size="sm" style="width: 100%;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
        Reset to Default Example
      </Button>
    </div>
  </div>

  <!-- Results Section -->
  <div slot="results" class="calc-results-wrapper">
    <div class="results-header">
      <h2 class="results-title">DSCR Calculation Results</h2>
      <span class="results-subtitle">Coverage evaluation and net cash flow analysis</span>
    </div>

    <!-- Hero Result Card: Primary DSCR Metric -->
    <div class="dscr-hero-card" id="dscr-hero-card">
      <div class="hero-top-row">
        <span class="hero-label">Debt Service Coverage Ratio</span>
        <span class="status-badge badge-success" id="dscr-status-badge">Strong Coverage</span>
      </div>
      <div class="hero-main-row">
        <div class="hero-ratio-display" id="res-dscr-val">1.50x</div>
        <div class="hero-equation" id="lbl-dscr-equation">
          <span class="eq-item">NOI: <strong id="eq-noi-val">$120,000</strong></span>
          <span class="eq-divider">÷</span>
          <span class="eq-item">Debt: <strong id="eq-debt-val">$80,000</strong></span>
        </div>
      </div>
    </div>

    <!-- 4-Tile Organized Summary Grid -->
    <div class="summary-tiles-grid">
      <!-- 1. Net Operating Income (NOI) -->
      <div class="summary-tile">
        <span class="tile-label">Net Operating Income (NOI)</span>
        <div class="tile-amount text-positive" id="tile-noi">$120,000</div>
        <span class="tile-caption" id="tile-noi-caption">Income ($150k) − Expenses ($30k)</span>
      </div>

      <!-- 2. Total Annual Debt Service -->
      <div class="summary-tile">
        <span class="tile-label">Total Annual Debt Service</span>
        <div class="tile-amount text-primary" id="tile-debt">$80,000</div>
        <span class="tile-caption" id="tile-debt-caption">Principal ($35k) + Interest ($45k)</span>
      </div>

      <!-- 3. Annual Cash Flow After Debt -->
      <div class="summary-tile">
        <span class="tile-label">Annual Cash Flow After Debt</span>
        <div class="tile-amount text-positive" id="tile-annual-flow">+$40,000</div>
        <span class="tile-caption">Net pre-tax cash surplus per year</span>
      </div>

      <!-- 4. Monthly Cash Flow After Debt -->
      <div class="summary-tile">
        <span class="tile-label">Monthly Cash Flow After Debt</span>
        <div class="tile-amount text-positive" id="tile-monthly-flow">+$3,333</div>
        <span class="tile-caption">Estimated take-home cash per month</span>
      </div>
    </div>

    <!-- Diagnostic Verdict Card -->
    <div class="diagnostic-card" id="dscr-diagnostic-card">
      <div class="diagnostic-header">
        <svg class="diagnostic-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        <span class="diagnostic-title">What This Means For You</span>
      </div>
      <p id="res-dscr-verdict-text" class="diagnostic-text">
        With an annual Net Operating Income (NOI) of <strong>$120,000.00</strong> and total annual Debt Service of <strong>$80,000.00</strong>, your DSCR is <strong>1.50x</strong>. The property generates <strong>50.0%</strong> more operating income than needed to cover debt payments, leaving an annual surplus cash cushion of <strong>+$40,000.00</strong> (+$3,333.33/month). This comfortably meets standard commercial and DSCR lender guidelines (typically 1.20x–1.25x).
      </p>
      <p class="diagnostic-disclaimer">
        <em>Note: Underwriting guidelines vary by lender. While 1.20x–1.25x is a standard qualifying benchmark, loan approval also depends on credit score, down payment (LTV), liquid cash reserves, and appraisal value.</em>
      </p>
    </div>

    <!-- Clear Benchmark Matrix Table -->
    <div class="benchmark-container">
      <h3 class="benchmark-heading">Lender DSCR Underwriting Guidelines</h3>
      <div class="benchmark-table-wrapper">
        <table class="benchmark-table">
          <thead>
            <tr>
              <th>DSCR Ratio</th>
              <th>Cash Flow Status</th>
              <th>Typical Lender Assessment</th>
            </tr>
          </thead>
          <tbody>
            <tr id="row-ref-deficit">
              <td><strong>&lt; 1.00x</strong></td>
              <td><span class="status-pill pill-danger">Deficit</span></td>
              <td>Negative cash flow; generally declined unless backed by significant personal reserves.</td>
            </tr>
            <tr id="row-ref-tight">
              <td><strong>1.00x – 1.19x</strong></td>
              <td><span class="status-pill pill-warning">Marginal</span></td>
              <td>Narrow cushion; lenders often require higher interest rates or lower leverage (65%–70% LTV).</td>
            </tr>
            <tr id="row-ref-benchmark">
              <td><strong>1.20x – 1.25x</strong></td>
              <td><span class="status-pill pill-primary">Standard</span></td>
              <td>Standard qualifying benchmark for most residential DSCR and commercial mortgages.</td>
            </tr>
            <tr id="row-ref-strong">
              <td><strong>&gt; 1.25x</strong></td>
              <td><span class="status-pill pill-success">Strong</span></td>
              <td>Healthy financial cushion; qualifies for competitive interest rates and favorable terms.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</CalculatorLayout>

<script>
  function initDscrCalculator() {
    const root = document.getElementById('dscr-calculator');
    if (!root) return;

    // Currency selector
    const currencySelect = document.getElementById('dscr-currency-select') as HTMLSelectElement | null;
    const currencySymbols = document.querySelectorAll('.currency-symbol');

    // Inputs & Sliders
    const grossRentInput = document.getElementById('dscr-gross-rent-input') as HTMLInputElement | null;
    const grossRentSlider = document.getElementById('dscr-gross-rent-slider') as HTMLInputElement | null;

    const expensesInput = document.getElementById('dscr-expenses-input') as HTMLInputElement | null;
    const expensesSlider = document.getElementById('dscr-expenses-slider') as HTMLInputElement | null;

    const principalInput = document.getElementById('dscr-principal-input') as HTMLInputElement | null;
    const principalSlider = document.getElementById('dscr-principal-slider') as HTMLInputElement | null;

    const interestInput = document.getElementById('dscr-interest-input') as HTMLInputElement | null;
    const interestSlider = document.getElementById('dscr-interest-slider') as HTMLInputElement | null;

    // Subtotal elements
    const subtotalNoiVal = document.getElementById('subtotal-noi-val');
    const subtotalDebtVal = document.getElementById('subtotal-debt-val');

    // Result Hero elements
    const dscrHeroCard = document.getElementById('dscr-hero-card');
    const resDscrVal = document.getElementById('res-dscr-val');
    const dscrStatusBadge = document.getElementById('dscr-status-badge');
    const eqNoiVal = document.getElementById('eq-noi-val');
    const eqDebtVal = document.getElementById('eq-debt-val');

    // Summary Tiles elements
    const tileNoi = document.getElementById('tile-noi');
    const tileNoiCaption = document.getElementById('tile-noi-caption');
    const tileDebt = document.getElementById('tile-debt');
    const tileDebtCaption = document.getElementById('tile-debt-caption');
    const tileAnnualFlow = document.getElementById('tile-annual-flow');
    const tileMonthlyFlow = document.getElementById('tile-monthly-flow');

    // Diagnostic Card elements
    const dscrDiagnosticCard = document.getElementById('dscr-diagnostic-card');
    const resDscrVerdictText = document.getElementById('res-dscr-verdict-text');

    // Benchmark Table Rows
    const rowRefDeficit = document.getElementById('row-ref-deficit');
    const rowRefTight = document.getElementById('row-ref-tight');
    const rowRefBenchmark = document.getElementById('row-ref-benchmark');
    const rowRefStrong = document.getElementById('row-ref-strong');

    // Reset button
    const resetBtn = document.getElementById('dscr-reset-btn');

    // Active Currency
    let currentCurrency = currencySelect ? currencySelect.value : 'USD';

    const currencyMap: Record<string, { symbol: string; decimals: number }> = {
      USD: { symbol: '$', decimals: 2 },
      EUR: { symbol: '€', decimals: 2 },
      GBP: { symbol: '£', decimals: 2 },
      CAD: { symbol: 'C$', decimals: 2 },
      AUD: { symbol: 'A$', decimals: 2 },
      INR: { symbol: '₹', decimals: 2 },
      JPY: { symbol: '¥', decimals: 0 },
      SGD: { symbol: 'S$', decimals: 2 },
      CHF: { symbol: 'CHF ', decimals: 2 }
    };

    function formatMoney(amount: number, forceDecimals: boolean = true): string {
      const config = currencyMap[currentCurrency] || { symbol: '$', decimals: 2 };
      const decimals = config.decimals === 0 || !forceDecimals ? 0 : config.decimals;
      const isNeg = amount < 0;
      const absVal = Math.abs(amount);

      const numStr = absVal.toLocaleString('en-US', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });

      return `${isNeg ? '-' : ''}${config.symbol}${numStr}`;
    }

    function formatSignedMoney(amount: number, forceDecimals: boolean = true): string {
      const config = currencyMap[currentCurrency] || { symbol: '$', decimals: 2 };
      const decimals = config.decimals === 0 || !forceDecimals ? 0 : config.decimals;
      const absVal = Math.abs(amount);
      const numStr = absVal.toLocaleString('en-US', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });

      if (amount > 0) {
        return `+${config.symbol}${numStr}`;
      } else if (amount < 0) {
        return `-${config.symbol}${numStr}`;
      } else {
        return `${config.symbol}${numStr}`;
      }
    }

    function formatShortMoney(amount: number): string {
      const config = currencyMap[currentCurrency] || { symbol: '$', decimals: 2 };
      const abs = Math.abs(amount);
      if (abs >= 1000) {
        const kVal = (abs / 1000).toFixed(abs % 1000 === 0 ? 0 : 1);
        return `${amount < 0 ? '-' : ''}${config.symbol}${kVal}k`;
      }
      return `${amount < 0 ? '-' : ''}${config.symbol}${abs}`;
    }

    // Helper to link input and slider
    function syncInputPair(input: HTMLInputElement | null, slider: HTMLInputElement | null) {
      if (!input || !slider) return;

      input.addEventListener('input', () => {
        const val = parseFloat(input.value) || 0;
        slider.value = String(val);
        calculateDSCR();
      });

      slider.addEventListener('input', () => {
        input.value = slider.value;
        calculateDSCR();
      });
    }

    syncInputPair(grossRentInput, grossRentSlider);
    syncInputPair(expensesInput, expensesSlider);
    syncInputPair(principalInput, principalSlider);
    syncInputPair(interestInput, interestSlider);

    // Currency Change Listener
    if (currencySelect) {
      currencySelect.addEventListener('change', () => {
        currentCurrency = currencySelect.value;
        const sym = currencyMap[currentCurrency]?.symbol || '$';
        currencySymbols.forEach((el) => {
          el.textContent = sym;
        });
        calculateDSCR();
      });
    }

    // Reset button
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (grossRentInput) grossRentInput.value = '150000';
        if (grossRentSlider) grossRentSlider.value = '150000';

        if (expensesInput) expensesInput.value = '30000';
        if (expensesSlider) expensesSlider.value = '30000';

        if (principalInput) principalInput.value = '35000';
        if (principalSlider) principalSlider.value = '35000';

        if (interestInput) interestInput.value = '45000';
        if (interestSlider) interestSlider.value = '45000';

        calculateDSCR();
      });
    }

    // Core Calculation Logic
    function calculateDSCR() {
      const grossRent = Math.max(0, parseFloat(grossRentInput?.value || '0') || 0);
      const expenses = Math.max(0, parseFloat(expensesInput?.value || '0') || 0);

      const principal = Math.max(0, parseFloat(principalInput?.value || '0') || 0);
      const interest = Math.max(0, parseFloat(interestInput?.value || '0') || 0);

      // 1. Net Operating Income (NOI)
      const noi = grossRent - expenses;

      // 2. Total Annual Debt Service
      const totalDebtService = principal + interest;

      // 3. Cash Flow
      const annualCashFlow = noi - totalDebtService;
      const monthlyCashFlow = annualCashFlow / 12;

      // Subtotals in inputs panel
      if (subtotalNoiVal) subtotalNoiVal.textContent = formatMoney(noi);
      if (subtotalDebtVal) subtotalDebtVal.textContent = formatMoney(totalDebtService);

      // Safe zero debt handling
      const isZeroDebt = totalDebtService === 0;
      let dscr = 0;

      if (!isZeroDebt) {
        dscr = noi / totalDebtService;
      }

      // 4. Update Hero Card
      if (eqNoiVal) eqNoiVal.textContent = formatMoney(noi, false);
      if (eqDebtVal) eqDebtVal.textContent = formatMoney(totalDebtService, false);

      // Reset benchmark table highlights
      [rowRefDeficit, rowRefTight, rowRefBenchmark, rowRefStrong].forEach(r => r?.classList.remove('active-row'));

      if (isZeroDebt) {
        // Safe Zero Debt Case
        if (resDscrVal) resDscrVal.textContent = 'N/A';
        if (dscrStatusBadge) {
          dscrStatusBadge.textContent = 'Debt-Free Property';
          dscrStatusBadge.className = 'status-badge badge-neutral';
        }
        if (dscrHeroCard) {
          dscrHeroCard.className = 'dscr-hero-card hero-neutral';
        }
      } else {
        const dscrFormatted = `${dscr.toFixed(2)}x`;
        if (resDscrVal) resDscrVal.textContent = dscrFormatted;

        if (dscr < 1.0) {
          if (dscrStatusBadge) {
            dscrStatusBadge.textContent = 'Cash Flow Deficit';
            dscrStatusBadge.className = 'status-badge badge-danger';
          }
          if (dscrHeroCard) dscrHeroCard.className = 'dscr-hero-card hero-danger';
          if (rowRefDeficit) rowRefDeficit.classList.add('active-row');
        } else if (dscr < 1.20) {
          if (dscrStatusBadge) {
            dscrStatusBadge.textContent = 'Marginal Coverage';
            dscrStatusBadge.className = 'status-badge badge-warning';
          }
          if (dscrHeroCard) dscrHeroCard.className = 'dscr-hero-card hero-warning';
          if (rowRefTight) rowRefTight.classList.add('active-row');
        } else if (dscr <= 1.35) {
          if (dscrStatusBadge) {
            dscrStatusBadge.textContent = 'Standard Benchmark Met';
            dscrStatusBadge.className = 'status-badge badge-primary';
          }
          if (dscrHeroCard) dscrHeroCard.className = 'dscr-hero-card hero-primary';
          if (rowRefBenchmark) rowRefBenchmark.classList.add('active-row');
        } else {
          if (dscrStatusBadge) {
            dscrStatusBadge.textContent = 'Strong Coverage';
            dscrStatusBadge.className = 'status-badge badge-success';
          }
          if (dscrHeroCard) dscrHeroCard.className = 'dscr-hero-card hero-success';
          if (rowRefStrong) rowRefStrong.classList.add('active-row');
        }
      }

      // 5. Update 4 Summary Tiles
      if (tileNoi) {
        tileNoi.textContent = formatMoney(noi, false);
        tileNoi.className = noi >= 0 ? 'tile-amount text-positive' : 'tile-amount text-negative';
      }
      if (tileNoiCaption) {
        tileNoiCaption.textContent = `Income (${formatShortMoney(grossRent)}) − Expenses (${formatShortMoney(expenses)})`;
      }

      if (tileDebt) {
        tileDebt.textContent = formatMoney(totalDebtService, false);
      }
      if (tileDebtCaption) {
        tileDebtCaption.textContent = `Principal (${formatShortMoney(principal)}) + Interest (${formatShortMoney(interest)})`;
      }

      if (tileAnnualFlow) {
        tileAnnualFlow.textContent = formatSignedMoney(annualCashFlow, false);
        tileAnnualFlow.className = annualCashFlow >= 0 ? 'tile-amount text-positive' : 'tile-amount text-negative';
      }

      if (tileMonthlyFlow) {
        tileMonthlyFlow.textContent = formatSignedMoney(monthlyCashFlow, false);
        tileMonthlyFlow.className = monthlyCashFlow >= 0 ? 'tile-amount text-positive' : 'tile-amount text-negative';
      }

      // 6. Update Diagnostic Narrative Card
      if (resDscrVerdictText && dscrDiagnosticCard) {
        if (isZeroDebt) {
          dscrDiagnosticCard.className = 'diagnostic-card card-neutral';
          resDscrVerdictText.innerHTML = `Total annual debt service is <strong>${formatMoney(0)}</strong>. DSCR measures how income covers loan obligations, so it is not applicable for a property without debt. With no loan payments to make, 100% of your Net Operating Income (<strong>${formatMoney(noi)}/year</strong>) is retained as cash flow.`;
        } else if (dscr < 1.0) {
          const deficit = Math.abs(annualCashFlow);
          const monthlyDef = deficit / 12;
          dscrDiagnosticCard.className = 'diagnostic-card card-danger';
          resDscrVerdictText.innerHTML = `With an annual Net Operating Income (NOI) of <strong>${formatMoney(noi)}</strong> and total debt payments of <strong>${formatMoney(totalDebtService)}</strong>, your DSCR is <strong>${dscr.toFixed(2)}x</strong>. The property operates at an annual cash flow deficit of <strong>-${formatMoney(deficit)}/year</strong> (-${formatMoney(monthlyDef)}/month), covering only <strong>${(dscr * 100).toFixed(1)}%</strong> of required debt. The owner must inject personal funds monthly to satisfy mortgage payments.`;
        } else if (dscr < 1.20) {
          const surplus = annualCashFlow;
          const monthlySurp = surplus / 12;
          dscrDiagnosticCard.className = 'diagnostic-card card-warning';
          resDscrVerdictText.innerHTML = `With an annual Net Operating Income (NOI) of <strong>${formatMoney(noi)}</strong> and total debt payments of <strong>${formatMoney(totalDebtService)}</strong>, your DSCR is <strong>${dscr.toFixed(2)}x</strong>. While cash flow is positive with an annual surplus of <strong>+${formatMoney(surplus)}/year</strong> (+${formatMoney(monthlySurp)}/month), this falls below the typical <strong>1.20x–1.25x</strong> safety cushion required by most commercial and DSCR mortgage lenders.`;
        } else {
          const surplus = annualCashFlow;
          const monthlySurp = surplus / 12;
          const excessPercent = ((dscr - 1.0) * 100).toFixed(1);
          dscrDiagnosticCard.className = 'diagnostic-card card-success';
          resDscrVerdictText.innerHTML = `With an annual Net Operating Income (NOI) of <strong>${formatMoney(noi)}</strong> and total annual Debt Service of <strong>${formatMoney(totalDebtService)}</strong>, your DSCR is <strong>${dscr.toFixed(2)}x</strong>. The property generates <strong>${excessPercent}%</strong> more operating income than needed to service debt, leaving an annual surplus cash cushion of <strong>+${formatMoney(surplus)}</strong> (+${formatMoney(monthlySurp)}/month). This comfortably meets standard commercial and DSCR lender guidelines (typically 1.20x–1.25x).`;
        }
      }
    }

    // Initial calculation
    calculateDSCR();

    // Clipboard Copy Handler for Toolbar
    window.addEventListener('copy-calculator-results', () => {
      const grossRent = grossRentInput?.value || '0';
      const expenses = expensesInput?.value || '0';
      const noiText = subtotalNoiVal?.textContent || '$0';
      const debtText = subtotalDebtVal?.textContent || '$0';
      const dscrText = resDscrVal?.textContent || '0.00x';
      const cashflowText = tileAnnualFlow?.textContent || '$0';
      const monthlyText = tileMonthlyFlow?.textContent || '$0';
      const diagnosisText = resDscrVerdictText?.textContent || '';

      const summary = `DSCR Calculator Results (FinCalcLab):\n` +
        `• Annual Rental Income: ${formatMoney(parseFloat(grossRent) || 0)}\n` +
        `• Annual Operating Expenses: ${formatMoney(parseFloat(expenses) || 0)}\n` +
        `• Net Operating Income (NOI): ${noiText}\n` +
        `• Total Annual Debt Service: ${debtText}\n` +
        `• Debt Service Coverage Ratio (DSCR): ${dscrText}\n` +
        `• Annual Cash Flow After Debt: ${cashflowText}\n` +
        `• Monthly Cash Flow: ${monthlyText}\n` +
        `• Evaluation: ${diagnosisText}\n` +
        `Calculated at: https://fincalclab.com/calculator/dscr-calculator`;

      navigator.clipboard.writeText(summary).then(() => {
        window.dispatchEvent(new CustomEvent('calculator-copied-success'));
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initDscrCalculator);
  document.addEventListener('astro:after-swap', initDscrCalculator);
</script>

