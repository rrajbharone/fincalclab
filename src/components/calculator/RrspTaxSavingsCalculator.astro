---
import CalculatorLayout from './CalculatorLayout.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
---

<CalculatorLayout
  title="RRSP Tax Savings Calculator (Canada)"
  description="Calculate your estimated Canadian RRSP tax savings, federal and provincial tax reductions, and net after-tax cost for 2026 across all 13 provinces and territories."
  category="Taxes & Retirement"
>
  <!-- Inputs Section -->
  <div slot="inputs" class="calc-inputs-wrapper" id="rrsp-tax-root">
    <div class="input-section" style="border-top: none; padding-top: 0;">
      <h3 class="section-title">Income &amp; Contribution Details</h3>

      <!-- Tax Year Selector -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="rrsp-tax-year">Tax Year</label>
          <select id="rrsp-tax-year" class="currency-select" aria-label="Select Tax Year">
            <option value="2026" selected>2026 (Current Tax Year)</option>
            <option value="2025">2025 (Prior Tax Year)</option>
          </select>
        </div>
      </div>

      <!-- Province / Territory Selector -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="rrsp-province-select">Province or Territory</label>
          <select id="rrsp-province-select" class="currency-select" aria-label="Select Province or Territory">
            <option value="ON" selected>Ontario (ON)</option>
            <option value="BC">British Columbia (BC)</option>
            <option value="AB">Alberta (AB)</option>
            <option value="QC">Quebec (QC)</option>
            <option value="MB">Manitoba (MB)</option>
            <option value="SK">Saskatchewan (SK)</option>
            <option value="NS">Nova Scotia (NS)</option>
            <option value="NB">New Brunswick (NB)</option>
            <option value="NL">Newfoundland and Labrador (NL)</option>
            <option value="PE">Prince Edward Island (PE)</option>
            <option value="YT">Yukon (YT)</option>
            <option value="NT">Northwest Territories (NT)</option>
            <option value="NU">Nunavut (NU)</option>
          </select>
        </div>
        <span class="input-subtext">Tax brackets and tax savings depend directly on your province or territory of residence on December 31.</span>
      </div>

      <!-- Annual Taxable Income -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="rrsp-income-val">Annual Taxable Income</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol">$</span>
            <input type="number" id="rrsp-income-val" min="0" max="10000000" step="2500" value="100000" aria-label="Annual Taxable Income in Canadian Dollars" />
          </div>
        </div>
        <input type="range" id="rrsp-income-slider" min="15000" max="250000" step="2500" value="100000" class="slider-range" aria-label="Annual Income Slider" />
        
        <!-- Income Quick Presets -->
        <div class="preset-pills-row">
          <span class="preset-label">Quick:</span>
          <button type="button" class="preset-pill" data-income="50000">$50k</button>
          <button type="button" class="preset-pill" data-income="75000">$75k</button>
          <button type="button" class="preset-pill active" data-income="100000">$100k</button>
          <button type="button" class="preset-pill" data-income="125000">$125k</button>
          <button type="button" class="preset-pill" data-income="160000">$160k</button>
          <button type="button" class="preset-pill" data-income="220000">$220k</button>
        </div>
        <span class="input-subtext">Your total gross taxable earnings from employment, self-employment, and other income before deductions.</span>
      </div>

      <!-- RRSP Contribution -->
      <div class="input-group" style="margin-top: var(--space-3);">
        <div class="input-label-row">
          <label for="rrsp-contrib-val">RRSP Contribution</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol">$</span>
            <input type="number" id="rrsp-contrib-val" min="0" max="1000000" step="500" value="10000" aria-label="RRSP Contribution Amount" />
          </div>
        </div>
        <input type="range" id="rrsp-contrib-slider" min="0" max="50000" step="500" value="10000" class="slider-range" aria-label="RRSP Contribution Slider" />
        
        <!-- Contribution Quick Presets -->
        <div class="preset-pills-row">
          <span class="preset-label">Quick:</span>
          <button type="button" class="preset-pill" data-contrib="2500">$2.5k</button>
          <button type="button" class="preset-pill" data-contrib="5000">$5k</button>
          <button type="button" class="preset-pill active" data-contrib="10000">$10k</button>
          <button type="button" class="preset-pill" data-contrib="15000">$15k</button>
          <button type="button" class="preset-pill" data-contrib="25000">$25k</button>
        </div>
        <span class="input-subtext">The planned amount deposited into your RRSP to reduce current-year taxable income.</span>
      </div>

      <!-- Optional: Available RRSP Contribution Room -->
      <div class="input-group" style="margin-top: var(--space-3);">
        <div class="input-label-row">
          <label for="rrsp-room-val">
            Available RRSP Contribution Room
            <span class="optional-tag">(Optional)</span>
          </label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol">$</span>
            <input type="number" id="rrsp-room-val" min="0" max="1000000" step="1000" placeholder="e.g. 25,000" aria-label="Available RRSP Contribution Room from Notice of Assessment" />
          </div>
        </div>
        <input type="range" id="rrsp-room-slider" min="0" max="100000" step="1000" value="0" class="slider-range" aria-label="Available Room Slider" style="display: none;" />
        
        <!-- Room Quick Presets -->
        <div class="preset-pills-row">
          <span class="preset-label">Quick:</span>
          <button type="button" class="preset-pill" data-room="10000">$10k</button>
          <button type="button" class="preset-pill" data-room="18000">$18k (18% of $100k)</button>
          <button type="button" class="preset-pill" data-room="25000">$25k</button>
          <button type="button" class="preset-pill" data-room="33810">$33.8k (2026 Max)</button>
          <button type="button" class="preset-pill" data-room="clear">Leave Empty</button>
        </div>
        <span class="input-subtext">
          Found on your CRA Notice of Assessment. If left blank, the calculator assumes your full contribution is within your deduction limit.
        </span>
      </div>

      <div style="margin-top: var(--space-4);">
        <Button variant="secondary" size="sm" id="rrsp-reset-btn" class="w-full">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          Reset Calculator
        </Button>
      </div>
    </div>
  </div>

  <!-- Results Section -->
  <div slot="results" class="calc-results-wrapper">

    <!-- Primary Hero: Estimated RRSP Tax Savings -->
    <Card elevation="md" class="primary-hero-card">
      <div class="hero-top-row">
        <span class="hero-label">Estimated RRSP Tax Savings</span>
        <span class="hero-badge" id="rrsp-hero-badge">31.48% Effective Savings</span>
      </div>
      <div class="hero-main-metric" id="rrsp-hero-savings">$3,148.00</div>
      <p class="hero-subtext" id="rrsp-hero-sub">
        Combined Federal &amp; Ontario income tax reduction
      </p>

      <!-- Sub-Hero: Estimated After-Tax Cost -->
      <div class="sub-hero-container">
        <div class="sub-hero-label">Estimated After-Tax Cost</div>
        <div class="sub-hero-val" id="rrsp-hero-cost">$6,852.00</div>
        <p class="sub-hero-subtext" id="rrsp-hero-cost-sub">
          Your actual out-of-pocket investment after tax savings
        </p>
      </div>
    </Card>

    <!-- Visual Breakdown Flow -->
    <div class="flow-card">
      <div class="flow-header">
        <span class="flow-title">How Your Contribution Works</span>
      </div>
      <div class="step-flow-grid">
        <div class="step-tile">
          <div class="step-number">1</div>
          <div class="step-val" id="flow-contrib">$10,000</div>
          <div class="step-desc">RRSP Contribution</div>
        </div>
        <div class="step-arrow">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </div>
        <div class="step-tile">
          <div class="step-number">2</div>
          <div class="step-val text-primary" id="flow-taxable-after">$90,000</div>
          <div class="step-desc">Lower Taxable Income</div>
        </div>
        <div class="step-arrow">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </div>
        <div class="step-tile">
          <div class="step-number">3</div>
          <div class="step-val text-success" id="flow-savings">$3,148</div>
          <div class="step-desc">Estimated Tax Reduction</div>
        </div>
        <div class="step-arrow">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </div>
        <div class="step-tile">
          <div class="step-number">4</div>
          <div class="step-val text-accent" id="flow-cost">$6,852</div>
          <div class="step-desc">Estimated After-Tax Cost</div>
        </div>
      </div>
    </div>

    <!-- Results Explanation -->
    <div class="results-explanation-card">
      <p class="results-explanation-text" id="rrsp-explanation-text">
        An RRSP contribution can reduce your taxable income when the contribution is deductible. Your actual tax savings depend on your income, province or territory, contribution amount, available RRSP deduction room and applicable tax rules.
      </p>
    </div>

    <!-- Room Status / Potential Contribution Above Room Alert -->
    <div id="rrsp-room-alert" class="status-banner hidden">
      <div class="status-banner-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      </div>
      <div class="status-banner-content" id="rrsp-room-alert-msg">
        <!-- Injected via JavaScript -->
      </div>
    </div>

    <!-- Quebec Estimate Advisory Banner -->
    <div id="rrsp-qc-alert" class="status-banner info-banner hidden">
      <div class="status-banner-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
      </div>
      <div class="status-banner-content">
        <strong>Quebec Resident Note:</strong> Quebec results are estimates. Quebec residents file separate federal and provincial returns with Revenu Québec, receive a 16.5% basic federal tax abatement, and are subject to Quebec's separate progressive rate schedule.
      </div>
    </div>

    <!-- Detailed Metrics Grid (All Required Metrics) -->
    <div class="metrics-grid">
      <div class="metric-tile">
        <span class="metric-label">RRSP Contribution</span>
        <span class="metric-val" id="metric-contrib">$10,000.00</span>
        <span class="metric-sub">Total amount invested</span>
      </div>

      <div class="metric-tile">
        <span class="metric-label">Deductible RRSP Contribution</span>
        <span class="metric-val text-primary" id="metric-deductible">$10,000.00</span>
        <span class="metric-sub" id="metric-deductible-sub">100% deductible against income</span>
      </div>

      <div class="metric-tile">
        <span class="metric-label">Contribution Above Room</span>
        <span class="metric-val" id="metric-above-room">$0.00</span>
        <span class="metric-sub" id="metric-above-room-sub">Within available limit</span>
      </div>

      <div class="metric-tile">
        <span class="metric-label">Taxable Income Before</span>
        <span class="metric-val" id="metric-income-before">$100,000.00</span>
        <span class="metric-sub">Gross taxable income</span>
      </div>

      <div class="metric-tile">
        <span class="metric-label">Taxable Income After</span>
        <span class="metric-val text-primary" id="metric-income-after">$90,000.00</span>
        <span class="metric-sub">Reduced taxable income</span>
      </div>

      <div class="metric-tile">
        <span class="metric-label">Estimated Tax Before</span>
        <span class="metric-val" id="metric-tax-before">$25,188.83</span>
        <span class="metric-sub">Total tax without RRSP</span>
      </div>

      <div class="metric-tile">
        <span class="metric-label">Estimated Tax After</span>
        <span class="metric-val" id="metric-tax-after">$22,040.83</span>
        <span class="metric-sub">Total tax with deduction</span>
      </div>

      <div class="metric-tile">
        <span class="metric-label">Estimated Federal Tax Savings</span>
        <span class="metric-val text-success" id="metric-fed-savings">$2,050.00</span>
        <span class="metric-sub">Federal tax reduction</span>
      </div>

      <div class="metric-tile">
        <span class="metric-label" id="metric-prov-label">Estimated Provincial Tax Savings</span>
        <span class="metric-val text-success" id="metric-prov-savings">$1,098.00</span>
        <span class="metric-sub" id="metric-prov-sub">Ontario tax reduction</span>
      </div>

      <div class="metric-tile highlight-tile">
        <span class="metric-label">Total Estimated Tax Savings</span>
        <span class="metric-val text-success" id="metric-total-savings">$3,148.00</span>
        <span class="metric-sub">Federal + Provincial</span>
      </div>
    </div>

    <!-- Expandable Progressive Bracket Audit Table -->
    <div class="breakdown-container">
      <button type="button" class="breakdown-toggle-btn" id="rrsp-audit-toggle" aria-expanded="false" aria-controls="rrsp-audit-panel">
        <span style="display: flex; align-items: center; gap: 8px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          View Detailed Tax Calculation Breakdown
        </span>
        <svg class="chevron-icon" id="rrsp-audit-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
      </button>

      <div class="breakdown-panel hidden" id="rrsp-audit-panel">
        <div class="schedule-table-wrapper">
          <table class="schedule-table">
            <thead>
              <tr>
                <th style="text-align: left;">Tax Category</th>
                <th style="text-align: right;">Before RRSP</th>
                <th style="text-align: right;">After RRSP</th>
                <th style="text-align: right;">Tax Savings</th>
              </tr>
            </thead>
            <tbody id="rrsp-audit-tbody">
              <!-- Populated dynamically via JS -->
            </tbody>
          </table>
        </div>
        <p class="schedule-footnote">
          *Estimates reflect official 2026 progressive federal and provincial/territorial income tax brackets. Actual tax returns account for the Basic Personal Amount, non-refundable tax credits, and individual deductions.
        </p>
      </div>
    </div>

    <!-- Plain-English Verdict & Statutory Disclaimer -->
    <div class="verdict-container" style="margin-top: var(--space-2);">
      <Card elevation="sm" class="verdict-card verdict-info">
        <div class="verdict-header">
          <div class="verdict-badge">Canadian Tax Summary</div>
          <span class="verdict-title" id="rrsp-summary-title">RRSP Tax Deduction Impact</span>
        </div>
        <p class="verdict-desc" id="rrsp-summary-desc">
          Contributing <strong>$10,000.00</strong> to your RRSP reduces your taxable income from <strong>$100,000.00</strong> to <strong>$90,000.00</strong>, generating an estimated tax savings of <strong>$3,148.00</strong>. Your effective after-tax cost is <strong>$6,852.00</strong>.
        </p>
        <p class="verdict-disclaimer">
          This calculator provides an estimate for educational purposes only. Your actual tax savings may differ based on your complete tax situation, deductions, credits, RRSP deduction limit and other factors. Check your CRA information and consider speaking with a qualified tax professional for advice specific to your situation.
        </p>
      </Card>
    </div>

  </div>
</CalculatorLayout>

<script>
  function initRrspTaxSavingsCalculator() {
    interface TaxBracket {
      rate: number;
      from: number;
      to: number;
    }

    interface ProvinceConfig {
      name: string;
      brackets: TaxBracket[];
      surtax?: boolean;
      abatement?: boolean;
    }

    interface YearTaxConfig {
      federalBrackets: TaxBracket[];
      provinces: Record<string, ProvinceConfig>;
    }

    const TAX_CONFIG: Record<string, YearTaxConfig> = {
