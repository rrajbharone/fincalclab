    };

    // -------------------------------------------------------------
    // DOM ELEMENTS
    // -------------------------------------------------------------
    const taxYearSelect   = document.getElementById('rrsp-tax-year') as HTMLSelectElement;
    const provinceSelect  = document.getElementById('rrsp-province-select') as HTMLSelectElement;

    const incomeInput     = document.getElementById('rrsp-income-val') as HTMLInputElement;
    const incomeSlider    = document.getElementById('rrsp-income-slider') as HTMLInputElement;

    const roomInput       = document.getElementById('rrsp-room-val') as HTMLInputElement;
    const roomSlider      = document.getElementById('rrsp-room-slider') as HTMLInputElement;

    const contribInput    = document.getElementById('rrsp-contrib-val') as HTMLInputElement;
    const contribSlider   = document.getElementById('rrsp-contrib-slider') as HTMLInputElement;

    // Estimator Accordion
    const estimatorToggle = document.getElementById('rrsp-estimator-toggle') as HTMLButtonElement;
    const estimatorPanel  = document.getElementById('rrsp-estimator-panel') as HTMLElement;
    const estimatorChevron= document.getElementById('rrsp-estimator-chevron') as HTMLElement;
    const priorIncomeInput= document.getElementById('rrsp-prior-income') as HTMLInputElement;
    const unusedRoomInput = document.getElementById('rrsp-unused-room') as HTMLInputElement;
    const applyEstimateBtn= document.getElementById('rrsp-apply-estimate-btn') as HTMLButtonElement;

    const resetBtn        = document.getElementById('rrsp-reset-btn') as HTMLButtonElement;

    // Output Elements
    const heroSavings     = document.getElementById('rrsp-hero-savings') as HTMLElement;
    const heroSub         = document.getElementById('rrsp-hero-sub') as HTMLElement;

    const flowContrib     = document.getElementById('step-flow-contrib') as HTMLElement;
    const flowDeduct      = document.getElementById('step-flow-deduct') as HTMLElement;
    const flowSavings     = document.getElementById('step-flow-savings') as HTMLElement;
    const flowCost        = document.getElementById('step-flow-cost') as HTMLElement;

    const boxDeductible   = document.getElementById('rrsp-box-deductible') as HTMLElement;
    const boxDeductDesc   = document.getElementById('rrsp-box-deductible-desc') as HTMLElement;
    const boxCost         = document.getElementById('rrsp-box-cost') as HTMLElement;
    const boxCostDesc     = document.getElementById('rrsp-box-cost-desc') as HTMLElement;

    const tilePlanned     = document.getElementById('tile-planned-contrib') as HTMLElement;
    const tileRemaining   = document.getElementById('tile-remaining-room') as HTMLElement;
    const tileRemainingSub= document.getElementById('tile-remaining-sub') as HTMLElement;
    const tileExcess      = document.getElementById('tile-excess-room') as HTMLElement;
    const tileExcessSub   = document.getElementById('tile-excess-sub') as HTMLElement;
    const tileFedSaved    = document.getElementById('tile-fed-saved') as HTMLElement;
    const tileProvSaved   = document.getElementById('tile-prov-saved') as HTMLElement;
    const tileProvSub     = document.getElementById('tile-prov-sub') as HTMLElement;
    const tileEffective   = document.getElementById('tile-effective-rate') as HTMLElement;

    const breakdownToggle = document.getElementById('rrsp-breakdown-toggle') as HTMLButtonElement;
    const breakdownWrapper= document.getElementById('rrsp-breakdown-wrapper') as HTMLElement;
    const breakdownChevron= document.getElementById('rrsp-breakdown-chevron') as HTMLElement;
    const breakdownTbody  = document.getElementById('rrsp-breakdown-tbody') as HTMLElement;

    const bannerExcess    = document.getElementById('rrsp-excess-banner') as HTMLElement;
    const excessMsg       = document.getElementById('rrsp-excess-msg') as HTMLElement;
    const bannerQc        = document.getElementById('rrsp-qc-banner') as HTMLElement;

    const verdictTitle    = document.getElementById('rrsp-verdict-title') as HTMLElement;
    const verdictDesc     = document.getElementById('rrsp-verdict-desc') as HTMLElement;

    // Currency Formatter
    function fmt(val: number): string {
      const absVal = Math.abs(val);
      const str = absVal.toLocaleString('en-CA', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
      return `${val < 0 ? '-' : ''}$${str}`;
    }

    // Progressive Bracket Tax Calculator
    function calculateBracketTax(taxableIncome: number, brackets: TaxBracket[]): number {
      if (taxableIncome <= 0) return 0;
      let totalTax = 0;
      for (const b of brackets) {
        if (taxableIncome <= b.from) continue;
        const taxableSlice = Math.min(taxableIncome - b.from, b.to - b.from);
        if (taxableSlice > 0) {
          totalTax += taxableSlice * b.rate;
        }
      }
      return totalTax;
    }

    // -------------------------------------------------------------
    // CALCULATION LOGIC
    // -------------------------------------------------------------
    function updateCalculation() {
      const yearKey = taxYearSelect.value || '2026';
      const provKey = provinceSelect.value || 'ON';
      const yearConfig = TAX_CONFIG[yearKey] || TAX_CONFIG['2026'];
      const provData = yearConfig.provinces[provKey] || yearConfig.provinces['ON'];

      const income = Math.max(0, parseFloat(incomeInput.value) || 0);
      const availableRoom = Math.max(0, parseFloat(roomInput.value) || 0);
      const plannedContrib = Math.max(0, parseFloat(contribInput.value) || 0);

      // Deductibility & Excess
      const deductibleContrib = Math.min(plannedContrib, availableRoom);
      const excessContrib = Math.max(0, plannedContrib - availableRoom);
      const remainingRoom = Math.max(0, availableRoom - plannedContrib);

      // Taxable Income Comparison
      const incomeBefore = income;
      const incomeAfter = Math.max(0, income - deductibleContrib);

      // Federal Tax Calculations
      let fedTaxBefore = calculateBracketTax(incomeBefore, yearConfig.federalBrackets);
      let fedTaxAfter = calculateBracketTax(incomeAfter, yearConfig.federalBrackets);

      // Quebec Federal Abatement (16.5% reduction on basic federal tax)
      if (provData.abatement) {
        fedTaxBefore *= 0.835;
        fedTaxAfter *= 0.835;
      }
      const fedTaxSaved = Math.max(0, fedTaxBefore - fedTaxAfter);

      // Provincial Tax Calculations
      let provTaxBefore = calculateBracketTax(incomeBefore, provData.brackets);
      let provTaxAfter = calculateBracketTax(incomeAfter, provData.brackets);

      // Ontario Surtax Handling (20% surtax on tax > $5,500 + 36% on tax > $7,000)
      if (provData.surtax) {
        const calcOnSurtax = (baseTax: number) => {
          let s = 0;
          if (baseTax > 5500) s += (baseTax - 5500) * 0.20;
          if (baseTax > 7000) s += (baseTax - 7000) * 0.36;
          return s;
        };
        provTaxBefore += calcOnSurtax(provTaxBefore);
        provTaxAfter += calcOnSurtax(provTaxAfter);
      }

      const provTaxSaved = Math.max(0, provTaxBefore - provTaxAfter);
      const totalTaxBefore = fedTaxBefore + provTaxBefore;
      const totalTaxAfter = fedTaxAfter + provTaxAfter;
      const totalTaxSaved = Math.max(0, totalTaxBefore - totalTaxAfter);

      // True Economic Cost & Effective Rate
      const afterTaxCost = Math.max(0, plannedContrib - totalTaxSaved);
      const effectiveRate = deductibleContrib > 0 ? (totalTaxSaved / deductibleContrib) * 100 : 0;

      // -------------------------------------------------------------
      // UPDATE UI
      // -------------------------------------------------------------
      heroSavings.textContent = fmt(totalTaxSaved);
      heroSub.textContent = `Combined Federal & ${provData.name} tax reduction (${effectiveRate.toFixed(2)}% effective rate)`;

      flowContrib.textContent = `$${Math.round(plannedContrib).toLocaleString('en-CA')}`;
      flowDeduct.textContent = `$${Math.round(deductibleContrib).toLocaleString('en-CA')}`;
      flowSavings.textContent = fmt(totalTaxSaved);
      flowCost.textContent = fmt(afterTaxCost);

      boxDeductible.textContent = fmt(deductibleContrib);
      boxDeductDesc.textContent = excessContrib > 0 
        ? `Capped at $${Math.round(availableRoom).toLocaleString('en-CA')} available room` 
        : '100% within available room';

      boxCost.textContent = fmt(afterTaxCost);
      boxCostDesc.textContent = `Actual net cost to invest ${fmt(plannedContrib)}`;

      tilePlanned.textContent = fmt(plannedContrib);
      tileRemaining.textContent = fmt(remainingRoom);
      tileRemainingSub.textContent = remainingRoom > 0 ? 'Available for future deductions' : 'Contribution room fully used';

      tileExcess.textContent = fmt(excessContrib);
      tileExcess.style.color = excessContrib > 0 ? 'var(--color-danger, #ef4444)' : 'var(--color-success)';
      tileExcessSub.textContent = excessContrib > 0 ? 'Exceeds CRA room limit' : 'Within CRA room';

      tileFedSaved.textContent = fmt(fedTaxSaved);
      tileProvSaved.textContent = fmt(provTaxSaved);
      tileProvSub.textContent = `${provData.name} tax savings`;

      tileEffective.textContent = `${effectiveRate.toFixed(2)}%`;

      // Warning Banners
      if (excessContrib > 0) {
        bannerExcess.classList.remove('hidden');
        excessMsg.innerHTML = `Your planned contribution of <strong>${fmt(plannedContrib)}</strong> exceeds your available room of <strong>${fmt(availableRoom)}</strong> by <strong>${fmt(excessContrib)}</strong>. The CRA allows a lifetime cumulative overcontribution buffer of $2,000 before applying a 1% per month penalty tax under Part X.1. Verify your CRA deduction limit.`;
      } else {
        bannerExcess.classList.add('hidden');
      }

      if (provKey === 'QC') {
        bannerQc.classList.remove('hidden');
      } else {
        bannerQc.classList.add('hidden');
      }

      // Verdict Content
      if (plannedContrib === 0) {
        verdictTitle.textContent = 'Enter a Planned Contribution';
        verdictDesc.innerHTML = `You currently have <strong>${fmt(availableRoom)}</strong> in available RRSP contribution room. Contributing to your RRSP will immediately lower your taxable income of <strong>${fmt(income)}</strong>.`;
      } else if (excessContrib > 0) {
        verdictTitle.textContent = 'Excess Contribution Alert';
        verdictDesc.innerHTML = `You can deduct up to <strong>${fmt(deductibleContrib)}</strong> of your contribution this tax year, producing an estimated tax savings of <strong>${fmt(totalTaxSaved)}</strong>. However, the remaining <strong>${fmt(excessContrib)}</strong> cannot be deducted now and may trigger CRA overcontribution penalties if exceeding the $2,000 cushion.`;
      } else {
        verdictTitle.textContent = 'High-Value RRSP Tax Shelter';
        verdictDesc.innerHTML = `By contributing <strong>${fmt(plannedContrib)}</strong> to your RRSP, your taxable income drops to <strong>${fmt(incomeAfter)}</strong>, delivering an estimated tax refund/savings of <strong>${fmt(totalTaxSaved)}</strong> (${effectiveRate.toFixed(1)}% savings rate). Your net after-tax outlay is only <strong>${fmt(afterTaxCost)}</strong>.`;
      }

      // Populate Progressive Table
      populateBreakdownTable({
        fedBefore: fedTaxBefore,
        fedAfter: fedTaxAfter,
        fedSaved: fedTaxSaved,
        provName: provData.name,
        provBefore: provTaxBefore,
        provAfter: provTaxAfter,
        provSaved: provTaxSaved,
        totalBefore: totalTaxBefore,
        totalAfter: totalTaxAfter,
        totalSaved: totalTaxSaved
      });
    }

    // Populate Dynamic Tax Table
    function populateBreakdownTable(d: {
      fedBefore: number;
      fedAfter: number;
      fedSaved: number;
      provName: string;
      provBefore: number;
      provAfter: number;
      provSaved: number;
      totalBefore: number;
      totalAfter: number;
      totalSaved: number;
    }) {
      const rows = [
        {
          category: 'Federal Income Tax',
          before: fmt(d.fedBefore),
          after: fmt(d.fedAfter),
          savings: fmt(d.fedSaved),
          highlight: false
        },
        {
          category: `${d.provName} Provincial Tax`,
          before: fmt(d.provBefore),
          after: fmt(d.provAfter),
          savings: fmt(d.provSaved),
          highlight: false
        },
        {
          category: 'Total Estimated Income Tax',
          before: fmt(d.totalBefore),
          after: fmt(d.totalAfter),
          savings: fmt(d.totalSaved),
          highlight: true
        }
      ];

      breakdownTbody.innerHTML = rows.map(r => `
        <tr ${r.highlight ? 'style="font-weight: 700; background-color: var(--color-bg-surface);"' : ''}>
          <td style="color: var(--color-text-base);">${r.category}</td>
          <td style="font-family: var(--font-mono, monospace); text-align: right; color: var(--color-text-muted);">${r.before}</td>
          <td style="font-family: var(--font-mono, monospace); text-align: right; color: var(--color-text-base);">${r.after}</td>
          <td style="font-family: var(--font-mono, monospace); text-align: right; color: var(--color-success); font-weight: 700;">${r.savings}</td>
        </tr>
      `).join('');
    }

    // -------------------------------------------------------------
    // INPUT SYNCHRONIZATION & EVENT LISTENERS
    // -------------------------------------------------------------
    function sync(inp: HTMLInputElement, sld: HTMLInputElement) {
      inp.addEventListener('input', () => {
        let val = parseFloat(inp.value);
        if (isNaN(val) || val < 0) val = 0;
        sld.value = String(Math.min(parseFloat(sld.max), val));
        updateCalculation();
      });

      sld.addEventListener('input', () => {
        inp.value = sld.value;
        updateCalculation();
      });
    }

    sync(incomeInput, incomeSlider);
    sync(roomInput, roomSlider);
    sync(contribInput, contribSlider);

    taxYearSelect.addEventListener('change', updateCalculation);
    provinceSelect.addEventListener('change', updateCalculation);

    // Preset Pills Handlers
    function setupPresets(selector: string, targetInput: HTMLInputElement, targetSlider?: HTMLInputElement) {
      const pills = document.querySelectorAll(selector);
      pills.forEach(pill => {
        pill.addEventListener('click', (e) => {
          const btn = e.currentTarget as HTMLButtonElement;
          pills.forEach(p => p.classList.remove('active'));
          btn.classList.add('active');

          const dataVal = btn.dataset.income || btn.dataset.room || btn.dataset.contrib;
          if (dataVal !== undefined) {
            if (dataVal === 'max') {
              const curRoom = parseFloat(roomInput.value) || 0;
              targetInput.value = String(curRoom);
              if (targetSlider) targetSlider.value = String(Math.min(parseFloat(targetSlider.max), curRoom));
            } else {
              targetInput.value = dataVal;
              if (targetSlider) targetSlider.value = String(Math.min(parseFloat(targetSlider.max), parseFloat(dataVal)));
            }
            updateCalculation();
          }
        });
      });
    }

    setupPresets('[data-income]', incomeInput, incomeSlider);
    setupPresets('[data-room]', roomInput, roomSlider);
    setupPresets('[data-contrib]', contribInput, contribSlider);

    // Estimator Accordion
    estimatorToggle.addEventListener('click', () => {
      const isExpanded = estimatorToggle.getAttribute('aria-expanded') === 'true';
      estimatorToggle.setAttribute('aria-expanded', String(!isExpanded));
      estimatorPanel.classList.toggle('hidden');
      estimatorChevron.style.transform = isExpanded ? 'rotate(0deg)' : 'rotate(180deg)';
    });

    // Helper: recalculate estimate button label
    function updateEstimateBtnLabel() {
      const priorInc = Math.max(0, parseFloat(priorIncomeInput.value) || 0);
      const unused = Math.max(0, parseFloat(unusedRoomInput.value) || 0);
      const yearKey = taxYearSelect.value || '2026';
      const cap = TAX_CONFIG[yearKey]?.rrspLimit || 33810;
      const newRoom = Math.min(cap, priorInc * 0.18);
      const totalEstimated = Math.round(newRoom + unused);
      applyEstimateBtn.textContent = `Apply Estimated Room ($${totalEstimated.toLocaleString('en-CA')})`;
    }

    priorIncomeInput.addEventListener('input', updateEstimateBtnLabel);
    unusedRoomInput.addEventListener('input', updateEstimateBtnLabel);

    applyEstimateBtn.addEventListener('click', () => {
      const priorInc = Math.max(0, parseFloat(priorIncomeInput.value) || 0);
      const unused = Math.max(0, parseFloat(unusedRoomInput.value) || 0);
      const yearKey = taxYearSelect.value || '2026';
      const cap = TAX_CONFIG[yearKey]?.rrspLimit || 33810;
      const newRoom = Math.min(cap, priorInc * 0.18);
      const totalEstimated = Math.round(newRoom + unused);

      roomInput.value = String(totalEstimated);
      roomSlider.value = String(Math.min(parseFloat(roomSlider.max), totalEstimated));
      updateCalculation();
    });

    // Breakdown Accordion Toggle
    breakdownToggle.addEventListener('click', () => {
      const isExpanded = breakdownToggle.getAttribute('aria-expanded') === 'true';
      breakdownToggle.setAttribute('aria-expanded', String(!isExpanded));
      breakdownWrapper.classList.toggle('hidden');
      breakdownChevron.style.transform = isExpanded ? 'rotate(0deg)' : 'rotate(180deg)';
    });

    // Reset Button
    resetBtn.addEventListener('click', () => {
      taxYearSelect.value = '2026';
      provinceSelect.value = 'ON';

      incomeInput.value = '95000';
      incomeSlider.value = '95000';

      roomInput.value = '25000';
      roomSlider.value = '25000';

      contribInput.value = '10000';
      contribSlider.value = '10000';

      priorIncomeInput.value = '95000';
      unusedRoomInput.value = '7900';
      updateEstimateBtnLabel();

      // Reset preset active states
      document.querySelectorAll('.preset-pill').forEach(p => p.classList.remove('active'));
      document.querySelector('[data-income="95000"]')?.classList.add('active');
      document.querySelector('[data-room="25000"]')?.classList.add('active');
      document.querySelector('[data-contrib="10000"]')?.classList.add('active');

      updateCalculation();
    });

    // Initial Calculation Run
    updateEstimateBtnLabel();
    updateCalculation();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRrspContributionCalculator);
  } else {
    initRrspContributionCalculator();
  }
</script>

