---
import CalculatorLayout from './CalculatorLayout.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
---

<CalculatorLayout
  title="RRSP Contribution Calculator (Canada)"
  description="Calculate your Canadian RRSP tax deduction, federal and provincial tax savings, remaining contribution room, and after-tax cost for 2026 across all provinces."
  category="Taxes & Retirement"
>
  <!-- Inputs Section -->
  <div slot="inputs" class="calc-inputs-wrapper" id="rrsp-root">
    <div class="input-section" style="border-top: none; padding-top: 0;">
      <h3 class="section-title">Income &amp; Contribution Details</h3>

      <!-- Tax Year Selector -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="rrsp-tax-year">Tax Year</label>
          <select id="rrsp-tax-year" class="currency-select" aria-label="Select Tax Year">
            <option value="2026" selected>2026 (CRA Dollar Limit: $33,810)</option>
            <option value="2025">2025 (CRA Dollar Limit: $32,490)</option>
          </select>
        </div>
      </div>

      <!-- Province / Territory Selector -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="rrsp-province-select">Province or Territory</label>
          <select id="rrsp-province-select" class="currency-select" aria-label="Select Province or Territory">
            <option value="ON" selected>Ontario (ON)</option>
            <option value="BC">British Columbia (BC)</option>
            <option value="AB">Alberta (AB)</option>
            <option value="QC">Quebec (QC)</option>
            <option value="MB">Manitoba (MB)</option>
            <option value="SK">Saskatchewan (SK)</option>
            <option value="NS">Nova Scotia (NS)</option>
            <option value="NB">New Brunswick (NB)</option>
            <option value="NL">Newfoundland and Labrador (NL)</option>
            <option value="PE">Prince Edward Island (PE)</option>
            <option value="YT">Yukon (YT)</option>
            <option value="NT">Northwest Territories (NT)</option>
            <option value="NU">Nunavut (NU)</option>
          </select>
        </div>
        <span class="input-subtext">Tax brackets and tax savings vary significantly depending on your province of residence on December 31.</span>
      </div>

      <!-- Annual Income -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="rrsp-income-val">Annual Taxable Income</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol">$</span>
            <input type="number" id="rrsp-income-val" min="0" max="10000000" step="2500" value="95000" aria-label="Annual Taxable Income in Canadian Dollars" />
          </div>
        </div>
        <input type="range" id="rrsp-income-slider" min="15000" max="250000" step="2500" value="95000" class="slider-range" aria-label="Annual Income Slider" />
        
        <!-- Income Quick Presets -->
        <div class="preset-pills-row">
          <span class="preset-label">Quick:</span>
          <button type="button" class="preset-pill" data-income="55000">$55k</button>
          <button type="button" class="preset-pill" data-income="75000">$75k</button>
          <button type="button" class="preset-pill active" data-income="95000">$95k</button>
          <button type="button" class="preset-pill" data-income="120000">$120k</button>
          <button type="button" class="preset-pill" data-income="160000">$160k</button>
          <button type="button" class="preset-pill" data-income="220000">$220k</button>
        </div>
        <span class="input-subtext">Your total gross annual employment salary, self-employment profits, and other taxable income before deductions.</span>
      </div>

      <!-- Available RRSP Contribution Room -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="rrsp-room-val">Available RRSP Contribution Room</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol">$</span>
            <input type="number" id="rrsp-room-val" min="0" max="1000000" step="1000" value="25000" aria-label="Available RRSP Contribution Room" />
          </div>
        </div>
        <input type="range" id="rrsp-room-slider" min="0" max="100000" step="1000" value="25000" class="slider-range" aria-label="Available Room Slider" />
        
        <!-- Room Quick Presets -->
        <div class="preset-pills-row">
          <span class="preset-label">Quick:</span>
          <button type="button" class="preset-pill" data-room="10000">$10k</button>
          <button type="button" class="preset-pill" data-room="17100">$17.1k (18% of $95k)</button>
          <button type="button" class="preset-pill active" data-room="25000">$25k</button>
          <button type="button" class="preset-pill" data-room="33810">$33.8k (2026 Max)</button>
          <button type="button" class="preset-pill" data-room="50000">$50k</button>
        </div>
        <span class="input-subtext">
          Your RRSP contribution room is shown on your latest CRA Notice of Assessment. Enter that amount for the most accurate result.
        </span>
      </div>

      <!-- Optional "Estimate My RRSP Room" Accordion -->
      <div class="advanced-section" style="margin-top: var(--space-2); margin-bottom: var(--space-2);">
        <button type="button" class="advanced-toggle-btn" id="rrsp-estimator-toggle" aria-expanded="false" aria-controls="rrsp-estimator-panel">
          <span style="display: flex; align-items: center; gap: 8px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            Estimate My RRSP Room (Optional Helper)
          </span>
          <svg class="chevron-icon" id="rrsp-estimator-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>

        <div class="advanced-panel hidden" id="rrsp-estimator-panel">
          <p style="font-size: 0.8rem; color: var(--color-text-muted); margin: 0 0 var(--space-3) 0; line-height: 1.45;">
            CRA calculates new annual room as 18% of earned income up to the annual dollar limit ($33,810 for 2026), minus pension adjustments (PA), plus unused room carried forward.
          </p>
          <div class="input-group">
            <div class="input-label-row" style="font-size: 0.85rem;">
              <label for="rrsp-prior-income">Prior Year Earned Income</label>
              <div class="input-symbol-wrapper" style="width: 140px;">
                <span class="currency-symbol">$</span>
                <input type="number" id="rrsp-prior-income" min="0" max="1000000" step="5000" value="95000" aria-label="Prior Year Earned Income" />
              </div>
            </div>
          </div>
          <div class="input-group" style="margin-top: var(--space-2);">
            <div class="input-label-row" style="font-size: 0.85rem;">
              <label for="rrsp-unused-room">Unused Room Carried Forward</label>
              <div class="input-symbol-wrapper" style="width: 140px;">
                <span class="currency-symbol">$</span>
                <input type="number" id="rrsp-unused-room" min="0" max="1000000" step="1000" value="7900" aria-label="Unused Room Carried Forward" />
              </div>
            </div>
          </div>
          <div style="margin-top: var(--space-3);">
            <Button variant="secondary" size="sm" id="rrsp-apply-estimate-btn" class="w-full">
              Apply Estimated Room ($25,000)
            </Button>
          </div>
        </div>
      </div>

      <!-- Planned RRSP Contribution -->
      <div class="input-group" style="margin-top: var(--space-3);">
        <div class="input-label-row">
          <label for="rrsp-contrib-val">Planned RRSP Contribution</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol">$</span>
            <input type="number" id="rrsp-contrib-val" min="0" max="1000000" step="500" value="10000" aria-label="Planned RRSP Contribution" />
          </div>
        </div>
        <input type="range" id="rrsp-contrib-slider" min="0" max="50000" step="500" value="10000" class="slider-range" aria-label="Planned Contribution Slider" />
        
        <!-- Contribution Quick Presets -->
        <div class="preset-pills-row">
          <span class="preset-label">Quick:</span>
          <button type="button" class="preset-pill" data-contrib="2500">$2.5k</button>
          <button type="button" class="preset-pill" data-contrib="5000">$5k</button>
          <button type="button" class="preset-pill active" data-contrib="10000">$10k</button>
          <button type="button" class="preset-pill" data-contrib="15000">$15k</button>
          <button type="button" class="preset-pill" data-contrib="max">Match Room</button>
        </div>
        <span class="input-subtext">The amount you intend to deposit into your individual or spousal RRSP before the contribution deadline.</span>
      </div>

      <!-- Warning & Intelligence Banners -->
      <div id="rrsp-excess-banner" class="callout-banner warning hidden" style="margin-top: var(--space-4);">
        <div class="callout-icon">⚠️</div>
        <div class="callout-body">
          <span class="callout-title" id="rrsp-excess-title">Potential Excess Contribution</span>
          <span class="callout-msg" id="rrsp-excess-msg">
            Your planned contribution exceeds your available contribution room. Only contributions within your CRA limit are tax deductible. The CRA permits a lifetime $2,000 cumulative overcontribution cushion; excess amounts beyond that cushion face a 1% per month penalty tax under Part X.1.
          </span>
        </div>
      </div>

      <div id="rrsp-qc-banner" class="callout-banner warning hidden" style="margin-top: var(--space-4);">
        <div class="callout-icon">ℹ️</div>
        <div class="callout-body">
          <span class="callout-title">Quebec Provincial Tax Filing</span>
          <span class="callout-msg">
            Quebec calculates provincial income tax separately through Revenu Québec and benefits from a 16.5% federal tax abatement. Both federal and provincial tax deductions are computed progressively.
          </span>
        </div>
      </div>

      <!-- Reset Action -->
      <div style="margin-top: var(--space-5);">
        <Button variant="outline" size="sm" id="rrsp-reset-btn" class="w-full">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
          Reset Calculator Inputs
        </Button>
      </div>
    </div>
  </div>

  <!-- Results Section -->
  <div slot="results" class="calc-results-wrapper">
    <h3 class="results-heading">RRSP Tax Savings Summary</h3>

    <!-- Primary Hero Box: Estimated Tax Savings -->
    <div class="hero-metric-box">
      <span class="hero-metric-label">Estimated RRSP Tax Savings</span>
      <div class="hero-metric-value" id="rrsp-hero-savings">$3,148.00</div>
      <span class="hero-metric-subtext" id="rrsp-hero-sub">Combined Federal &amp; Ontario tax reduction (31.48% effective rate)</span>
    </div>

    <!-- Visual Step Flow Diagram -->
    <div class="step-flow-card">
      <div class="step-flow-col">
        <span class="step-flow-badge">1. Deposit</span>
        <span class="step-flow-val" id="step-flow-contrib">$10,000</span>
        <span class="step-flow-desc">You contribute</span>
      </div>
      <div class="step-flow-arrow">→</div>
      <div class="step-flow-col">
        <span class="step-flow-badge">2. Deduction</span>
        <span class="step-flow-val" id="step-flow-deduct">$10,000</span>
        <span class="step-flow-desc">Taxable income cut</span>
      </div>
      <div class="step-flow-arrow">→</div>
      <div class="step-flow-col">
        <span class="step-flow-badge">3. Tax Saved</span>
        <span class="step-flow-val" id="step-flow-savings" style="color: var(--color-success);">$3,148</span>
        <span class="step-flow-desc">Gov refund/credit</span>
      </div>
      <div class="step-flow-arrow">→</div>
      <div class="step-flow-col">
        <span class="step-flow-badge">4. Net Cost</span>
        <span class="step-flow-val" id="step-flow-cost" style="color: var(--color-primary);">$6,852</span>
        <span class="step-flow-desc">True out-of-pocket</span>
      </div>
    </div>

    <!-- Dual Summary Value Cards -->
    <div class="net-value-container">
      <div class="net-value-box highlight-primary">
        <span class="net-box-label">Deductible Contribution</span>
        <div id="rrsp-box-deductible" class="net-box-value" style="color: var(--color-primary);">$10,000.00</div>
        <span class="net-box-desc" id="rrsp-box-deductible-desc">100% within available room</span>
      </div>
      <div class="net-value-box highlight-success">
        <span class="net-box-label">After-Tax Cost of Contribution</span>
        <div id="rrsp-box-cost" class="net-box-value" style="color: var(--color-success);">$6,852.00</div>
        <span class="net-box-desc" id="rrsp-box-cost-desc">Actual net cost to invest $10,000</span>
      </div>
    </div>

    <!-- Key Metrics Grid (Rule 15 Responsive Wrapping) -->
    <h4 class="metrics-grid-title">Contribution &amp; Room Details</h4>
    <div class="results-grid rrsp-metrics-grid">
      <div class="result-tile">
        <span class="tile-label">Planned Contribution</span>
        <div class="tile-value" id="tile-planned-contrib" style="color: var(--color-text-base);">$10,000.00</div>
        <span class="tile-sub">Total cash deposited</span>
      </div>
      <div class="result-tile">
        <span class="tile-label">Remaining RRSP Room</span>
        <div class="tile-value" id="tile-remaining-room" style="color: var(--color-primary);">$15,000.00</div>
        <span class="tile-sub" id="tile-remaining-sub">Carried forward to future</span>
      </div>
      <div class="result-tile">
        <span class="tile-label">Potential Excess</span>
        <div class="tile-value" id="tile-excess-room" style="color: var(--color-success);">$0.00</div>
        <span class="tile-sub" id="tile-excess-sub">Within CRA room</span>
      </div>
      <div class="result-tile">
        <span class="tile-label">Federal Tax Saved</span>
        <div class="tile-value" id="tile-fed-saved" style="color: var(--color-success);">$2,050.00</div>
        <span class="tile-sub">CRA federal deduction</span>
      </div>
      <div class="result-tile">
        <span class="tile-label">Provincial Tax Saved</span>
        <div class="tile-value" id="tile-prov-saved" style="color: var(--color-success);">$1,098.00</div>
        <span class="tile-sub" id="tile-prov-sub">Ontario tax savings</span>
      </div>
      <div class="result-tile">
        <span class="tile-label">Effective Savings Rate</span>
        <div class="tile-value" id="tile-effective-rate" style="color: var(--color-primary);">31.48%</div>
        <span class="tile-sub">On deductible contribution</span>
      </div>
    </div>

    <!-- Detailed Tax Breakdown Table Accordion -->
    <div class="schedule-section" style="margin-top: var(--space-2);">
      <button type="button" class="schedule-toggle-btn" id="rrsp-breakdown-toggle" aria-expanded="false" aria-controls="rrsp-breakdown-wrapper">
        <span style="display: flex; align-items: center; gap: 8px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
          Progressive Tax Reduction Breakdown
        </span>
        <svg class="chevron-icon" id="rrsp-breakdown-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
      </button>

      <div class="schedule-wrapper hidden" id="rrsp-breakdown-wrapper">
        <div class="schedule-table-container">
          <table class="schedule-table" id="rrsp-breakdown-table">
            <thead>
              <tr>
                <th>Tax Category</th>
                <th>Without RRSP</th>
                <th>With RRSP</th>
                <th>Estimated Savings</th>
              </tr>
            </thead>
            <tbody id="rrsp-breakdown-tbody">
              <!-- Dynamically populated rows -->
            </tbody>
          </table>
        </div>
        <p class="schedule-footnote">
          *Estimates reflect 2026 progressive federal and provincial/territorial tax brackets. Actual tax returns account for the Basic Personal Amount, provincial surtaxes/credits, and individual deductions.
        </p>
      </div>
    </div>

    <!-- Plain-English Verdict & Context -->
    <div class="verdict-container" style="margin-top: var(--space-2);">
      <Card elevation="sm" class="verdict-card verdict-info">
        <div class="verdict-header">
          <div class="verdict-badge">Canadian Tax Insight</div>
          <span class="verdict-title" id="rrsp-verdict-title">Smart RRSP Deduction</span>
        </div>
        <p class="verdict-desc" id="rrsp-verdict-desc">
          By contributing <strong>$10,000.00</strong> to your RRSP, your taxable income is reduced to <strong>$85,000.00</strong>, generating an estimated tax savings of <strong>$3,148.00</strong>. Your effective net cost to invest $10,000 is only <strong>$6,852.00</strong>.
        </p>
        <p class="verdict-disclaimer">
          This calculator provides an estimate for educational purposes only. Your actual RRSP deduction limit, tax savings and tax payable depend on your personal tax situation and information available to the Canada Revenue Agency. Check your latest CRA Notice of Assessment or CRA account before making a contribution. This calculator is not tax or financial advice.
        </p>
      </Card>
    </div>

  </div>
</CalculatorLayout>

<script>
  function initRrspContributionCalculator() {
    // -------------------------------------------------------------
    // CANADIAN TAX CONFIGURATION (2026 & 2025 Maintainable Engine)
    // -------------------------------------------------------------
    interface TaxBracket {
      rate: number;
      from: number;
      to: number;
    }

    interface JurisdictionTaxData {
      rrspLimit: number;
      federalBrackets: TaxBracket[];
      provinces: Record<string, { name: string; brackets: TaxBracket[]; surtax?: boolean; abatement?: boolean }>;
    }

