---
import CalculatorLayout from './CalculatorLayout.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
---

<CalculatorLayout
  title="Mobile Home Moving Cost Calculator"
  description="Estimate total mobile home moving and setup costs. Reconcile transportation base rates, mileage surcharges, oversize permits, escort pilot cars, blocking setup, and utility reconnections."
  category="Finance"
>
  <!-- Inputs Section -->
  <div slot="inputs" class="calc-inputs-wrapper" id="mobile-home-moving-calculator">
    
    <!-- Step 1: Base Configuration -->
    <div style="display: flex; flex-direction: column; gap: var(--space-5);">
      <h3 style="font-size: 1rem; font-weight: 700; border-bottom: 1px solid var(--color-border); padding-bottom: 6px; margin-bottom: 0;">1. Calculator Settings</h3>
      
      <!-- Currency Selector -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="mh-currency-select">Currency</label>
          <select id="mh-currency-select" class="currency-select" aria-label="Select Currency">
            <option value="USD" selected>USD ($) - US Dollar</option>
            <option value="EUR">EUR (€) - Euro</option>
            <option value="GBP">GBP (£) - British Pound</option>
            <option value="INR">INR (₹) - Indian Rupee</option>
            <option value="JPY">JPY (¥) - Japanese Yen</option>
            <option value="AUD">AUD (A$) - Australian Dollar</option>
            <option value="CAD">CAD (C$) - Canadian Dollar</option>
            <option value="SGD">SGD (S$) - Singapore Dollar</option>
            <option value="CHF">CHF (CHF) - Swiss Franc</option>
          </select>
        </div>
      </div>

      <!-- Mobile Home Type Selector -->
      <div class="input-group">
        <label style="font-size: 0.95rem; font-weight: 600; color: var(--color-text-base); margin-bottom: 2px;">Mobile Home Size</label>
        <div class="mode-segment-container" style="display: flex; background: var(--color-bg-base); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 4px; gap: 4px;">
          <button type="button" id="btn-mh-type-single" class="segment-btn active" style="flex: 1; border: none; background: transparent; padding: var(--space-2); font-size: 0.82rem; font-weight: 700; border-radius: var(--radius-sm); cursor: pointer; transition: all var(--transition-fast);">Single-Wide</button>
          <button type="button" id="btn-mh-type-double" class="segment-btn" style="flex: 1; border: none; background: transparent; padding: var(--space-2); font-size: 0.82rem; font-weight: 700; border-radius: var(--radius-sm); cursor: pointer; transition: all var(--transition-fast);">Double-Wide</button>
          <button type="button" id="btn-mh-type-triple" class="segment-btn" style="flex: 1; border: none; background: transparent; padding: var(--space-2); font-size: 0.82rem; font-weight: 700; border-radius: var(--radius-sm); cursor: pointer; transition: all var(--transition-fast);">Triple-Wide</button>
        </div>
      </div>
    </div>

    <!-- Step 2: Distance Details -->
    <div style="display: flex; flex-direction: column; gap: var(--space-5); margin-top: var(--space-5);">
      <h3 style="font-size: 1rem; font-weight: 700; border-bottom: 1px solid var(--color-border); padding-bottom: 6px; margin-bottom: 0;">2. Distance & Transport</h3>
      
      <!-- Moving Distance -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="mh-distance-input">Moving Distance</label>
          <div class="input-symbol-wrapper">
            <input type="number" id="mh-distance-input" min="1" max="1000" step="5" value="80" aria-label="Moving Distance" style="text-align: left;" />
            <span class="percent-symbol">miles</span>
          </div>
        </div>
        <input type="range" id="mh-distance-slider" min="1" max="500" step="5" value="80" class="slider-range" aria-label="Moving Distance Slider" />
      </div>

      <!-- Setup Foundation Options -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="mh-setup-select">Foundation & Setup Level</label>
          <select id="mh-setup-select" class="currency-select" aria-label="Select Foundation and Setup Service">
            <option value="NONE">None (Transport Only)</option>
            <option value="BASIC" selected>Basic Blocking & Tie-Downs</option>
            <option value="SLAB">Deluxe Concrete Footing / Slab</option>
          </select>
        </div>
      </div>

      <!-- Utilities Reconnections -->
      <div class="input-group" style="display: flex; flex-direction: row; align-items: center; gap: 8px;">
        <input type="checkbox" id="mh-utilities-check" checked style="width: 18px; height: 18px; cursor: pointer;" />
        <label for="mh-utilities-check" style="font-size: 0.9rem; font-weight: 600; color: var(--color-text-muted); cursor: pointer; user-select: none;">
          Include utility disconnect & reconnect
        </label>
      </div>
    </div>

    <!-- Step 3: Add-on Accessories -->
    <div style="display: flex; flex-direction: column; gap: var(--space-5); margin-top: var(--space-5);">
      <h3 style="font-size: 1rem; font-weight: 700; border-bottom: 1px solid var(--color-border); padding-bottom: 6px; margin-bottom: 0;">3. Optional Services</h3>
      
      <!-- Tires & Axle Prep -->
      <div class="input-group" style="display: flex; flex-direction: row; align-items: center; gap: 8px;">
        <input type="checkbox" id="mh-tires-check" checked style="width: 18px; height: 18px; cursor: pointer;" />
        <label for="mh-tires-check" style="font-size: 0.9rem; font-weight: 600; color: var(--color-text-muted); cursor: pointer; user-select: none;">
          Tires & Axle Rental / Prep (+$500)
        </label>
      </div>

      <!-- Skirting installation -->
      <div class="input-group" style="display: flex; flex-direction: row; align-items: center; gap: 8px;">
        <input type="checkbox" id="mh-skirting-check" style="width: 18px; height: 18px; cursor: pointer;" />
        <label for="mh-skirting-check" style="font-size: 0.9rem; font-weight: 600; color: var(--color-text-muted); cursor: pointer; user-select: none;">
          New Skirting Installation (+$1,200)
        </label>
      </div>

      <!-- AC Unit moving -->
      <div class="input-group" style="display: flex; flex-direction: row; align-items: center; gap: 8px;">
        <input type="checkbox" id="mh-ac-check" style="width: 18px; height: 18px; cursor: pointer;" />
        <label for="mh-ac-check" style="font-size: 0.9rem; font-weight: 600; color: var(--color-text-muted); cursor: pointer; user-select: none;">
          AC Unit Disconnect & Transport (+$600)
        </label>
      </div>
    </div>

    <!-- Reset Trigger -->
    <div class="inputs-actions" style="margin-top: var(--space-6);">
      <Button id="mh-reset" variant="outline" size="sm" style="width: 100%;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
        Reset Calculator Inputs
      </Button>
    </div>
  </div>

  <!-- Results Section -->
  <div slot="results" class="calc-results-wrapper">
    <h3 class="results-heading">Cost Estimation summary</h3>

    <!-- Primary Cost Displays -->
    <div class="net-value-container" style="display: flex; gap: var(--space-4); margin-bottom: var(--space-5);">
      <div class="net-value-box" style="flex: 1; border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); background: var(--color-bg-base); border-top: 4px solid var(--color-success);">
        <span style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--color-text-light);">Total Estimate</span>
        <div id="res-mh-total" style="font-size: 1.75rem; font-weight: 800; color: var(--color-success); margin-top: 4px;">$6,380.00</div>
        <span style="font-size: 0.65rem; color: var(--color-text-light);">Fully loaded transport and setup cost</span>
      </div>
      <div class="net-value-box" style="flex: 1; border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); background: var(--color-bg-base); border-top: 4px solid var(--color-primary);">
        <span style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--color-text-light);">Transport Base</span>
        <div id="res-mh-transport" style="font-size: 1.75rem; font-weight: 800; color: var(--color-primary); margin-top: 4px;">$2,680.00</div>
        <span style="font-size: 0.65rem; color: var(--color-text-light);">Includes base rate & mileage fee</span>
      </div>
    </div>

    <!-- Optimization Verdict -->
    <div style="margin-bottom: var(--space-6);">
      <Card elevation="sm" id="mh-verdict-card" style="border-left: 4px solid var(--color-success); padding: var(--space-4) var(--space-5); background: var(--color-bg-base);">
        <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: var(--color-text-muted);">Moving Diagnosis</span>
        <p id="res-mh-verdict-text" style="margin: 4px 0 0 0; font-size: 0.875rem; line-height: 1.5; color: var(--color-text-muted);">
          Your estimated mobile home moving cost is <strong>$6,380.00</strong>. This includes <strong>$2,680.00</strong> in transportation & mileage, <strong>$200.00</strong> in oversize permits, and <strong>$3,500.00</strong> in site setup, utilities, and optional adjustments.
        </p>
      </Card>
    </div>

    <!-- Detailed Cost Breakdown Table -->
    <h4 style="font-size: 0.95rem; font-weight: 700; margin-bottom: var(--space-3);">Itemized Cost Breakdown</h4>
    <div style="width: 100%; overflow-x: auto; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg-base);">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem; min-width: 480px;">
        <thead>
          <tr style="border-bottom: 2px solid var(--color-border); background: var(--color-bg-surface);">
            <th style="padding: var(--space-3); font-weight: 700; color: var(--color-text-base);">Service Element</th>
            <th style="padding: var(--space-3); font-weight: 700; text-align: right; color: var(--color-text-base);">Estimated Cost</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid var(--color-border);">
            <td style="padding: var(--space-3); font-weight: 600; color: var(--color-text-muted);">Base Transport Fee (up to 50 miles)</td>
            <td id="item-mh-base" style="padding: var(--space-3); text-align: right; color: var(--color-text-base); font-weight: 600;">$2,500.00</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-border);">
            <td style="padding: var(--space-3); font-weight: 600; color: var(--color-text-muted);">Overage Mileage Surcharge</td>
            <td id="item-mh-mileage" style="padding: var(--space-3); text-align: right; color: var(--color-text-base); font-weight: 600;">$180.00</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-border);">
            <td style="padding: var(--space-3); font-weight: 600; color: var(--color-text-muted);">State Oversize Cargo Permits</td>
            <td id="item-mh-permits-only" style="padding: var(--space-3); text-align: right; color: var(--color-text-base); font-weight: 600;">$200.00</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-border);">
            <td style="padding: var(--space-3); font-weight: 600; color: var(--color-text-muted);">Pilot Car Escort Vehicles</td>
            <td id="item-mh-escort" style="padding: var(--space-3); text-align: right; color: var(--color-text-base); font-weight: 600;">$0.00</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-border);">
            <td style="padding: var(--space-3); font-weight: 600; color: var(--color-text-muted);">Site Foundation Setup & Re-leveling</td>
            <td id="item-mh-setup" style="padding: var(--space-3); text-align: right; color: var(--color-text-base); font-weight: 600;">$2,000.00</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--color-border);">
            <td style="padding: var(--space-3); font-weight: 600; color: var(--color-text-muted);">Utility Disconnect & Reconnect</td>
            <td id="item-mh-utilities" style="padding: var(--space-3); text-align: right; color: var(--color-text-base); font-weight: 600;">$1,000.00</td>
          </tr>
          <tr style="border-bottom: none;">
            <td style="padding: var(--space-3); font-weight: 600; color: var(--color-text-muted);">Optional Services & Accessories</td>
            <td id="item-mh-addons" style="padding: var(--space-3); text-align: right; color: var(--color-text-base); font-weight: 600;">$500.00</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</CalculatorLayout>

<script>
  function initMhCalculator() {
    const currencySelect = document.getElementById('mh-currency-select') as HTMLSelectElement;

    // Mobile home type toggle buttons
    const btnSingle = document.getElementById('btn-mh-type-single') as HTMLButtonElement;
    const btnDouble = document.getElementById('btn-mh-type-double') as HTMLButtonElement;
    const btnTriple = document.getElementById('btn-mh-type-triple') as HTMLButtonElement;

    // Inputs
    const distanceInput = document.getElementById('mh-distance-input') as HTMLInputElement;
    const distanceSlider = document.getElementById('mh-distance-slider') as HTMLInputElement;
    const setupSelect = document.getElementById('mh-setup-select') as HTMLSelectElement;
    const utilitiesCheck = document.getElementById('mh-utilities-check') as HTMLInputElement;
    const tiresCheck = document.getElementById('mh-tires-check') as HTMLInputElement;
    const skirtingCheck = document.getElementById('mh-skirting-check') as HTMLInputElement;
    const acCheck = document.getElementById('mh-ac-check') as HTMLInputElement;

    let selectedType: 'single' | 'double' | 'triple' = 'single';

    if (!distanceInput || !currencySelect || !btnSingle) return;

    // Helper functions for sliders
    function bindSlider(input: HTMLInputElement, slider: HTMLInputElement, callback: () => void) {
      if (!input || !slider) return;
      input.addEventListener('input', () => {
        slider.value = input.value;
        callback();
      });
      slider.addEventListener('input', () => {
        input.value = slider.value;
        callback();
      });
    }

    // Bind distance
    bindSlider(distanceInput, distanceSlider, calculateAll);

    // Bind drop downs and checkboxes
    setupSelect.addEventListener('change', calculateAll);
    utilitiesCheck.addEventListener('change', calculateAll);
    tiresCheck.addEventListener('change', calculateAll);
    skirtingCheck.addEventListener('change', calculateAll);
    acCheck.addEventListener('change', calculateAll);

    function updateSegmentColors(activeBtn: HTMLButtonElement, otherBtns: HTMLButtonElement[]) {
      activeBtn.style.background = 'var(--color-primary)';
      activeBtn.style.color = 'var(--color-bg-base)';
      otherBtns.forEach(btn => {
        btn.style.background = 'transparent';
        btn.style.color = 'var(--color-text-base)';
      });
    }

    // Type toggles events
    btnSingle.addEventListener('click', () => {
      selectedType = 'single';
      btnSingle.classList.add('active');
      btnDouble.classList.remove('active');
      btnTriple.classList.remove('active');
      updateSegmentColors(btnSingle, [btnDouble, btnTriple]);
      calculateAll();
    });

    btnDouble.addEventListener('click', () => {
      selectedType = 'double';
      btnDouble.classList.add('active');
      btnSingle.classList.remove('active');
      btnTriple.classList.remove('active');
      updateSegmentColors(btnDouble, [btnSingle, btnTriple]);
      calculateAll();
    });

    btnTriple.addEventListener('click', () => {
      selectedType = 'triple';
      btnTriple.classList.add('active');
      btnSingle.classList.remove('active');
      btnDouble.classList.remove('active');
      updateSegmentColors(btnTriple, [btnSingle, btnDouble]);
      calculateAll();
    });

    // Style segment controller initially
    updateSegmentColors(btnSingle, [btnDouble, btnTriple]);

    // Currency updates
    currencySelect.addEventListener('change', () => {
      const symbol = getCurrencySymbol(currencySelect.value);
      document.querySelectorAll('.currency-symbol').forEach(el => el.textContent = symbol);
      calculateAll();
    });

    function getCurrencySymbol(curr: string) {
      switch (curr) {
        case 'EUR': return '€';
        case 'GBP': return '£';
        case 'INR': return '₹';
        case 'JPY': return '¥';
        case 'AUD': return 'A$';
        case 'CAD': return 'C$';
        case 'SGD': return 'S$';
        case 'CHF': return 'CHF';
        default: return '$';
      }
    }

    // Reset button
    const resetBtn = document.getElementById('mh-reset');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        selectedType = 'single';
        btnSingle.classList.add('active');
        btnDouble.classList.remove('active');
        btnTriple.classList.remove('active');
        updateSegmentColors(btnSingle, [btnDouble, btnTriple]);

        currencySelect.value = 'USD';
        document.querySelectorAll('.currency-symbol').forEach(el => el.textContent = '$');

        distanceInput.value = '80';
        distanceSlider.value = '80';
        setupSelect.value = 'BASIC';
        utilitiesCheck.checked = true;
        tiresCheck.checked = true;
        skirtingCheck.checked = false;
        acCheck.checked = false;

        calculateAll();
      });
    }

    function formatCurrency(val: number) {
      const symbol = getCurrencySymbol(currencySelect.value);
      return symbol + val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function calculateAll() {
      const distance = parseFloat(distanceInput.value) || 0;
      
      let baseTransportCost = 0;
      let overageRate = 0;
      let permitsCost = 0;
      let escortCost = 0;

      let setupCost = 0;
      let utilityCost = 0;
      let addonsCost = 0;

      // 1. Core Transport Logistics based on home width size
      if (selectedType === 'single') {
        baseTransportCost = 2500;
        overageRate = 6.00;
        permitsCost = 200;
        escortCost = 0;
      } else if (selectedType === 'double') {
        baseTransportCost = 5000;
        overageRate = 12.00;
        permitsCost = 400;
        // Double-wides require 1 escort vehicle for the full distance
        escortCost = distance * 2.00;
      } else {
        baseTransportCost = 8000;
        overageRate = 18.00;
        permitsCost = 700;
        // Triple-wides require 2 escort vehicles for the full distance
        escortCost = distance * 4.00;
      }

      // Mileage overages
      const baseDistance = 50;
      const overageMiles = Math.max(0, distance - baseDistance);
      const mileageSurcharge = overageMiles * overageRate;

      const transportSubtotal = baseTransportCost + mileageSurcharge;
      const regulatorySubtotal = permitsCost + escortCost;

      // 2. Foundation / Setup Pricing
      const setupType = setupSelect.value;
      if (setupType === 'BASIC') {
        if (selectedType === 'single') setupCost = 2000;
        else if (selectedType === 'double') setupCost = 4000;
        else setupCost = 6000;
      } else if (setupType === 'SLAB') {
        if (selectedType === 'single') setupCost = 4500;
        else if (selectedType === 'double') setupCost = 7500;
        else setupCost = 10500;
      } else {
        setupCost = 0;
      }

      // Utilities reconnections
      if (utilitiesCheck.checked) {
        if (selectedType === 'single') utilityCost = 1000;
        else if (selectedType === 'double') utilityCost = 1800;
        else utilityCost = 2500;
      } else {
        utilityCost = 0;
      }

      // 3. Add-on pricing
      if (tiresCheck.checked) addonsCost += 500;
      if (skirtingCheck.checked) addonsCost += 1200;
      if (acCheck.checked) addonsCost += 600;

      // Total loaded estimation sum
      const totalCost = transportSubtotal + regulatorySubtotal + setupCost + utilityCost + addonsCost;

      // DOM updates
      const resTotal = document.getElementById('res-mh-total');
      const resTransport = document.getElementById('res-mh-transport');
      const resVerdictText = document.getElementById('res-mh-verdict-text');

      if (resTotal) resTotal.textContent = formatCurrency(totalCost);
      if (resTransport) resTransport.textContent = formatCurrency(transportSubtotal);

      if (resVerdictText) {
        resVerdictText.innerHTML = `Your estimated mobile home moving cost is <strong>${formatCurrency(totalCost)}</strong>. This includes <strong>${formatCurrency(transportSubtotal)}</strong> in transportation & mileage, <strong>${formatCurrency(regulatorySubtotal)}</strong> in oversize permits and pilot cars, and <strong>${formatCurrency(setupCost + utilityCost + addonsCost)}</strong> in foundation setup, utilities, and optional services.`;
      }

      // Itemized values DOM
      const itemBase = document.getElementById('item-mh-base');
      const itemMileage = document.getElementById('item-mh-mileage');
      const itemPermitsOnly = document.getElementById('item-mh-permits-only');
      const itemEscort = document.getElementById('item-mh-escort');
      const itemSetup = document.getElementById('item-mh-setup');
      const itemUtilities = document.getElementById('item-mh-utilities');
      const itemAddons = document.getElementById('item-mh-addons');

      if (itemBase) itemBase.textContent = formatCurrency(baseTransportCost);
      if (itemMileage) itemMileage.textContent = formatCurrency(mileageSurcharge);
      if (itemPermitsOnly) itemPermitsOnly.textContent = formatCurrency(permitsCost);
      if (itemEscort) itemEscort.textContent = formatCurrency(escortCost);
      if (itemSetup) itemSetup.textContent = formatCurrency(setupCost);
      if (itemUtilities) itemUtilities.textContent = formatCurrency(utilityCost);
      if (itemAddons) itemAddons.textContent = formatCurrency(addonsCost);
    }

    // Trigger initial calculation
    calculateAll();

    // Clipboard Copy Results Handler
    window.addEventListener('copy-calculator-results', () => {
      const distance = distanceInput.value;
      const setupLevel = setupSelect.options[setupSelect.selectedIndex].text;
      const tires = tiresCheck.checked ? 'Yes' : 'No';
      const skirting = skirtingCheck.checked ? 'Yes' : 'No';
      const ac = acCheck.checked ? 'Yes' : 'No';

      const report = `Mobile Home Moving Cost Estimate Report:\n` +
                     `Home Size: ${selectedType === 'single' ? 'Single-Wide' : selectedType === 'double' ? 'Double-Wide' : 'Triple-Wide'}\n` +
                     `Moving Distance: ${distance} miles\n` +
                     `Setup Level: ${setupLevel}\n` +
                     `Utilities reconnected: ${utilitiesCheck.checked ? 'Yes' : 'No'}\n` +
                     `Tires/Axle Prep: ${tires} | Skirting setup: ${skirting} | AC service: ${ac}\n` +
                     `Estimated Total Moving Cost: ${document.getElementById('res-mh-total')?.textContent}\n` +
                     `Transportation subtotal: ${document.getElementById('res-mh-transport')?.textContent}\n` +
                     `Itemized estimates:\n` +
                     `- Base transport: ${document.getElementById('item-mh-base')?.textContent}\n` +
                     `- Mileage surcharge: ${document.getElementById('item-mh-mileage')?.textContent}\n` +
                     `- Permits: ${document.getElementById('item-mh-permits-only')?.textContent}\n` +
                     `- Escort cars: ${document.getElementById('item-mh-escort')?.textContent}\n` +
                     `- Foundation setup: ${document.getElementById('item-mh-setup')?.textContent}\n` +
                     `- Utilities reconnect: ${document.getElementById('item-mh-utilities')?.textContent}\n` +
                     `- Optional adjustments: ${document.getElementById('item-mh-addons')?.textContent}\n` +
                     `Diagnosis: ${document.getElementById('res-mh-verdict-text')?.textContent}`;

      navigator.clipboard.writeText(report).then(() => {
        window.dispatchEvent(new CustomEvent('calculator-copied-success'));
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initMhCalculator);
  document.addEventListener('astro:after-swap', initMhCalculator);
</script>

<style>
  .calc-inputs-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .input-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }

  .input-label-row label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-base);
  }

  /* Input symbol wrapper */
  .input-symbol-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    background-color: var(--color-bg-base);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0 10px;
    width: 145px;
    height: 38px;
    transition: border-color var(--transition-fast);
  }

