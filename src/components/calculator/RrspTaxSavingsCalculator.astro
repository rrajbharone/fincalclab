              { from: 154244, to: 215943, rate: 0.178 },
              { from: 215943, to: 274640, rate: 0.198 },
              { from: 274640, to: 549280, rate: 0.208 },
              { from: 549280, to: Infinity, rate: 0.218 }
            ]
          },
          'PE': {
