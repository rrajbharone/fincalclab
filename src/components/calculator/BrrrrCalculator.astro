        initRateInput.value = '8.0';
        initRateSlider.value = '8.0';
        if (initLoanTypeSelect) initLoanTypeSelect.value = 'amort30';
        refiLtvInput.value = '75';
        refiLtvSlider.value = '75';
        refiClosingInput.value = '4500';
        refiClosingSlider.value = '4500';
        refiRateInput.value = '6.5';
        refiRateSlider.value = '6.5';
        if (refiTermSelect) refiTermSelect.value = '30';

        recalculate();
      });
    }

    // Standard Monthly Amortization Payment Formula
    function calcMonthlyPayment(principal, annualRatePct, termYears) {
      if (principal <= 0) return 0;
      if (annualRatePct <= 0) return principal / (termYears * 12);
      const r = annualRatePct / 100 / 12;
      const n = termYears * 12;
      return (principal * (r * Math.pow(1 + r, n))) / (Math.pow(1 + r, n) - 1);
    }

    // Remaining Balance Formula after H months
    function calcRemainingBalance(principal, annualRatePct, termYears, monthsElapsed, loanType) {
      if (principal <= 0) return 0;
      if (loanType === 'interestOnly') {
        // Interest only loan principal does not amortize
        return principal;
      }
      const totalMonths = termYears * 12;
      if (monthsElapsed >= totalMonths) return 0;
      if (annualRatePct <= 0) {
        return Math.max(0, principal - (principal / totalMonths) * monthsElapsed);
      }
      const r = annualRatePct / 100 / 12;
      const n = totalMonths;
      const balance = (principal * (Math.pow(1 + r, n) - Math.pow(1 + r, monthsElapsed))) / (Math.pow(1 + r, n) - 1);
      return Math.max(0, balance);
    }

    // Calculation Engine
    function recalculate() {
      const purchasePrice = Math.max(0, parseFloat(purchasePriceInput?.value) || 0);
      const downPct = Math.max(0, Math.min(100, parseFloat(downPctInput?.value) || 0));
      const downPayment = Math.max(0, parseFloat(downAmtInput?.value) || 0);
      const rehabCost = Math.max(0, parseFloat(rehabCostInput?.value) || 0);
      const purchaseClosing = Math.max(0, parseFloat(purchaseClosingInput?.value) || 0);
      const monthlyHolding = Math.max(0, parseFloat(monthlyHoldingInput?.value) || 0);
      const refiMonths = Math.max(1, parseInt(refiMonthsInput?.value, 10) || 6);

      const arv = Math.max(0, parseFloat(arvInput?.value) || 0);
      const monthlyRent = Math.max(0, parseFloat(monthlyRentInput?.value) || 0);
      const monthlyExpenses = Math.max(0, parseFloat(monthlyExpensesInput?.value) || 0);

      const initRate = Math.max(0, parseFloat(initRateInput?.value) || 0);
      const initLoanType = initLoanTypeSelect?.value || 'amort30';
      const refiLtvPct = Math.max(0, Math.min(100, parseFloat(refiLtvInput?.value) || 75));
      const refiClosing = Math.max(0, parseFloat(refiClosingInput?.value) || 0);
      const refiRate = Math.max(0, parseFloat(refiRateInput?.value) || 6.5);
      const refiTermYears = parseInt(refiTermSelect?.value, 10) || 30;

      // 1. Initial Investment & Acquisition Financing
      const totalHoldingCosts = monthlyHolding * refiMonths;
      const totalInitialCashInvested = downPayment + rehabCost + purchaseClosing + totalHoldingCosts;
      
      const initialPrincipal = Math.max(0, purchasePrice - downPayment);
      let initTermYears = 30;
      if (initLoanType === 'amort15') initTermYears = 15;
      if (initLoanType === 'interestOnly') initTermYears = 1;

      // Original Loan Payoff at Refinance Month
      let originalLoanPayoff = 0;
      if (initialPrincipal > 0) {
        originalLoanPayoff = calcRemainingBalance(initialPrincipal, initRate, initTermYears, refiMonths, initLoanType);
      }

      // 2. Refinance Calculations
      const newLoanAmount = arv * (refiLtvPct / 100);
      // Net Cash Returned to investor = New Loan - Payoff Old Loan - Refinance Closing Costs
      const netCashReturned = newLoanAmount - originalLoanPayoff - refiClosing;

      // Cash Left in Deal = Initial Cash Invested - Net Cash Returned
      const cashLeftInDeal = totalInitialCashInvested - netCashReturned;
      const capitalRecoveryPct = totalInitialCashInvested > 0 ? (netCashReturned / totalInitialCashInvested) * 100 : 0;

      // 3. New Monthly Mortgage Payment (P&I)
      const newMonthlyMortgage = calcMonthlyPayment(newLoanAmount, refiRate, refiTermYears);

      // 4. Monthly & Annual Rental Cash Flow
      const monthlyNetCashFlow = monthlyRent - monthlyExpenses - newMonthlyMortgage;
      const annualNetCashFlow = monthlyNetCashFlow * 12;

      // 5. Cash-on-Cash Return
      let cocReturn = 0;
      let isInfiniteReturn = false;
      if (cashLeftInDeal <= 0) {
        if (annualNetCashFlow > 0) {
          isInfiniteReturn = true;
        } else {
          cocReturn = 0;
        }
      } else {
        cocReturn = (annualNetCashFlow / cashLeftInDeal) * 100;
      }

      // Retained Property Equity
      const retainedEquity = Math.max(0, arv - newLoanAmount);

      // Render Outputs
      // 1. Primary Highlight Cards
      if (cashLeftInDeal <= 0) {
        resCashLeft.textContent = '$0 (All Cash Out)';
        resCashLeft.className = 'net-box-amount text-success';
        const surplus = Math.abs(cashLeftInDeal);
        if (surplus > 0) {
          lblCashLeftSub.textContent = `100% recovered + ${formatCurrency(surplus)} cash profit`;
        } else {
          lblCashLeftSub.textContent = '100% of all initial capital recovered';
        }
      } else {
        resCashLeft.textContent = formatCurrency(cashLeftInDeal);
        resCashLeft.className = 'net-box-amount text-primary';
        lblCashLeftSub.textContent = `${capitalRecoveryPct.toFixed(0)}% of capital recouped at refi`;
      }

      resCashReturned.textContent = formatCurrency(Math.max(0, netCashReturned));
      lblCashReturnedSub.textContent = `From ${formatCurrency(newLoanAmount)} Refinance Loan`;

      // 2. Alert Banner Assessment
      if (cashLeftInDeal <= 0 && monthlyNetCashFlow > 0) {
        alertBanner.className = 'alert-banner alert-success';
        alertIcon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>';
        alertTitle.textContent = '🎉 Perfect BRRRR: Infinite Cash-on-Cash Return!';
        alertDesc.textContent = `You extracted 100% of your initial capital (${formatCurrency(totalInitialCashInvested)}) at refinance. You now own a ${formatCurrency(arv)} asset with ${formatCurrency(retainedEquity)} in equity and $0 cash left in the deal!`;
      } else if (monthlyNetCashFlow <= 0) {
        alertBanner.className = 'alert-banner alert-warning';
        alertIcon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>';
        alertTitle.textContent = '⚠️ Negative or Neutral Cash Flow Warning';
        alertDesc.textContent = `Operating expenses and new debt service (${formatCurrency(newMonthlyMortgage)}/mo) exceed or match gross rent. Consider higher rent, lower refinance LTV, or expense reductions.`;
      } else if (capitalRecoveryPct >= 70) {
        alertBanner.className = 'alert-banner alert-info';
        alertIcon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>';
        alertTitle.textContent = `⚡ Partial Capital Recovery: ${capitalRecoveryPct.toFixed(0)}% Capital Returned`;
        alertDesc.textContent = `You returned ${formatCurrency(netCashReturned)} of your ${formatCurrency(totalInitialCashInvested)} cash invested. Only ${formatCurrency(cashLeftInDeal)} remains tied up, yielding an outstanding ${cocReturn.toFixed(1)}% Cash-on-Cash return!`;
      } else {
        alertBanner.className = 'alert-banner alert-info';
        alertIcon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>';
        alertTitle.textContent = `Deal Evaluation: ${capitalRecoveryPct.toFixed(0)}% Capital Returned at Refi`;
        alertDesc.textContent = `${formatCurrency(cashLeftInDeal)} remains in the property after cash-out refinance. The asset generates ${formatCurrency(monthlyNetCashFlow)}/month in net passive cash flow.`;
      }

      // 3. Flow Tracker
      flowBuyVal.textContent = formatCurrency(purchasePrice);
      flowBuySub.textContent = `Down: ${formatCurrency(downPayment)} | Loan: ${formatCurrency(initialPrincipal)}`;
      flowRehabVal.textContent = formatCurrency(rehabCost + totalHoldingCosts);
      flowRehabSub.textContent = `${formatCurrency(rehabCost)} work + ${formatCurrency(totalHoldingCosts)} holding`;
      flowRentVal.textContent = `${formatCurrency(monthlyRent)}/mo`;
      flowRentSub.textContent = `OpEx: ${formatCurrency(monthlyExpenses)}/mo`;
      flowRefiVal.textContent = formatCurrency(newLoanAmount);
      flowRefiSub.textContent = `Payoff: ${formatCurrency(originalLoanPayoff)} | Cash Out: ${formatCurrency(netCashReturned)}`;

      // 4. Metrics Grid Tiles
      tileInitialCash.textContent = formatCurrency(totalInitialCashInvested);
      lblTileInitialSub.textContent = `${formatCurrency(downPayment)} down + ${formatCurrency(rehabCost)} rehab + ${formatCurrency(purchaseClosing + totalHoldingCosts)} closing/holding`;

      tileNewLoan.textContent = formatCurrency(newLoanAmount);
      lblTileNewLoanSub.textContent = `${refiLtvPct}% LTV on ${formatCurrency(arv)} ARV`;

      tileLoanPayoff.textContent = formatCurrency(originalLoanPayoff);
      lblTilePayoffSub.textContent = initialPrincipal > 0 ? `Principal payoff after ${refiMonths} months` : 'All-cash purchase (no loan)';

      tileNewMortgage.textContent = `${formatCurrency(newMonthlyMortgage)} / mo`;
      lblTileMortgageSub.textContent = `${refiRate.toFixed(2)}% Rate, ${refiTermYears}-Yr Term`;

      tileMonthlyCf.textContent = `${formatCurrency(monthlyNetCashFlow)} / mo`;
      tileMonthlyCf.style.color = monthlyNetCashFlow >= 0 ? 'var(--color-success, #16a34a)' : '#ef4444';
      lblTileMcfSub.textContent = `${formatCurrency(monthlyRent)} rent − ${formatCurrency(monthlyExpenses)} OpEx − ${formatCurrency(newMonthlyMortgage)} P&I`;

      tileAnnualCf.textContent = `${formatCurrency(annualNetCashFlow)} / yr`;
      tileAnnualCf.style.color = annualNetCashFlow >= 0 ? 'var(--color-success, #16a34a)' : '#ef4444';
      lblTileAcfSub.textContent = 'Passive pre-tax rental income';

      if (isInfiniteReturn) {
        tileCocReturn.textContent = 'Infinite / 100%+';
        tileCocReturn.className = 'tile-value text-success';
        lblTileCocSub.textContent = '100% of cash invested was recovered!';
      } else if (cashLeftInDeal <= 0) {
        tileCocReturn.textContent = 'N/A';
        tileCocReturn.className = 'tile-value text-base';
        lblTileCocSub.textContent = 'Zero or negative net cash flow';
      } else {
        tileCocReturn.textContent = `${cocReturn.toFixed(1)}%`;
        tileCocReturn.className = 'tile-value text-primary';
        lblTileCocSub.textContent = `${formatCurrency(annualNetCashFlow)}/yr on ${formatCurrency(cashLeftInDeal)} remaining`;
      }

      tileEquityRetained.textContent = formatCurrency(retainedEquity);
      lblTileEquitySub.textContent = `${(100 - refiLtvPct)}% equity in ${formatCurrency(arv)} property`;

      // Context Card
      if (cashLeftInDeal <= 0) {
        lblRepeatTitle.textContent = 'Infinite Velocity of Capital';
        lblContextDesc.innerHTML = `Because you extracted <strong>100% of your initial cash (${formatCurrency(totalInitialCashInvested)})</strong>, your effective basis is <strong>$0</strong>. You keep a <strong>${formatCurrency(arv)}</strong> real estate asset producing <strong>${formatCurrency(monthlyNetCashFlow)}/month</strong>, and your entire original capital is 100% free to repeat the process immediately!`;
      } else {
        lblRepeatTitle.textContent = 'Recycling Your Capital';
        lblContextDesc.innerHTML = `Because you recovered <strong>${formatCurrency(netCashReturned)}</strong> of your initial <strong>${formatCurrency(totalInitialCashInvested)}</strong>, you retain <strong>${formatCurrency(retainedEquity)}</strong> in equity and <strong>${formatCurrency(monthlyNetCashFlow)}/month</strong> in cash flow, while having the liquidity ready to acquire your next BRRRR property!`;
      }
    }

    // Initial Calculation
    recalculate();

    // Clipboard Copy Handler from CalculatorLayout toolbar
    window.addEventListener('copy-calculator-results', async () => {
      try {
        const cashLeft = resCashLeft?.textContent || '—';
        const cashReturned = resCashReturned?.textContent || '—';
        const initialCash = tileInitialCash?.textContent || '—';
        const newLoan = tileNewLoan?.textContent || '—';
        const monthlyCf = tileMonthlyCf?.textContent || '—';
        const annualCf = tileAnnualCf?.textContent || '—';
        const coc = tileCocReturn?.textContent || '—';
        const equity = tileEquityRetained?.textContent || '—';

        const summaryText = `BRRRR Strategy Investment Analysis (FinCalcLab.com):
• Total Initial Cash Invested: ${initialCash}
• Cash Left in Deal: ${cashLeft}
• Net Cash Returned at Refi: ${cashReturned}
• New Refinance Loan: ${newLoan}
• Monthly Net Cash Flow: ${monthlyCf}
• Annual Net Cash Flow: ${annualCf}
• Cash-on-Cash Return: ${coc}
• Retained Property Equity: ${equity}
Calculated at https://fincalclab.com/calculator/brrrr-calculator`;

        await navigator.clipboard.writeText(summaryText);
        window.dispatchEvent(new CustomEvent('calculator-copied-success'));
      } catch (err) {
        console.error('Failed to copy results:', err);
      }
    });
