---
import CalculatorLayout from './CalculatorLayout.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
---

<CalculatorLayout
  title="True Cost of Home Ownership Calculator"
  description="Calculate the true all-in monthly and annual cost of owning a home, including mortgage principal and interest, property taxes, insurance, HOA fees, maintenance, and utilities."
  category="Real Estate &amp; Mortgages"
>
  <!-- Inputs Section -->
  <div slot="inputs" class="calc-inputs-wrapper" id="home-cost-calculator">
    
    <!-- Currency Selector -->
    <div class="input-group">
      <label for="tc-currency-select" class="field-label-top">Currency</label>
      <select id="tc-currency-select" class="form-select-full" aria-label="Select Currency">
        <option value="USD" selected>USD ($) - US Dollar</option>
        <option value="CAD">CAD (C$) - Canadian Dollar</option>
        <option value="GBP">GBP (£) - British Pound</option>
        <option value="EUR">EUR (€) - Euro</option>
        <option value="AUD">AUD (A$) - Australian Dollar</option>
        <option value="INR">INR (₹) - Indian Rupee</option>
        <option value="SGD">SGD (S$) - Singapore Dollar</option>
        <option value="JPY">JPY (¥) - Japanese Yen</option>
        <option value="CHF">CHF (CHF) - Swiss Franc</option>
      </select>
    </div>

    <!-- Section 1: Purchase Price & Mortgage Financing -->
    <h3 class="input-section-heading">1. Home Purchase &amp; Mortgage Financing</h3>

    <!-- Purchase Price -->
    <div class="input-group">
      <div class="input-label-row">
        <label for="tc-purchase-price">Home Purchase Price ($)</label>
        <div class="input-symbol-wrapper">
          <span class="currency-symbol" id="sym-price">$</span>
          <input 
            type="number" 
            id="tc-purchase-price" 
            min="10000" 
            max="10000000" 
            step="5000" 
            value="350000" 
            aria-label="Home Purchase Price" 
          />
        </div>
      </div>
      <input 
        type="range" 
        id="tc-purchase-price-slider" 
        min="100000" 
        max="1000000" 
        step="10000" 
        value="350000" 
        class="slider-range" 
        aria-label="Purchase Price Slider" 
      />
      <span class="input-hint">Agreed purchase price for the residential property.</span>
    </div>

    <!-- Down Payment -->
    <div class="input-group">
      <div class="input-label-row">
        <div class="label-with-badge">
          <label for="tc-down-payment">Down Payment ($)</label>
          <span class="pct-badge" id="tc-down-pct-badge">20.0% of price</span>
        </div>
        <div class="input-symbol-wrapper">
          <span class="currency-symbol" id="sym-down">$</span>
          <input 
            type="number" 
            id="tc-down-payment" 
            min="0" 
            max="10000000" 
            step="1000" 
            value="70000" 
            aria-label="Down Payment Amount" 
          />
        </div>
      </div>
      <input 
        type="range" 
        id="tc-down-payment-slider" 
        min="0" 
        max="350000" 
        step="5000" 
        value="70000" 
        class="slider-range" 
        aria-label="Down Payment Slider" 
      />
      <div class="quick-chips-row" aria-label="Quick down payment options">
        <span class="chips-label">Down %:</span>
        <button type="button" class="down-chip-btn" data-pct="5">5%</button>
        <button type="button" class="down-chip-btn" data-pct="10">10%</button>
        <button type="button" class="down-chip-btn active" data-pct="20">20%</button>
        <button type="button" class="down-chip-btn" data-pct="30">30%</button>
        <button type="button" class="down-chip-btn" data-pct="100">100% (All Cash)</button>
      </div>
      <span class="input-hint">Upfront equity cash contributed. Reduces borrowed principal and monthly interest.</span>
    </div>

    <!-- Mortgage Rate & Term Grid -->
    <div class="input-row-grid">
      <div class="input-group">
        <div class="input-label-row">
          <label for="tc-mortgage-rate">Mortgage Interest Rate (%)</label>
          <div class="input-symbol-wrapper">
            <input 
              type="number" 
              id="tc-mortgage-rate" 
              min="0" 
              max="20" 
              step="0.1" 
              value="6.5" 
              aria-label="Mortgage Interest Rate" 
            />
            <span class="percent-symbol">%</span>
          </div>
        </div>
        <input 
          type="range" 
          id="tc-mortgage-rate-slider" 
          min="0" 
          max="12" 
          step="0.1" 
          value="6.5" 
          class="slider-range" 
          aria-label="Mortgage Rate Slider" 
        />
        <span class="input-hint">Annual fixed mortgage interest rate.</span>
      </div>

      <div class="input-group">
        <div class="input-label-row">
          <label for="tc-mortgage-term">Mortgage Term (Years)</label>
          <div class="input-symbol-wrapper">
            <input 
              type="number" 
              id="tc-mortgage-term" 
              min="1" 
              max="40" 
              step="1" 
              value="30" 
              aria-label="Mortgage Term in Years" 
            />
            <span class="unit-symbol">yrs</span>
          </div>
        </div>
        <div class="quick-chips-row" style="margin-top: 6px;" aria-label="Quick mortgage term presets">
          <button type="button" class="term-chip-btn" data-term="15">15y</button>
          <button type="button" class="term-chip-btn" data-term="20">20y</button>
          <button type="button" class="term-chip-btn active" data-term="30">30y</button>
        </div>
        <span class="input-hint">Duration of mortgage loan (30 years = 360 monthly payments).</span>
      </div>
    </div>

    <!-- Section 2: Property Taxes, Insurance & HOA -->
    <div style="margin-top: var(--space-5);">
      <h3 class="input-section-heading">2. Property Taxes, Insurance &amp; HOA Dues</h3>
      
      <div class="input-row-grid">
        <div class="input-group">
          <div class="input-label-row">
            <label for="tc-annual-tax">Annual Property Tax ($)</label>
            <div class="input-symbol-wrapper">
              <span class="currency-symbol" id="sym-tax">$</span>
              <input 
                type="number" 
                id="tc-annual-tax" 
                min="0" 
                max="100000" 
                step="100" 
                value="4200" 
                aria-label="Annual Property Tax" 
              />
            </div>
          </div>
          <span class="input-hint" id="tc-tax-monthly-hint">$350/mo escrowed for municipal property taxes (~1.2% rate).</span>
        </div>

        <div class="input-group">
          <div class="input-label-row">
            <label for="tc-annual-insurance">Annual Homeowners Insurance ($)</label>
            <div class="input-symbol-wrapper">
              <span class="currency-symbol" id="sym-ins">$</span>
              <input 
                type="number" 
                id="tc-annual-insurance" 
                min="0" 
                max="50000" 
                step="50" 
                value="1800" 
                aria-label="Annual Homeowners Insurance" 
              />
            </div>
          </div>
          <span class="input-hint" id="tc-ins-monthly-hint">$150/mo for hazard, fire, wind, and liability insurance.</span>
        </div>
      </div>

      <div class="input-group">
        <div class="input-label-row">
          <label for="tc-monthly-hoa">Monthly HOA Fees ($)</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol" id="sym-hoa">$</span>
            <input 
              type="number" 
              id="tc-monthly-hoa" 
              min="0" 
              max="5000" 
              step="25" 
              value="0" 
              aria-label="Monthly HOA Fees" 
            />
          </div>
        </div>
        <span class="input-hint">Homeowners Association, condo regime, or community maintenance dues.</span>
      </div>
    </div>

    <!-- Section 3: Maintenance, Utilities & Other Ownership Costs -->
    <div style="margin-top: var(--space-5);">
      <h3 class="input-section-heading">3. Maintenance, Utilities &amp; Living Upkeep</h3>
      
      <div class="input-row-grid">
        <div class="input-group">
          <div class="input-label-row">
            <label for="tc-monthly-maint">Monthly Maintenance &amp; Repairs ($)</label>
            <div class="input-symbol-wrapper">
              <span class="currency-symbol" id="sym-maint">$</span>
              <input 
                type="number" 
                id="tc-monthly-maint" 
                min="0" 
                max="10000" 
                step="25" 
                value="350" 
                aria-label="Monthly Maintenance and Repairs" 
              />
            </div>
          </div>
          <span class="input-hint">Reserve for roof, HVAC, plumbing, painting, and appliance repairs (~1% rule).</span>
        </div>

        <div class="input-group">
          <div class="input-label-row">
            <label for="tc-monthly-util">Monthly Utilities ($)</label>
            <div class="input-symbol-wrapper">
              <span class="currency-symbol" id="sym-util">$</span>
              <input 
                type="number" 
                id="tc-monthly-util" 
                min="0" 
                max="5000" 
                step="25" 
                value="300" 
                aria-label="Monthly Utilities" 
              />
            </div>
          </div>
          <span class="input-hint">Electricity, heating gas, municipal water, sewer, trash, and recycling.</span>
        </div>
      </div>

      <div class="input-group">
        <div class="input-label-row">
          <label for="tc-monthly-other">Monthly Other Costs ($)</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol" id="sym-other">$</span>
            <input 
              type="number" 
              id="tc-monthly-other" 
              min="0" 
              max="5000" 
              step="25" 
              value="100" 
              aria-label="Other Monthly Homeownership Costs" 
            />
          </div>
        </div>
        <span class="input-hint">Lawn care, pest control, security system monitoring, and home warranty subscriptions.</span>
      </div>
    </div>

    <!-- Reset Form Button -->
    <div class="reset-action-row">
      <button type="button" id="tc-reset-btn" class="reset-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
        <span>Reset to Default Example</span>
      </button>
    </div>

  </div>

  <!-- Results Section -->
  <div slot="results" class="calc-results-wrapper" id="home-cost-results-panel">
    
    <div class="results-header">
      <h2 class="results-title">True Homeownership Cost Summary</h2>
      <span class="results-subtitle">Comprehensive monthly, annual, and 30-year expenditure breakdown</span>
    </div>

    <!-- 5 Hero Cards (The 5 Prominent Required Results) -->
    <div class="hero-metrics-grid">
      <!-- 1: Total Monthly Cost -->
      <div class="hero-metric-card primary-hero">
        <span class="hero-label">Total Monthly Homeownership Cost</span>
        <div class="hero-value-wrap">
          <span class="hero-value" id="res-total-monthly">$3,020</span>
          <span class="hero-unit">/mo</span>
        </div>
        <span class="hero-subtext" id="res-monthly-subtext">True all-in out-of-pocket monthly housing expense</span>
      </div>

      <!-- 2: Monthly Mortgage Payment (P&I) -->
      <div class="hero-metric-card secondary-hero">
        <span class="hero-label">Monthly Mortgage Payment (P&amp;I)</span>
        <div class="hero-value-wrap">
          <span class="hero-value" id="res-monthly-pi">$1,770</span>
          <span class="hero-unit">/mo</span>
        </div>
        <span class="hero-subtext" id="res-pi-pct-subtext">58.6% of total monthly expense</span>
      </div>

      <!-- 3: Monthly Non-Mortgage Costs -->
      <div class="hero-metric-card secondary-hero">
        <span class="hero-label">Monthly Non-Mortgage Costs</span>
        <div class="hero-value-wrap">
          <span class="hero-value text-accent" id="res-monthly-non-mortgage">$1,250</span>
          <span class="hero-unit">/mo</span>
        </div>
        <span class="hero-subtext" id="res-non-mortgage-subtext">Taxes, insurance, HOA, upkeep &amp; utilities</span>
      </div>

      <!-- 4: Estimated Annual Cost -->
      <div class="hero-metric-card primary-hero">
        <span class="hero-label">Estimated Annual Cost</span>
        <div class="hero-value-wrap">
          <span class="hero-value" id="res-annual-total">$36,237</span>
          <span class="hero-unit">/yr</span>
        </div>
        <span class="hero-subtext">Total annual cost across all categories</span>
      </div>
    </div>

    <!-- Hero 5: Total Mortgage Interest Over Term -->
    <div class="interest-hero-banner">
      <div class="interest-hero-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path><line x1="12" y1="6" x2="12" y2="18"></line></svg>
      </div>
      <div class="interest-hero-text">
        <span class="interest-hero-label">Total Mortgage Interest Over Loan Term</span>
        <div class="interest-hero-val-row">
          <span class="interest-hero-val" id="res-total-interest">$357,125</span>
          <span class="interest-hero-sub" id="res-interest-sub">on a $280,000 mortgage principal (30 years)</span>
        </div>
      </div>
    </div>

    <!-- Visual Monthly Cost Breakdown Bar -->
    <div class="cost-bar-card">
      <div class="bar-header">
        <span class="bar-title">Monthly Expenditure Distribution</span>
        <span class="bar-total" id="res-bar-total">$3,020 /mo</span>
      </div>

      <div class="stacked-bar-container" role="progressbar" aria-valuemin="0" aria-valuemax="100" id="res-progress-bar" aria-label="Monthly homeownership cost breakdown">
        <div class="bar-segment bar-pi" id="bar-pi" style="width: 58.6%;" title="Mortgage Principal & Interest"></div>
        <div class="bar-segment bar-taxes" id="bar-taxes" style="width: 16.6%;" title="Taxes & Insurance"></div>
        <div class="bar-segment bar-maint" id="bar-maint" style="width: 11.6%;" title="Maintenance & Repairs"></div>
        <div class="bar-segment bar-util" id="bar-util" style="width: 13.2%;" title="Utilities, HOA & Other"></div>
      </div>

      <div class="breakdown-legend">
        <div class="legend-item">
          <span class="legend-color-dot dot-pi"></span>
          <div class="legend-text-col">
            <span class="legend-title">Mortgage P&amp;I</span>
            <span class="legend-numbers" id="legend-pi">$1,770 (58.6%)</span>
          </div>
        </div>

        <div class="legend-item">
          <span class="legend-color-dot dot-taxes"></span>
          <div class="legend-text-col">
            <span class="legend-title">Taxes &amp; Insurance</span>
            <span class="legend-numbers" id="legend-taxes">$500 (16.6%)</span>
          </div>
        </div>

        <div class="legend-item">
          <span class="legend-color-dot dot-maint"></span>
          <div class="legend-text-col">
            <span class="legend-title">Maintenance</span>
            <span class="legend-numbers" id="legend-maint">$350 (11.6%)</span>
          </div>
        </div>

        <div class="legend-item">
          <span class="legend-color-dot dot-util"></span>
          <div class="legend-text-col">
            <span class="legend-title">Utilities &amp; Other</span>
            <span class="legend-numbers" id="legend-util">$400 (13.2%)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Itemized Monthly & Annual Expense Table -->
    <div class="itemized-table-card">
      <div class="itemized-header">
        <span class="itemized-title">Itemized Expense Breakdown</span>
      </div>
      <div class="table-compact-wrapper">
        <table class="itemized-table">
          <thead>
            <tr>
              <th scope="col">Expense Category</th>
              <th scope="col" style="text-align: right;">Monthly</th>
              <th scope="col" style="text-align: right;">Annual</th>
              <th scope="col" style="text-align: right;">Share</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Mortgage Principal &amp; Interest (P&amp;I)</td>
              <td style="text-align: right; font-weight: 700;" id="row-pi">$1,770</td>
              <td style="text-align: right;" id="row-pi-annual">$21,237</td>
              <td style="text-align: right;" id="row-pi-share">58.6%</td>
            </tr>
            <tr>
              <td>Property Taxes</td>
              <td style="text-align: right; font-weight: 700;" id="row-tax">$350</td>
              <td style="text-align: right;" id="row-tax-annual">$4,200</td>
              <td style="text-align: right;" id="row-tax-share">11.6%</td>
            </tr>
            <tr>
              <td>Homeowners Hazard Insurance</td>
              <td style="text-align: right; font-weight: 700;" id="row-ins">$150</td>
              <td style="text-align: right;" id="row-ins-annual">$1,800</td>
              <td style="text-align: right;" id="row-ins-share">5.0%</td>
            </tr>
            <tr>
              <td>HOA Dues</td>
              <td style="text-align: right; font-weight: 700;" id="row-hoa">$0</td>
              <td style="text-align: right;" id="row-hoa-annual">$0</td>
              <td style="text-align: right;" id="row-hoa-share">0.0%</td>
            </tr>
            <tr>
              <td>Maintenance &amp; Structural Repairs</td>
              <td style="text-align: right; font-weight: 700;" id="row-maint">$350</td>
              <td style="text-align: right;" id="row-maint-annual">$4,200</td>
              <td style="text-align: right;" id="row-maint-share">11.6%</td>
            </tr>
            <tr>
              <td>Utilities (Water, Gas, Electric, Trash)</td>
              <td style="text-align: right; font-weight: 700;" id="row-util">$300</td>
              <td style="text-align: right;" id="row-util-annual">$3,600</td>
              <td style="text-align: right;" id="row-util-share">9.9%</td>
            </tr>
            <tr>
              <td>Other Recurring Costs (Lawn, Security)</td>
              <td style="text-align: right; font-weight: 700;" id="row-other">$100</td>
              <td style="text-align: right;" id="row-other-annual">$1,200</td>
              <td style="text-align: right;" id="row-other-share">3.3%</td>
            </tr>
            <tr class="table-total-row">
              <td><strong>Total Estimated Out-of-Pocket</strong></td>
              <td style="text-align: right; font-weight: 800; color: var(--color-primary);" id="row-total-monthly">$3,020</td>
              <td style="text-align: right; font-weight: 800; color: var(--color-primary);" id="row-total-annual">$36,237</td>
              <td style="text-align: right; font-weight: 800;">100.0%</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Lifetime Ownership Horizon Card -->
    <div class="lifetime-card">
      <div class="lifetime-header">
        <span class="lifetime-title">Cumulative Cost Over <span id="res-term-display">30</span>-Year Mortgage Term</span>
      </div>
      <div class="lifetime-metrics-grid">
        <div class="life-col">
          <span class="life-label">Initial Down Payment</span>
          <span class="life-val" id="res-life-down">$70,000</span>
          <span class="life-sub">Initial cash equity basis</span>
        </div>
        <div class="life-col">
          <span class="life-label">Total Mortgage Payments</span>
          <span class="life-val" id="res-life-mortgage">$637,125</span>
          <span class="life-sub" id="res-life-mortgage-sub">Principal ($280k) + Interest ($357k)</span>
        </div>
        <div class="life-col">
          <span class="life-label">Total Non-Mortgage Costs</span>
          <span class="life-val text-accent" id="res-life-non-mortgage">$450,000</span>
          <span class="life-sub">Taxes, repairs &amp; utilities</span>
        </div>
      </div>
      <div class="lifetime-footer">
        <span class="life-footer-label">Total All-In Expenditure (Including Down Payment):</span>
        <span class="life-footer-val" id="res-life-all-in">$1,157,125</span>
      </div>
    </div>

    <!-- Plain English Dynamic Narrative Explanation -->
    <div class="narrative-card">
      <div class="narrative-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        <span>True Cost Analysis</span>
      </div>
      <p class="narrative-text" id="res-narrative">
        Purchasing a <strong>$350,000</strong> home with <strong>$70,000</strong> down (20.0%) leaves a mortgage loan principal of <strong>$280,000</strong>. At a <strong>6.5%</strong> interest rate over <strong>30 years</strong>, your monthly mortgage payment (principal and interest) is <strong>$1,770</strong>. However, your true monthly homeownership cost is <strong>$3,020</strong> when including <strong>$1,250</strong> in non-mortgage ownership expenses ($350 property tax, $150 insurance, $350 maintenance reserves, $300 utilities, and $100 other upkeep). This means your non-mortgage ownership expenses add an extra <strong>70.6%</strong> to your base mortgage payment, bringing your total annual homeownership cost to <strong>$36,237</strong>.
      </p>
    </div>

    <!-- Exclusions Notice Box -->
    <div class="exclusions-notice-box">
      <div class="exclusions-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
      </div>
      <p class="exclusions-text">
        <strong>Cost Scope &amp; Exclusions Notice:</strong> This model reflects ongoing recurring operational costs. It excludes upfront buyer closing costs (lender origination fees, appraisal, title insurance, and escrow reserves, typically 2%–5% of purchase price), moving fees, initial furnishing, and future property tax or utility inflation.
      </p>
    </div>

  </div>
</CalculatorLayout>

<script>
  function initTrueCostCalculator() {
    const currencySymbols = {
      USD: '$',
      CAD: 'C$',
      GBP: '£',
      EUR: '€',
      AUD: 'A$',
      INR: '₹',
      SGD: 'S$',
      JPY: '¥',
      CHF: 'CHF '
    };

    let currentCurrency = 'USD';
    let currentSymbol = '$';

    // Inputs
    const currencySelect = document.getElementById('tc-currency-select');
    const priceInput = document.getElementById('tc-purchase-price');
    const priceSlider = document.getElementById('tc-purchase-price-slider');
    const downInput = document.getElementById('tc-down-payment');
    const downSlider = document.getElementById('tc-down-payment-slider');
    const rateInput = document.getElementById('tc-mortgage-rate');
    const rateSlider = document.getElementById('tc-mortgage-rate-slider');
    const termInput = document.getElementById('tc-mortgage-term');
    const taxInput = document.getElementById('tc-annual-tax');
    const insInput = document.getElementById('tc-annual-insurance');
    const hoaInput = document.getElementById('tc-monthly-hoa');
    const maintInput = document.getElementById('tc-monthly-maint');
    const utilInput = document.getElementById('tc-monthly-util');
    const otherInput = document.getElementById('tc-monthly-other');
    const resetBtn = document.getElementById('tc-reset-btn');

    // Symbols & Badges
    const symPrice = document.getElementById('sym-price');
    const symDown = document.getElementById('sym-down');
    const symTax = document.getElementById('sym-tax');
    const symIns = document.getElementById('sym-ins');
    const symHoa = document.getElementById('sym-hoa');
    const symMaint = document.getElementById('sym-maint');
    const symUtil = document.getElementById('sym-util');
    const symOther = document.getElementById('sym-other');
    const downPctBadge = document.getElementById('tc-down-pct-badge');
    const downChips = document.querySelectorAll('.down-chip-btn');
    const termChips = document.querySelectorAll('.term-chip-btn');

    // Hints
    const taxHint = document.getElementById('tc-tax-monthly-hint');
    const insHint = document.getElementById('tc-ins-monthly-hint');

    // Hero Outputs
    const resTotalMonthly = document.getElementById('res-total-monthly');
    const resMonthlySubtext = document.getElementById('res-monthly-subtext');
    const resMonthlyPi = document.getElementById('res-monthly-pi');
    const resPiPctSubtext = document.getElementById('res-pi-pct-subtext');
    const resMonthlyNonMortgage = document.getElementById('res-monthly-non-mortgage');
    const resAnnualTotal = document.getElementById('res-annual-total');
    const resTotalInterest = document.getElementById('res-total-interest');
    const resInterestSub = document.getElementById('res-interest-sub');

    // Bar & Legend
    const resBarTotal = document.getElementById('res-bar-total');
    const barPi = document.getElementById('bar-pi');
    const barTaxes = document.getElementById('bar-taxes');
    const barMaint = document.getElementById('bar-maint');
    const barUtil = document.getElementById('bar-util');
    const legendPi = document.getElementById('legend-pi');
    const legendTaxes = document.getElementById('legend-taxes');
    const legendMaint = document.getElementById('legend-maint');
    const legendUtil = document.getElementById('legend-util');

    // Table rows
    const rowPi = document.getElementById('row-pi');
    const rowPiAnnual = document.getElementById('row-pi-annual');
    const rowPiShare = document.getElementById('row-pi-share');
    const rowTax = document.getElementById('row-tax');
    const rowTaxAnnual = document.getElementById('row-tax-annual');
    const rowTaxShare = document.getElementById('row-tax-share');
    const rowIns = document.getElementById('row-ins');
    const rowInsAnnual = document.getElementById('row-ins-annual');
    const rowInsShare = document.getElementById('row-ins-share');
    const rowHoa = document.getElementById('row-hoa');
    const rowHoaAnnual = document.getElementById('row-hoa-annual');
    const rowHoaShare = document.getElementById('row-hoa-share');
    const rowMaint = document.getElementById('row-maint');
    const rowMaintAnnual = document.getElementById('row-maint-annual');
    const rowMaintShare = document.getElementById('row-maint-share');
    const rowUtil = document.getElementById('row-util');
    const rowUtilAnnual = document.getElementById('row-util-annual');
    const rowUtilShare = document.getElementById('row-util-share');
    const rowOther = document.getElementById('row-other');
    const rowOtherAnnual = document.getElementById('row-other-annual');
    const rowOtherShare = document.getElementById('row-other-share');
    const rowTotalMonthly = document.getElementById('row-total-monthly');
    const rowTotalAnnual = document.getElementById('row-total-annual');

    // Lifetime
    const resTermDisplay = document.getElementById('res-term-display');
    const resLifeDown = document.getElementById('res-life-down');
    const resLifeMortgage = document.getElementById('res-life-mortgage');
    const resLifeMortgageSub = document.getElementById('res-life-mortgage-sub');
    const resLifeNonMortgage = document.getElementById('res-life-non-mortgage');
    const resLifeAllIn = document.getElementById('res-life-all-in');

    // Narrative
    const resNarrative = document.getElementById('res-narrative');

    if (!priceInput) return;

    function formatMoney(amount, decimals = 0) {
      if (isNaN(amount) || amount === null) amount = 0;
      const formatted = Math.round(amount).toLocaleString('en-US', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });
      return `${currentSymbol}${formatted}`;
    }

    function formatNumber(amount, decimals = 0) {
      if (isNaN(amount) || amount === null) amount = 0;
      return amount.toLocaleString('en-US', {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
      });
    }

    function updateCurrency(curr) {
      currentCurrency = curr;
      currentSymbol = currencySymbols[curr] || '$';
      if (symPrice) symPrice.textContent = currentSymbol;
      if (symDown) symDown.textContent = currentSymbol;
      if (symTax) symTax.textContent = currentSymbol;
      if (symIns) symIns.textContent = currentSymbol;
      if (symHoa) symHoa.textContent = currentSymbol;
      if (symMaint) symMaint.textContent = currentSymbol;
      if (symUtil) symUtil.textContent = currentSymbol;
      if (symOther) symOther.textContent = currentSymbol;
      recalculate();
    }

    function recalculate() {
      const price = Math.max(0, parseFloat(priceInput.value) || 0);
      let down = Math.max(0, parseFloat(downInput.value) || 0);

      // Prevent down payment from exceeding purchase price
      if (down > price && price > 0) {
        down = price;
        downInput.value = price;
      }

      // Sync down slider max
      if (price > 0) {
        downSlider.max = String(price);
      }

      const rate = Math.max(0, parseFloat(rateInput.value) || 0);
      const termYears = Math.max(1, Math.min(40, parseFloat(termInput.value) || 30));
      const annualTax = Math.max(0, parseFloat(taxInput.value) || 0);
      const annualIns = Math.max(0, parseFloat(insInput.value) || 0);
      const hoa = Math.max(0, parseFloat(hoaInput.value) || 0);
      const maint = Math.max(0, parseFloat(maintInput.value) || 0);
      const util = Math.max(0, parseFloat(utilInput.value) || 0);
      const other = Math.max(0, parseFloat(otherInput.value) || 0);

      const downPct = price > 0 ? (down / price) * 100 : 0;
      if (downPctBadge) downPctBadge.textContent = `${downPct.toFixed(1)}% of price`;

      const loanPrincipal = Math.max(0, price - down);
      const termMonths = Math.round(termYears * 12);

      let monthlyPi = 0;
      let totalLoanRepayment = 0;
      let totalInterest = 0;

      if (loanPrincipal === 0) {
        monthlyPi = 0;
        totalLoanRepayment = 0;
        totalInterest = 0;
      } else if (rate === 0) {
        monthlyPi = loanPrincipal / termMonths;
        totalLoanRepayment = loanPrincipal;
        totalInterest = 0;
      } else {
        const monthlyRate = rate / (12 * 100);
        const compound = Math.pow(1 + monthlyRate, termMonths);
        monthlyPi = loanPrincipal * (monthlyRate * compound) / (compound - 1);
        totalLoanRepayment = monthlyPi * termMonths;
        totalInterest = Math.max(0, totalLoanRepayment - loanPrincipal);
      }

      const monthlyTax = annualTax / 12;
      const monthlyIns = annualIns / 12;
      const monthlyNonMortgage = monthlyTax + monthlyIns + hoa + maint + util + other;
      const totalMonthlyCost = monthlyPi + monthlyNonMortgage;
      const annualTotalCost = totalMonthlyCost * 12;

      // Over full mortgage term
      const totalNonMortgageOverTerm = monthlyNonMortgage * termMonths;
      const totalAllInWithDown = down + totalLoanRepayment + totalNonMortgageOverTerm;

      // Update helper hints
      if (taxHint) taxHint.textContent = `${formatMoney(monthlyTax)}/mo property taxes escrowed.`;
      if (insHint) insHint.textContent = `${formatMoney(monthlyIns)}/mo homeowners insurance.`;

      // Hero outputs
      if (resTotalMonthly) resTotalMonthly.textContent = formatMoney(totalMonthlyCost);
      if (resMonthlyPi) resMonthlyPi.textContent = formatMoney(monthlyPi);
      if (resMonthlyNonMortgage) resMonthlyNonMortgage.textContent = formatMoney(monthlyNonMortgage);
      if (resAnnualTotal) resAnnualTotal.textContent = formatMoney(annualTotalCost);

      const piShare = totalMonthlyCost > 0 ? (monthlyPi / totalMonthlyCost) * 100 : 0;
      const nonMortgageShare = totalMonthlyCost > 0 ? (monthlyNonMortgage / totalMonthlyCost) * 100 : 0;

      if (resPiPctSubtext) {
        resPiPctSubtext.textContent = loanPrincipal === 0 ? 'Home is 100% paid off in cash' : `${piShare.toFixed(1)}% of total monthly expense`;
      }
      if (resTotalInterest) resTotalInterest.textContent = formatMoney(totalInterest);
      if (resInterestSub) {
        resInterestSub.textContent = loanPrincipal === 0
          ? 'No mortgage debt ($0 borrowed)'
          : `on a ${formatMoney(loanPrincipal)} mortgage principal (${termYears} years)`;
      }

      // Bar distribution
      const taxesInsMonthly = monthlyTax + monthlyIns;
      const utilOtherMonthly = util + other + hoa;
      const basis = totalMonthlyCost > 0 ? totalMonthlyCost : 1;

      const barPiPct = (monthlyPi / basis) * 100;
      const barTaxesPct = (taxesInsMonthly / basis) * 100;
      const barMaintPct = (maint / basis) * 100;
      const barUtilPct = (utilOtherMonthly / basis) * 100;

      if (resBarTotal) resBarTotal.textContent = `${formatMoney(totalMonthlyCost)} /mo`;
      if (barPi) barPi.style.width = `${barPiPct.toFixed(1)}%`;
      if (barTaxes) barTaxes.style.width = `${barTaxesPct.toFixed(1)}%`;
      if (barMaint) barMaint.style.width = `${barMaintPct.toFixed(1)}%`;
      if (barUtil) barUtil.style.width = `${barUtilPct.toFixed(1)}%`;

      if (legendPi) legendPi.textContent = `${formatMoney(monthlyPi)} (${barPiPct.toFixed(1)}%)`;
      if (legendTaxes) legendTaxes.textContent = `${formatMoney(taxesInsMonthly)} (${barTaxesPct.toFixed(1)}%)`;
      if (legendMaint) legendMaint.textContent = `${formatMoney(maint)} (${barMaintPct.toFixed(1)}%)`;
      if (legendUtil) legendUtil.textContent = `${formatMoney(utilOtherMonthly)} (${barUtilPct.toFixed(1)}%)`;

      // Table rows
      if (rowPi) rowPi.textContent = formatMoney(monthlyPi);
      if (rowPiAnnual) rowPiAnnual.textContent = formatMoney(monthlyPi * 12);
      if (rowPiShare) rowPiShare.textContent = `${barPiPct.toFixed(1)}%`;

      if (rowTax) rowTax.textContent = formatMoney(monthlyTax);
      if (rowTaxAnnual) rowTaxAnnual.textContent = formatMoney(annualTax);
      if (rowTaxShare) rowTaxShare.textContent = `${((monthlyTax / basis) * 100).toFixed(1)}%`;

      if (rowIns) rowIns.textContent = formatMoney(monthlyIns);
      if (rowInsAnnual) rowInsAnnual.textContent = formatMoney(annualIns);
      if (rowInsShare) rowInsShare.textContent = `${((monthlyIns / basis) * 100).toFixed(1)}%`;

      if (rowHoa) rowHoa.textContent = formatMoney(hoa);
      if (rowHoaAnnual) rowHoaAnnual.textContent = formatMoney(hoa * 12);
      if (rowHoaShare) rowHoaShare.textContent = `${((hoa / basis) * 100).toFixed(1)}%`;

      if (rowMaint) rowMaint.textContent = formatMoney(maint);
      if (rowMaintAnnual) rowMaintAnnual.textContent = formatMoney(maint * 12);
      if (rowMaintShare) rowMaintShare.textContent = `${barMaintPct.toFixed(1)}%`;

      if (rowUtil) rowUtil.textContent = formatMoney(util);
      if (rowUtilAnnual) rowUtilAnnual.textContent = formatMoney(util * 12);
      if (rowUtilShare) rowUtilShare.textContent = `${((util / basis) * 100).toFixed(1)}%`;

      if (rowOther) rowOther.textContent = formatMoney(other);
      if (rowOtherAnnual) rowOtherAnnual.textContent = formatMoney(other * 12);
      if (rowOtherShare) rowOtherShare.textContent = `${((other / basis) * 100).toFixed(1)}%`;

      if (rowTotalMonthly) rowTotalMonthly.textContent = formatMoney(totalMonthlyCost);
      if (rowTotalAnnual) rowTotalAnnual.textContent = formatMoney(annualTotalCost);

      // Lifetime Horizon Card
      if (resTermDisplay) resTermDisplay.textContent = String(termYears);
      if (resLifeDown) resLifeDown.textContent = formatMoney(down);
      if (resLifeMortgage) resLifeMortgage.textContent = formatMoney(totalLoanRepayment);
      if (resLifeMortgageSub) {
        resLifeMortgageSub.textContent = loanPrincipal === 0
          ? 'No mortgage debt'
          : `Principal (${formatMoney(loanPrincipal)}) + Interest (${formatMoney(totalInterest)})`;
      }
      if (resLifeNonMortgage) resLifeNonMortgage.textContent = formatMoney(totalNonMortgageOverTerm);
      if (resLifeAllIn) resLifeAllIn.textContent = formatMoney(totalAllInWithDown);

      // Dynamic Narrative
      if (resNarrative) {
        if (loanPrincipal === 0) {
          resNarrative.innerHTML = `Purchasing a <strong>${formatMoney(price)}</strong> home entirely in cash with a 100% down payment means you have <strong>${formatMoney(0)}</strong> in mortgage debt. However, your monthly homeownership cost is <strong>${formatMoney(totalMonthlyCost)}</strong> ($${formatNumber(Math.round(annualTotalCost))}/year) to cover property taxes (${formatMoney(monthlyTax)}/mo), insurance (${formatMoney(monthlyIns)}/mo), maintenance reserves (${formatMoney(maint)}/mo), utilities (${formatMoney(util)}/mo), and recurring property expenses.`;
        } else {
          const ratio = monthlyPi > 0 ? (monthlyNonMortgage / monthlyPi) * 100 : 0;
          resNarrative.innerHTML = `Purchasing a <strong>${formatMoney(price)}</strong> home with <strong>${formatMoney(down)}</strong> down (${downPct.toFixed(1)}%) leaves a mortgage loan principal of <strong>${formatMoney(loanPrincipal)}</strong>. At a <strong>${rate.toFixed(1)}%</strong> interest rate over <strong>${termYears} years</strong>, your monthly mortgage payment (principal and interest) is <strong>${formatMoney(monthlyPi)}</strong>. However, your true monthly homeownership cost is <strong>${formatMoney(totalMonthlyCost)}</strong> when including <strong>${formatMoney(monthlyNonMortgage)}</strong> in non-mortgage ownership expenses (${formatMoney(monthlyTax)} property tax, ${formatMoney(monthlyIns)} insurance, ${formatMoney(maint)} maintenance reserves, ${formatMoney(util)} utilities, and ${formatMoney(other + hoa)} other upkeep). This means your non-mortgage ownership expenses add an extra <strong>${ratio.toFixed(1)}%</strong> to your base mortgage payment, bringing your total annual homeownership cost to <strong>${formatMoney(annualTotalCost)}</strong>.`;
        }
      }

      // Sync Chip States
      downChips.forEach(chip => {
        const val = parseFloat(chip.getAttribute('data-pct'));
        chip.classList.toggle('active', Math.abs(downPct - val) < 0.5);
      });

      termChips.forEach(chip => {
        const val = parseFloat(chip.getAttribute('data-term'));
        chip.classList.toggle('active', Math.abs(termYears - val) < 0.5);
      });
    }

    // Currency Change
    if (currencySelect) {
      currencySelect.addEventListener('change', (e) => {
        updateCurrency(e.target.value);
      });
    }

    // Bidirectional sync: Price
    priceInput.addEventListener('input', () => {
      priceSlider.value = priceInput.value;
      recalculate();
    });
    priceSlider.addEventListener('input', () => {
      priceInput.value = priceSlider.value;
      recalculate();
    });

    // Bidirectional sync: Down Payment
    downInput.addEventListener('input', () => {
      downSlider.value = downInput.value;
      recalculate();
    });
    downSlider.addEventListener('input', () => {
      downInput.value = downSlider.value;
      recalculate();
    });

    // Down Chips
    downChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const pct = parseFloat(chip.getAttribute('data-pct')) || 20;
        const price = parseFloat(priceInput.value) || 0;
        const newDown = Math.round(price * (pct / 100));
        downInput.value = newDown;
        downSlider.value = newDown;
        recalculate();
      });
    });

    // Bidirectional sync: Rate
    rateInput.addEventListener('input', () => {
      rateSlider.value = rateInput.value;
      recalculate();
    });
    rateSlider.addEventListener('input', () => {
      rateInput.value = rateSlider.value;
      recalculate();
    });

    // Term Chips
    termChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const term = parseFloat(chip.getAttribute('data-term')) || 30;
        termInput.value = term;
        recalculate();
      });
    });

    // Term input
    termInput.addEventListener('input', recalculate);

    // Other inputs
    taxInput.addEventListener('input', recalculate);
    insInput.addEventListener('input', recalculate);
    hoaInput.addEventListener('input', recalculate);
    maintInput.addEventListener('input', recalculate);
    utilInput.addEventListener('input', recalculate);
    otherInput.addEventListener('input', recalculate);

    // Reset button
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        priceInput.value = '350000';
        priceSlider.value = '350000';
        downInput.value = '70000';
        downSlider.value = '70000';
        rateInput.value = '6.5';
        rateSlider.value = '6.5';
        termInput.value = '30';
        taxInput.value = '4200';
        insInput.value = '1800';
        hoaInput.value = '0';
        maintInput.value = '350';
        utilInput.value = '300';
        otherInput.value = '100';
        if (currencySelect) {
          currencySelect.value = 'USD';
          updateCurrency('USD');
        } else {
          recalculate();
        }
      });
    }

    // Action Toolbar Clipboard Integration
    window.addEventListener('copy-calculator-results', async () => {
      try {
        const price = priceInput.value;
        const down = downInput.value;
        const totalMo = resTotalMonthly ? resTotalMonthly.textContent : '';
        const piMo = resMonthlyPi ? resMonthlyPi.textContent : '';
        const nonMo = resMonthlyNonMortgage ? resMonthlyNonMortgage.textContent : '';
        const annual = resAnnualTotal ? resAnnualTotal.textContent : '';
        const interest = resTotalInterest ? resTotalInterest.textContent : '';

        const textToCopy = `FinCalcLab True Cost of Home Ownership Calculator Results:
• Home Purchase Price: ${formatMoney(price)}
• Down Payment: ${formatMoney(down)}
---------------------------------------
• Total Monthly Homeownership Cost: ${totalMo}/mo
• Mortgage Principal & Interest: ${piMo}/mo
• Monthly Non-Mortgage Expenses: ${nonMo}/mo
• Estimated Annual Cost: ${annual}/yr
• Total Mortgage Interest: ${interest}
• Calculated online at: ${window.location.href}`;

        await navigator.clipboard.writeText(textToCopy);
        window.dispatchEvent(new CustomEvent('calculator-copied-success'));
      } catch (err) {
        console.error('Failed to copy results:', err);
      }
    });

    // Initial calculation
    recalculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTrueCostCalculator);
  } else {
    initTrueCostCalculator();
  }
  document.addEventListener('astro:page-load', initTrueCostCalculator);
</script>

