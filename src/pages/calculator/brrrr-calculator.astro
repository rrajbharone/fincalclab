---
import Layout from '../../layouts/Layout.astro';
import BrrrrCalculator from '../../components/calculator/BrrrrCalculator.astro';
import Card from '../../components/ui/Card.astro';

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Calculators', item: '/all-calculators' },
  { name: 'BRRRR Calculator', item: '/calculator/brrrr-calculator' }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What does BRRRR stand for in real estate investing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BRRRR stands for Buy, Rehab, Rent, Refinance, Repeat. It is a real estate investment strategy where an investor purchases a distressed or undervalued property, renovates it to force appreciation (Rehab), leases it to qualified tenants (Rent), executes a cash-out refinance based on the higher After Repair Value (Refinance), and recycles the returned capital to acquire additional properties (Repeat)."
      }
    },
    {
      "@type": "Question",
      "name": "What is a 'Perfect BRRRR'?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A 'Perfect BRRRR' occurs when the new cash-out refinance loan completely pays off all underlying acquisition financing and reimburses 100% of the investor's initial out-of-pocket capital (down payment, renovation costs, closing costs, and holding expenses). In this scenario, the investor has $0 of their own money left tied up in the deal while continuing to own a cash-flowing, equity-rich rental property."
      }
    },
    {
      "@type": "Question",
      "name": "What is the 70% rule in real estate and how does it relate to BRRRR?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The 70% rule states that an investor should pay no more than 70% of a property's estimated After Repair Value (ARV) minus the estimated renovation costs: Maximum Allowable Offer (MAO) = (ARV × 70%) − Rehab. In a BRRRR deal, following this rule ensures that a standard 70% to 75% LTV cash-out refinance will return all or most of the initial capital invested."
      }
    },
    {
      "@type": "Question",
      "name": "What is After Repair Value (ARV) and how is it calculated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "After Repair Value (ARV) is the estimated market value of a property once all renovations, modernizations, and structural repairs are completed. It is calculated by analyzing recent comparable sales ('comps') of renovated properties within the same neighborhood with similar square footage, bedroom/bathroom counts, and architectural styles within the past 3 to 6 months."
      }
    },
    {
      "@type": "Question",
      "name": "What is a loan seasoning period?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A seasoning period is the mandatory length of time a borrower must own a property before a conventional lender will permit a cash-out refinance based on a new appraised value rather than the original purchase price. For conventional Fannie Mae and Freddie Mac residential mortgages, the seasoning period is typically 6 to 12 months, whereas specialized DSCR and commercial portfolio lenders may require 3 to 6 months or offer no seasoning with verified rehab receipts."
      }
    },
    {
      "@type": "Question",
      "name": "What is an 'Infinite Return' on a BRRRR deal?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "An infinite Cash-on-Cash return occurs mathematically when an investor recovers 100% (or more) of their initial invested capital at refinance ($0 remaining investment basis) while the asset generates positive net cash flow. Because dividing any positive cash flow by zero capital results in infinity, the investor is generating perpetual profit with none of their own money tied up in the asset."
      }
    },
    {
      "@type": "Question",
      "name": "How does a Debt Service Coverage Ratio (DSCR) loan work for BRRRR?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A DSCR loan qualifies the borrower based on the rental income generated by the property rather than personal employment income or W-2 tax returns. Lenders typically require a minimum DSCR of 1.20 to 1.25, meaning gross rental income must exceed total principal, interest, taxes, and insurance (PITI) by at least 20% to 25%."
      }
    },
    {
      "@type": "Question",
      "name": "Can you execute a BRRRR deal using hard money or private lending?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Most experienced BRRRR investors fund the Buy and Rehab phases using short-term hard money or private loans (typically 6 to 12-month terms at 8% to 12% interest). Once the renovation is complete and the home is leased to a tenant, the investor refinances into a long-term, low-rate permanent mortgage to retire the hard money loan."
      }
    },
    {
      "@type": "Question",
      "name": "What are the biggest risks of the BRRRR method?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The four primary risks of the BRRRR strategy are: 1) Low appraisals at refinance that trap capital in the property, 2) Unforeseen rehab budget overruns and contractor delays, 3) Rising mortgage interest rates that compress rental cash flow, and 4) Extended tenant vacancy or non-payment during the holding and leasing phase."
      }
    },
    {
      "@type": "Question",
      "name": "How is Cash-on-Cash (CoC) return calculated after refinancing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Post-refinance Cash-on-Cash return is calculated as: CoC (%) = (Annual Net Cash Flow / Cash Left in Deal) × 100. If an investor leaves $10,000 of their own money in the property after refinance and receives $4,000 per year in net rental cash flow, their post-refinance Cash-on-Cash return is 40.0% ($4,000 / $10,000)."
      }
    }
  ]
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "BRRRR Calculator",
  "url": "https://fincalclab.com/calculator/brrrr-calculator",
  "description": "Calculate BRRRR real estate returns (Buy, Rehab, Rent, Refinance, Repeat). Model initial cash invested, refinance proceeds, net cash left in deal, rental cash flow, and Cash-on-Cash return.",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

<Layout
  title="BRRRR Calculator | Buy, Rehab, Rent, Refinance, Repeat Analysis"
  description="Free BRRRR calculator for real estate investors. Analyze cash invested, forced appreciation, refinance cash-out proceeds, cash left in deal, and Cash-on-Cash return."
  breadcrumbs={breadcrumbs}
>
  <!-- Schema Injections -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} slot="head" />

  <div class="calculator-page-container container">
    <!-- Interactive Calculator Component -->
    <BrrrrCalculator />

    <!-- Featured Real Estate Strategy Callout -->
    <section class="au-callout-section" aria-labelledby="brrrr-strategy-heading">
      <Card elevation="sm" class="au-callout-card">
        <div class="au-callout-header">
          <div class="au-callout-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          </div>
          <div class="au-callout-heading-wrap">
            <span class="au-callout-eyebrow">The Real Estate Wealth Engine</span>
            <h2 id="brrrr-strategy-heading" class="au-callout-title">The Velocity of Capital: Why BRRRR Beats Traditional Buy-and-Hold</h2>
          </div>
        </div>

        <p class="au-callout-desc">
          In traditional buy-and-hold investing, putting 20% down on every property permanently locks your capital inside the walls of that house. If you save $50,000 every two years, building a 10-property portfolio takes 20 years. By using the <strong>BRRRR method</strong> (Buy, Rehab, Rent, Refinance, Repeat), forced appreciation allows you to extract 100% of your capital through a cash-out refinance, allowing the <strong>exact same initial savings</strong> to purchase multiple income-producing properties in rapid succession.
        </p>

        <div class="au-callout-action">
          <a href="/calculator/cap-rate-calculator" class="au-callout-btn">
            <span>Analyze Property Capitalization Rates</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </Card>
    </section>

    <!-- Comprehensive Real Estate Educational Guide -->
    <article class="educational-guide prose">
      
      <!-- Section 1 -->
      <section class="guide-section">
        <h2>What Is the BRRRR Method in Real Estate?</h2>
        <p>
          The <strong>BRRRR method</strong> is an acronym that stands for <strong>Buy, Rehab, Rent, Refinance, Repeat</strong>. Popularized by modern real estate entrepreneurs, it is a disciplined, value-add framework designed to build a scalable portfolio of rental properties with finite starting capital.
        </p>
        <p>
          Instead of purchasing turnkey properties at retail prices, BRRRR investors seek out distressed, outdated, or mismanaged properties priced at a steep discount. By executing strategic renovations, the investor creates <strong>forced appreciation</strong>—instantly expanding the property's market value. Once the property is renovated and leased to high-quality tenants, the investor executes a long-term, cash-out refinance based on the newly appraised <strong>After Repair Value (ARV)</strong>.
        </p>
        <p>
          The cash proceeds from the refinance pay off initial acquisition debt and reimburse the investor's down payment and renovation costs. The investor retains ownership of the cash-flowing asset with built-in equity, while recovering their initial liquidity to <strong>repeat</strong> the cycle on the next deal. To compare how different rental yields perform across local housing markets, explore our companion <a href="/calculator/cap-rate-calculator">Cap Rate Calculator</a>.
        </p>
      </section>

      <!-- Section 2 -->
      <section class="guide-section">
        <h2>How the BRRRR Method Works: A Step-by-Step Breakdown</h2>
        <p>
          Executing a successful BRRRR project requires synchronizing five distinct operational stages. A mistake in any single stage can undermine the final refinance or cash flow:
        </p>

        <div class="key-callout-box">
          <div class="callout-title">The 5 Operational Phases of a BRRRR Project</div>
          <ol class="callout-steps">
            <li>
              <strong>1. Buy:</strong> Acquire an undervalued property that requires cosmetic or structural improvements. The purchase price must be low enough to create substantial equity post-rehab. Investors frequently secure these deals via off-market marketing, probate sales, foreclosures, or wholesaler networks.
            </li>
            <li>
              <strong>2. Rehab:</strong> Renovate the asset to bring it to top-of-market rental condition without over-improving for the neighborhood. Key focus areas include modern kitchens, durable vinyl plank flooring, energy-efficient HVAC, updated bathrooms, and fresh interior and exterior paint.
            </li>
            <li>
              <strong>3. Rent:</strong> Place vetted, reliable tenants at competitive market rents. Lenders require signed leases and proof of initial rent deposits before approving a cash-out refinance. Strong tenant screening ensures steady operational cash flow. If you plan to live in one unit of a multi-family property while renting out the other units, you can combine this strategy with our <a href="/calculator/house-hacking-calculator">House Hacking Calculator</a>.
            </li>
            <li>
              <strong>4. Refinance:</strong> Replace short-term acquisition debt (or return personal cash) with a permanent, 30-year fixed-rate residential mortgage or commercial DSCR loan. The lender orders an appraisal to verify the After Repair Value (ARV) and typically issues a new loan up to 70% to 80% of that value.
            </li>
            <li>
              <strong>5. Repeat:</strong> Take the tax-free loan proceeds extracted at refinance and redeploy that exact same capital into the down payment and renovation budget for property number two, three, and beyond.
            </li>
          </ol>
        </div>
      </section>

      <!-- Section 3 -->
      <section class="guide-section">
        <h2>The 70% Rule in Real Estate &amp; How It Applies to BRRRR</h2>
        <p>
          The classic real estate <strong>70% rule</strong> is an underwriting guideline used by real estate flippers and BRRRR investors to establish the maximum purchase price they can afford to pay for a distressed property. The formula is expressed as:
        </p>

        <div class="formula-card">
          <div class="formula-label">70% Rule Formula (Maximum Allowable Offer)</div>
          <div class="formula-math">
            MAO = (After Repair Value &times; 0.70) &minus; Estimated Rehab Costs
          </div>
          <p class="formula-note">
            Where <strong>MAO</strong> is the Maximum Allowable Offer, <strong>ARV</strong> is the expected market value after full renovation, and <strong>Rehab Costs</strong> encompass all materials, labor, permits, and contingency buffers.
          </p>
        </div>

        <p>
          Why 70%? Because most permanent lenders cap cash-out refinances at <strong>70% to 75% LTV</strong>. When you purchase at or below 70% of ARV minus rehab costs, the total capital required to buy and renovate the home equals roughly 70% to 75% of the finished property value. When the new loan closes at 75% LTV, <strong>100% of your invested capital is returned to your bank account</strong>.
        </p>

        <div class="table-responsive-wrapper">
          <table class="growth-comparison-table">
            <thead>
              <tr>
                <th scope="col">Estimated ARV</th>
                <th scope="col">Rehab Budget</th>
                <th scope="col">70% Benchmark</th>
                <th scope="col">Maximum Allowable Offer (MAO)</th>
                <th scope="col">Refi Capital Recovery Potential</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>$200,000</strong></td>
                <td>$35,000</td>
                <td>$140,000</td>
                <td><strong>$105,000</strong></td>
                <td style="color: var(--color-success); font-weight: 600;">100% (Perfect BRRRR)</td>
              </tr>
              <tr>
                <td><strong>$260,000</strong></td>
                <td>$40,000</td>
                <td>$182,000</td>
                <td><strong>$142,000</strong></td>
                <td style="color: var(--color-success); font-weight: 600;">100% (Full Cash-Out)</td>
              </tr>
              <tr>
                <td><strong>$350,000</strong></td>
                <td>$60,000</td>
                <td>$245,000</td>
                <td><strong>$185,000</strong></td>
                <td style="color: var(--color-success); font-weight: 600;">100% (Zero Basis)</td>
              </tr>
              <tr>
                <td><strong>$500,000</strong></td>
                <td>$85,000</td>
                <td>$350,000</td>
                <td><strong>$265,000</strong></td>
                <td style="color: var(--color-success); font-weight: 600;">100% (High Capital Velocity)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 4 -->
      <section class="guide-section">
        <h2>Accurately Estimating Rehab Costs and After Repair Value (ARV)</h2>
        <p>
          The two most critical variables in any BRRRR calculation are <strong>Rehab Costs</strong> and <strong>After Repair Value (ARV)</strong>. Overestimating ARV by 10% or underestimating rehab by $15,000 will leave thousands of dollars trapped in the deal.
        </p>
        
        <h3>Determining After Repair Value (ARV)</h3>
        <p>
          ARV is not what you hope the property will be worth; it is what an independent licensed appraiser will certify based on recent closed sales. To calculate accurate ARV:
        </p>
        <ul>
          <li><strong>Identify True Comparables:</strong> Find 3 to 5 single-family or multi-family properties within a 0.5-mile to 1-mile radius that sold within the last 90 to 180 days.</li>
          <li><strong>Match Condition and Finishes:</strong> Select comps that were recently fully remodeled with comparable finishes (e.g., granite or quartz countertops, new cabinetry, modern baths).</li>
          <li><strong>Normalize Physical Characteristics:</strong> Adjust for differences in gross living area (square footage), bedroom/bathroom count, lot size, presence of a garage, and architectural style.</li>
        </ul>

        <h3>Constructing a Realistic Rehab Budget</h3>
        <p>
          Beginner investors frequently budget only for visible cosmetics (paint, flooring) while neglecting mechanical systems. Professional investors itemize renovations across two categories:
        </p>
        <ul>
          <li><strong>Major Mechanical &amp; Structural Systems:</strong> Roof condition, foundation integrity, electrical panel service (minimum 100–200 amp), plumbing supply and sewer lines, and HVAC furnaces/heat pumps.</li>
          <li><strong>Interior Value-Add Cosmetics:</strong> Kitchen cabinets, countertops, modern appliance packages, bathroom vanities, tile tub surrounds, luxury vinyl plank (LVP) flooring, and lighting fixtures.</li>
          <li><strong>Mandatory Contingency Reserve:</strong> Always allocate a <strong>15% to 20% contingency line item</strong> above your contractor bids for unexpected discoveries behind walls, such as cast iron pipe corrosion, outdated knob-and-tube wiring, or hidden moisture damage.</li>
        </ul>
      </section>

      <!-- Section 5 -->
      <section class="guide-section">
        <h2>Seasoning Periods and Lender Refinancing Hurdles</h2>
        <p>
          A <strong>seasoning period</strong> is the minimum duration of time a mortgage lender requires an investor to hold title to a property before executing a cash-out refinance based on a newly completed appraisal rather than the original purchase price.
        </p>

        <h3>Conventional Loans (Fannie Mae &amp; Freddie Mac)</h3>
        <p>
          Under conventional agency guidelines, Fannie Mae generally mandates a <strong>12-month seasoning period</strong> on cash-out refinances if you want the loan amount calculated against the new appraised value. If you refinance prior to 12 months, the lender will base your maximum loan amount on the <em>lesser</em> of the new appraised value or your original purchase price plus verified rehab costs.
        </p>

        <h3>DSCR and Commercial Portfolio Loans</h3>
        <p>
          Because of agency seasoning constraints, many full-time BRRRR investors use <strong>Debt Service Coverage Ratio (DSCR) loans</strong> or local commercial portfolio bank financing. These specialty lenders offer distinct advantages:
        </p>
        <ul>
          <li><strong>Shorter Seasoning:</strong> Most DSCR lenders require only <strong>3 to 6 months</strong> of seasoning, and some offer zero seasoning with full contractor invoices.</li>
          <li><strong>No Personal Income Verification:</strong> Approval is based strictly on property rental cash flow, meaning no personal tax returns, W-2 forms, or debt-to-income (DTI) calculations.</li>
          <li><strong>Entity Borrowing:</strong> Allows purchasing and refinancing directly within a Limited Liability Company (LLC) or corporate entity for asset protection.</li>
        </ul>
      </section>

      <!-- Section 6 -->
      <section class="guide-section">
        <h2>Cash-Out Refinance Mechanics: LTV, Appraisals, and Debt Service</h2>
        <p>
          The refinance stage converts your equity into tax-free cash liquidity. In the eyes of tax authorities such as the IRS, loan proceeds are borrowed debt rather than earned income, meaning <strong>cash-out refinance proceeds are 100% free of income tax</strong>.
        </p>
        <p>
          Lenders evaluate two primary underwriting limits during refinance:
        </p>
        
        <h3>1. Loan-to-Value (LTV) Ratio</h3>
        <p>
          The lender establishes a maximum ceiling on the new loan relative to the appraised After Repair Value:
        </p>
        <div class="formula-card">
          <div class="formula-label">Refinance Loan Amount Formula</div>
          <div class="formula-math">
            New Loan Amount = ARV &times; Refinance LTV%
          </div>
          <p class="formula-note">
            Standard residential cash-out LTV thresholds range from <strong>70% to 75%</strong> for single-family homes and 2-to-4 unit multi-family properties. Some lenders permit up to 80% LTV at slightly higher interest rates.
          </p>
        </div>

        <h3>2. Debt Service Coverage Ratio (DSCR)</h3>
        <p>
          For investment property loans, lenders require evidence that the property generates sufficient gross rent to comfortably cover the new mortgage payment (principal, interest, property taxes, and insurance):
        </p>
        <div class="formula-card">
          <div class="formula-label">Debt Service Coverage Ratio Formula</div>
          <div class="formula-math">
            DSCR = Net Operating Income (or Gross Rent) / Total Annual Debt Service (PITI)
          </div>
          <p class="formula-note">
            A DSCR of <strong>1.25</strong> is standard, indicating the property generates 25% more rent than the total mortgage, tax, and insurance liability. Learn more about calculating net yields in our <a href="/blog/how-to-calculate-cap-rate/">guide on how to calculate capitalization rate</a>.
          </p>
        </div>
      </section>

      <!-- Section 7 -->
      <section class="guide-section">
        <h2>Cash-on-Cash Return vs. Infinite Return Explained</h2>
        <p>
          In traditional real estate transactions, investors measure performance through <strong>Cash-on-Cash (CoC) return</strong>: the annual pre-tax cash flow divided by the total out-of-pocket cash invested:
        </p>
        <div class="formula-card">
          <div class="formula-label">Standard Cash-on-Cash Return Formula</div>
          <div class="formula-math">
            Cash-on-Cash Return (%) = (Annual Net Cash Flow / Cash Left in Deal) &times; 100
          </div>
        </div>

        <h3>The "Infinite Return" Phenomenon</h3>
        <p>
          In a "Perfect BRRRR", the cash-out refinance returns 100% (or more) of the investor's down payment, renovation expenditures, closing costs, and holding expenses. When this happens:
        </p>
        <ul>
          <li><strong>Initial Cash Invested:</strong> $80,000</li>
          <li><strong>Net Cash Returned at Refinance:</strong> $80,000</li>
          <li><strong>Cash Remaining in Deal:</strong> $80,000 &minus; $80,000 = <strong>$0.00</strong></li>
          <li><strong>Annual Net Cash Flow:</strong> $4,410 / year</li>
        </ul>
        <p>
          When you calculate Cash-on-Cash return ($4,410 / $0), the mathematical result is undefined, representing an <strong>Infinite Return</strong>. You are generating perpetual passive income and equity growth from an asset that contains none of your initial capital. If you later choose to accelerate mortgage principal paydown, test different amortization scenarios using our <a href="/calculator/mortgage-early-repayment-calculator">Mortgage Early Repayment Calculator</a>.
        </p>
      </section>

      <!-- Section 8 -->
      <section class="guide-section">
        <h2>Real-World Worked Numerical BRRRR Example</h2>
        <p>
          To illustrate how all the numbers connect in practice, let us walk through a complete real-world BRRRR project based on the default values modeled in our calculator:
        </p>

        <div class="table-responsive-wrapper">
          <table class="growth-comparison-table">
            <thead>
              <tr>
                <th scope="col">Project Phase</th>
                <th scope="col">Financial Component</th>
                <th scope="col">Dollar Amount</th>
                <th scope="col">Operational Notes</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>1. Buy</strong></td>
                <td>Purchase Price</td>
                <td><strong>$150,000</strong></td>
                <td>Distressed off-market 3-bed / 2-bath single family</td>
              </tr>
              <tr>
                <td><strong>1. Buy</strong></td>
                <td>Down Payment (20%)</td>
                <td>$30,000</td>
                <td>Initial equity down payment ($120,000 acquisition loan)</td>
              </tr>
              <tr>
                <td><strong>1. Buy</strong></td>
                <td>Purchase Closing Costs</td>
                <td>$4,000</td>
                <td>Title insurance, escrow fees, appraisal, transfer taxes</td>
              </tr>
              <tr>
                <td><strong>2. Rehab</strong></td>
                <td>Renovation Budget</td>
                <td>$40,000</td>
                <td>New roof, kitchen remodel, LVP flooring, bathrooms</td>
              </tr>
              <tr>
                <td><strong>2. Rehab</strong></td>
                <td>Holding Costs (6 Months)</td>
                <td>$6,000</td>
                <td>$1,000/mo debt service, utilities, taxes during construction</td>
              </tr>
              <tr style="background: rgba(37, 99, 235, 0.05); font-weight: 700;">
                <td><strong>Total Initial Cash</strong></td>
                <td>Total Capital Invested</td>
                <td><strong>$80,000</strong></td>
                <td>$30k down + $40k rehab + $4k closing + $6k holding</td>
              </tr>
              <tr>
                <td><strong>3. Rent</strong></td>
                <td>Gross Monthly Rent</td>
                <td><strong>$2,200 / mo</strong></td>
                <td>Placed qualified 1-year tenant following renovation</td>
              </tr>
              <tr>
                <td><strong>3. Rent</strong></td>
                <td>Monthly Operating Expenses</td>
                <td>$600 / mo</td>
                <td>Taxes, insurance, property management, maintenance reserve</td>
              </tr>
              <tr>
                <td><strong>4. Refinance</strong></td>
                <td>After Repair Value (ARV)</td>
                <td><strong>$260,000</strong></td>
                <td>Independent appraisal certified post-rehab market value</td>
              </tr>
              <tr>
                <td><strong>4. Refinance</strong></td>
                <td>New Loan Amount (75% LTV)</td>
                <td>$195,000</td>
                <td>New 30-year fixed loan at 6.50% interest rate</td>
              </tr>
              <tr>
                <td><strong>4. Refinance</strong></td>
                <td>Payoff Original Loan</td>
                <td>&minus;$119,509</td>
                <td>Retires initial acquisition mortgage after 6 months ($120k loan at 8.0%)</td>
              </tr>
              <tr>
                <td><strong>4. Refinance</strong></td>
                <td>Refinance Closing Costs</td>
                <td>&minus;$4,500</td>
                <td>Lender origination fees, appraisal, new title policy</td>
              </tr>
              <tr style="background: rgba(2, 132, 199, 0.06); font-weight: 700;">
                <td><strong>Net Cash Returned</strong></td>
                <td>Cash Out at Closing</td>
                <td><strong>$70,991</strong></td>
                <td>$195,000 loan &minus; $119,509 payoff &minus; $4,500 refi costs</td>
              </tr>
              <tr style="background: rgba(22, 163, 74, 0.06); font-weight: 700;">
