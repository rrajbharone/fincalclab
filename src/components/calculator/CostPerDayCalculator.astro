---
import CalculatorLayout from './CalculatorLayout.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
---

<CalculatorLayout
  title="Cost Per Day Calculator"
  description="Amortize total costs over specific durations or calendar date ranges. Calculate daily, weekly, monthly, and annual equivalent costs instantly."
  category="Finance"
>
  <!-- Inputs Section -->
  <div slot="inputs" class="calc-inputs-wrapper" id="cost-per-day-calculator">
    
    <!-- Step 1: Base Configuration -->
    <div style="display: flex; flex-direction: column; gap: var(--space-5);">
      <h3 style="font-size: 1rem; font-weight: 700; border-bottom: 1px solid var(--color-border); padding-bottom: 6px; margin-bottom: 0;">1. Calculator Settings</h3>
      
      <!-- Currency Selector -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="cpd-currency-select">Currency</label>
          <select id="cpd-currency-select" class="currency-select" aria-label="Select Currency">
            <option value="USD" selected>USD ($) - US Dollar</option>
            <option value="EUR">EUR (€) - Euro</option>
            <option value="GBP">GBP (£) - British Pound</option>
            <option value="INR">INR (₹) - Indian Rupee</option>
            <option value="JPY">JPY (¥) - Japanese Yen</option>
            <option value="AUD">AUD (A$) - Australian Dollar</option>
            <option value="CAD">CAD (C$) - Canadian Dollar</option>
            <option value="SGD">SGD (S$) - Singapore Dollar</option>
            <option value="CHF">CHF (CHF) - Swiss Franc</option>
          </select>
        </div>
      </div>

      <!-- Mode Segment controller -->
      <div class="input-group">
        <label style="font-size: 0.95rem; font-weight: 600; color: var(--color-text-base); margin-bottom: 2px;">Time Input Mode</label>
        <div class="mode-segment-container" style="display: flex; background: var(--color-bg-base); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 4px; gap: 4px;">
          <button type="button" id="btn-mode-flat" class="segment-btn active" style="flex: 1; border: none; background: transparent; padding: var(--space-2); font-size: 0.85rem; font-weight: 700; border-radius: var(--radius-sm); cursor: pointer; transition: all var(--transition-fast);">Flat Days</button>
          <button type="button" id="btn-mode-dates" class="segment-btn" style="flex: 1; border: none; background: transparent; padding: var(--space-2); font-size: 0.85rem; font-weight: 700; border-radius: var(--radius-sm); cursor: pointer; transition: all var(--transition-fast);">Date Range</button>
        </div>
      </div>
    </div>

    <!-- Step 2: Cost Details -->
    <div style="display: flex; flex-direction: column; gap: var(--space-5); margin-top: var(--space-5);">
      <h3 style="font-size: 1rem; font-weight: 700; border-bottom: 1px solid var(--color-border); padding-bottom: 6px; margin-bottom: 0;">2. Expense Details</h3>
      
      <!-- Total Cost Amount -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="cpd-cost-input">Total Cost</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol">$</span>
            <input type="number" id="cpd-cost-input" min="1" step="10" value="1200" aria-label="Total Cost" />
          </div>
        </div>
        <input type="range" id="cpd-cost-slider" min="10" max="10000" step="50" value="1200" class="slider-range" aria-label="Total Cost Slider" />
      </div>
    </div>

    <!-- Mode A Content: Flat Days Inputs -->
    <div id="cpd-mode-flat-inputs" class="mode-inputs-group" style="display: flex; flex-direction: column; gap: var(--space-5); margin-top: var(--space-5);">
      <h3 style="font-size: 1rem; font-weight: 700; border-bottom: 1px solid var(--color-border); padding-bottom: 6px; margin-bottom: 0;">3. Duration Details</h3>
      
      <!-- Number of Days -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="cpd-days-input">Number of Days</label>
          <div class="input-symbol-wrapper">
            <input type="number" id="cpd-days-input" min="1" max="1000" step="1" value="30" aria-label="Number of Days" style="text-align: left;" />
            <span class="percent-symbol">days</span>
          </div>
        </div>
        <input type="range" id="cpd-days-slider" min="1" max="365" step="1" value="30" class="slider-range" aria-label="Days Slider" />
      </div>
    </div>

    <!-- Mode B Content: Date Range Inputs -->
    <div id="cpd-mode-dates-inputs" class="mode-inputs-group hidden" style="display: flex; flex-direction: column; gap: var(--space-5); margin-top: var(--space-5);">
      <h3 style="font-size: 1rem; font-weight: 700; border-bottom: 1px solid var(--color-border); padding-bottom: 6px; margin-bottom: 0;">3. Calendar Dates</h3>
      
      <!-- Start Date -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="cpd-start-date">Start Date</label>
          <input type="date" id="cpd-start-date" class="currency-select" style="max-width: 100%; width: 145px; font-weight: 700;" value="2026-01-01" aria-label="Start Date" />
        </div>
      </div>

      <!-- End Date -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="cpd-end-date">End Date</label>
          <input type="date" id="cpd-end-date" class="currency-select" style="max-width: 100%; width: 145px; font-weight: 700;" value="2026-01-31" aria-label="End Date" />
        </div>
      </div>

      <!-- Inclusive End Date Checkbox -->
      <div class="input-group" style="display: flex; flex-direction: row; align-items: center; gap: 8px;">
        <input type="checkbox" id="cpd-inclusive-check" checked style="width: 18px; height: 18px; cursor: pointer;" />
        <label for="cpd-inclusive-check" style="font-size: 0.9rem; font-weight: 600; color: var(--color-text-muted); cursor: pointer; user-select: none;">
          Include end date in count (+1 day)
        </label>
      </div>

      <!-- Date Range Errors -->
      <div id="cpd-date-error" class="hidden" style="color: var(--color-danger); font-size: 0.85rem; font-weight: 700; border-left: 3px solid var(--color-danger); padding-left: 8px;">
        Error: Start Date must be before or equal to End Date.
      </div>
    </div>

    <!-- Reset Trigger -->
    <div class="inputs-actions" style="margin-top: var(--space-6);">
      <Button id="cpd-reset" variant="outline" size="sm" style="width: 100%;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
        Reset Calculator Inputs
      </Button>
    </div>
  </div>

  <!-- Results Section -->
  <div slot="results" class="calc-results-wrapper">
    <h3 class="results-heading">Amortization Summary</h3>

    <!-- Core Cost Per Day Payout Outputs -->
    <div class="net-value-container" style="display: flex; gap: var(--space-4); margin-bottom: var(--space-5);">
      <div class="net-value-box" style="flex: 1; border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); background: var(--color-bg-base); border-top: 4px solid var(--color-success);">
        <span style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--color-text-light);">Cost Per Day</span>
        <div id="res-cpd-daily" style="font-size: 1.75rem; font-weight: 800; color: var(--color-success); margin-top: 4px;">$40.00</div>
        <span style="font-size: 0.65rem; color: var(--color-text-light);" id="lbl-cpd-total-desc">Amortized over 30 days</span>
      </div>
      <div class="net-value-box" style="flex: 1; border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); background: var(--color-bg-base); border-top: 4px solid var(--color-primary);">
        <span style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--color-text-light);">Weekly Equivalent</span>
        <div id="res-cpd-weekly" style="font-size: 1.75rem; font-weight: 800; color: var(--color-primary); margin-top: 4px;">$280.00</div>
        <span style="font-size: 0.65rem; color: var(--color-text-light);" id="lbl-cpd-weekly-desc">7 days equivalent projection</span>
      </div>
    </div>

    <!-- Optimization Verdict -->
    <div style="margin-bottom: var(--space-6);">
      <Card elevation="sm" id="cpd-verdict-card" style="border-left: 4px solid var(--color-success); padding: var(--space-4) var(--space-5); background: var(--color-bg-base);">
        <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: var(--color-text-muted);">Daily Amortization Breakdown</span>
        <p id="res-cpd-verdict-text" style="margin: 4px 0 0 0; font-size: 0.875rem; line-height: 1.5; color: var(--color-text-muted);">
          A total cost of <strong>$1,200.00</strong> amortized over <strong>30 days</strong> results in a daily cost of <strong>$40.00</strong>.
        </p>
      </Card>
    </div>

    <!-- Key Metrics Grid -->
    <h4 style="font-size: 0.95rem; font-weight: 700; margin-bottom: var(--space-3);">Amortized Time Equivalents</h4>
    <div class="results-grid cpd-metrics-grid">
      <div class="result-tile">
        <span class="tile-label">Daily Cost</span>
        <div class="tile-value" id="tile-cpd-daily" style="color: var(--color-success);">$40.00</div>
        <span style="font-size: 0.65rem; color: var(--color-text-light);">Amortized daily rate</span>
      </div>

      <div class="result-tile">
        <span class="tile-label">Weekly Cost</span>
        <div class="tile-value" id="tile-cpd-weekly" style="color: var(--color-primary);">$280.00</div>
        <span style="font-size: 0.65rem; color: var(--color-text-light);">Based on 7-day week</span>
      </div>

      <div class="result-tile">
        <span class="tile-label">Monthly Cost</span>
        <div class="tile-value" id="tile-cpd-monthly" style="color: var(--color-accent);">$1,217.50</div>
        <span style="font-size: 0.65rem; color: var(--color-text-light);">Based on 30.4375 days</span>
      </div>

      <div class="result-tile yearly-tile">
        <span class="tile-label">Yearly Equivalent Cost</span>
        <div class="tile-value" id="tile-cpd-yearly" style="color: var(--color-success);">$14,600.00</div>
        <span style="font-size: 0.65rem; color: var(--color-text-light);">Extrapolated over 365-day year</span>
      </div>
    </div>
  </div>
</CalculatorLayout>

<script>
  function initCpdCalculator() {
    // Select settings elements
    const currencySelect = document.getElementById('cpd-currency-select') as HTMLSelectElement;
    
    // Mode toggles buttons
    const btnFlat = document.getElementById('btn-mode-flat') as HTMLButtonElement;
    const btnDates = document.getElementById('btn-mode-dates') as HTMLButtonElement;

    // Mode Input blocks
    const flatInputsBlock = document.getElementById('cpd-mode-flat-inputs') as HTMLDivElement;
    const datesInputsBlock = document.getElementById('cpd-mode-dates-inputs') as HTMLDivElement;

    // Base Cost Input Fields
    const costInput = document.getElementById('cpd-cost-input') as HTMLInputElement;
    const costSlider = document.getElementById('cpd-cost-slider') as HTMLInputElement;

    // Mode A (Flat Days) Input Fields
    const daysInput = document.getElementById('cpd-days-input') as HTMLInputElement;
    const daysSlider = document.getElementById('cpd-days-slider') as HTMLInputElement;

    // Mode B (Dates Range) Input Fields
    const startDateInput = document.getElementById('cpd-start-date') as HTMLInputElement;
    const endDateInput = document.getElementById('cpd-end-date') as HTMLInputElement;
    const inclusiveCheck = document.getElementById('cpd-inclusive-check') as HTMLInputElement;
    const dateError = document.getElementById('cpd-date-error') as HTMLDivElement;

    let activeMode: 'flat' | 'dates' = 'flat';

    if (!costInput || !currencySelect || !btnFlat || !btnDates) return;

    // Helper functions for sliders
    function bindSlider(input: HTMLInputElement, slider: HTMLInputElement, callback: () => void) {
      if (!input || !slider) return;
      input.addEventListener('input', () => {
        slider.value = input.value;
        callback();
      });
      slider.addEventListener('input', () => {
        input.value = slider.value;
        callback();
      });
    }

    // Bind Base cost
    bindSlider(costInput, costSlider, calculateAll);

    // Bind Mode A
    bindSlider(daysInput, daysSlider, calculateAll);

    // Bind Mode B date changes
    startDateInput.addEventListener('change', calculateAll);
    endDateInput.addEventListener('change', calculateAll);
    inclusiveCheck.addEventListener('change', calculateAll);

    // Mode toggles
    btnFlat.addEventListener('click', () => {
      activeMode = 'flat';
      btnFlat.classList.add('active');
      btnDates.classList.remove('active');
      
      btnFlat.style.background = 'var(--color-primary)';
      btnFlat.style.color = 'var(--color-bg-base)';
      btnDates.style.background = 'transparent';
      btnDates.style.color = 'var(--color-text-base)';

      flatInputsBlock.classList.remove('hidden');
      datesInputsBlock.classList.add('hidden');
      calculateAll();
    });

    btnDates.addEventListener('click', () => {
      activeMode = 'dates';
      btnDates.classList.add('active');
      btnFlat.classList.remove('active');

      btnDates.style.background = 'var(--color-primary)';
      btnDates.style.color = 'var(--color-bg-base)';
      btnFlat.style.background = 'transparent';
      btnFlat.style.color = 'var(--color-text-base)';

      datesInputsBlock.classList.remove('hidden');
      flatInputsBlock.classList.add('hidden');
      calculateAll();
    });

    // Style segment controller initially
    btnFlat.style.background = 'var(--color-primary)';
    btnFlat.style.color = 'var(--color-bg-base)';
    btnDates.style.background = 'transparent';
    btnDates.style.color = 'var(--color-text-base)';

    // Currency updates
    currencySelect.addEventListener('change', () => {
      const symbol = getCurrencySymbol(currencySelect.value);
      document.querySelectorAll('.currency-symbol').forEach(el => el.textContent = symbol);
      calculateAll();
    });

    function getCurrencySymbol(curr: string) {
      switch (curr) {
        case 'EUR': return '€';
        case 'GBP': return '£';
        case 'INR': return '₹';
        case 'JPY': return '¥';
        case 'AUD': return 'A$';
        case 'CAD': return 'C$';
        case 'SGD': return 'S$';
        case 'CHF': return 'CHF';
        default: return '$';
      }
    }

    // Reset button
    const resetBtn = document.getElementById('cpd-reset');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        // Mode resets
        activeMode = 'flat';
        btnFlat.classList.add('active');
        btnDates.classList.remove('active');

        btnFlat.style.background = 'var(--color-primary)';
        btnFlat.style.color = 'var(--color-bg-base)';
        btnDates.style.background = 'transparent';
        btnDates.style.color = 'var(--color-text-base)';

        flatInputsBlock.classList.remove('hidden');
        datesInputsBlock.classList.add('hidden');
        currencySelect.value = 'USD';
        document.querySelectorAll('.currency-symbol').forEach(el => el.textContent = '$');

        // Reset values
        costInput.value = '1200';
        costSlider.value = '1200';
        daysInput.value = '30';
        daysSlider.value = '30';
        startDateInput.value = '2026-01-01';
        endDateInput.value = '2026-01-31';
        inclusiveCheck.checked = true;

        calculateAll();
      });
    }

    function formatCurrency(val: number) {
      const symbol = getCurrencySymbol(currencySelect.value);
      return symbol + val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function calculateAll() {
      // Inputs variables
      const totalCost = parseFloat(costInput.value) || 0;
      let totalDays = 30;

      let hasError = false;

      if (activeMode === 'flat') {
        totalDays = parseInt(daysInput.value) || 1;
        if (totalDays <= 0) totalDays = 1;
        if (dateError) dateError.classList.add('hidden');
      } else {
        const startStr = startDateInput.value;
        const endStr = endDateInput.value;
        
        if (startStr && endStr) {
          const startDate = new Date(startStr);
          const endDate = new Date(endStr);
          
          if (startDate > endDate) {
            hasError = true;
            if (dateError) dateError.classList.remove('hidden');
          } else {
            if (dateError) dateError.classList.add('hidden');
            const diffTime = Math.abs(endDate.getTime() - startDate.getTime());
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            
            totalDays = diffDays + (inclusiveCheck.checked ? 1 : 0);
            if (totalDays <= 0) totalDays = 1; // Prevent divide by zero
          }
        }
      }

      if (hasError) return;

      // Math
      const dailyCost = totalCost / totalDays;
      const weeklyCost = dailyCost * 7;
      const monthlyCost = dailyCost * 30.4375; // average days per month (365 / 12)
      const yearlyCost = dailyCost * 365;

      // DOM Outputs
      const resCpdDaily = document.getElementById('res-cpd-daily');
      const resCpdWeekly = document.getElementById('res-cpd-weekly');
      const lblCpdTotalDesc = document.getElementById('lbl-cpd-total-desc');
      const resCpdVerdictText = document.getElementById('res-cpd-verdict-text');

      const tileCpdDaily = document.getElementById('tile-cpd-daily');
      const tileCpdWeekly = document.getElementById('tile-cpd-weekly');
      const tileCpdMonthly = document.getElementById('tile-cpd-monthly');
      const tileCpdYearly = document.getElementById('tile-cpd-yearly');

      if (resCpdDaily) resCpdDaily.textContent = formatCurrency(dailyCost);
      if (resCpdWeekly) resCpdWeekly.textContent = formatCurrency(weeklyCost);
      if (lblCpdTotalDesc) lblCpdTotalDesc.textContent = `Amortized over ${totalDays} ${totalDays === 1 ? 'day' : 'days'}`;

      if (resCpdVerdictText) {
        resCpdVerdictText.innerHTML = `A total cost of <strong>${formatCurrency(totalCost)}</strong> amortized over <strong>${totalDays} ${totalDays === 1 ? 'day' : 'days'}</strong> results in a daily cost of <strong>${formatCurrency(dailyCost)}</strong>.`;
      }

      // Tiles
      if (tileCpdDaily) tileCpdDaily.textContent = formatCurrency(dailyCost);
      if (tileCpdWeekly) tileCpdWeekly.textContent = formatCurrency(weeklyCost);
      if (tileCpdMonthly) tileCpdMonthly.textContent = formatCurrency(monthlyCost);
      if (tileCpdYearly) tileCpdYearly.textContent = formatCurrency(yearlyCost);
    }

    // Trigger initial calculation
    calculateAll();

    // Clipboard copy results handler
    window.addEventListener('copy-calculator-results', () => {
      let text = '';
      if (activeMode === 'flat') {
        text = `Cost Per Day Report:\n` +
               `Total Cost: ${costInput.value} | Flat Duration: ${daysInput.value} days\n` +
               `Daily Cost: ${document.getElementById('res-cpd-daily')?.textContent}\n` +
               `Weekly equivalent: ${document.getElementById('res-cpd-weekly')?.textContent}\n` +
               `Monthly equivalent: ${document.getElementById('tile-cpd-monthly')?.textContent}\n` +
               `Yearly equivalent: ${document.getElementById('tile-cpd-yearly')?.textContent}\n` +
               `Diagnosis: ${document.getElementById('res-cpd-verdict-text')?.textContent}`;
      } else {
        text = `Cost Per Day Report:\n` +
               `Total Cost: ${costInput.value} | Start Date: ${startDateInput.value} | End Date: ${endDateInput.value} | Inclusive: ${inclusiveCheck.checked}\n` +
               `Total calculated days: ${document.getElementById('lbl-cpd-total-desc')?.textContent}\n` +
               `Daily Cost: ${document.getElementById('res-cpd-daily')?.textContent}\n` +
               `Weekly equivalent: ${document.getElementById('res-cpd-weekly')?.textContent}\n` +
               `Monthly equivalent: ${document.getElementById('tile-cpd-monthly')?.textContent}\n` +
               `Yearly equivalent: ${document.getElementById('tile-cpd-yearly')?.textContent}\n` +
               `Diagnosis: ${document.getElementById('res-cpd-verdict-text')?.textContent}`;
      }
      
      navigator.clipboard.writeText(text).then(() => {
        window.dispatchEvent(new CustomEvent('calculator-copied-success'));
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initCpdCalculator);
  document.addEventListener('astro:after-swap', initCpdCalculator);
</script>

<style>
  .calc-inputs-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .input-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }

  .input-label-row label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-base);
  }

  /* Input symbol wrapper */
  .input-symbol-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    background-color: var(--color-bg-base);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0 10px;
    width: 145px;
    height: 38px;
    transition: border-color var(--transition-fast);
  }

  .input-symbol-wrapper:focus-within {
    border-color: var(--color-primary);
  }

  .currency-symbol {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-light);
    margin-right: 4px;
  }

  .input-symbol-wrapper input {
    width: 100%;
    border: none;
    background: transparent;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-base);
    text-align: right;
    outline: none;
  }

  .input-symbol-wrapper input::-webkit-outer-spin-button,
  .input-symbol-wrapper input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .percent-symbol {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-light);
    margin-left: 4px;
    white-space: nowrap;
  }

  /* Currency select menu */
  .currency-select {
    width: 100%;
    max-width: 250px;
    height: 38px;
    padding: 0 10px;
    background-color: var(--color-bg-base);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-base);
    outline: none;
    cursor: pointer;
    transition: border-color var(--transition-fast);
  }

  .currency-select:focus {
    border-color: var(--color-primary);
  }

  /* Slider range */
  .slider-range {
    -webkit-appearance: none;
    width: 100%;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--color-border);
    outline: none;
    margin: 6px 0;
    cursor: pointer;
  }

  .slider-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-primary);
    border: 2px solid var(--color-bg-surface);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast), background-color var(--transition-fast);
  }

  .slider-range::-webkit-slider-thumb:hover {
    transform: scale(1.1);
    background: var(--color-primary-hover);
  }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .result-tile {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

