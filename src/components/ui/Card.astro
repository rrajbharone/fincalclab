---
interface Props {
  class?: string;
  hoverable?: boolean;
  elevation?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  id?: string;
  href?: string;
}

const {
  class: className = '',
  hoverable = false,
  elevation = 'md',
  id,
  href,
} = Astro.props;

const Tag = href ? 'a' : 'div';
---

<Tag
  id={id}
  href={href}
  class={`card card-elevation-${elevation} ${hoverable ? 'card-hoverable' : ''} ${className}`}
>
  <slot />
</Tag>

<style>
  .card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal), background-color var(--transition-normal);
    position: relative;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .card-elevation-none {
    box-shadow: none;
  }

  .card-elevation-sm {
    box-shadow: var(--shadow-sm);
  }

  .card-elevation-md {
    box-shadow: var(--shadow-md);
  }

  .card-elevation-lg {
    box-shadow: var(--shadow-lg);
  }

  .card-elevation-xl {
    box-shadow: var(--shadow-xl);
  }

  /* Keyboard accessibility / focus states */
  .card-hoverable:focus-within {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-lg), 0 0 0 2px var(--color-primary);
  }

  .card-hoverable:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Desktop / Mouse Hover interactions */
  @media (hover: hover) and (pointer: fine) {
    .card-hoverable {
      cursor: pointer;
    }

    .card-hoverable:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-xl);
      border-color: var(--color-border-hover);
    }

    /* Coordinated hover on card title */
    .card-hoverable:hover :global(.calc-card-title) {
      color: var(--color-primary);
    }

    /* Coordinated hover on action link */
    .card-hoverable:hover :global(.calc-card-action .btn),
    .card-hoverable:hover :global(.full-link-btn) {
      color: var(--color-primary);
    }

    /* Coordinated arrow shift on hover */
    .card-hoverable:hover :global(.calc-card-action svg),
    .card-hoverable:hover :global(.full-link-btn svg) {
      transform: translateX(4px);
      color: var(--color-primary);
    }
  }

  /* Focus-within coordinated states for keyboard navigation */
  .card-hoverable:focus-within :global(.calc-card-title) {
    color: var(--color-primary);
  }

  .card-hoverable:focus-within :global(.calc-card-action .btn),
  .card-hoverable:focus-within :global(.full-link-btn) {
    color: var(--color-primary);
  }

  .card-hoverable:focus-within :global(.calc-card-action svg),
  .card-hoverable:focus-within :global(.full-link-btn svg) {
    transform: translateX(4px);
    color: var(--color-primary);
  }

  /* Smooth transitions for internal elements */
  .card-hoverable :global(.calc-card-title) {
    transition: color var(--transition-fast);
  }

  .card-hoverable :global(.calc-card-action .btn),
  .card-hoverable :global(.full-link-btn) {
    transition: color var(--transition-fast);
  }

  .card-hoverable :global(.calc-card-action svg),
  .card-hoverable :global(.full-link-btn svg) {
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  /* Remove isolated button background and padding in full-link cards */
  .card-hoverable :global(.full-link-btn),
  .card-hoverable :global(.calc-card-action .btn-text) {
    background-color: transparent !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  .card-hoverable :global(.full-link-btn:hover),
  .card-hoverable :global(.calc-card-action .btn-text:hover) {
    background-color: transparent !important;
  }

  @media (max-width: 480px) {
    .card {
      padding: var(--space-4);
      border-radius: var(--radius-md);
    }
  }
</style>
