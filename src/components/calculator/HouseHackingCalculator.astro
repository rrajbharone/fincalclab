<script>
  // Setup Client-side Calculation Engine with Astro page lifecycle compatibility
  document.addEventListener('DOMContentLoaded', initHouseHackingCalc);
  document.addEventListener('astro:page-load', initHouseHackingCalc);

  function initHouseHackingCalc() {
    const root = document.getElementById('house-hacking-calculator');
    if (!root) return;

    // Currency Definitions
    const currencyConfigs = {
      USD: { symbol: '$', code: 'USD', locale: 'en-US' },
      CAD: { symbol: 'C$', code: 'CAD', locale: 'en-CA' },
      GBP: { symbol: '£', code: 'GBP', locale: 'en-GB' },
      EUR: { symbol: '€', code: 'EUR', locale: 'de-DE' },
      AUD: { symbol: 'A$', code: 'AUD', locale: 'en-AU' },
      INR: { symbol: '₹', code: 'INR', locale: 'en-IN' },
      SGD: { symbol: 'S$', code: 'SGD', locale: 'en-SG' },
      JPY: { symbol: '¥', code: 'JPY', locale: 'ja-JP' },
      CHF: { symbol: 'CHF', code: 'CHF', locale: 'de-CH' }
    };

    let activeCurrency = 'USD';

    // Core Input Elements
    const curSelect = document.getElementById('hh-currency-select');
    const priceInput = document.getElementById('hh-price-input');
    const priceSlider = document.getElementById('hh-price-slider');

    const dpPctInput = document.getElementById('hh-dp-pct-input');
    const dpPctSlider = document.getElementById('hh-dp-pct-slider');
    const dpAmtInput = document.getElementById('hh-dp-amt-input');

    const closingInput = document.getElementById('hh-closing-input');
    const repairsInput = document.getElementById('hh-repairs-input');

    const rateInput = document.getElementById('hh-rate-input');
    const rateSlider = document.getElementById('hh-rate-slider');
    const termSelect = document.getElementById('hh-term-select');

    const unitsCountSelect = document.getElementById('hh-units-count-select');
    const unitsListContainer = document.getElementById('hh-units-list');
    const addUnitBtn = document.getElementById('hh-add-unit-btn');

    const otherIncInput = document.getElementById('hh-other-income-input');
    const vacancyInput = document.getElementById('hh-vacancy-input');
    const vacancySlider = document.getElementById('hh-vacancy-slider');

    const taxInput = document.getElementById('hh-tax-input');
    const insuranceInput = document.getElementById('hh-insurance-input');
    const pmiInput = document.getElementById('hh-pmi-input');
    const maintInput = document.getElementById('hh-maint-input');
    const utilsInput = document.getElementById('hh-utils-input');
    const mgmtInput = document.getElementById('hh-mgmt-input');
    const hoaInput = document.getElementById('hh-hoa-input');

    const currentCostInput = document.getElementById('hh-current-cost-input');
    const resetBtn = document.getElementById('hh-reset-btn');

    // Default Unit Rents Array
    let unitRents = [1400, 1200];

    // Initialize Unit Input Rows
    renderUnitInputs();

    function renderUnitInputs() {
      if (!unitsListContainer) return;
      unitsListContainer.innerHTML = '';

      unitRents.forEach((rent, idx) => {
        const card = document.createElement('div');
        card.className = 'tenant-unit-card';
        card.innerHTML = `
          <div class="tenant-unit-main">
            <div class="tenant-unit-header">
              <span class="tenant-unit-badge">Unit ${idx + 1}</span>
              <label class="tenant-unit-label" for="hh-unit-rent-${idx}">Tenant Unit / Room ${idx + 1}</label>
            </div>
            <div class="tenant-unit-actions">
              <div class="input-symbol-wrapper">
                <span class="currency-symbol hh-unit-sym">${currencyConfigs[activeCurrency].symbol}</span>
                <input 
                  type="number" 
                  id="hh-unit-rent-${idx}"
                  class="hh-unit-rent-input" 
                  data-index="${idx}" 
                  min="0" 
                  step="50" 
                  value="${rent}" 
                  aria-label="Tenant Unit / Room ${idx + 1} Monthly Rent" 
                />
              </div>
              ${unitRents.length > 1 ? `
                <button type="button" class="unit-delete-btn" data-delete-index="${idx}" title="Remove Tenant Unit / Room ${idx + 1}" aria-label="Remove Tenant Unit ${idx + 1}">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
              ` : ''}
            </div>
          </div>
        `;
        unitsListContainer.appendChild(card);
      });

      // Attach listeners to unit rent inputs
      const rentInputs = unitsListContainer.querySelectorAll('.hh-unit-rent-input');
      rentInputs.forEach(input => {
        input.addEventListener('input', (e) => {
          const index = Number(e.target.dataset.index);
          const val = Math.max(0, Number(e.target.value) || 0);
          unitRents[index] = val;
          calculateAll();
        });
      });

      // Attach listeners to delete buttons
      const deleteBtns = unitsListContainer.querySelectorAll('.unit-delete-btn');
      deleteBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget;
          const index = Number(target.dataset.deleteIndex);
          if (unitRents.length > 1) {
            unitRents.splice(index, 1);
            if (unitsCountSelect) unitsCountSelect.value = String(Math.min(6, unitRents.length));
            renderUnitInputs();
            calculateAll();
          }
        });
      });
    }

    if (unitsCountSelect) {
      unitsCountSelect.addEventListener('change', () => {
        const targetCount = Number(unitsCountSelect.value) || 1;
        const currentCount = unitRents.length;
        if (targetCount > currentCount) {
          for (let i = currentCount; i < targetCount; i++) {
            const lastVal = unitRents[unitRents.length - 1] || 1000;
            unitRents.push(lastVal);
          }
        } else if (targetCount < currentCount) {
          unitRents = unitRents.slice(0, targetCount);
        }
        renderUnitInputs();
        calculateAll();
      });
    }

    if (addUnitBtn) {
      addUnitBtn.addEventListener('click', () => {
        const lastVal = unitRents[unitRents.length - 1] || 1000;
        unitRents.push(lastVal);
        if (unitsCountSelect) {
          unitsCountSelect.value = String(Math.min(6, unitRents.length));
        }
        renderUnitInputs();
        calculateAll();
      });
    }

    // Helper: Money Formatter
    function formatMoney(num, decimal = 0) {
      const cfg = currencyConfigs[activeCurrency] || currencyConfigs.USD;
      if (isNaN(num) || !isFinite(num)) num = 0;
      return new Intl.NumberFormat(cfg.locale, {
        style: 'currency',
        currency: cfg.code,
        minimumFractionDigits: decimal,
        maximumFractionDigits: decimal
      }).format(num);
    }

    // Currency Switcher
    if (curSelect) {
      curSelect.addEventListener('change', () => {
        activeCurrency = curSelect.value;
        const sym = currencyConfigs[activeCurrency].symbol;
        const symIds = [
          'sym-price', 'sym-dp-amt', 'sym-closing', 'sym-repairs',
          'sym-other-inc', 'sym-tax', 'sym-ins', 'sym-pmi',
          'sym-maint', 'sym-utils', 'sym-mgmt', 'sym-hoa', 'sym-curr'
        ];
        symIds.forEach(id => {
          const el = document.getElementById(id);
          if (el) el.textContent = sym;
        });
        const unitSymbols = document.querySelectorAll('.hh-unit-sym');
        unitSymbols.forEach(el => el.textContent = sym);
        calculateAll();
      });
    }

    // Two-way synchronization helper for Sliders and Inputs
    function linkSliderAndInput(inputEl, sliderEl, onChangeCallback) {
      if (!inputEl || !sliderEl) return;
      inputEl.addEventListener('input', () => {
        sliderEl.value = inputEl.value;
        if (onChangeCallback) onChangeCallback();
        calculateAll();
      });
      sliderEl.addEventListener('input', () => {
        inputEl.value = sliderEl.value;
        if (onChangeCallback) onChangeCallback();
        calculateAll();
      });
    }

    // Link price
    linkSliderAndInput(priceInput, priceSlider, () => {
      syncDownPaymentFromPct();
      updateTaxHint();
    });

    // Link Down Payment Percentage & Amount
    function syncDownPaymentFromPct() {
      const p = Math.max(0, Number(priceInput.value) || 0);
      const pct = Math.max(0, Math.min(100, Number(dpPctInput.value) || 0));
      const amt = (p * pct) / 100;
      if (dpAmtInput) dpAmtInput.value = Math.round(amt);
      // Auto-adjust PMI helper: if down payment >= 20%, suggest $0 PMI if not manually customized
      if (pct >= 20 && pmiInput && Number(pmiInput.value) > 0) {
        pmiInput.value = 0;
      } else if (pct < 20 && pmiInput && Number(pmiInput.value) === 0) {
        // Suggest typical PMI: ~0.5% loan / 12
        const loan = p - amt;
        pmiInput.value = Math.round((loan * 0.005) / 12);
      }
    }

    function syncDownPaymentFromAmt() {
      const p = Math.max(0, Number(priceInput.value) || 0);
      const amt = Math.max(0, Number(dpAmtInput.value) || 0);
      const pct = p > 0 ? (amt / p) * 100 : 0;
      if (dpPctInput) dpPctInput.value = pct.toFixed(1);
      if (dpPctSlider) dpPctSlider.value = pct.toFixed(1);
    }

    linkSliderAndInput(dpPctInput, dpPctSlider, syncDownPaymentFromPct);

    if (dpAmtInput) {
      dpAmtInput.addEventListener('input', () => {
        syncDownPaymentFromAmt();
        calculateAll();
      });
    }

    // Link rate and term
    linkSliderAndInput(rateInput, rateSlider);
    if (termSelect) termSelect.addEventListener('change', calculateAll);

    // Link vacancy
    linkSliderAndInput(vacancyInput, vacancySlider);

    // Other inputs
    const standardInputs = [
      closingInput, repairsInput, otherIncInput, taxInput, insuranceInput,
      pmiInput, maintInput, utilsInput, mgmtInput, hoaInput, currentCostInput
    ];

    standardInputs.forEach(inp => {
      if (inp) {
        inp.addEventListener('input', () => {
          if (inp === taxInput) updateTaxHint();
          if (inp === insuranceInput) updateInsHint();
          calculateAll();
        });
      }
    });

    function updateTaxHint() {
      const hintTax = document.getElementById('hint-tax-annual');
      if (hintTax && taxInput && priceInput) {
        const mTax = Number(taxInput.value) || 0;
        const p = Number(priceInput.value) || 0;
        const aTax = mTax * 12;
        const pct = p > 0 ? ((aTax / p) * 100).toFixed(2) : '0.00';
        hintTax.textContent = `Annual: ${formatMoney(aTax)} (~${pct}% of price)`;
      }
    }

    function updateInsHint() {
      const hintIns = document.getElementById('hint-ins-annual');
      if (hintIns && insuranceInput) {
        const mIns = Number(insuranceInput.value) || 0;
        hintIns.textContent = `Annual: ${formatMoney(mIns * 12)}`;
      }
    }

    // Reset Button Handler
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (priceInput) priceInput.value = 425000;
        if (priceSlider) priceSlider.value = 425000;
        if (dpPctInput) dpPctInput.value = 5.0;
        if (dpPctSlider) dpPctSlider.value = 5.0;
        if (dpAmtInput) dpAmtInput.value = 21250;
        if (closingInput) closingInput.value = 9000;
        if (repairsInput) repairsInput.value = 8000;
        if (rateInput) rateInput.value = 6.5;
        if (rateSlider) rateSlider.value = 6.5;
        if (termSelect) termSelect.value = '30';

        unitRents = [1400, 1200];
        if (unitsCountSelect) unitsCountSelect.value = '2';
        renderUnitInputs();

        if (otherIncInput) otherIncInput.value = 50;
        if (vacancyInput) vacancyInput.value = 5.0;
        if (vacancySlider) vacancySlider.value = 5.0;

        if (taxInput) taxInput.value = 375;
        if (insuranceInput) insuranceInput.value = 140;
        if (pmiInput) pmiInput.value = 160;
        if (maintInput) maintInput.value = 200;
        if (utilsInput) utilsInput.value = 175;
        if (mgmtInput) mgmtInput.value = 0;
        if (hoaInput) hoaInput.value = 0;
        if (currentCostInput) currentCostInput.value = 2000;

        updateTaxHint();
        updateInsHint();
        calculateAll();
      });
    }

    // Standard Amortization Formula
    function calcMortgage(principal, annualRatePct, years) {
      if (principal <= 0) return 0;
      const n = years * 12;
      if (n <= 0) return 0;
      const r = (annualRatePct / 100) / 12;
      if (r === 0) return principal / n;
      return principal * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
    }

    // Primary Calculation Routine
    function calculateAll() {
      // 1. Property Purchase & Financing
      const price = Math.max(0, Number(priceInput.value) || 0);
      const dpPct = Math.max(0, Math.min(100, Number(dpPctInput.value) || 0));
      const downPayment = (price * dpPct) / 100;
      const closing = Math.max(0, Number(closingInput.value) || 0);
      const repairs = Math.max(0, Number(repairsInput.value) || 0);
      const initialCashRequired = downPayment + closing + repairs;

      const principal = Math.max(0, price - downPayment);
      const rate = Math.max(0, Number(rateInput.value) || 0);
      const termYears = Math.max(1, Number(termSelect.value) || 30);
      const mortgageMonthly = calcMortgage(principal, rate, termYears);

      // 2. Rental Income
      const grossUnitRent = unitRents.reduce((sum, r) => sum + (Number(r) || 0), 0);
      const otherIncome = Math.max(0, Number(otherIncInput.value) || 0);
      const grossMonthlyRent = grossUnitRent + otherIncome;

      const vacancyPct = Math.max(0, Math.min(100, Number(vacancyInput.value) || 0));
      const vacancyLoss = grossMonthlyRent * (vacancyPct / 100);
      const effectiveMonthlyRent = grossMonthlyRent - vacancyLoss;

      // 3. Operating Expenses
      const propTax = Math.max(0, Number(taxInput.value) || 0);
      const ins = Math.max(0, Number(insuranceInput.value) || 0);
      const pmi = Math.max(0, Number(pmiInput.value) || 0);
      const maint = Math.max(0, Number(maintInput.value) || 0);
      const utils = Math.max(0, Number(utilsInput.value) || 0);
      const mgmt = Math.max(0, Number(mgmtInput.value) || 0);
      const hoa = Math.max(0, Number(hoaInput.value) || 0);

      const totalMonthlyOpEx = propTax + ins + pmi + maint + utils + mgmt + hoa;
      const totalMonthlyExpenses = mortgageMonthly + totalMonthlyOpEx;

      // 4. Net Out-of-Pocket Cost vs Property Cash Flow
      const outOfPocket = totalMonthlyExpenses - effectiveMonthlyRent;
      const monthlyCashFlow = effectiveMonthlyRent - totalMonthlyExpenses;
      const isPositiveCashFlow = monthlyCashFlow > 0;

      // 5. Coverage Percentage
      const coveragePct = totalMonthlyExpenses > 0 ? (effectiveMonthlyRent / totalMonthlyExpenses) * 100 : 0;

      // 6. Savings vs Current Housing Cost
      const currentHousingCost = Math.max(0, Number(currentCostInput.value) || 0);
      let monthlySavings = 0;
      let annualSavings = 0;
      if (currentHousingCost > 0) {
        monthlySavings = currentHousingCost - outOfPocket;
        annualSavings = monthlySavings * 12;
      }

      // --- Update DOM Elements ---

      // 1. Hero Boxes
      const boxPrimary = document.getElementById('box-primary-result');
      const lblPrimaryTitle = document.getElementById('lbl-primary-title');
      const resPrimaryAmount = document.getElementById('res-primary-amount');
      const lblPrimarySub = document.getElementById('lbl-primary-sub');

      if (resPrimaryAmount && lblPrimaryTitle && lblPrimarySub) {
        if (isPositiveCashFlow) {
          lblPrimaryTitle.textContent = 'Net Positive Monthly Cash Flow';
          resPrimaryAmount.textContent = `+${formatMoney(monthlyCashFlow)}`;
          resPrimaryAmount.className = 'net-box-amount text-success';
          lblPrimarySub.textContent = `Tenants pay 100% of expenses and give you ${formatMoney(monthlyCashFlow)} extra each month!`;
          if (boxPrimary) boxPrimary.style.borderTopColor = '#16a34a';
        } else {
          lblPrimaryTitle.textContent = 'Net Monthly Out-of-Pocket Housing Cost';
          resPrimaryAmount.textContent = formatMoney(outOfPocket);
          resPrimaryAmount.className = 'net-box-amount text-primary';
          lblPrimarySub.textContent = `You pay ${formatMoney(outOfPocket)}/mo instead of full ${formatMoney(totalMonthlyExpenses)} property costs`;
          if (boxPrimary) boxPrimary.style.borderTopColor = 'var(--color-primary)';
        }
      }

      const resTotalExp = document.getElementById('res-total-expenses');
      if (resTotalExp) resTotalExp.textContent = formatMoney(totalMonthlyExpenses);

      const lblExpBreakdown = document.getElementById('lbl-expense-breakdown');
      if (lblExpBreakdown) {
        lblExpBreakdown.textContent = `Mortgage P&I: ${formatMoney(mortgageMonthly)} | OpEx: ${formatMoney(totalMonthlyOpEx)}`;
      }

      const resEffIncome = document.getElementById('res-effective-income');
      if (resEffIncome) resEffIncome.textContent = formatMoney(effectiveMonthlyRent);

      const lblGrossIncome = document.getElementById('lbl-gross-income');
      if (lblGrossIncome) {
        lblGrossIncome.textContent = `Gross: ${formatMoney(grossMonthlyRent)}/mo | Vacancy Loss: -${formatMoney(vacancyLoss)}/mo`;
      }

      // 2. Coverage Bar & Verdict
      const resCoveragePct = document.getElementById('res-coverage-pct');
      const barCoverageFill = document.getElementById('bar-coverage-fill');
      const verdictBanner = document.getElementById('verdict-banner');
      const verdictIcon = document.getElementById('verdict-icon');
      const verdictTitle = document.getElementById('verdict-title');
      const verdictDesc = document.getElementById('verdict-desc');

      const clampedFillPct = Math.min(100, Math.max(0, coveragePct));
      if (resCoveragePct) resCoveragePct.textContent = `${coveragePct.toFixed(1)}%`;
      if (barCoverageFill) {
        barCoverageFill.style.width = `${clampedFillPct}%`;
        if (coveragePct >= 100) {
          barCoverageFill.style.background = '#16a34a';
        } else if (coveragePct >= 60) {
          barCoverageFill.style.background = 'linear-gradient(90deg, #2563eb 0%, #10b981 100%)';
        } else {
          barCoverageFill.style.background = '#2563eb';
        }
      }

      if (verdictTitle && verdictDesc && verdictIcon) {
        if (coveragePct >= 100) {
          verdictTitle.textContent = '100%+ Coverage: Free Living & Positive Cash Flow!';
          verdictDesc.innerHTML = `Rental income fully covers all mortgage payments and operating costs. You live completely rent-free and pocket <strong>+${formatMoney(monthlyCashFlow)}/month</strong> in positive cash flow!`;
          verdictIcon.style.color = '#16a34a';
          verdictIcon.style.background = 'rgba(22, 163, 74, 0.1)';
        } else if (coveragePct >= 65) {
          verdictTitle.textContent = 'Substantial Housing Subsidy (Major Savings)';
          verdictDesc.innerHTML = `Tenants cover <strong>${coveragePct.toFixed(1)}%</strong> of your total property expenses. Your net out-of-pocket housing cost is slashed to <strong>${formatMoney(outOfPocket)}/mo</strong>${currentHousingCost > 0 ? `, saving you <strong>${formatMoney(monthlySavings)}/month</strong> compared to your current housing!` : '.'}`;
          verdictIcon.style.color = 'var(--color-primary)';
          verdictIcon.style.background = 'rgba(37, 99, 235, 0.1)';
        } else if (coveragePct >= 35) {
          verdictTitle.textContent = 'Moderate Housing Subsidy';
          verdictDesc.innerHTML = `Tenants offset <strong>${coveragePct.toFixed(1)}%</strong> of your property costs. You pay <strong>${formatMoney(outOfPocket)}/month</strong> out-of-pocket while building substantial long-term real estate equity.`;
          verdictIcon.style.color = '#d97706';
          verdictIcon.style.background = 'rgba(217, 119, 6, 0.1)';
        } else {
          verdictTitle.textContent = 'Minor Housing Offset';
          verdictDesc.innerHTML = `Rental income covers <strong>${coveragePct.toFixed(1)}%</strong> of expenses. High mortgage or operating costs leave an out-of-pocket payment of <strong>${formatMoney(outOfPocket)}/month</strong>.`;
          verdictIcon.style.color = '#dc2626';
          verdictIcon.style.background = 'rgba(220, 38, 38, 0.1)';
        }
      }

      // 3. Metrics Grid
      const resMortgage = document.getElementById('res-mortgage');
      if (resMortgage) resMortgage.textContent = formatMoney(mortgageMonthly);

      const lblMortgageSub = document.getElementById('lbl-mortgage-sub');
      if (lblMortgageSub) lblMortgageSub.textContent = `Loan: ${formatMoney(principal)} @ ${rate.toFixed(2)}%`;

      const resMonthlyOpEx = document.getElementById('res-monthly-opex');
      if (resMonthlyOpEx) resMonthlyOpEx.textContent = formatMoney(totalMonthlyOpEx);

      const resGrossRent = document.getElementById('res-gross-rent');
      if (resGrossRent) resGrossRent.textContent = formatMoney(grossMonthlyRent);

      const lblGrossSub = document.getElementById('lbl-gross-sub');
      if (lblGrossSub) lblGrossSub.textContent = `${unitRents.length} Units/Rooms + Other Income`;

      const resVacancyLoss = document.getElementById('res-vacancy-loss');
      if (resVacancyLoss) resVacancyLoss.textContent = `-${formatMoney(vacancyLoss)}`;

      const lblVacancySub = document.getElementById('lbl-vacancy-sub');
      if (lblVacancySub) lblVacancySub.textContent = `${vacancyPct.toFixed(1)}% turnover buffer`;

      const resInitialCash = document.getElementById('res-initial-cash');
      if (resInitialCash) resInitialCash.textContent = formatMoney(initialCashRequired);

      const lblCashBreakdown = document.getElementById('lbl-cash-breakdown');
      if (lblCashBreakdown) {
        lblCashBreakdown.textContent = `Down (${formatMoney(downPayment)}) + Close (${formatMoney(closing)}) + Rep (${formatMoney(repairs)})`;
      }

      const resCashFlow = document.getElementById('res-cash-flow');
      if (resCashFlow) {
        if (isPositiveCashFlow) {
          resCashFlow.textContent = `+${formatMoney(monthlyCashFlow)}`;
          resCashFlow.className = 'metric-value text-success';
        } else {
          resCashFlow.textContent = `-${formatMoney(Math.abs(monthlyCashFlow))}`;
          resCashFlow.className = 'metric-value';
        }
      }

      const lblCashFlowSub = document.getElementById('lbl-cash-flow-sub');
      if (lblCashFlowSub) {
        lblCashFlowSub.textContent = isPositiveCashFlow ? 'Net surplus pocketed by owner' : 'Owner covers remaining cost';
      }

      const resMonthlySavings = document.getElementById('res-monthly-savings');
      const resAnnualSavings = document.getElementById('res-annual-savings');
      const lblSavingsSub = document.getElementById('lbl-savings-sub');

      if (resMonthlySavings && resAnnualSavings && lblSavingsSub) {
        if (currentHousingCost > 0) {
          const sign = monthlySavings >= 0 ? '+' : '';
          resMonthlySavings.textContent = `${sign}${formatMoney(monthlySavings)}`;
          resAnnualSavings.textContent = `${sign}${formatMoney(annualSavings)}`;
          lblSavingsSub.textContent = `vs ${formatMoney(currentHousingCost)}/mo Current Rent`;
        } else {
          resMonthlySavings.textContent = '—';
          resAnnualSavings.textContent = '—';
          lblSavingsSub.textContent = 'Enter current housing cost above';
        }
      }

      // 4. Cash Flow Statement Table
      const setTableText = (id, txt) => {
        const el = document.getElementById(id);
        if (el) el.textContent = txt;
      };

      setTableText('tbl-gross-rent', formatMoney(grossMonthlyRent));
      setTableText('tbl-annual-gross-rent', formatMoney(grossMonthlyRent * 12));

      setTableText('tbl-vacancy-pct', `${vacancyPct.toFixed(1)}%`);
      setTableText('tbl-vacancy', `-${formatMoney(vacancyLoss)}`);
      setTableText('tbl-annual-vacancy', `-${formatMoney(vacancyLoss * 12)}`);

      setTableText('tbl-eff-rent', formatMoney(effectiveMonthlyRent));
      setTableText('tbl-annual-eff-rent', formatMoney(effectiveMonthlyRent * 12));

      setTableText('tbl-mortgage', `-${formatMoney(mortgageMonthly)}`);
      setTableText('tbl-annual-mortgage', `-${formatMoney(mortgageMonthly * 12)}`);

      setTableText('tbl-taxes', `-${formatMoney(propTax)}`);
      setTableText('tbl-annual-taxes', `-${formatMoney(propTax * 12)}`);

      setTableText('tbl-insurance', `-${formatMoney(ins)}`);
      setTableText('tbl-annual-insurance', `-${formatMoney(ins * 12)}`);

      setTableText('tbl-pmi', `-${formatMoney(pmi)}`);
      setTableText('tbl-annual-pmi', `-${formatMoney(pmi * 12)}`);

      setTableText('tbl-maint', `-${formatMoney(maint)}`);
      setTableText('tbl-annual-maint', `-${formatMoney(maint * 12)}`);

      setTableText('tbl-utils', `-${formatMoney(utils)}`);
      setTableText('tbl-annual-utils', `-${formatMoney(utils * 12)}`);

      const mgmtHoa = mgmt + hoa;
      setTableText('tbl-mgmt-hoa', `-${formatMoney(mgmtHoa)}`);
      setTableText('tbl-annual-mgmt-hoa', `-${formatMoney(mgmtHoa * 12)}`);

      setTableText('tbl-total-exp', `-${formatMoney(totalMonthlyExpenses)}`);
      setTableText('tbl-annual-total-exp', `-${formatMoney(totalMonthlyExpenses * 12)}`);

      const tblNetLabel = document.getElementById('tbl-net-label');
      const tblNetAmount = document.getElementById('tbl-net-amount');
      const tblAnnualNetAmount = document.getElementById('tbl-annual-net-amount');

      if (tblNetLabel && tblNetAmount && tblAnnualNetAmount) {
        if (isPositiveCashFlow) {
          tblNetLabel.textContent = 'Net Monthly Cash Surplus (Positive Cash Flow)';
          tblNetAmount.textContent = `+${formatMoney(monthlyCashFlow)}`;
          tblNetAmount.className = 'text-success';
          tblAnnualNetAmount.textContent = `+${formatMoney(monthlyCashFlow * 12)}`;
          tblAnnualNetAmount.className = 'text-success';
        } else {
          tblNetLabel.textContent = 'Net Monthly Out-of-Pocket Housing Cost';
          tblNetAmount.textContent = formatMoney(outOfPocket);
          tblNetAmount.className = 'text-primary';
          tblAnnualNetAmount.textContent = formatMoney(outOfPocket * 12);
          tblAnnualNetAmount.className = 'text-primary';
        }
      }

      // 5. Mathematical Formula Step-by-Step Callout
      const stepsContainer = document.getElementById('formula-steps-container');
      if (stepsContainer) {
        stepsContainer.innerHTML = `
          <div class="formula-step-item">
            <strong>1. Initial Investment:</strong> Purchase Price (${formatMoney(price)}) × Down Payment (${dpPct.toFixed(1)}%) = <strong>${formatMoney(downPayment)}</strong>. Adding closing costs (${formatMoney(closing)}) and repairs (${formatMoney(repairs)}) yields total cash required: <strong>${formatMoney(initialCashRequired)}</strong>.
          </div>
          <div class="formula-step-item">
            <strong>2. Mortgage P&amp;I Payment:</strong> Loan Principal ${formatMoney(principal)} at ${rate.toFixed(2)}% over ${termYears} years yields a monthly principal &amp; interest payment of <strong>${formatMoney(mortgageMonthly)}/month</strong>.
          </div>
          <div class="formula-step-item">
            <strong>3. Effective Rental Income:</strong> Gross rent (${formatMoney(grossMonthlyRent)}) minus ${vacancyPct.toFixed(1)}% vacancy loss (${formatMoney(vacancyLoss)}) = <strong>${formatMoney(effectiveMonthlyRent)}/month</strong>.
          </div>
          <div class="formula-step-item">
            <strong>4. Total Property Costs:</strong> Mortgage (${formatMoney(mortgageMonthly)}) + Taxes (${formatMoney(propTax)}) + Insurance (${formatMoney(ins)}) + PMI (${formatMoney(pmi)}) + Maintenance (${formatMoney(maint)}) + Utilities (${formatMoney(utils)}) + Mgmt/HOA (${formatMoney(mgmtHoa)}) = <strong>${formatMoney(totalMonthlyExpenses)}/month</strong>.
          </div>
          <div class="formula-step-item">
            <strong>5. Net House Hacking Result:</strong> Total Expenses (${formatMoney(totalMonthlyExpenses)}) − Effective Rent (${formatMoney(effectiveMonthlyRent)}) = <strong>${isPositiveCashFlow ? `+${formatMoney(monthlyCashFlow)}/mo Net Cash Flow` : `${formatMoney(outOfPocket)}/mo Net Out-of-Pocket Cost`}</strong> (Rental Coverage: <strong>${coveragePct.toFixed(1)}%</strong>).
          </div>
          ${currentHousingCost > 0 ? `
            <div class="formula-step-item formula-step-highlight">
              <strong>6. Comparative Wealth Benefit:</strong> Current rent (${formatMoney(currentHousingCost)}) − Net out-of-pocket (${formatMoney(outOfPocket)}) = <strong>${formatMoney(monthlySavings)}/month</strong> in direct savings (<strong>${formatMoney(annualSavings)}/year</strong>).
            </div>
          ` : ''}
        `;
      }
    }

    // Run initial calculation on load
    calculateAll();
  }
</script>
