---
import CalculatorLayout from './CalculatorLayout.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
---

<CalculatorLayout
  title="BRRRR Calculator"
  description="Analyze real estate BRRRR deals (Buy, Rehab, Rent, Refinance, Repeat). Estimate cash invested, refinance proceeds, cash left in deal, rental cash flow, and Cash-on-Cash return."
  category="Real Estate &amp; Investing"
>
  <!-- Inputs Section -->
  <div slot="inputs" class="calc-inputs-wrapper" id="brrrr-calculator">
    
    <!-- Currency Selector -->
    <div class="input-group">
      <label for="brrrr-currency-select" class="field-label-top">Currency</label>
      <select id="brrrr-currency-select" class="form-select-full" aria-label="Select Currency">
        <option value="USD" selected>USD ($) - US Dollar</option>
        <option value="CAD">CAD (C$) - Canadian Dollar</option>
        <option value="GBP">GBP (£) - British Pound</option>
        <option value="EUR">EUR (€) - Euro</option>
        <option value="AUD">AUD (A$) - Australian Dollar</option>
        <option value="INR">INR (₹) - Indian Rupee</option>
        <option value="SGD">SGD (S$) - Singapore Dollar</option>
        <option value="JPY">JPY (¥) - Japanese Yen</option>
        <option value="CHF">CHF (CHF) - Swiss Franc</option>
      </select>
    </div>

    <!-- Section 1: Buy & Rehab (Acquisition Phase) -->
    <h3 class="input-section-heading">1. Buy &amp; Rehab (Acquisition Phase)</h3>
    
    <!-- Purchase Price -->
    <div class="input-group">
      <div class="input-label-row">
        <label for="brrrr-purchase-price">Purchase Price</label>
        <div class="input-symbol-wrapper">
          <span class="currency-symbol" id="sym-price">$</span>
          <input 
            type="number" 
            id="brrrr-purchase-price" 
            min="10000" 
            max="3000000" 
            step="5000" 
            value="150000" 
            aria-label="Property Purchase Price" 
          />
        </div>
      </div>
      <input 
        type="range" 
        id="brrrr-purchase-price-slider" 
        min="30000" 
        max="600000" 
        step="5000" 
        value="150000" 
        class="slider-range" 
        aria-label="Purchase Price Slider" 
      />
      <span class="input-hint">Agreed acquisition price for the distressed or undervalued property.</span>
    </div>

    <!-- Down Payment Row (% and Amount) -->
    <div class="input-row-grid">
      <div class="input-group">
        <div class="input-label-row">
          <label for="brrrr-down-pct">Down Payment (%)</label>
          <div class="input-symbol-wrapper">
            <input 
              type="number" 
              id="brrrr-down-pct" 
              min="0" 
              max="100" 
              step="1" 
              value="20" 
              aria-label="Down Payment Percentage" 
            />
            <span class="unit-symbol">%</span>
          </div>
        </div>
        <input 
          type="range" 
          id="brrrr-down-pct-slider" 
          min="0" 
          max="100" 
          step="5" 
          value="20" 
          class="slider-range" 
          aria-label="Down Payment Percentage Slider" 
        />
        <span class="input-hint">Enter 100% for all-cash purchase.</span>
      </div>

      <div class="input-group">
        <div class="input-label-row">
          <label for="brrrr-down-amt">Down Payment Amount</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol" id="sym-down">$</span>
            <input 
              type="number" 
              id="brrrr-down-amt" 
              min="0" 
              max="3000000" 
              step="1000" 
              value="30000" 
              aria-label="Down Payment Amount" 
            />
          </div>
        </div>
        <span class="input-hint">Auto-synced with down payment percentage.</span>
      </div>
    </div>

    <!-- Rehab Budget & Purchase Closing Costs -->
    <div class="input-row-grid">
      <div class="input-group">
        <div class="input-label-row">
          <label for="brrrr-rehab-cost">Rehab Budget</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol" id="sym-rehab">$</span>
            <input 
              type="number" 
              id="brrrr-rehab-cost" 
              min="0" 
              max="1000000" 
              step="1000" 
              value="40000" 
              aria-label="Estimated Renovation / Rehab Cost" 
            />
          </div>
        </div>
        <input 
          type="range" 
          id="brrrr-rehab-cost-slider" 
          min="0" 
          max="150000" 
          step="2500" 
          value="40000" 
          class="slider-range" 
          aria-label="Rehab Cost Slider" 
        />
        <span class="input-hint">Materials, contractor labor, permits, contingencies.</span>
      </div>

      <div class="input-group">
        <div class="input-label-row">
          <label for="brrrr-purchase-closing">Purchase Closing Costs</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol" id="sym-pclosing">$</span>
            <input 
              type="number" 
              id="brrrr-purchase-closing" 
              min="0" 
              max="100000" 
              step="500" 
              value="4000" 
              aria-label="Purchase Closing Costs" 
            />
          </div>
        </div>
        <input 
          type="range" 
          id="brrrr-purchase-closing-slider" 
          min="0" 
          max="15000" 
          step="500" 
          value="4000" 
          class="slider-range" 
          aria-label="Purchase Closing Costs Slider" 
        />
        <span class="input-hint">Title, escrow, attorney fees, inspection (~2%–4%).</span>
      </div>
    </div>

    <!-- Monthly Holding Costs & Months to Refinance -->
    <div class="input-row-grid">
      <div class="input-group">
        <div class="input-label-row">
          <label for="brrrr-monthly-holding">Monthly Holding Costs</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol" id="sym-holding">$</span>
            <input 
              type="number" 
              id="brrrr-monthly-holding" 
              min="0" 
              max="20000" 
              step="50" 
              value="1000" 
              aria-label="Monthly Holding Costs" 
            />
          </div>
        </div>
        <input 
          type="range" 
          id="brrrr-monthly-holding-slider" 
          min="0" 
          max="4000" 
          step="50" 
          value="1000" 
          class="slider-range" 
          aria-label="Monthly Holding Costs Slider" 
        />
        <span class="input-hint">Loan payments, property taxes, insurance, utilities while vacant.</span>
      </div>

      <div class="input-group">
        <div class="input-label-row">
          <label for="brrrr-refi-months">Holding Period (Seasoning)</label>
          <div class="input-symbol-wrapper">
            <input 
              type="number" 
              id="brrrr-refi-months" 
              min="1" 
              max="36" 
              step="1" 
              value="6" 
              aria-label="Months until Refinance" 
            />
            <span class="unit-symbol">mo</span>
          </div>
        </div>
        <input 
          type="range" 
          id="brrrr-refi-months-slider" 
          min="1" 
          max="24" 
          step="1" 
          value="6" 
          class="slider-range" 
          aria-label="Months to Refinance Slider" 
        />
        <span class="input-hint">Months until rehab is done and refinance closes (typically 6 mos).</span>
      </div>
    </div>

    <!-- Section 2: Property Value & Rental Operations -->
    <div style="margin-top: var(--space-6);">
      <h3 class="input-section-heading">2. After Repair Value &amp; Rental Operations</h3>
      
      <!-- After Repair Value (ARV) -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="brrrr-arv">After Repair Value (ARV)</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol" id="sym-arv">$</span>
            <input 
              type="number" 
              id="brrrr-arv" 
              min="20000" 
              max="5000000" 
              step="5000" 
              value="260000" 
              aria-label="After Repair Value" 
            />
          </div>
        </div>
        <input 
          type="range" 
          id="brrrr-arv-slider" 
          min="50000" 
          max="800000" 
          step="5000" 
          value="260000" 
          class="slider-range" 
          aria-label="ARV Slider" 
        />
        <span class="input-hint">Expected appraised market value once property is fully renovated.</span>
      </div>

      <!-- Monthly Rent & Operating Expenses -->
      <div class="input-row-grid">
        <div class="input-group">
          <div class="input-label-row">
            <label for="brrrr-monthly-rent">Gross Monthly Rent</label>
            <div class="input-symbol-wrapper">
              <span class="currency-symbol" id="sym-rent">$</span>
              <input 
                type="number" 
                id="brrrr-monthly-rent" 
                min="0" 
                max="50000" 
                step="50" 
                value="2200" 
                aria-label="Gross Monthly Rent" 
              />
            </div>
          </div>
          <input 
            type="range" 
            id="brrrr-monthly-rent-slider" 
            min="500" 
            max="6000" 
            step="50" 
            value="2200" 
            class="slider-range" 
            aria-label="Monthly Rent Slider" 
          />
          <span class="input-hint">Expected gross monthly rental income from tenants.</span>
        </div>

        <div class="input-group">
          <div class="input-label-row">
            <label for="brrrr-monthly-expenses">Monthly Operating Expenses</label>
            <div class="input-symbol-wrapper">
              <span class="currency-symbol" id="sym-expenses">$</span>
              <input 
                type="number" 
                id="brrrr-monthly-expenses" 
                min="0" 
                max="25000" 
                step="25" 
                value="600" 
                aria-label="Monthly Operating Expenses" 
              />
            </div>
          </div>
          <input 
            type="range" 
            id="brrrr-monthly-expenses-slider" 
            min="0" 
            max="2500" 
            step="25" 
            value="600" 
            class="slider-range" 
            aria-label="Monthly Operating Expenses Slider" 
          />
          <span class="input-hint">Taxes, insurance, property management, vacancy, repairs reserve, CapEx.</span>
        </div>
      </div>
    </div>

    <!-- Section 3: Financing & Long-Term Refinance -->
    <div style="margin-top: var(--space-6);">
      <h3 class="input-section-heading">3. Initial Financing &amp; Long-Term Refinance</h3>
      
      <!-- Initial Loan Interest Rate & Loan Type (if not 100% cash) -->
      <div class="input-row-grid" id="row-initial-financing">
        <div class="input-group">
          <div class="input-label-row">
            <label for="brrrr-init-rate">Initial Loan Interest Rate (%)</label>
            <div class="input-symbol-wrapper">
              <input 
                type="number" 
                id="brrrr-init-rate" 
                min="0" 
                max="25" 
                step="0.25" 
                value="8.0" 
                aria-label="Initial Loan Interest Rate" 
              />
              <span class="unit-symbol">%</span>
            </div>
          </div>
          <input 
            type="range" 
            id="brrrr-init-rate-slider" 
            min="0" 
            max="18" 
            step="0.25" 
            value="8.0" 
            class="slider-range" 
            aria-label="Initial Rate Slider" 
          />
          <span class="input-hint">Hard money, private loan, or conventional purchase rate.</span>
        </div>

        <div class="input-group">
          <label for="brrrr-init-loan-type" class="field-label-top">Initial Loan Structure</label>
          <select id="brrrr-init-loan-type" class="form-select-full" aria-label="Initial Loan Structure">
            <option value="amort30" selected>30-Year Amortizing</option>
            <option value="interestOnly">Interest-Only / Bridge Loan</option>
            <option value="amort15">15-Year Amortizing</option>
          </select>
          <span class="input-hint">Determines remaining balance paid off at refinance.</span>
        </div>
      </div>

      <!-- Refinance LTV % & Closing Costs -->
      <div class="input-row-grid">
        <div class="input-group">
          <div class="input-label-row">
            <label for="brrrr-refi-ltv">Refinance LTV (%)</label>
            <div class="input-symbol-wrapper">
              <input 
                type="number" 
                id="brrrr-refi-ltv" 
                min="50" 
                max="90" 
                step="1" 
                value="75" 
                aria-label="Refinance Loan to Value" 
              />
              <span class="unit-symbol">%</span>
            </div>
          </div>
          <input 
            type="range" 
            id="brrrr-refi-ltv-slider" 
            min="50" 
            max="85" 
            step="1" 
            value="75" 
            class="slider-range" 
            aria-label="Refinance LTV Slider" 
          />
          <span class="input-hint">Standard cash-out refinance max is 70%–80% of ARV.</span>
        </div>

        <div class="input-group">
          <div class="input-label-row">
            <label for="brrrr-refi-closing">Refinance Closing Costs</label>
            <div class="input-symbol-wrapper">
              <span class="currency-symbol" id="sym-rclosing">$</span>
              <input 
                type="number" 
                id="brrrr-refi-closing" 
                min="0" 
                max="50000" 
                step="250" 
                value="4500" 
                aria-label="Refinance Closing Costs" 
              />
            </div>
          </div>
          <input 
            type="range" 
            id="brrrr-refi-closing-slider" 
            min="0" 
            max="15000" 
            step="250" 
            value="4500" 
            class="slider-range" 
            aria-label="Refinance Closing Costs Slider" 
          />
          <span class="input-hint">Appraisal, lender origination, title, escrow (~1.5%–3%).</span>
        </div>
      </div>

      <!-- Refinance Interest Rate & Loan Term -->
      <div class="input-row-grid">
        <div class="input-group">
          <div class="input-label-row">
            <label for="brrrr-refi-rate">New Mortgage Rate (%)</label>
            <div class="input-symbol-wrapper">
              <input 
                type="number" 
                id="brrrr-refi-rate" 
                min="1.0" 
                max="15.0" 
                step="0.125" 
                value="6.5" 
                aria-label="Refinance Interest Rate" 
              />
              <span class="unit-symbol">%</span>
            </div>
          </div>
          <input 
            type="range" 
            id="brrrr-refi-rate-slider" 
            min="3.0" 
            max="12.0" 
            step="0.125" 
            value="6.5" 
            class="slider-range" 
            aria-label="Refinance Rate Slider" 
          />
          <span class="input-hint">Long-term permanent mortgage or DSCR interest rate.</span>
        </div>

        <div class="input-group">
          <label for="brrrr-refi-term" class="field-label-top">New Mortgage Term</label>
          <select id="brrrr-refi-term" class="form-select-full" aria-label="New Mortgage Term">
            <option value="30" selected>30 Years (Fixed)</option>
            <option value="25">25 Years (Fixed)</option>
            <option value="20">20 Years (Fixed)</option>
            <option value="15">15 Years (Fixed)</option>
          </select>
          <span class="input-hint">Amortization duration for the permanent loan.</span>
        </div>
      </div>
    </div>

    <!-- Reset Trigger -->
    <div class="inputs-actions" style="margin-top: var(--space-6);">
      <Button id="brrrr-reset-btn" variant="outline" size="sm" style="width: 100%;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
        Reset to Default Example
      </Button>
    </div>

  </div>

  <!-- Results Section -->
  <div slot="results" class="calc-results-wrapper">
    <h3 class="results-heading">BRRRR Strategy Investment Returns</h3>

    <!-- Dynamic Strategy Assessment Banner -->
    <div id="brrrr-alert-banner" class="alert-banner alert-success">
      <div class="alert-icon" id="brrrr-alert-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      </div>
      <div class="alert-content">
        <div class="alert-title" id="brrrr-alert-title">Calculating BRRRR Metrics...</div>
        <div class="alert-desc" id="brrrr-alert-desc">
          Analyzing cash invested, refinance payout, remaining equity, and rental yield.
        </div>
      </div>
    </div>

    <!-- Primary Net Value Displays (Rule 15 Compliant) -->
    <div class="net-value-container">
      <!-- Card 1: Cash Left in Deal -->
      <div class="net-value-box cash-left-box">
        <span class="net-box-label">Cash Left in Deal</span>
        <div id="res-cash-left" class="net-box-amount text-primary">$9,009</div>
        <span class="net-box-sub" id="lbl-cash-left-sub">89% of capital recouped at refi</span>
      </div>

      <!-- Card 2: Net Cash Returned at Refi -->
      <div class="net-value-box cash-returned-box">
        <span class="net-box-label">Net Cash Returned</span>
        <div id="res-cash-returned" class="net-box-amount text-accent">$70,991</div>
        <span class="net-box-sub" id="lbl-cash-returned-sub">From $195,000 Refinance Loan</span>
      </div>
    </div>

    <!-- Step-by-Step BRRRR Financial Flow (Interactive Tracker) -->
    <div class="brrrr-flow-card">
      <div class="flow-header">
        <span class="flow-title">BRRRR Deal Execution Breakdown</span>
        <span class="flow-badge" id="res-flow-badge">Buy · Rehab · Rent · Refi · Repeat</span>
      </div>
      <div class="flow-steps-grid">
        <div class="flow-step-item">
          <span class="step-num">B</span>
          <div class="step-details">
            <span class="step-label">Buy &amp; Acquire</span>
            <span class="step-value" id="flow-buy-val">$150,000</span>
            <span class="step-sub" id="flow-buy-sub">Down: $30k | Loan: $120k</span>
          </div>
        </div>
        <div class="flow-step-item">
          <span class="step-num">R</span>
          <div class="step-details">
            <span class="step-label">Rehab &amp; Hold</span>
            <span class="step-value" id="flow-rehab-val">$46,000</span>
            <span class="step-sub" id="flow-rehab-sub">$40k work + $6k holding</span>
          </div>
        </div>
        <div class="flow-step-item">
          <span class="step-num">R</span>
          <div class="step-details">
            <span class="step-label">Rent &amp; Cash Flow</span>
            <span class="step-value" id="flow-rent-val">$2,200/mo</span>
            <span class="step-sub" id="flow-rent-sub">OpEx: $600/mo</span>
          </div>
        </div>
        <div class="flow-step-item">
          <span class="step-num">R</span>
          <div class="step-details">
            <span class="step-label">Refinance (75%)</span>
            <span class="step-value" id="flow-refi-val">$195,000</span>
            <span class="step-sub" id="flow-refi-sub">Payoff: $119.5k | Cash Out: $71.0k</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Key Metrics Grid (Rule 15 Compliant) -->
    <h4 class="metrics-section-heading">Detailed Financial Metrics</h4>
    <div class="results-grid brrrr-metrics-grid">
      <!-- 1. Total Initial Cash Invested -->
      <div class="result-tile">
        <span class="tile-label">Total Initial Cash Invested</span>
        <div class="tile-value text-base" id="tile-initial-cash">$80,000</div>
        <span class="tile-sub" id="lbl-tile-initial-sub">Down + Rehab + Closing + Holding</span>
      </div>

      <!-- 2. New Refinance Loan Amount -->
      <div class="result-tile">
        <span class="tile-label">New Refinance Loan</span>
        <div class="tile-value text-primary" id="tile-new-loan">$195,000</div>
        <span class="tile-sub" id="lbl-tile-new-loan-sub">75% LTV on $260,000 ARV</span>
      </div>

      <!-- 3. Original Loan Payoff Amount -->
      <div class="result-tile">
        <span class="tile-label">Original Loan Payoff</span>
        <div class="tile-value text-base" id="tile-loan-payoff">$119,509</div>
        <span class="tile-sub" id="lbl-tile-payoff-sub">Principal balance after 6 months</span>
      </div>

      <!-- 4. New Monthly Mortgage Payment -->
      <div class="result-tile">
        <span class="tile-label">New Monthly Mortgage (P&amp;I)</span>
        <div class="tile-value text-base" id="tile-new-mortgage">$1,233 / mo</div>
        <span class="tile-sub" id="lbl-tile-mortgage-sub">6.50% Rate, 30-Yr Fixed</span>
      </div>

      <!-- 5. Monthly Net Cash Flow -->
      <div class="result-tile">
        <span class="tile-label">Monthly Net Cash Flow</span>
        <div class="tile-value" id="tile-monthly-cf" style="color: var(--color-success, #16a34a);">$367 / mo</div>
        <span class="tile-sub" id="lbl-tile-mcf-sub">Rent − OpEx − New Mortgage</span>
      </div>

      <!-- 6. Annual Net Cash Flow -->
      <div class="result-tile">
        <span class="tile-label">Annual Net Cash Flow</span>
        <div class="tile-value" id="tile-annual-cf" style="color: var(--color-success, #16a34a);">$4,410 / yr</div>
        <span class="tile-sub" id="lbl-tile-acf-sub">Passive pre-tax rental income</span>
      </div>

      <!-- 7. Post-Refi Cash-on-Cash Return -->
      <div class="result-tile">
        <span class="tile-label">Cash-on-Cash Return (CoC)</span>
        <div class="tile-value text-primary" id="tile-coc-return">48.9%</div>
        <span class="tile-sub" id="lbl-tile-coc-sub">Annual Cash Flow / Cash Left</span>
      </div>

      <!-- 8. Equity Retained in Property -->
      <div class="result-tile">
        <span class="tile-label">Retained Property Equity</span>
        <div class="tile-value text-base" id="tile-equity-retained">$65,000</div>
        <span class="tile-sub" id="lbl-tile-equity-sub">25% equity buffer ($260k ARV)</span>
      </div>
    </div>

    <!-- Strategy Multiplier Card -->
    <div class="brrrr-context-card">
      <div class="context-header">
        <div class="context-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
        </div>
        <div class="context-title-wrap">
          <span class="context-eyebrow">The "Repeat" Multiplier</span>
          <h4 class="context-title" id="lbl-repeat-title">Recycling Your Capital</h4>
        </div>
      </div>
      <p class="context-desc" id="lbl-context-desc">
        Because you recovered <strong>$70,991</strong> of your initial <strong>$80,000</strong>, you retain <strong>$65,000</strong> in real estate wealth and <strong>$367/month</strong> in cash flow, while having the liquidity ready to acquire your next BRRRR property!
      </p>
    </div>

  </div>
</CalculatorLayout>

<script>
  function initBrrrrCalculator() {
    const currencyConfigs = {
      USD: { symbol: '$', code: 'USD', locale: 'en-US' },
      CAD: { symbol: 'C$', code: 'CAD', locale: 'en-CA' },
      GBP: { symbol: '£', code: 'GBP', locale: 'en-GB' },
      EUR: { symbol: '€', code: 'EUR', locale: 'de-DE' },
      AUD: { symbol: 'A$', code: 'AUD', locale: 'en-AU' },
      INR: { symbol: '₹', code: 'INR', locale: 'en-IN' },
      SGD: { symbol: 'S$', code: 'SGD', locale: 'en-SG' },
      JPY: { symbol: '¥', code: 'JPY', locale: 'ja-JP' },
