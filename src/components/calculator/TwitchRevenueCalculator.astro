---
import CalculatorLayout from './CalculatorLayout.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
---

<CalculatorLayout
  title="Twitch Revenue Calculator"
  description="Estimate your monthly and annual Twitch streaming income. Select specific revenue sources or calculate your total creator earnings across subscriptions, ads, Bits, and tips."
  category="Creator & Media"
>
  <!-- Inputs Section -->
  <div slot="inputs" class="calc-inputs-wrapper" id="twitch-revenue-calculator">
    
    <!-- Revenue Source Selection Section -->
    <div class="revenue-selection-block">
      <div class="selection-header">
        <div class="selection-title-row">
          <h3 class="selection-title">Select What You Want to Calculate</h3>
          <span class="selection-badge-rec">Recommended approach</span>
        </div>
        <span class="selection-subtitle">Choose individual earnings channels or calculate your full streaming revenue:</span>
      </div>

      <div class="source-list" role="group" aria-label="Select Twitch revenue sources">
        <!-- Row 1: Total Twitch Revenue (Master) -->
        <label class="source-item active" for="sel-source-total" id="card-source-total">
          <div class="source-item-left">
            <div class="source-item-icon total-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>
            </div>
            <div class="source-item-text">
              <div class="source-item-title-row">
                <span class="source-item-title">Total Twitch Revenue</span>
                <span class="source-tag">All Channels</span>
              </div>
              <span class="source-item-desc">Calculate all platform and external earning channels combined</span>
            </div>
          </div>
          <div class="source-item-right">
            <input type="checkbox" id="sel-source-total" class="source-checkbox" checked />
          </div>
        </label>

        <!-- Row 2: Subscription Earnings -->
        <label class="source-item active" for="sel-source-subs" id="card-source-subs">
          <div class="source-item-left">
            <div class="source-item-icon subs-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
            </div>
            <div class="source-item-text">
              <span class="source-item-title">Subscription Earnings</span>
              <span class="source-item-desc">Paid Tier 1–3, gift subs, and Prime Gaming monthly payouts</span>
            </div>
          </div>
          <div class="source-item-right">
            <input type="checkbox" id="sel-source-subs" class="source-checkbox" checked />
          </div>
        </label>

        <!-- Row 3: Advertising Revenue -->
        <label class="source-item active" for="sel-source-ads" id="card-source-ads">
          <div class="source-item-left">
            <div class="source-item-icon ads-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect><polyline points="17 2 12 7 7 2"></polyline></svg>
            </div>
            <div class="source-item-text">
              <span class="source-item-title">Advertising Revenue</span>
              <span class="source-item-desc">Pre-roll and mid-roll video ad impressions on a CPM model</span>
            </div>
          </div>
          <div class="source-item-right">
            <input type="checkbox" id="sel-source-ads" class="source-checkbox" checked />
          </div>
        </label>

        <!-- Row 4: Bits & Direct Donations -->
        <label class="source-item active" for="sel-source-bits" id="card-source-bits">
          <div class="source-item-left">
            <div class="source-item-icon bits-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path><line x1="12" y1="6" x2="12" y2="18"></line></svg>
            </div>
            <div class="source-item-text">
              <span class="source-item-title">Bits &amp; Direct Donations</span>
              <span class="source-item-desc">Chat Bits cheered ($0.01/bit) and net external tips/donations</span>
            </div>
          </div>
          <div class="source-item-right">
            <input type="checkbox" id="sel-source-bits" class="source-checkbox" checked />
          </div>
        </label>
      </div>
    </div>

    <!-- Step 1: Stream Profile (Always Visible Common Section) -->
    <div class="input-section" id="section-stream-profile">
      <div class="section-title-wrap">
        <h3 class="input-section-title">Stream Profile</h3>
        <span class="section-badge-info">Common Metrics</span>
      </div>
      
      <!-- Currency Selector -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="trc-currency-select">Display Currency</label>
        </div>
        <select id="trc-currency-select" class="currency-select-full" aria-label="Select Display Currency">
          <option value="USD" selected>USD ($) - US Dollar</option>
          <option value="EUR">EUR (€) - Euro</option>
          <option value="GBP">GBP (£) - British Pound</option>
          <option value="CAD">CAD (C$) - Canadian Dollar</option>
          <option value="AUD">AUD (A$) - Australian Dollar</option>
          <option value="INR">INR (₹) - Indian Rupee</option>
          <option value="JPY">JPY (¥) - Japanese Yen</option>
          <option value="SGD">SGD (S$) - Singapore Dollar</option>
          <option value="CHF">CHF (CHF) - Swiss Franc</option>
        </select>
        <span class="input-hint">Select the currency for your estimated earnings and localized inputs.</span>
      </div>

      <!-- Exchange Rate (shown/active for non-USD) -->
      <div class="input-group" id="trc-fx-group" style="display: none;">
        <div class="input-label-row">
          <label for="trc-fx-rate">Exchange Rate (1 USD to <span class="active-currency-code">EUR</span>)</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol dynamic-curr-sym">€</span>
            <input 
              type="number" 
              id="trc-fx-rate" 
              min="0.01" 
              step="0.01" 
              value="0.92" 
              aria-label="Exchange rate from USD" 
            />
          </div>
        </div>
        <span class="input-hint">Twitch pays Bits at USD $0.01 and base subscription payouts in USD. Edit this rate to match your local bank or payment processor payout rate.</span>
      </div>

      <!-- Average Concurrent Viewers (ACV) -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="trc-viewers-input">Average Concurrent Viewers (ACV)</label>
          <div class="input-symbol-wrapper">
            <input 
              type="number" 
              id="trc-viewers-input" 
              min="0" 
              max="100000" 
              step="10" 
              value="300" 
              aria-label="Average Concurrent Viewers" 
            />
            <span class="unit-symbol">viewers</span>
          </div>
        </div>
        <input 
          type="range" 
          id="trc-viewers-slider" 
          min="0" 
          max="5000" 
          step="10" 
          value="300" 
          class="slider-range" 
          aria-label="Average Viewers Slider" 
        />
        <span class="input-hint">Average number of people watching simultaneously during your stream, not total unique views or peak viewers.</span>
      </div>

      <!-- Hours Streamed per Month -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="trc-hours-input">Streaming Hours per Month</label>
          <div class="input-symbol-wrapper">
            <input 
              type="number" 
              id="trc-hours-input" 
              min="0" 
              max="720" 
              step="5" 
              value="80" 
              aria-label="Hours Streamed per Month" 
            />
            <span class="unit-symbol">hrs/mo</span>
          </div>
        </div>
        <input 
          type="range" 
          id="trc-hours-slider" 
          min="0" 
          max="250" 
          step="5" 
          value="80" 
          class="slider-range" 
          aria-label="Hours Streamed Slider" 
        />
        <span class="input-hint">Total monthly broadcast hours (e.g. streaming 20 hours per week equals roughly 80 hours per month).</span>
      </div>
    </div>

    <!-- Step 2: Subscription Earnings (Conditional Section) -->
    <div class="input-section conditional-section" id="section-subscription-earnings">
      <div class="section-title-wrap">
        <h3 class="input-section-title">Subscription Earnings</h3>
        <span class="section-badge-subs">Active</span>
      </div>
      
      <!-- Creator Revenue Split Selection -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="trc-split">Creator Subscription Revenue Share</label>
        </div>
        <select id="trc-split" class="currency-select-full" aria-label="Creator Subscription Revenue Share">
          <option value="50" selected>Standard Affiliate & Partner (50/50 Split)</option>
          <option value="60">Twitch Plus Tier 1 (60/40 Split - 100 Plus Points)</option>
          <option value="70">Twitch Plus Tier 2 / Partner Premium (70/30 Split - 350 Plus Points)</option>
          <option value="custom">Custom Split (%)</option>
        </select>
        <span class="input-hint">Revenue share applied to paid Tier 1, Tier 2, Tier 3, and Gift subscriptions. (Prime subscriptions use separate fixed regional payouts).</span>
      </div>

      <!-- Custom Split Percentage Input (shown if Custom selected) -->
      <div class="input-group" id="trc-custom-split-group" style="display: none;">
        <div class="input-label-row">
          <label for="trc-custom-split-input">Custom Creator Split (%)</label>
          <div class="input-symbol-wrapper">
            <input 
              type="number" 
              id="trc-custom-split-input" 
              min="0" 
              max="100" 
              step="1" 
              value="50" 
              aria-label="Custom Creator Split Percentage" 
            />
            <span class="unit-symbol">%</span>
          </div>
        </div>
      </div>

      <!-- Paid Tier 1 Subs -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="trc-subs-t1-input">Paid Tier 1 Subscriptions</label>
          <div class="input-symbol-wrapper">
            <input 
              type="number" 
              id="trc-subs-t1-input" 
              min="0" 
              max="50000" 
              step="10" 
              value="150" 
              aria-label="Paid Tier 1 Subscribers" 
            />
            <span class="unit-symbol">subs</span>
          </div>
        </div>
        <input 
          type="range" 
          id="trc-subs-t1-slider" 
          min="0" 
          max="2000" 
          step="10" 
          value="150" 
          class="slider-range" 
          aria-label="Tier 1 Slider" 
        />
        <div class="price-edit-row">
          <label for="trc-price-t1">Price / Sub:</label>
          <div class="mini-price-input">
            <span class="dynamic-curr-sym">$</span>
            <input type="number" id="trc-price-t1" min="0.1" step="0.1" value="4.99" aria-label="Tier 1 Subscription Price" />
          </div>
          <span class="price-hint">Base US $4.99 (editable for local regional pricing)</span>
        </div>
      </div>

      <!-- Paid Tier 2 Subs -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="trc-subs-t2-input">Paid Tier 2 Subscriptions</label>
          <div class="input-symbol-wrapper">
            <input 
              type="number" 
              id="trc-subs-t2-input" 
              min="0" 
              max="5000" 
              step="1" 
              value="10" 
              aria-label="Paid Tier 2 Subscribers" 
            />
            <span class="unit-symbol">subs</span>
          </div>
        </div>
        <input 
          type="range" 
          id="trc-subs-t2-slider" 
          min="0" 
          max="200" 
          step="1" 
          value="10" 
          class="slider-range" 
          aria-label="Tier 2 Slider" 
        />
        <div class="price-edit-row">
          <label for="trc-price-t2">Price / Sub:</label>
          <div class="mini-price-input">
            <span class="dynamic-curr-sym">$</span>
            <input type="number" id="trc-price-t2" min="0.1" step="0.1" value="9.99" aria-label="Tier 2 Subscription Price" />
          </div>
          <span class="price-hint">Base US $9.99 (2 Plus Points per sub)</span>
        </div>
      </div>

      <!-- Paid Tier 3 Subs -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="trc-subs-t3-input">Paid Tier 3 Subscriptions</label>
          <div class="input-symbol-wrapper">
            <input 
              type="number" 
              id="trc-subs-t3-input" 
              min="0" 
              max="1000" 
              step="1" 
              value="2" 
              aria-label="Paid Tier 3 Subscribers" 
            />
            <span class="unit-symbol">subs</span>
          </div>
        </div>
        <input 
          type="range" 
          id="trc-subs-t3-slider" 
          min="0" 
          max="50" 
          step="1" 
          value="2" 
          class="slider-range" 
          aria-label="Tier 3 Slider" 
        />
        <div class="price-edit-row">
          <label for="trc-price-t3">Price / Sub:</label>
          <div class="mini-price-input">
            <span class="dynamic-curr-sym">$</span>
            <input type="number" id="trc-price-t3" min="0.1" step="0.1" value="24.99" aria-label="Tier 3 Subscription Price" />
          </div>
          <span class="price-hint">Base US $24.99 (6 Plus Points per sub)</span>
        </div>
      </div>

      <!-- Gift Subscriptions (Tier 1) -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="trc-subs-gift-input">Monthly Gift Subscriptions (Tier 1)</label>
          <div class="input-symbol-wrapper">
            <input 
              type="number" 
              id="trc-subs-gift-input" 
              min="0" 
              max="50000" 
              step="5" 
              value="25" 
              aria-label="Gift Subscriptions" 
            />
            <span class="unit-symbol">gifts</span>
          </div>
        </div>
        <input 
          type="range" 
          id="trc-subs-gift-slider" 
          min="0" 
          max="500" 
          step="5" 
          value="25" 
          class="slider-range" 
          aria-label="Gift Subs Slider" 
        />
        <span class="input-hint">Community gifted subscriptions earn the same creator split as standard Tier 1 subscriptions.</span>
      </div>

      <!-- Prime Gaming Subscriptions -->
      <div class="input-group highlight-input-group">
        <div class="input-label-row">
          <label for="trc-subs-prime-input">Prime Gaming Subscriptions</label>
          <div class="input-symbol-wrapper">
            <input 
              type="number" 
              id="trc-subs-prime-input" 
              min="0" 
              max="20000" 
              step="5" 
              value="50" 
              aria-label="Prime Gaming Subscribers" 
            />
            <span class="unit-symbol">Prime</span>
          </div>
        </div>
        <input 
          type="range" 
          id="trc-subs-prime-slider" 
          min="0" 
          max="1000" 
          step="5" 
          value="50" 
          class="slider-range" 
          aria-label="Prime Subs Slider" 
        />
        <div class="price-edit-row">
          <label for="trc-payout-prime">Avg Creator Payout / Sub:</label>
          <div class="mini-price-input">
            <span class="dynamic-curr-sym">$</span>
            <input type="number" id="trc-payout-prime" min="0.1" step="0.05" value="2.25" aria-label="Average Prime Gaming Creator Payout" />
          </div>
          <span class="price-hint">US ~$2.25, UK ~$1.80, DE ~$1.55, CA/AU ~$1.40 (fixed payout by viewer country)</span>
        </div>
        <span class="input-hint">Twitch pays a fixed regional fee for Prime subs rather than a 50% or 70% revenue share. Adjust this to match your audience's primary location.</span>
      </div>
    </div>

    <!-- Step 3: Advertising Revenue (Conditional Section) -->
    <div class="input-section conditional-section" id="section-advertising-revenue">
      <div class="section-title-wrap">
        <h3 class="input-section-title">Advertising Revenue</h3>
        <span class="section-badge-ads">Active</span>
      </div>
      
      <!-- Delivered Ad Impressions per Viewer per Hour -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="trc-ad-rate-input">Delivered Ad Impressions per Viewer / Hour</label>
          <div class="input-symbol-wrapper">
            <input 
              type="number" 
              id="trc-ad-rate-input" 
              min="0" 
              max="20" 
              step="0.5" 
              value="4.0" 
              aria-label="Delivered Ad Impressions per Viewer per Hour" 
            />
            <span class="unit-symbol">ads/hr</span>
          </div>
        </div>
        <input 
          type="range" 
          id="trc-ad-rate-slider" 
          min="0" 
          max="12" 
          step="0.5" 
          value="4.0" 
          class="slider-range" 
          aria-label="Ad Delivery Slider" 
        />
        <span class="input-hint">Running a standard 3-minute ad break yields 6 potential 30-second slots. After accounting for ad-blockers, ad-free subscriber perks, Twitch Turbo, and geographic fill rates, streamers typically average <strong>2.0 to 4.5 delivered ad views per viewer per hour</strong>.</span>
      </div>

      <!-- Estimated Ad CPM -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="trc-ad-cpm-input">Estimated Ad CPM (Earnings per 1,000 Ad Impressions)</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol dynamic-curr-sym">$</span>
            <input 
              type="number" 
              id="trc-ad-cpm-input" 
              min="0.1" 
              max="50" 
              step="0.25" 
              value="3.50" 
              aria-label="Estimated Ad CPM" 
            />
          </div>
        </div>
        <input 
          type="range" 
          id="trc-ad-cpm-slider" 
          min="0.5" 
          max="15" 
          step="0.25" 
          value="3.50" 
          class="slider-range" 
          aria-label="Ad CPM Slider" 
        />
        <span class="input-hint">CPM (Cost Per Mille) is your net payout per 1,000 delivered video ad impressions. Twitch averages $2.00–$5.00 in gaming, reaching $7.00–$10.00+ during Q4 holiday campaigns.</span>
      </div>

      <!-- Real-time calculation helper box -->
      <div class="helper-stat-box">
        <span class="stat-box-label">Monthly Ad Delivery Estimate:</span>
        <strong id="trc-live-ad-impressions">96,000 Total Impressions</strong>
        <span class="stat-box-calc">(300 viewers × 4.0 ads/hr × 80 hours streamed)</span>
      </div>
    </div>

    <!-- Step 4: Bits and Donations (Conditional Section) -->
    <div class="input-section conditional-section" id="section-bits-donations">
      <div class="section-title-wrap">
        <h3 class="input-section-title">Bits &amp; Direct Donations</h3>
        <span class="section-badge-bits">Active</span>
      </div>
      
      <!-- Monthly Bits Cheered -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="trc-bits">Monthly Bits Cheered</label>
          <div class="input-symbol-wrapper">
            <input 
              type="number" 
              id="trc-bits" 
              min="0" 
              max="5000000" 
              step="500" 
              value="10000" 
              aria-label="Monthly Bits Cheered" 
            />
            <span class="unit-symbol">Bits</span>
          </div>
        </div>
        <span class="input-hint">Twitch pays creators exactly <strong>USD $0.01 per Bit</strong> cheered. 10,000 Bits = USD $100.00 (automatically converted to your selected display currency).</span>
      </div>

      <!-- Monthly Direct Tips & Donations -->
      <div class="input-group" style="margin-top: var(--space-3);">
        <div class="input-label-row">
          <label for="trc-tips">Monthly Direct Tips &amp; Donations (Gross)</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol dynamic-curr-sym">$</span>
            <input 
              type="number" 
              id="trc-tips" 
              min="0" 
              max="100000" 
              step="25" 
              value="150" 
              aria-label="Monthly Tips & Donations" 
            />
          </div>
        </div>
        <span class="input-hint">Direct contributions received outside Twitch via Streamlabs, PayPal, Ko-fi, or Stripe.</span>
      </div>

      <!-- Tip Processing Fee -->
      <div class="input-group" style="margin-top: var(--space-2);">
        <div class="input-label-row">
          <label for="trc-tip-fee">Payment Processing Fee (%)</label>
          <div class="input-symbol-wrapper">
            <input 
              type="number" 
              id="trc-tip-fee" 
              min="0" 
              max="15" 
              step="0.5" 
              value="3.0" 
              aria-label="Tip Payment Processing Fee Percentage" 
            />
            <span class="unit-symbol">%</span>
          </div>
        </div>
        <span class="input-hint">Third-party processors (PayPal, Stripe) typically deduct 2.9% + $0.30 per donation. Deducted to calculate true net tips.</span>
      </div>
    </div>

    <!-- Reset Action -->
    <div class="inputs-actions" style="margin-top: var(--space-6);">
      <Button id="trc-reset" variant="outline" size="sm" style="width: 100%;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;" aria-hidden="true"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
        Reset to Default Example
      </Button>
    </div>
  </div>

  <!-- Results Section -->
  <div slot="results" class="calc-results-wrapper">
    <div class="results-header-block">
      <h2 class="results-heading" id="trc-results-title">Twitch Revenue Summary</h2>
      <span class="results-subheading" id="trc-results-subtitle">Estimated gross creator earnings across selected channels</span>
    </div>

    <!-- Core Earnings Payout Displays -->
    <div class="net-value-container">
      <div class="net-value-box highlight-monthly">
        <span class="hero-box-label" id="lbl-hero-monthly">Est. Monthly Revenue</span>
        <div id="res-trc-monthly" class="hero-box-value primary-value">$1,205.57</div>
        <span class="hero-box-sub" id="lbl-trc-annual">Estimated Annual: $14,466.78 /yr</span>
      </div>
      <div class="net-value-box highlight-hourly">
        <span class="hero-box-label">Hourly Streaming Revenue</span>
        <div id="res-trc-hourly" class="hero-box-value success-value">$15.07</div>
        <span class="hero-box-sub" id="lbl-trc-hours-total">Across 80 broadcast hours</span>
      </div>
    </div>

    <!-- Primary Income Verdict Card -->
    <div class="verdict-wrapper">
      <Card elevation="sm" id="trc-verdict-card" class="verdict-card">
        <div class="verdict-header">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="verdict-icon" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          <span class="verdict-title" id="lbl-verdict-title">Primary Revenue Driver</span>
        </div>
        <p id="res-trc-verdict-text" class="verdict-body">
          Your primary earnings driver is <strong>Paid Subscriptions</strong>, contributing <strong>$511.57</strong> (<strong>42.4%</strong> of your total monthly stream income).
        </p>
      </Card>
    </div>

    <!-- Detailed Channel Breakdown Grid (Dynamic Tiles) -->
    <h3 class="breakdown-heading" id="lbl-breakdown-heading">Revenue by Income Source</h3>
    <div class="results-grid trc-metrics-grid" id="trc-tiles-grid">
      <!-- 1. Paid Subs -->
      <div class="result-tile" id="tile-card-paid-subs">
