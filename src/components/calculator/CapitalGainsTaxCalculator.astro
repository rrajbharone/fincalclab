    const noteHeading = document.getElementById('note-heading');
    const noteBody = document.getElementById('note-body');
    const lblHoldingText = document.getElementById('lbl-holding-text');

    // Country-specific fields
    const fieldUsFiling = document.getElementById('field-us-filing-status');
    const fieldCaProvince = document.getElementById('field-ca-province');
    const fieldAuResidency = document.getElementById('field-au-residency');
    const fieldInRegime = document.getElementById('field-in-regime');
    const fieldUsStateRate = document.getElementById('field-us-state-rate');

    // Asset Types for Each Country
    const ASSET_TYPES: Record<string, { val: string; label: string; subtext: string }[]> = {
      US: [
        { val: 'stocks', label: 'Stocks, ETFs & Mutual Funds', subtext: 'Taxed under standard US LTCG rates (0%, 15%, 20%) or ordinary income.' },
        { val: 'real_estate', label: 'Investment Real Estate / Second Home', subtext: 'Standard capital gains rates apply.' },
        { val: 'primary_residence', label: 'Primary Residence (Section 121)', subtext: 'Qualifies for up to $250k (Single) or $500k (Married) tax-free exclusion.' },
        { val: 'collectibles', label: 'Collectibles & Precious Metals', subtext: 'Taxed at ordinary rate capped at maximum 28%.' }
      ],
      UK: [
        { val: 'shares', label: 'Shares & Investment Funds', subtext: '18% basic rate / 24% higher rate with £3,000 Annual Exempt Amount.' },
        { val: 'residential', label: 'Residential Property (Buy-to-Let / Second Home)', subtext: '18% basic rate / 24% higher rate in 2026/27.' },
        { val: 'primary_home', label: 'Main Residence (Private Residence Relief)', subtext: '100% tax-free under UK Private Residence Relief (PRR).' },
        { val: 'badr', label: 'Business Assets (BADR)', subtext: '18% statutory rate in 2026/27 on qualifying lifetime disposals.' },
        { val: 'other', label: 'Other Chargeable Assets', subtext: '18% basic / 24% higher rate on chattels and valuable property.' }
      ],
      AU: [
        { val: 'shares', label: 'Australian & Global Shares', subtext: '50% CGT discount applies to Australian residents holding for 12+ months.' },
        { val: 'property', label: 'Investment Property', subtext: 'Taxed at marginal income rates + Medicare levy with 50% discount for 12+ months.' },
        { val: 'main_residence', label: 'Main Residence (Home Sale)', subtext: '100% tax-exempt under ATO Main Residence Exemption rules.' },
        { val: 'other', label: 'Other Capital Assets', subtext: 'Standard Australian assessable income rules.' }
      ],
      IN: [
        { val: 'listed_equity', label: 'Listed Equity Shares & Equity Mutual Funds', subtext: 'LTCG: 12.5% over ₹1.25L exemption (held >12 mo); STCG: 20% (held ≤12 mo).' },
        { val: 'real_estate', label: 'Immovable Property (Land & Building)', subtext: 'LTCG: 12.5% without indexation (held >24 mo); STCG: Slab rates.' },
        { val: 'unlisted_shares', label: 'Unlisted Company Shares', subtext: 'LTCG: 12.5% (held >24 mo); STCG: Slab rates.' },
        { val: 'debt_mf', label: 'Debt / Non-Equity Mutual Funds', subtext: 'Always taxed at slab rates under Section 50AA regardless of holding.' },
        { val: 'gold', label: 'Gold & Other Capital Assets', subtext: 'LTCG: 12.5% (held >24 mo); STCG: Slab rates.' }
      ],
      CA: [
        { val: 'stocks', label: 'Stocks & Non-Registered Mutual Funds', subtext: '50% inclusion on first $250k gain; 66.67% inclusion on gain above $250k.' },
        { val: 'real_estate', label: 'Investment Real Estate / Cottage', subtext: 'Federal and provincial progressive tax brackets on taxable portion.' },
        { val: 'primary_residence', label: 'Principal Residence', subtext: '100% tax-free under the Canadian Principal Residence Exemption (PRE).' },
        { val: 'other', label: 'Other Chargeable Property', subtext: 'Standard Canadian capital gains inclusion rules.' }
      ],
      SG: [
        { val: 'stocks', label: 'Stocks, ETFs & REITs', subtext: '0% capital gains tax. Singapore does not levy capital gains tax on investments under IRAS rules.' },
        { val: 'residential', label: 'Residential Real Estate', subtext: '0% capital gains tax under IRAS rules. (Note: Seller\'s Stamp Duty / SSD may apply if sold within 3 years).' },
        { val: 'crypto', label: 'Cryptocurrency & Digital Assets', subtext: '0% capital gains tax for personal investment under IRAS guidelines.' },
        { val: 'other', label: 'Other Capital Assets', subtext: '100% tax-exempt under Singapore statutory tax rules.' }
      ]
    };

    function updateCountryUI(country: string) {
      activeCountry = country;
      let curr = '$';
      if (country === 'UK') curr = '£';
      if (country === 'IN') curr = '₹';
      if (country === 'SG') curr = 'S$';

      // Sync mobile select & flag
      if (mobileCountrySelect && mobileCountrySelect.value !== country) {
        mobileCountrySelect.value = country;
      }
      if (mobileSelectedFlag) {
        mobileSelectedFlag.textContent = getCountryFlag(country);
      }

      // Sync desktop pills
      countryPills.forEach(p => {
        const isCurrent = (p.getAttribute('data-country') === country);
        p.classList.toggle('active', isCurrent);
        p.setAttribute('aria-selected', String(isCurrent));
      });

      // Update currency symbols
      if (currSym1) currSym1.textContent = curr;
      if (currSym2) currSym2.textContent = curr;
      if (currSym3) currSym3.textContent = curr;
      if (currSym4) currSym4.textContent = curr;
      if (currSym5) currSym5.textContent = curr;
      if (resCurrSym) resCurrSym.textContent = curr;
      if (subCurr1) subCurr1.textContent = curr;
      if (subCurr2) subCurr2.textContent = curr;

      // Update Country Help Text
      if (countryHelpText) {
        if (country === 'US') countryHelpText.textContent = 'Official 2026 IRS federal capital gains tax rules, long-term rate bands (0%, 15%, 20%), and Net Investment Income Tax (NIIT).';
        if (country === 'UK') countryHelpText.textContent = 'Official HMRC 2026/27 Capital Gains Tax rates (18% & 24%), £3,000 Annual Exempt Amount, and BADR rules.';
        if (country === 'AU') countryHelpText.textContent = 'Official ATO 2026–27 individual resident tax rates (Revised Stage 3), 2% Medicare levy, and 50% CGT discount for assets held 12+ months.';
        if (country === 'IN') countryHelpText.textContent = 'Official FY 2026–27 (AY 2027–28) Indian Income Tax rules: 12.5% LTCG with ₹1.25 lakh equity exemption, 20% STCG, and 4% Health & Education cess.';
        if (country === 'CA') countryHelpText.textContent = 'Official CRA 2026 rules: 50% inclusion on gains up to $250k and 66.67% on excess, integrated with federal & provincial tax brackets.';
        if (country === 'SG') countryHelpText.textContent = 'Official Inland Revenue Authority of Singapore (IRAS) guidelines: 0% capital gains tax on investments, stocks, and real estate.';
      }

      // Populate Asset Types
      if (assetTypeSelect) {
        const assets = ASSET_TYPES[country] || ASSET_TYPES.US;
        assetTypeSelect.innerHTML = '';
        assets.forEach((a, i) => {
          const opt = document.createElement('option');
          opt.value = a.val;
          opt.textContent = a.label;
          if (i === 0) opt.selected = true;
          assetTypeSelect.appendChild(opt);
        });
        if (assetTypeSubtext && assets[0]) {
          assetTypeSubtext.textContent = assets[0].subtext;
        }
      }

      // Toggle Country-Specific Inputs
      if (fieldUsFiling) fieldUsFiling.classList.toggle('hidden', country !== 'US');
      if (fieldUsStateRate) fieldUsStateRate.classList.toggle('hidden', country !== 'US');
      if (fieldCaProvince) fieldCaProvince.classList.toggle('hidden', country !== 'CA');
      if (fieldAuResidency) fieldAuResidency.classList.toggle('hidden', country !== 'AU');
      if (fieldInRegime) fieldInRegime.classList.toggle('hidden', country !== 'IN');

      // Adjust default input values if changing to India (INR scale) vs Western currencies
      if (country === 'IN' && Number(purchasePriceInput.value) < 100000) {
        purchasePriceInput.value = '500000';
        salePriceInput.value = '1200000';
        eligibleCostsInput.value = '25000';
        otherIncomeInput.value = '1000000';
        if (otherIncomeSlider) {
          otherIncomeSlider.max = '3000000';
          otherIncomeSlider.value = '1000000';
        }
      } else if (country !== 'IN' && Number(purchasePriceInput.value) >= 500000 && purchasePriceInput.value === '500000') {
        purchasePriceInput.value = '50000';
        salePriceInput.value = '120000';
        eligibleCostsInput.value = '3000';
        otherIncomeInput.value = '85000';
        if (otherIncomeSlider) {
          otherIncomeSlider.max = '250000';
          otherIncomeSlider.value = '85000';
        }
      }

      calculateAndRender();
    }

    function calculateAndRender() {
      const country = activeCountry;
      const curr = (country === 'UK') ? '£' : ((country === 'IN') ? '₹' : ((country === 'SG') ? 'S$' : '$'));
      const purchasePrice = Math.max(0, parseFloat(purchasePriceInput.value) || 0);
      const salePrice = Math.max(0, parseFloat(salePriceInput.value) || 0);
      const eligibleCosts = Math.max(0, parseFloat(eligibleCostsInput.value) || 0);
      const otherIncome = Math.max(0, parseFloat(otherIncomeInput.value) || 0);
      const capitalLosses = Math.max(0, parseFloat(capitalLossesInput.value) || 0);
      const assetType = assetTypeSelect.value;
      const holdingDays = getHoldingDays(dateAcquiredInput.value, dateSoldInput.value);
      const holdingInfo = getHoldingText(holdingDays);

      // Update holding text indicator
      if (lblHoldingText) {
        lblHoldingText.textContent = holdingInfo.text;
      }

      const totalCost = purchasePrice + eligibleCosts;
      const grossGain = salePrice - totalCost;

      // Base calculation object
      let res = {
        grossGain,
        exemptions: 0,
        lossesApplied: 0,
        taxableGain: 0,
        discountApplied: 0,
        baseTax: 0,
        extraTax1: 0,
        extraTax2: 0,
        totalTax: 0,
        effectiveRate: 0,
        afterTaxGain: grossGain,
        netProceeds: salePrice - eligibleCosts,
        classification: holdingInfo.isLongTerm ? 'Long-Term' : 'Short-Term',
        badgeTitle: '',
        heroVerdict: '',
        noteHeading: '',
        noteBody: '',
        baseTaxName: 'Federal / National Tax',
        extraTax1Name: '',
        extraTax2Name: ''
      };

      if (grossGain <= 0) {
        // Zero gain or capital loss scenario
        res.totalTax = 0;
        res.afterTaxGain = grossGain;
        res.netProceeds = salePrice - eligibleCosts;
        res.heroVerdict = grossGain < 0
          ? `You have realized a capital loss of <strong>${curr}${fmt(Math.abs(grossGain))}</strong>. No capital gains tax is due, and this loss can offset other capital gains.`
          : `Your sale proceeds exactly equal your cost basis and expenses. No capital gains tax is due.`;
      } else {
        // Country specific logic
        if (country === 'US') {
          const filingStatus = filingStatusSelect.value || 'single';
          const stateRate = Math.max(0, parseFloat(stateRateInput.value) || 0);

          let exemption = 0;
          if (assetType === 'primary_residence') {
            exemption = (filingStatus === 'mfj') ? 500000 : 250000;
          }
          const gainAfterEx = Math.max(0, grossGain - exemption);
          const netGain = Math.max(0, gainAfterEx - capitalLosses);

          let fedTax = 0;
          if (!holdingInfo.isLongTerm) {
            const taxBefore = calcUsOrdinaryTax(otherIncome, filingStatus);
            const taxAfter = calcUsOrdinaryTax(otherIncome + netGain, filingStatus);
            fedTax = taxAfter - taxBefore;
          } else {
            if (assetType === 'collectibles') {
              const taxBefore = calcUsOrdinaryTax(otherIncome, filingStatus);
              const taxAfter = calcUsOrdinaryTax(otherIncome + netGain, filingStatus);
              fedTax = Math.min(taxAfter - taxBefore, netGain * 0.28);
            } else {
              fedTax = calcUsLtcgTax(otherIncome, netGain, filingStatus);
            }
          }

          // NIIT (3.8%)
          let niitTax = 0;
          const niitThreshold = US_CONFIG.niitThresholds[filingStatus] || 200000;
          const magi = otherIncome + netGain;
          if (magi > niitThreshold) {
            const excess = magi - niitThreshold;
            const subject = Math.min(netGain, excess);
            niitTax = subject * US_CONFIG.niitRate;
          }

          const stateTax = netGain * (stateRate / 100);
          const totalTax = fedTax + niitTax + stateTax;

          res.exemptions = Math.min(grossGain, exemption);
          res.lossesApplied = Math.min(gainAfterEx, capitalLosses);
          res.taxableGain = netGain;
          res.baseTax = fedTax;
          res.extraTax1 = niitTax;
          res.extraTax2 = stateTax;
          res.totalTax = totalTax;
          res.baseTaxName = 'US Federal Capital Gains Tax';
          res.extraTax1Name = 'Net Investment Income Tax (3.8%)';
          res.extraTax2Name = `State Income Tax (${stateRate.toFixed(1)}%)`;
          res.badgeTitle = `🇺🇸 United States • 2026 Federal`;
          res.noteHeading = 'IRS 2026 Federal Capital Gains Tax Rules';
          res.noteBody = `Assets held for over 1 year qualify for preferential 0%, 15%, or 20% federal LTCG brackets based on filing status (${filingStatus.toUpperCase()}) and ordinary income. Short-term gains are taxed at ordinary rates.`;
        }
        else if (country === 'UK') {
          if (assetType === 'primary_home') {
            res.exemptions = grossGain;
            res.taxableGain = 0;
            res.totalTax = 0;
            res.heroVerdict = `Your home sale is <strong>100% exempt from UK Capital Gains Tax</strong> under Private Residence Relief (PRR).`;
          } else {
            const gainAfterLosses = Math.max(0, grossGain - capitalLosses);
            const aea = UK_CONFIG.annualExemptAmount; // £3,000
            const taxableGain = Math.max(0, gainAfterLosses - aea);

            let totalTax = 0;
            if (assetType === 'badr') {
              totalTax = taxableGain * UK_CONFIG.rates.badr; // 18% in 2026/27
            } else {
              const taxableIncomeAbovePa = Math.max(0, otherIncome - UK_CONFIG.personalAllowance);
              const unusedBasicBand = Math.max(0, UK_CONFIG.basicRateBandSize - taxableIncomeAbovePa);
              const gainInBasic = Math.min(taxableGain, unusedBasicBand);
              const gainInHigher = taxableGain - gainInBasic;
              const rates = UK_CONFIG.rates[assetType] || UK_CONFIG.rates.shares;
              totalTax = (gainInBasic * rates.basic) + (gainInHigher * rates.higher);
            }

            res.exemptions = Math.min(gainAfterLosses, aea);
            res.lossesApplied = Math.min(grossGain, capitalLosses);
            res.taxableGain = taxableGain;
            res.baseTax = totalTax;
            res.totalTax = totalTax;
            res.baseTaxName = 'UK HMRC Capital Gains Tax';
            res.badgeTitle = '🇬🇧 United Kingdom • 2026/27';
            res.noteHeading = 'HMRC 2026/27 Capital Gains Tax Rules';
            res.noteBody = 'Following the Autumn Budget reforms, UK gains on shares and residential property are taxed at 18% (basic rate) and 24% (higher rate). Each individual receives a £3,000 Annual Exempt Amount.';
          }
        }
        else if (country === 'AU') {
          if (assetType === 'main_residence') {
            res.exemptions = grossGain;
            res.taxableGain = 0;
            res.totalTax = 0;
            res.heroVerdict = `Your property disposal is <strong>100% tax-free</strong> under the Australian Taxation Office (ATO) Main Residence Exemption.`;
          } else {
            const isResident = (auResidencySelect.value === 'resident');
            const gainAfterLosses = Math.max(0, grossGain - capitalLosses);
            const isEligibleDiscount = isResident && (holdingDays >= 365);
            const discount = isEligibleDiscount ? gainAfterLosses * 0.5 : 0;
            const taxableGain = gainAfterLosses - discount;

            const taxBefore = calcAuIncomeTax(otherIncome) + calcAuMedicare(otherIncome);
            const taxAfter = calcAuIncomeTax(otherIncome + taxableGain) + calcAuMedicare(otherIncome + taxableGain);
            const totalTax = taxAfter - taxBefore;

            res.lossesApplied = Math.min(grossGain, capitalLosses);
            res.discountApplied = discount;
            res.taxableGain = taxableGain;
            res.baseTax = totalTax;
            res.totalTax = totalTax;
            res.baseTaxName = 'ATO Income Tax & Medicare on Gain';
            res.badgeTitle = '🇦🇺 Australia • 2026–27 Revised Stage 3';
            res.noteHeading = 'ATO 2026–27 Capital Gains Tax & Discount';
            res.noteBody = isEligibleDiscount
              ? `You qualify for the 50% CGT discount because you held the asset for 12+ months as an Australian resident. Only $${fmt(taxableGain)} is included in your assessable income.`
              : 'The full capital gain is included in assessable income and taxed at your marginal rate + 2% Medicare levy (no 50% discount applied).';
          }
        }
        else if (country === 'IN') {
          // Indian Rules
          let isLtcg = false;
          if (assetType === 'listed_equity') isLtcg = (holdingDays > 365);
          else if (assetType === 'debt_mf') isLtcg = false;
          else isLtcg = (holdingDays > 730);

          const gainAfterLosses = Math.max(0, grossGain - capitalLosses);
          let exemption = 0;
          let specialRate = null;
          let isSlab = false;

          if (assetType === 'listed_equity') {
            if (isLtcg) {
              exemption = IN_CONFIG.equityLtcgExemption; // ₹1,25,000
              specialRate = 0.125;
            } else {
              specialRate = 0.20;
            }
          } else if (assetType === 'debt_mf') {
            isSlab = true;
          } else {
            if (isLtcg) specialRate = 0.125;
            else isSlab = true;
          }

          const taxableGain = Math.max(0, gainAfterLosses - exemption);
          let baseTax = 0;
          const unexhausted = Math.max(0, IN_CONFIG.basicExemption - otherIncome);

          if (isSlab) {
            const taxBefore = calcInSlabTax(otherIncome);
            const taxAfter = calcInSlabTax(otherIncome + taxableGain);
            baseTax = taxAfter - taxBefore;
          } else if (specialRate !== null) {
            const gainAdjusted = Math.max(0, taxableGain - unexhausted);
            baseTax = gainAdjusted * specialRate;
          }

          let surchargeRate = 0;
          const totalInc = otherIncome + taxableGain;
          if (totalInc > 10000000) surchargeRate = 0.15;
          else if (totalInc > 5000000) surchargeRate = 0.10;
          const surcharge = baseTax * surchargeRate;
          const cess = (baseTax + surcharge) * IN_CONFIG.cessRate;
          const totalTax = baseTax + surcharge + cess;

          res.exemptions = Math.min(gainAfterLosses, exemption);
          res.lossesApplied = Math.min(grossGain, capitalLosses);
          res.taxableGain = taxableGain;
          res.baseTax = baseTax;
          res.extraTax1 = surcharge;
          res.extraTax2 = cess;
          res.totalTax = totalTax;
          res.baseTaxName = isSlab ? 'Tax at Applicable Slab Rate' : `Capital Gains Tax (${(specialRate * 100).toFixed(1)}%)`;
          res.extraTax1Name = 'Surcharge';
          res.extraTax2Name = 'Health & Education Cess (4%)';
          res.badgeTitle = '🇮🇳 India • FY 2026–27 (AY 2027–28)';
          res.noteHeading = 'Income Tax Department FY 2026–27 Rules';
          res.noteBody = isLtcg && assetType === 'listed_equity'
            ? 'Long-term equity gains qualify for the ₹1.25 lakh annual exemption under Section 112A. Gains above this limit are taxed at 12.5% plus 4% cess.'
            : 'Tax computed under revised Budget 2024 simplified capital gains framework with 4% Health & Education cess.';
        }
        else if (country === 'CA') {
          if (assetType === 'primary_residence') {
            res.exemptions = grossGain;
            res.taxableGain = 0;
            res.totalTax = 0;
            res.heroVerdict = `Your sale is <strong>100% tax-free</strong> under the Canadian Principal Residence Exemption (PRE).`;
          } else {
            const provKey = provinceSelect.value || 'ON';
            const netGain = Math.max(0, grossGain - capitalLosses);

            // Inclusion rate: 50% on first $250k, 66.67% on excess
            let taxableGain = 0;
            if (netGain <= 250000) {
              taxableGain = netGain * 0.50;
            } else {
              taxableGain = (250000 * 0.50) + ((netGain - 250000) * (2 / 3));
            }

            const taxBefore = calcCaTotalTax(otherIncome, provKey);
            const taxAfter = calcCaTotalTax(otherIncome + taxableGain, provKey);
            const fedTax = taxAfter.fed - taxBefore.fed;
            const provTax = taxAfter.prov - taxBefore.prov;
            const totalTax = taxAfter.total - taxBefore.total;

            res.lossesApplied = Math.min(grossGain, capitalLosses);
            res.taxableGain = taxableGain;
            res.baseTax = fedTax;
            res.extraTax1 = provTax;
            res.totalTax = totalTax;
            res.baseTaxName = 'Federal Income Tax on Gain';
            res.extraTax1Name = `Provincial Tax (${provKey})`;
            res.badgeTitle = `🇨🇦 Canada • 2026 (${provKey})`;
            res.noteHeading = 'CRA 2026 Capital Gains Inclusion Rules';
            res.noteBody = `In Canada, 50% of the first $250,000 in net gains is taxable (${taxableGain <= 125000 ? '50% rate applied' : 'blended 50%/66.67% inclusion'}). The taxable gain is integrated with federal and provincial tax brackets.`;
          }
        }
        else if (country === 'SG') {
          res.exemptions = grossGain;
          res.taxableGain = 0;
          res.baseTax = 0;
          res.totalTax = 0;
          res.baseTaxName = 'IRAS Capital Gains Tax (0%)';
          res.badgeTitle = '🇸🇬 Singapore • IRAS Rules (0% CGT)';
          res.noteHeading = 'IRAS Singapore 0% Capital Gains Tax';
          res.noteBody = 'Singapore does not levy capital gains tax on investments, stocks, mutual funds, or real estate. Your net capital gain is 100% tax-free under IRAS regulations, provided the disposal is an investment rather than commercial trading activity.';
          res.heroVerdict = `In Singapore, capital gains are <strong>100% tax-free</strong>. You owe <strong>S$0</strong> in capital gains tax under Inland Revenue Authority of Singapore (IRAS) rules, leaving your entire net profit of <strong>S$${fmt(grossGain)}</strong> in your pocket.`;
        }
      }

      // Calculations for output
      res.effectiveRate = grossGain > 0 ? (res.totalTax / grossGain) * 100 : 0;
      res.afterTaxGain = grossGain - res.totalTax;
      res.netProceeds = salePrice - eligibleCosts - res.totalTax;

      // Render Outputs
      if (resCountryBadge) resCountryBadge.textContent = res.badgeTitle || `${country} • 2026`;
      if (resHoldingBadge) resHoldingBadge.textContent = holdingInfo.text;
      if (resTotalTax) resTotalTax.textContent = fmt(res.totalTax);
      if (resTaxableGain) resTaxableGain.textContent = fmt(res.taxableGain);
      if (resAfterTaxGain) resAfterTaxGain.textContent = fmt(res.afterTaxGain);

      if (resHeroVerdict && !res.heroVerdict) {
        res.heroVerdict = `Based on an adjusted capital gain of <strong>${curr}${fmt(grossGain)}</strong>, your estimated capital gains tax is <strong>${curr}${fmt(res.totalTax)}</strong> (an effective tax rate of <strong>${fmtDec(res.effectiveRate, 1)}%</strong>).`;
      }
      if (resHeroVerdict && res.heroVerdict) {
        resHeroVerdict.innerHTML = res.heroVerdict;
      }

      // Split bar updates
      if (salePrice > 0) {
        const costPct = Math.max(0, Math.min(100, (totalCost / salePrice) * 100));
        const taxPct = Math.max(0, Math.min(100, (res.totalTax / salePrice) * 100));
        const gainPct = Math.max(0, 100 - costPct - taxPct);

        if (barSegCost) barSegCost.style.width = `${costPct}%`;
        if (barSegGain) barSegGain.style.width = `${gainPct}%`;
        if (barSegTax) barSegTax.style.width = `${taxPct}%`;
        if (resBarGainPct) resBarGainPct.textContent = `After-Tax Gain: ${fmtDec(gainPct, 1)}% of Sale`;
        if (legCostVal) legCostVal.textContent = `${curr}${fmt(totalCost)}`;
        if (legGainVal) legGainVal.textContent = `${curr}${fmt(res.afterTaxGain)}`;
        if (legTaxVal) legTaxVal.textContent = `${curr}${fmt(res.totalTax)}`;
      }

      // Table updates
      if (tblSalePrice) tblSalePrice.textContent = `${curr}${fmtDec(salePrice)}`;
      if (tblCostBasis) tblCostBasis.textContent = `−${curr}${fmtDec(purchasePrice)}`;
      if (tblEligibleCosts) tblEligibleCosts.textContent = `−${curr}${fmtDec(eligibleCosts)}`;
      if (tblGrossGain) tblGrossGain.textContent = `${curr}${fmtDec(grossGain)}`;
      if (tblExemptions) tblExemptions.textContent = `−${curr}${fmtDec(res.exemptions)}`;
      if (tblLosses) tblLosses.textContent = `−${curr}${fmtDec(res.lossesApplied)}`;

      // AU Discount row
      if (rowTblCgtDiscount) {
        if (country === 'AU' && res.discountApplied > 0) {
          rowTblCgtDiscount.classList.remove('hidden');
          if (tblDiscountVal) tblDiscountVal.textContent = `−${curr}${fmtDec(res.discountApplied)}`;
        } else {
          rowTblCgtDiscount.classList.add('hidden');
        }
      }

      if (tblTaxableGain) tblTaxableGain.textContent = `${curr}${fmtDec(res.taxableGain)}`;
      if (lblTblBaseTax) lblTblBaseTax.textContent = res.baseTaxName;
      if (tblBaseTax) tblBaseTax.textContent = `${curr}${fmtDec(res.baseTax)}`;

      // Extra tax 1
      if (rowTblExtraTax1) {
        if (res.extraTax1 > 0) {
          rowTblExtraTax1.classList.remove('hidden');
          if (lblTblExtraTax1) lblTblExtraTax1.textContent = res.extraTax1Name;
          if (tblExtraTax1) tblExtraTax1.textContent = `${curr}${fmtDec(res.extraTax1)}`;
        } else {
          rowTblExtraTax1.classList.add('hidden');
        }
      }

      // Extra tax 2
      if (rowTblExtraTax2) {
        if (res.extraTax2 > 0) {
          rowTblExtraTax2.classList.remove('hidden');
          if (lblTblExtraTax2) lblTblExtraTax2.textContent = res.extraTax2Name;
          if (tblExtraTax2) tblExtraTax2.textContent = `${curr}${fmtDec(res.extraTax2)}`;
        } else {
          rowTblExtraTax2.classList.add('hidden');
        }
      }

      if (tblTotalTax) tblTotalTax.textContent = `${curr}${fmtDec(res.totalTax)}`;
      if (tblEffectiveRate) tblEffectiveRate.textContent = `Effective Tax Rate: ${fmtDec(res.effectiveRate, 2)}%`;
      if (tblNetProceeds) tblNetProceeds.textContent = `${curr}${fmtDec(res.netProceeds)}`;

      // Tiles
      if (tileGrossGain) tileGrossGain.textContent = `${curr}${fmt(grossGain)}`;
      if (tileHoldingTime) tileHoldingTime.textContent = `${(holdingDays / 365).toFixed(1)} yrs`;
      if (tileHoldingSub) tileHoldingSub.textContent = `${holdingDays} days elapsed`;
      if (tileClassification) tileClassification.textContent = holdingInfo.isLongTerm ? 'Long-Term' : 'Short-Term';
      if (tileExemptions) tileExemptions.textContent = `${curr}${fmt(res.exemptions + res.lossesApplied + res.discountApplied)}`;
      if (tileTaxableGain) tileTaxableGain.textContent = `${curr}${fmt(res.taxableGain)}`;
      if (tileEffectiveRate) tileEffectiveRate.textContent = `${fmtDec(res.effectiveRate, 1)}%`;
      if (tileAfterTaxGain) tileAfterTaxGain.textContent = `${curr}${fmt(res.afterTaxGain)}`;
      if (tileNetProceeds) tileNetProceeds.textContent = `${curr}${fmt(res.netProceeds)}`;

      // Contextual Notes
      if (noteHeading && res.noteHeading) noteHeading.textContent = res.noteHeading;
      if (noteBody && res.noteBody) noteBody.textContent = res.noteBody;
    }

    // Event Listeners
    if (mobileCountrySelect) {
      mobileCountrySelect.addEventListener('change', () => {
        updateCountryUI(mobileCountrySelect.value);
      });
    }

    countryPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const c = pill.getAttribute('data-country') || 'US';
        updateCountryUI(c);
      });
    });

    [purchasePriceInput, salePriceInput, eligibleCostsInput, dateAcquiredInput, dateSoldInput, capitalLossesInput, stateRateInput].forEach(inp => {
      if (inp) inp.addEventListener('input', calculateAndRender);
    });

    if (otherIncomeInput && otherIncomeSlider) {
      otherIncomeInput.addEventListener('input', () => {
        otherIncomeSlider.value = otherIncomeInput.value;
        calculateAndRender();
      });
      otherIncomeSlider.addEventListener('input', () => {
        otherIncomeInput.value = otherIncomeSlider.value;
        calculateAndRender();
      });
    }

    [assetTypeSelect, filingStatusSelect, provinceSelect, auResidencySelect, inRegimeSelect].forEach(sel => {
      if (sel) sel.addEventListener('change', calculateAndRender);
    });

    if (advancedToggle && advancedContent) {
      advancedToggle.addEventListener('click', () => {
        const isExp = advancedToggle.getAttribute('aria-expanded') === 'true';
        advancedToggle.setAttribute('aria-expanded', String(!isExp));
        advancedContent.classList.toggle('hidden', isExp);
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (mobileCountrySelect) mobileCountrySelect.value = activeCountry;
        if (mobileSelectedFlag) mobileSelectedFlag.textContent = getCountryFlag(activeCountry);
        purchasePriceInput.value = (activeCountry === 'IN') ? '500000' : '50000';
        salePriceInput.value = (activeCountry === 'IN') ? '1200000' : '120000';
        eligibleCostsInput.value = (activeCountry === 'IN') ? '25000' : '3000';
        otherIncomeInput.value = (activeCountry === 'IN') ? '1000000' : '85000';
        if (otherIncomeSlider) otherIncomeSlider.value = otherIncomeInput.value;
        capitalLossesInput.value = '0';
        if (stateRateInput) stateRateInput.value = '0.0';
        dateAcquiredInput.value = '2024-03-15';
        dateSoldInput.value = '2026-05-20';
        calculateAndRender();
      });
    }

    // Native platform clipboard copy
    document.addEventListener('copy-calculator-results', () => {
      const curr = (activeCountry === 'UK') ? '£' : ((activeCountry === 'IN') ? '₹' : ((activeCountry === 'SG') ? 'S$' : '$'));
      const text = `Capital Gains Tax Calculation (${activeCountry}):
Gross Gain: ${curr}${tileGrossGain?.textContent || '0'}
Taxable Capital Gain: ${curr}${tileTaxableGain?.textContent || '0'}
Estimated Capital Gains Tax: ${curr}${resTotalTax?.textContent || '0'} (${tileEffectiveRate?.textContent || '0%'})
Estimated After-Tax Profit: ${curr}${tileAfterTaxGain?.textContent || '0'}
Net Cash Proceeds: ${curr}${tileNetProceeds?.textContent || '0'}
Calculated via FinCalcLab Capital Gains Tax Calculator (https://fincalclab.com/calculator/capital-gains-tax-calculator)`;

      navigator.clipboard.writeText(text).then(() => {
        alert('Capital gains calculation copied to clipboard!');
      }).catch(err => {
        console.error('Copy failed: ', err);
      });
    });

    // Initial calculation
    calculateAndRender();
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCapitalGainsCalculator);
  } else {
    initCapitalGainsCalculator();
  }
</script>
