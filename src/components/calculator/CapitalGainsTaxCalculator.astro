  // Formatting helpers
  function fmt(val: number, decimals = 0): string {
    if (isNaN(val) || !isFinite(val)) return '0';
    return Math.round(val).toLocaleString('en-US');
  }

  function fmtDec(val: number, decimals = 2): string {
    if (isNaN(val) || !isFinite(val)) return '0.00';
    return val.toLocaleString('en-US', {
      minimumFractionDigits: decimals,
      maximumFractionDigits: decimals
    });
  }

  function getHoldingDays(dateAcquiredStr: string, dateSoldStr: string): number {
    const d1 = new Date(dateAcquiredStr);
    const d2 = new Date(dateSoldStr);
    if (isNaN(d1.getTime()) || isNaN(d2.getTime())) return 366;
    const diffTime = d2.getTime() - d1.getTime();
    const days = Math.floor(diffTime / (1000 * 60 * 60 * 24));
    return days >= 0 ? days : 0;
  }

  function getHoldingText(days: number): { text: string; isLongTerm: boolean } {
    const years = Math.floor(days / 365);
    const remDays = days % 365;
    const months = Math.floor(remDays / 30);
    const isLongTerm = days > 365;
    let label = '';
    if (years > 0) {
      label = `Held ${years} yr${years > 1 ? 's' : ''}${months > 0 ? `, ${months} mo` : ''} (${days} days)`;
    } else if (months > 0) {
      label = `Held ${months} month${months > 1 ? 's' : ''} (${days} days)`;
    } else {
      label = `Held ${days} day${days !== 1 ? 's' : ''}`;
    }
    return { text: `${label} • ${isLongTerm ? 'Long-Term Gain' : 'Short-Term Gain'}`, isLongTerm };
  }

  // -----------------------------------------------------------------
  // US ENGINE
  function calcUsOrdinaryTax(income: number, status: string): number {
    if (income <= 0) return 0;
    const brackets = US_CONFIG.ordinaryBrackets[status] || US_CONFIG.ordinaryBrackets.single;
    let tax = 0;
    for (const b of brackets) {
      if (income > b.min) {
        const taxable = Math.min(income, b.max) - b.min;
        tax += taxable * b.rate;
      }
    }
    return tax;
  }

  function calcUsLtcgTax(ordinaryIncome: number, ltcg: number, status: string): number {
    if (ltcg <= 0) return 0;
    const bands = US_CONFIG.ltcgBrackets[status] || US_CONFIG.ltcgBrackets.single;
    let tax = 0;
    let currentStart = ordinaryIncome;
    let remaining = ltcg;
    for (const band of bands) {
      if (currentStart < band.max && remaining > 0) {
        const room = band.max - currentStart;
        const gainInBand = Math.min(remaining, room);
        tax += gainInBand * band.rate;
        remaining -= gainInBand;
        currentStart += gainInBand;
      }
    }
    return tax;
  }

  // -----------------------------------------------------------------
  // AU ENGINE
  function calcAuIncomeTax(income: number): number {
    if (income <= 18200) return 0;
    for (let i = AU_CONFIG.brackets.length - 1; i >= 0; i--) {
      const b = AU_CONFIG.brackets[i];
      if (income > b.min) {
        return b.baseTax + (income - b.min) * b.rate;
      }
    }
    return 0;
  }

  function calcAuMedicare(income: number): number {
    if (income <= AU_CONFIG.medicareLowIncomeThreshold) return 0;
    if (income <= AU_CONFIG.medicarePhaseInThreshold) {
      return (income - AU_CONFIG.medicareLowIncomeThreshold) * 0.10;
    }
    return income * AU_CONFIG.medicareRate;
  }

  // -----------------------------------------------------------------
  // IN ENGINE
  function calcInSlabTax(income: number): number {
    if (income <= 300000) return 0;
    if (income <= 700000) return 0; // Section 87A rebate
    let tax = 0;
    for (const b of IN_CONFIG.newRegimeBrackets) {
      if (income > b.min) {
        const taxable = Math.min(income, b.max) - b.min;
        tax += taxable * b.rate;
      }
    }
    return tax;
  }

  // -----------------------------------------------------------------
  // CA ENGINE
  function calcProgressive(income: number, brackets: { min: number; max: number; rate: number }[]): number {
    if (income <= 0) return 0;
    let tax = 0;
    for (const b of brackets) {
      if (income > b.min) {
        const taxable = Math.min(income, b.max) - b.min;
        tax += taxable * b.rate;
      }
    }
    return tax;
  }

  function calcCaTotalTax(income: number, provKey: string): { fed: number; prov: number; total: number } {
    let fed = calcProgressive(income, CA_CONFIG.federalBrackets);
    const provConfig = CA_CONFIG.provinces[provKey] || CA_CONFIG.provinces.ON;
    if (provConfig.abatement) {
      fed = fed * (1 - 0.165);
    }
    let prov = calcProgressive(income, provConfig.brackets);
    if (provConfig.surtax) {
      let surtax = 0;
      if (prov > 5554) surtax += (prov - 5554) * 0.20;
      if (prov > 7108) surtax += (prov - 7108) * 0.36;
      prov += surtax;
    }
    return { fed, prov, total: fed + prov };
  }

