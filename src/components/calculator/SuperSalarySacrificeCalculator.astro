---
import CalculatorLayout from './CalculatorLayout.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
---

<CalculatorLayout
  title="Super Salary Sacrifice Calculator (Australia)"
  description="Calculate how salary sacrificing into superannuation reduces your Australian income tax and Medicare levy, affects take-home pay, and boosts your retirement balance."
  category="Superannuation & Tax"
>
  <!-- Inputs Section -->
  <div slot="inputs" class="calc-inputs-wrapper" id="super-sacrifice-root">
    <div class="input-section" style="border-top: none; padding-top: 0;">
      <h3 class="section-title">1. Salary &amp; Tax Year</h3>

      <!-- Gross Annual Salary -->
      <div class="input-group">
        <div class="input-label-row">
          <label for="au-salary-input">Gross Annual Salary</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol">$</span>
            <input type="number" id="au-salary-input" min="0" max="2000000" step="1000" value="100000" aria-label="Gross Annual Salary" />
          </div>
        </div>
        <input type="range" id="au-salary-slider" min="0" max="300000" step="1000" value="100000" class="slider-range" aria-label="Salary Slider" />
        
        <!-- Salary Presets -->
        <div class="preset-pills-row">
          <span class="preset-label">Quick:</span>
          <button type="button" class="preset-pill" data-salary="60000">$60k</button>
          <button type="button" class="preset-pill" data-salary="85000">$85k</button>
          <button type="button" class="preset-pill active" data-salary="100000">$100k</button>
          <button type="button" class="preset-pill" data-salary="130000">$130k</button>
          <button type="button" class="preset-pill" data-salary="160000">$160k</button>
          <button type="button" class="preset-pill" data-salary="200000">$200k</button>
        </div>
        <span class="input-subtext">Your base annual salary before income tax and before salary sacrifice.</span>
      </div>

      <!-- Tax Year Selector -->
      <div class="input-group" style="margin-top: var(--space-4);">
        <div class="input-label-row">
          <label for="au-tax-year-select">Tax Year</label>
          <select id="au-tax-year-select" class="currency-select" aria-label="Select Australian Tax Year">
            <option value="2025_26" selected>2025–26 (Current: Revised Stage 3 &amp; 12% SG)</option>
            <option value="2024_25">2024–25 (Revised Stage 3 &amp; 11.5% SG)</option>
            <option value="2023_24">2023–24 (Historical: Pre-Stage 3 &amp; 11% SG)</option>
          </select>
        </div>
        <span class="input-subtext" id="au-tax-year-subtext">ATO individual resident tax brackets with 12.0% Super Guarantee and $30,000 concessional cap.</span>
      </div>

      <!-- Pay Frequency Selector -->
      <div class="input-group" style="margin-top: var(--space-4);">
        <div class="input-label-row">
          <label for="au-pay-freq-select">Pay Frequency (for Take-Home Pay)</label>
          <select id="au-pay-freq-select" class="currency-select" aria-label="Select Pay Frequency">
            <option value="annual" selected>Annual (per year)</option>
            <option value="monthly">Monthly (12 pays/year)</option>
            <option value="fortnightly">Fortnightly (26 pays/year)</option>
            <option value="weekly">Weekly (52 pays/year)</option>
          </select>
        </div>
        <span class="input-subtext">Used to display before-and-after take-home pay for each pay packet.</span>
      </div>
    </div>

    <!-- Step 2: Salary Sacrifice Amount -->
    <div class="input-section" style="margin-top: var(--space-4);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-3); padding-bottom: var(--space-2); border-bottom: 1px solid var(--color-border);">
        <h3 class="section-title" style="margin-bottom: 0; padding-bottom: 0; border-bottom: none;">2. Salary Sacrifice to Super</h3>
        
        <!-- Toggle Dollar vs Percent -->
        <div class="sacrifice-toggle-group" role="radiogroup" aria-label="Salary sacrifice input mode">
          <button type="button" class="toggle-mode-btn active" id="btn-mode-dollar" data-mode="dollar" aria-checked="true">Dollar ($)</button>
          <button type="button" class="toggle-mode-btn" id="btn-mode-percent" data-mode="percent" aria-checked="false">Percent (%)</button>
        </div>
      </div>

      <!-- Dollar Input Group -->
      <div id="group-sacrifice-dollar" class="input-group">
        <div class="input-label-row">
          <label for="au-sacrifice-val">Annual Amount Sacrificed</label>
          <div class="input-symbol-wrapper">
            <span class="currency-symbol">$</span>
            <input type="number" id="au-sacrifice-val" min="0" max="100000" step="500" value="10000" aria-label="Annual Salary Sacrifice in Dollars" />
          </div>
        </div>
        <input type="range" id="au-sacrifice-slider" min="0" max="35000" step="500" value="10000" class="slider-range" aria-label="Sacrifice Dollar Slider" />
        
        <!-- Dollar Presets -->
        <div class="preset-pills-row">
          <span class="preset-label">Quick:</span>
          <button type="button" class="preset-pill" data-sac-dollar="0">$0</button>
          <button type="button" class="preset-pill" data-sac-dollar="2500">$2.5k</button>
          <button type="button" class="preset-pill" data-sac-dollar="5000">$5k</button>
          <button type="button" class="preset-pill active" data-sac-dollar="10000">$10k</button>
          <button type="button" class="preset-pill" data-sac-dollar="15000">$15k</button>
          <button type="button" class="preset-pill" data-sac-dollar="20000">$20k</button>
        </div>
        <span class="input-subtext">Pre-tax gross salary diverted directly into your super fund each year.</span>
      </div>

      <!-- Percent Input Group (Hidden by default) -->
      <div id="group-sacrifice-percent" class="input-group hidden">
        <div class="input-label-row">
          <label for="au-sacrifice-pct-val">Percentage of Salary Sacrificed</label>
          <div class="input-symbol-wrapper">
            <input type="number" id="au-sacrifice-pct-val" min="0" max="100" step="0.5" value="10.0" aria-label="Salary Sacrifice Percentage" style="text-align: left;" />
            <span class="percent-symbol">%</span>
          </div>
        </div>
        <input type="range" id="au-sacrifice-pct-slider" min="0" max="40" step="0.5" value="10.0" class="slider-range" aria-label="Sacrifice Percentage Slider" />

        <!-- Percent Presets -->
        <div class="preset-pills-row">
          <span class="preset-label">Quick:</span>
          <button type="button" class="preset-pill" data-sac-pct="0">0%</button>
          <button type="button" class="preset-pill" data-sac-pct="3">3%</button>
          <button type="button" class="preset-pill" data-sac-pct="5">5%</button>
          <button type="button" class="preset-pill active" data-sac-pct="10">10%</button>
          <button type="button" class="preset-pill" data-sac-pct="15">15%</button>
        </div>
        <span class="input-subtext">Equivalent to <strong id="lbl-pct-equiv">$10,000.00 / year</strong> based on current gross salary.</span>
      </div>
    </div>

    <!-- Step 3: Optional Advanced / Employer Super Cap Accordion -->
    <div class="advanced-section" style="margin-top: var(--space-4);">
      <button type="button" class="advanced-toggle-btn" id="au-advanced-toggle" aria-expanded="false" aria-controls="au-advanced-panel">
        <span style="display: flex; align-items: center; gap: 8px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4M12 8h.01"/></svg>
          Concessional Cap &amp; Employer Super (Optional)
        </span>
        <svg class="chevron-icon" id="au-advanced-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
      </button>

      <div class="advanced-panel hidden" id="au-advanced-panel">
        <p style="font-size: 0.8rem; color: var(--color-text-muted); margin: 0 0 var(--space-3) 0; line-height: 1.45;">
          Employer Super Guarantee (SG) counts toward your annual concessional contributions cap ($30,000 for 2025–26). By default, this calculator automatically estimates employer SG (12.0% of salary). You can enter a custom amount if your employer contributes a different figure.
        </p>

        <div class="input-group">
          <div class="input-label-row">
            <label for="au-employer-super-input">Employer Super Guarantee ($ / year)</label>
            <div class="input-symbol-wrapper">
              <span class="currency-symbol">$</span>
              <input type="number" id="au-employer-super-input" min="0" max="100000" step="500" placeholder="Auto: 12% ($12,000)" aria-label="Employer Super Contribution" />
            </div>
          </div>
          <span class="input-subtext">Leave blank to use official SG rate (12.0% for 2025–26 = <strong id="lbl-auto-sg">$12,000.00</strong>).</span>
        </div>
      </div>
    </div>

    <!-- Reset Button -->
    <div style="margin-top: var(--space-4);">
      <Button variant="secondary" size="sm" id="au-sacrifice-reset" class="w-full">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        Reset Calculator
      </Button>
    </div>
  </div>

  <!-- Results Section -->
  <div slot="results" class="calc-results-wrapper">

    <!-- Primary Hero Card: Estimated Tax Saving -->
    <Card elevation="md" class="primary-hero-card">
      <div class="hero-top-row">
        <span class="hero-label">Estimated Tax Saving</span>
        <span class="hero-badge" id="au-tax-rate-badge">32.0% Marginal Rate</span>
      </div>
      <div class="hero-main-metric" id="res-tax-saving">$3,200.00</div>
      <p class="hero-subtext" id="res-hero-subtext">
        Combined income tax and Medicare levy saved annually
      </p>

      <!-- Sub-Hero Highlights -->
      <div class="sub-hero-container">
        <div class="sub-hero-grid">
          <div class="sub-hero-item">
            <span class="sub-hero-label">Take-Home Pay Reduction</span>
            <span class="sub-hero-val text-danger" id="res-takehome-drop">−$6,800.00</span>
            <span class="sub-hero-desc" id="res-takehome-drop-sub">Effective out-of-pocket cost</span>
          </div>
          <div class="sub-hero-item">
            <span class="sub-hero-label">Added to Super (Net)</span>
            <span class="sub-hero-val text-success" id="res-super-net">+$8,500.00</span>
            <span class="sub-hero-desc">After 15% super fund tax</span>
          </div>
        </div>
      </div>
    </Card>

    <!-- Super Salary Sacrifice Balance Bar -->
    <div class="tradeoff-card">
      <div class="tradeoff-header">
        <span class="tradeoff-title">The Salary Sacrifice Trade-off</span>
      </div>
      <div class="tradeoff-grid">
        <div class="tradeoff-item">
          <span class="tradeoff-lbl">Gross Sacrificed:</span>
          <strong class="tradeoff-val text-primary" id="tradeoff-gross">$10,000.00</strong>
        </div>
        <div class="tradeoff-item">
          <span class="tradeoff-lbl">Tax Saved:</span>
          <strong class="tradeoff-val text-success" id="tradeoff-tax-saved">+$3,200.00</strong>
        </div>
        <div class="tradeoff-item">
          <span class="tradeoff-lbl">Take-Home Drop:</span>
          <strong class="tradeoff-val text-danger" id="tradeoff-takehome-drop">−$6,800.00</strong>
        </div>
        <div class="tradeoff-item highlight-tradeoff">
          <span class="tradeoff-lbl">Net Wealth Boost:</span>
          <strong class="tradeoff-val text-success" id="tradeoff-net-boost">+$1,700.00</strong>
        </div>
      </div>
      <div class="tradeoff-note">
        You give up <strong>$6,800.00</strong> in take-home pay to deposit <strong>$8,500.00</strong> net into your superannuation—creating a <strong>$1,700.00</strong> immediate tax benefit!
      </div>
    </div>

    <!-- Concessional Cap Alert Banner (Conditional) -->
    <div id="au-cap-warning" class="status-banner warning-banner hidden">
      <div class="status-banner-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
      </div>
      <div class="status-banner-content" id="au-cap-warning-msg">
        <!-- Dynamically injected cap warning -->
      </div>
    </div>

    <!-- Division 293 Warning Banner (Conditional) -->
    <div id="au-div293-warning" class="status-banner info-banner hidden">
      <div class="status-banner-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      </div>
      <div class="status-banner-content" id="au-div293-msg">
        <strong>Division 293 Advisory:</strong> Your combined taxable income and concessional contributions exceed $250,000. You may be subject to Division 293 tax (an additional 15% tax on excess concessional contributions above $250,000). Even with Division 293, salary sacrifice generally delivers a 17% tax benefit compared to the top 47% marginal rate.
      </div>
    </div>

    <!-- Comparison Table: Without vs. With Salary Sacrifice -->
    <div class="table-card">
      <div class="table-header-row">
        <div>
          <h4 class="table-title">Before vs. After Salary Sacrifice Comparison</h4>
          <span class="table-sub">Detailed breakdown of income tax, Medicare levy, take-home pay, and super.</span>
        </div>
      </div>

      <div class="table-responsive-wrapper">
        <table class="comparison-table">
          <thead>
            <tr>
              <th scope="col" style="text-align: left;">Component</th>
              <th scope="col" style="text-align: right;">Without Sacrifice</th>
              <th scope="col" style="text-align: right;">With Sacrifice</th>
              <th scope="col" style="text-align: right;">Difference</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="font-weight: 600;">Gross Annual Salary</td>
              <td style="text-align: right;" id="tbl-gross-without">$100,000.00</td>
              <td style="text-align: right;" id="tbl-gross-with">$100,000.00</td>
              <td style="text-align: right; color: var(--color-text-muted);">$0.00</td>
            </tr>
            <tr>
              <td style="font-weight: 600;">Salary Sacrificed to Super</td>
              <td style="text-align: right;">$0.00</td>
              <td style="text-align: right; color: var(--color-primary); font-weight: 600;" id="tbl-sacrificed">$10,000.00</td>
              <td style="text-align: right; color: var(--color-primary); font-weight: 600;" id="tbl-sac-diff">+$10,000.00</td>
            </tr>
            <tr style="background: rgba(0, 0, 0, 0.015);">
              <td style="font-weight: 600;">Taxable Salary (ATO)</td>
              <td style="text-align: right;" id="tbl-taxable-without">$100,000.00</td>
              <td style="text-align: right; font-weight: 600;" id="tbl-taxable-with">$90,000.00</td>
              <td style="text-align: right; color: var(--color-success); font-weight: 600;" id="tbl-taxable-diff">−$10,000.00</td>
            </tr>
            <tr>
              <td>Estimated Income Tax</td>
              <td style="text-align: right;" id="tbl-tax-without">$20,788.00</td>
              <td style="text-align: right;" id="tbl-tax-with">$17,788.00</td>
              <td style="text-align: right; color: var(--color-success); font-weight: 600;" id="tbl-tax-diff">−$3,000.00</td>
            </tr>
            <tr>
              <td>Medicare Levy (2%)</td>
              <td style="text-align: right;" id="tbl-medicare-without">$2,000.00</td>
              <td style="text-align: right;" id="tbl-medicare-with">$1,800.00</td>
              <td style="text-align: right; color: var(--color-success); font-weight: 600;" id="tbl-medicare-diff">−$200.00</td>
            </tr>
            <tr style="font-weight: 600; border-top: 2px solid var(--color-border);">
              <td>Total Tax &amp; Medicare Paid</td>
              <td style="text-align: right;" id="tbl-total-tax-without">$22,788.00</td>
              <td style="text-align: right;" id="tbl-total-tax-with">$19,588.00</td>
              <td style="text-align: right; color: var(--color-success); font-weight: 700;" id="tbl-total-tax-diff">−$3,200.00</td>
            </tr>
            <tr style="background: rgba(16, 185, 129, 0.04); font-weight: 700;">
              <td>Estimated Take-Home Pay</td>
              <td style="text-align: right;" id="tbl-takehome-without">$77,212.00</td>
              <td style="text-align: right;" id="tbl-takehome-with">$70,412.00</td>
              <td style="text-align: right; color: var(--color-danger);" id="tbl-takehome-diff">−$6,800.00</td>
            </tr>
            <tr id="row-takehome-periodic" style="font-size: 0.78rem; color: var(--color-text-muted);">
              <td>Take-Home per Pay (<span id="lbl-tbl-freq">Annual</span>)</td>
              <td style="text-align: right;" id="tbl-freq-without">$77,212.00</td>
              <td style="text-align: right;" id="tbl-freq-with">$70,412.00</td>
              <td style="text-align: right; color: var(--color-danger);" id="tbl-freq-diff">−$6,800.00</td>
            </tr>
            <tr style="border-top: 2px solid var(--color-border);">
              <td style="font-weight: 600;">Super from Salary Sacrifice (Gross)</td>
              <td style="text-align: right;">$0.00</td>
              <td style="text-align: right; color: var(--color-primary); font-weight: 600;" id="tbl-super-gross">$10,000.00</td>
              <td style="text-align: right; color: var(--color-primary); font-weight: 600;" id="tbl-super-gross-diff">+$10,000.00</td>
            </tr>
            <tr>
              <td>Super Fund Contributions Tax (15%)</td>
              <td style="text-align: right;">$0.00</td>
              <td style="text-align: right; color: var(--color-danger);" id="tbl-super-tax">−$1,500.00</td>
              <td style="text-align: right; color: var(--color-danger);" id="tbl-super-tax-diff">−$1,500.00</td>
            </tr>
            <tr style="background: rgba(37, 99, 235, 0.04); font-weight: 700;">
              <td>Net Added to Superannuation</td>
              <td style="text-align: right;">$0.00</td>
              <td style="text-align: right; color: var(--color-success);" id="tbl-super-net">+$8,500.00</td>
              <td style="text-align: right; color: var(--color-success);" id="tbl-super-net-diff">+$8,500.00</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Responsive 8-Tile Metrics Grid (Rule 15 Responsive) -->
    <div class="metrics-grid">
      <div class="metric-tile">
        <span class="metric-label">Gross Salary</span>
        <span class="metric-val" id="tile-gross-salary">$100,000</span>
        <span class="metric-sub">Before salary sacrifice</span>
      </div>

      <div class="metric-tile">
        <span class="metric-label">Salary Sacrificed</span>
        <span class="metric-val text-primary" id="tile-sacrificed">$10,000</span>
        <span class="metric-sub" id="tile-sacrificed-sub">Pre-tax into super</span>
      </div>

      <div class="metric-tile">
        <span class="metric-label">New Taxable Salary</span>
        <span class="metric-val" id="tile-taxable-salary">$90,000</span>
        <span class="metric-sub">Taxed by ATO</span>
      </div>

      <div class="metric-tile highlight-tile">
        <span class="metric-label">Estimated Tax Saved</span>
        <span class="metric-val text-success" id="tile-tax-saved">$3,200</span>
        <span class="metric-sub" id="tile-tax-saved-sub">Income tax &amp; Medicare</span>
      </div>

      <div class="metric-tile">
        <span class="metric-label">Take-Home Reduction</span>
        <span class="metric-val text-danger" id="tile-takehome-drop">−$6,800</span>
        <span class="metric-sub" id="tile-takehome-drop-sub">Effective annual cost</span>
      </div>

      <div class="metric-tile">
        <span class="metric-label">Net Super Credited</span>
        <span class="metric-val text-success" id="tile-net-super">+$8,500</span>
        <span class="metric-sub">After 15% fund tax</span>
      </div>

      <div class="metric-tile">
        <span class="metric-label">Total Concessional Super</span>
        <span class="metric-val" id="tile-total-concessional">$22,000</span>
        <span class="metric-sub" id="tile-concessional-sub">Cap: $30,000 / yr</span>
      </div>

      <div class="metric-tile highlight-tile">
        <span class="metric-label">Net Annual Wealth Boost</span>
        <span class="metric-val text-success" id="tile-net-boost">+$1,700</span>
        <span class="metric-sub">Net super − take-home cost</span>
      </div>
    </div>

    <!-- Plain-English Verdict Summary -->
    <div class="verdict-container">
      <Card elevation="sm" class="verdict-card verdict-info">
        <div class="verdict-header">
          <div class="verdict-badge">ATO Tax Summary</div>
          <span class="verdict-title">How Salary Sacrifice Works For You</span>
        </div>
        <p class="verdict-desc" id="res-verdict-text">
          Salary sacrificing <strong>$10,000.00</strong> of your <strong>$100,000.00</strong> salary reduces your taxable income to <strong>$90,000.00</strong>, saving you <strong>$3,200.00</strong> in income tax and Medicare levy. Your take-home pay decreases by <strong>$6,800.00</strong> per year, while your super balance increases by <strong>$8,500.00</strong> (after the 15% super fund tax), resulting in a net wealth advantage of <strong>$1,700.00</strong>.
        </p>
      </Card>
    </div>

    <!-- Australia Statutory Disclaimer -->
    <div class="disclaimer-text">
      <strong>Australian Tax &amp; Superannuation Disclaimer:</strong> This calculator provides an estimate based on the information entered and current Australian Taxation Office (ATO) and superannuation rules for the selected tax year. Actual tax, Medicare levy, super contributions, and Division 293 outcomes may vary depending on your personal circumstances, tax offsets (such as LITO), private health insurance status, and HECS/HELP repayments. This calculator does not provide financial or taxation advice. Check the latest ATO guidance or speak with a licensed Australian financial planner or registered tax agent for advice tailored to your personal situation.
    </div>
  </div>
</CalculatorLayout>

<script>
  // Centralized Australian Tax Configuration
  interface TaxBracket {
    min: number;
    max: number | null;
    rate: number;
    baseTax: number;
  }

  interface TaxYearConfig {
    label: string;
    year: string;
    sgRate: number;
    concessionalCap: number;
    div293Threshold: number;
    div293Rate: number;
    medicareRate: number;
    medicareLowIncomeThreshold: number;
    medicarePhaseInThreshold: number;
    superTaxRate: number;
    brackets: TaxBracket[];
  }

  const AU_TAX_CONFIGS: Record<string, TaxYearConfig> = {
    '2025_26': {
      label: '2025–26 (Current: Revised Stage 3 & 12% SG)',
      year: '2025_26',
      sgRate: 0.12,
      concessionalCap: 30000,
