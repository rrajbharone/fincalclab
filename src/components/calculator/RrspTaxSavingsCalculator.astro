              { from: 140000, to: Infinity, rate: 0.1875 }
            ]
          },
          'YT': {
            name: 'Yukon',
            brackets: [
              { from: 0, to: 57375, rate: 0.064 },
              { from: 57375, to: 114750, rate: 0.090 },
              { from: 114750, to: 177882, rate: 0.109 },
              { from: 177882, to: 500000, rate: 0.128 },
              { from: 500000, to: Infinity, rate: 0.150 }
            ]
          },
          'NT': {
            name: 'Northwest Territories',
            brackets: [
              { from: 0, to: 50597, rate: 0.0590 },
              { from: 50597, to: 101198, rate: 0.0860 },
              { from: 101198, to: 164525, rate: 0.1220 },
              { from: 164525, to: Infinity, rate: 0.1405 }
            ]
          },
          'NU': {
            name: 'Nunavut',
            brackets: [
              { from: 0, to: 53268, rate: 0.040 },
              { from: 53268, to: 106537, rate: 0.070 },
              { from: 106537, to: 173205, rate: 0.090 },
              { from: 173205, to: Infinity, rate: 0.115 }
            ]
          }
        }
      }
    };

    // DOM Elements
    const root = document.getElementById('rrsp-tax-root');
    if (!root) return;

    const taxYearSelect  = document.getElementById('rrsp-tax-year') as HTMLSelectElement;
    const provinceSelect = document.getElementById('rrsp-province-select') as HTMLSelectElement;

    const incomeInput    = document.getElementById('rrsp-income-val') as HTMLInputElement;
    const incomeSlider   = document.getElementById('rrsp-income-slider') as HTMLInputElement;

    const contribInput   = document.getElementById('rrsp-contrib-val') as HTMLInputElement;
    const contribSlider  = document.getElementById('rrsp-contrib-slider') as HTMLInputElement;

    const roomInput      = document.getElementById('rrsp-room-val') as HTMLInputElement;
    const resetBtn       = document.getElementById('rrsp-reset-btn') as HTMLButtonElement;

    // Results elements
    const heroBadge      = document.getElementById('rrsp-hero-badge') as HTMLElement;
    const heroSavings    = document.getElementById('rrsp-hero-savings') as HTMLElement;
    const heroSub        = document.getElementById('rrsp-hero-sub') as HTMLElement;
    const heroCost       = document.getElementById('rrsp-hero-cost') as HTMLElement;
    const heroCostSub    = document.getElementById('rrsp-hero-cost-sub') as HTMLElement;

    // Flow elements
    const flowContrib    = document.getElementById('flow-contrib') as HTMLElement;
    const flowTaxable    = document.getElementById('flow-taxable-after') as HTMLElement;
    const flowSavings    = document.getElementById('flow-savings') as HTMLElement;
    const flowCost       = document.getElementById('flow-cost') as HTMLElement;

    // Alerts
    const roomAlert      = document.getElementById('rrsp-room-alert') as HTMLElement;
    const roomAlertMsg   = document.getElementById('rrsp-room-alert-msg') as HTMLElement;
    const qcAlert        = document.getElementById('rrsp-qc-alert') as HTMLElement;

    // Metrics grid
    const metricContrib  = document.getElementById('metric-contrib') as HTMLElement;
    const metricDeductible = document.getElementById('metric-deductible') as HTMLElement;
    const metricDeductibleSub = document.getElementById('metric-deductible-sub') as HTMLElement;
    const metricAboveRoom = document.getElementById('metric-above-room') as HTMLElement;
    const metricAboveRoomSub = document.getElementById('metric-above-room-sub') as HTMLElement;
    const metricIncomeBefore = document.getElementById('metric-income-before') as HTMLElement;
    const metricIncomeAfter = document.getElementById('metric-income-after') as HTMLElement;
    const metricTaxBefore = document.getElementById('metric-tax-before') as HTMLElement;
    const metricTaxAfter = document.getElementById('metric-tax-after') as HTMLElement;
    const metricFedSavings = document.getElementById('metric-fed-savings') as HTMLElement;
    const metricProvLabel = document.getElementById('metric-prov-label') as HTMLElement;
    const metricProvSavings = document.getElementById('metric-prov-savings') as HTMLElement;
    const metricProvSub  = document.getElementById('metric-prov-sub') as HTMLElement;
    const metricTotalSavings = document.getElementById('metric-total-savings') as HTMLElement;

    // Audit panel
    const auditToggle    = document.getElementById('rrsp-audit-toggle') as HTMLButtonElement;
    const auditPanel     = document.getElementById('rrsp-audit-panel') as HTMLElement;
    const auditChevron   = document.getElementById('rrsp-audit-chevron') as HTMLElement;
    const auditTbody     = document.getElementById('rrsp-audit-tbody') as HTMLElement;

    // Summary Card
    const summaryDesc    = document.getElementById('rrsp-summary-desc') as HTMLElement;

    // Currency Formatter
    function fmt(val: number): string {
      const absVal = Math.abs(val);
      const str = absVal.toLocaleString('en-CA', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
      return `${val < 0 ? '-' : ''}$${str}`;
    }

    function calculateBracketTax(taxableIncome: number, brackets: TaxBracket[]): number {
      if (taxableIncome <= 0) return 0;
      let totalTax = 0;
      for (const b of brackets) {
        if (taxableIncome <= b.from) continue;
        const taxableSlice = Math.min(taxableIncome - b.from, b.to - b.from);
        if (taxableSlice > 0) {
          totalTax += taxableSlice * b.rate;
        }
      }
      return totalTax;
    }

    function updateCalculation() {
      const yearKey = taxYearSelect.value || '2026';
      const provKey = provinceSelect.value || 'ON';
      const yearConfig = TAX_CONFIG[yearKey] || TAX_CONFIG['2026'];
      const provData = yearConfig.provinces[provKey] || yearConfig.provinces['ON'];

      const income = Math.max(0, parseFloat(incomeInput.value) || 0);
      const contrib = Math.max(0, parseFloat(contribInput.value) || 0);

      const roomRaw = roomInput.value.trim();
      const hasRoom = roomRaw !== '' && !isNaN(parseFloat(roomRaw));
      const availableRoom = hasRoom ? Math.max(0, parseFloat(roomRaw)) : Infinity;

      // Cap deductible contribution at available room (if provided) and at total taxable income
      const roomCappedContrib = hasRoom ? Math.min(contrib, availableRoom) : contrib;
      const deductibleContrib = Math.min(roomCappedContrib, income);
      const excessAboveRoom = hasRoom ? Math.max(0, contrib - availableRoom) : 0;

      const incomeBefore = income;
      const incomeAfter = Math.max(0, income - deductibleContrib);

      // Federal Tax Calculations
      let fedTaxBefore = calculateBracketTax(incomeBefore, yearConfig.federalBrackets);
      let fedTaxAfter = calculateBracketTax(incomeAfter, yearConfig.federalBrackets);

      if (provData.abatement) {
        fedTaxBefore *= 0.835;
        fedTaxAfter *= 0.835;
      }
      const fedTaxSaved = Math.max(0, fedTaxBefore - fedTaxAfter);

      // Provincial Tax Calculations
      let provTaxBefore = calculateBracketTax(incomeBefore, provData.brackets);
      let provTaxAfter = calculateBracketTax(incomeAfter, provData.brackets);

      if (provData.surtax) {
        const calcOnSurtax = (baseTax: number) => {
          let s = 0;
          if (baseTax > 5500) s += (baseTax - 5500) * 0.20;
          if (baseTax > 7000) s += (baseTax - 7000) * 0.36;
          return s;
        };
        provTaxBefore += calcOnSurtax(provTaxBefore);
        provTaxAfter += calcOnSurtax(provTaxAfter);
      }
      const provTaxSaved = Math.max(0, provTaxBefore - provTaxAfter);

      const totalTaxBefore = fedTaxBefore + provTaxBefore;
      const totalTaxAfter = fedTaxAfter + provTaxAfter;
      const totalTaxSaved = Math.max(0, totalTaxBefore - totalTaxAfter);
      const afterTaxCost = Math.max(0, contrib - totalTaxSaved);
      const effectiveRate = deductibleContrib > 0 ? (totalTaxSaved / deductibleContrib) * 100 : 0;

      // Update Hero Outputs
      heroSavings.textContent = fmt(totalTaxSaved);
      heroBadge.textContent = `${effectiveRate.toFixed(2)}% Effective Savings`;
      heroSub.textContent = `Combined Federal & ${provData.name} tax reduction`;

      heroCost.textContent = fmt(afterTaxCost);
      heroCostSub.textContent = `Actual out-of-pocket investment after ${fmt(totalTaxSaved)} tax savings`;

      // Update Flow Breakdown
      flowContrib.textContent = `$${Math.round(contrib).toLocaleString('en-CA')}`;
      flowTaxable.textContent = `$${Math.round(incomeAfter).toLocaleString('en-CA')}`;
      flowSavings.textContent = fmt(totalTaxSaved);
      flowCost.textContent = fmt(afterTaxCost);

      // Update Metrics Grid
      metricContrib.textContent = fmt(contrib);
      metricDeductible.textContent = fmt(deductibleContrib);
      metricDeductibleSub.textContent = hasRoom && excessAboveRoom > 0 
        ? `Capped at ${fmt(availableRoom)} available room` 
        : (deductibleContrib < contrib ? 'Capped at taxable income' : '100% deductible against income');

      metricAboveRoom.textContent = fmt(excessAboveRoom);
      metricAboveRoomSub.textContent = hasRoom 
        ? (excessAboveRoom > 0 ? 'Not deductible this year' : 'Within available room')
        : 'Assumed fully within CRA room';

      metricIncomeBefore.textContent = fmt(incomeBefore);
      metricIncomeAfter.textContent = fmt(incomeAfter);
      metricTaxBefore.textContent = fmt(totalTaxBefore);
      metricTaxAfter.textContent = fmt(totalTaxAfter);

      metricFedSavings.textContent = fmt(fedTaxSaved);
      metricProvLabel.textContent = `${provData.name} Tax Savings`;
      metricProvSavings.textContent = fmt(provTaxSaved);
      metricProvSub.textContent = `${provData.name} provincial reduction`;
      metricTotalSavings.textContent = fmt(totalTaxSaved);

      // Room & Excess Alert Banner
      if (hasRoom && excessAboveRoom > 0) {
        roomAlert.classList.remove('hidden');
        roomAlert.classList.remove('info-banner');
        roomAlertMsg.innerHTML = `<strong>Potential contribution above available room: ${fmt(excessAboveRoom)}.</strong> Only ${fmt(deductibleContrib)} of your ${fmt(contrib)} contribution can be deducted against current-year taxable income. Any amount exceeding your room cannot be claimed this year and may be subject to a CRA 1%/month penalty tax if over the $2,000 lifetime buffer.`;
      } else if (!hasRoom) {
        roomAlert.classList.remove('hidden');
        roomAlert.classList.add('info-banner');
        roomAlertMsg.innerHTML = `<strong>Deduction limit assumption:</strong> Because no Available RRSP Contribution Room was entered, the calculator assumes your entire ${fmt(contrib)} contribution is deductible. Always verify your official RRSP deduction limit on your latest CRA Notice of Assessment.`;
      } else {
        roomAlert.classList.add('hidden');
      }

      // Quebec Alert Banner
      if (provKey === 'QC') {
        qcAlert.classList.remove('hidden');
      } else {
        qcAlert.classList.add('hidden');
      }

      // Audit Breakdown Table Rows
      auditTbody.innerHTML = `
        <tr>
          <td style="font-weight: 500;">Federal Income Tax ${provData.abatement ? '(Net of 16.5% Abatement)' : ''}</td>
          <td style="text-align: right;">${fmt(fedTaxBefore)}</td>
          <td style="text-align: right;">${fmt(fedTaxAfter)}</td>
          <td style="text-align: right; color: var(--color-success); font-weight: 600;">${fmt(fedTaxSaved)}</td>
        </tr>
        <tr>
          <td style="font-weight: 500;">${provData.name} Provincial Tax ${provData.surtax ? '(Incl. Surtax)' : ''}</td>
          <td style="text-align: right;">${fmt(provTaxBefore)}</td>
          <td style="text-align: right;">${fmt(provTaxAfter)}</td>
          <td style="text-align: right; color: var(--color-success); font-weight: 600;">${fmt(provTaxSaved)}</td>
        </tr>
        <tr style="border-top: 2px solid var(--color-border); font-weight: 700; background-color: var(--color-surface-hover, rgba(0,0,0,0.02));">
          <td>Total Combined Income Tax</td>
          <td style="text-align: right;">${fmt(totalTaxBefore)}</td>
          <td style="text-align: right;">${fmt(totalTaxAfter)}</td>
          <td style="text-align: right; color: var(--color-success);">${fmt(totalTaxSaved)}</td>
        </tr>
      `;

      // Summary Card Text
      summaryDesc.innerHTML = `Contributing <strong>${fmt(contrib)}</strong> to your RRSP reduces your taxable income from <strong>${fmt(incomeBefore)}</strong> to <strong>${fmt(incomeAfter)}</strong>, generating an estimated tax savings of <strong>${fmt(totalTaxSaved)}</strong>. Your effective after-tax cost is <strong>${fmt(afterTaxCost)}</strong> (${effectiveRate.toFixed(2)}% effective savings rate).`;
    }

    // Input Events
    incomeInput.addEventListener('input', () => {
      incomeSlider.value = incomeInput.value;
      updateCalculation();
    });

    incomeSlider.addEventListener('input', () => {
      incomeInput.value = incomeSlider.value;
      updateCalculation();
    });

    contribInput.addEventListener('input', () => {
      contribSlider.value = contribInput.value;
      updateCalculation();
    });

    contribSlider.addEventListener('input', () => {
      contribInput.value = contribSlider.value;
      updateCalculation();
    });

    roomInput.addEventListener('input', updateCalculation);
    taxYearSelect.addEventListener('change', updateCalculation);
    provinceSelect.addEventListener('change', updateCalculation);

    // Preset Buttons
    root.querySelectorAll('.preset-pill').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const incomeVal = target.getAttribute('data-income');
        const contribVal = target.getAttribute('data-contrib');
        const roomVal = target.getAttribute('data-room');

        if (incomeVal) {
          incomeInput.value = incomeVal;
          incomeSlider.value = incomeVal;
          target.parentElement?.querySelectorAll('.preset-pill').forEach(p => p.classList.remove('active'));
          target.classList.add('active');
        } else if (contribVal) {
          contribInput.value = contribVal;
          contribSlider.value = contribVal;
          target.parentElement?.querySelectorAll('.preset-pill').forEach(p => p.classList.remove('active'));
          target.classList.add('active');
        } else if (roomVal !== null) {
          if (roomVal === 'clear') {
            roomInput.value = '';
          } else {
            roomInput.value = roomVal;
          }
          target.parentElement?.querySelectorAll('.preset-pill').forEach(p => p.classList.remove('active'));
          target.classList.add('active');
        }
        updateCalculation();
      });
    });

    // Reset Button
    resetBtn.addEventListener('click', () => {
      taxYearSelect.value = '2026';
      provinceSelect.value = 'ON';
      incomeInput.value = '100000';
      incomeSlider.value = '100000';
      contribInput.value = '10000';
      contribSlider.value = '10000';
      roomInput.value = '';

      root.querySelectorAll('.preset-pill').forEach(p => p.classList.remove('active'));
      root.querySelector('[data-income="100000"]')?.classList.add('active');
      root.querySelector('[data-contrib="10000"]')?.classList.add('active');
      root.querySelector('[data-room="clear"]')?.classList.add('active');

      updateCalculation();
    });

    // Audit Panel Toggle
    auditToggle.addEventListener('click', () => {
      const isExpanded = auditToggle.getAttribute('aria-expanded') === 'true';
      auditToggle.setAttribute('aria-expanded', String(!isExpanded));
      auditPanel.classList.toggle('hidden');
      auditChevron.classList.toggle('rotated');
    });

    // Initial calculation
    updateCalculation();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRrspTaxSavingsCalculator);
  } else {
    initRrspTaxSavingsCalculator();
  }
</script>

